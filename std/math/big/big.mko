// std/math/big — arbitrary-precision integers (signed).
// Go equivalent: math/big.Int (add/sub/mul/cmp/string). Digits are base 1e9.

struct Int {
    digits: []int
    neg: bool
}

fn zero() -> Int { return Int { digits: [0], neg: false } }

fn with_sign(x: Int, neg: bool) -> Int {
    if is_zero(x) { return zero() }
    return Int { digits: x.digits, neg: neg }
}

fn from_int(n: int) -> Int {
    if n == 0 { return zero() }
    let mut x = n
    let mut neg = false
    if x < 0 {
        neg = true
        x = 0 - x
    }
    let mut digits = make([]int, 0)
    while x > 0 {
        digits = append(digits, x % 1000000000)
        x = x / 1000000000
    }
    return Int { digits: digits, neg: neg }
}

fn from_string(s: string) -> (Int, string) {
    if str_len(s) == 0 { return (zero(), "empty") }
    let mut i = 0
    let mut neg = false
    if str_byte_at(s, 0) == 45 {
        neg = true
        i = 1
    } else if str_byte_at(s, 0) == 43 {
        i = 1
    }
    if i >= str_len(s) { return (zero(), "invalid") }
    let mut acc = zero()
    while i < str_len(s) {
        let c = str_byte_at(s, i)
        if c < 48 || c > 57 { return (zero(), "invalid digit") }
        acc = mul(acc, from_int(10))
        acc = add(acc, from_int(c - 48))
        i = i + 1
    }
    return (with_sign(acc, neg), "")
}

fn is_zero(x: Int) -> bool {
    return len(x.digits) == 1 && x.digits[0] == 0
}

fn cmp(a: Int, b: Int) -> int {
    if a.neg != b.neg {
        if is_zero(a) && is_zero(b) { return 0 }
        if a.neg { return -1 }
        return 1
    }
    let c = cmp_abs(a, b)
    if a.neg { return 0 - c }
    return c
}

fn cmp_abs(a: Int, b: Int) -> int {
    if len(a.digits) != len(b.digits) {
        if len(a.digits) > len(b.digits) { return 1 }
        return -1
    }
    let mut i = len(a.digits) - 1
    while i >= 0 {
        if a.digits[i] > b.digits[i] { return 1 }
        if a.digits[i] < b.digits[i] { return -1 }
        i = i - 1
    }
    return 0
}

fn add(a: Int, b: Int) -> Int {
    if a.neg == b.neg {
        return with_sign(add_abs(a, b), a.neg)
    }
    let c = cmp_abs(a, b)
    if c == 0 { return zero() }
    if c > 0 { return with_sign(sub_abs(a, b), a.neg) }
    return with_sign(sub_abs(b, a), b.neg)
}

fn sub(a: Int, b: Int) -> Int {
    return add(a, with_sign(b, !b.neg))
}

fn mul(a: Int, b: Int) -> Int {
    if is_zero(a) || is_zero(b) { return zero() }
    let mut out = make([]int, 0, len(a.digits) + len(b.digits) + 1)
    let mut i = 0
    while i < len(a.digits) + len(b.digits) + 1 {
        out = append(out, 0)
        i = i + 1
    }
    i = 0
    while i < len(a.digits) {
        let mut carry = 0
        let mut j = 0
        while j < len(b.digits) {
            let t = out[i + j] + a.digits[i] * b.digits[j] + carry
            out[i + j] = t % 1000000000
            carry = t / 1000000000
            j = j + 1
        }
        out[i + len(b.digits)] = out[i + len(b.digits)] + carry
        i = i + 1
    }
    return Int { digits: trim(out), neg: a.neg != b.neg }
}

fn add_abs(a: Int, b: Int) -> Int {
    let n = len(a.digits)
    let m = len(b.digits)
    let mut lim = n
    if m > lim { lim = m }
    let mut out = make([]int, 0, lim + 1)
    let mut carry = 0
    let mut i = 0
    while i < lim || carry != 0 {
        let mut s = carry
        if i < n { s = s + a.digits[i] }
        if i < m { s = s + b.digits[i] }
        out = append(out, s % 1000000000)
        carry = s / 1000000000
        i = i + 1
    }
    return Int { digits: trim(out), neg: false }
}

fn sub_abs(a: Int, b: Int) -> Int {
    let mut out = make([]int, 0, len(a.digits))
    let mut borrow = 0
    let mut i = 0
    while i < len(a.digits) {
        let mut s = a.digits[i] - borrow
        if i < len(b.digits) { s = s - b.digits[i] }
        if s < 0 {
            s = s + 1000000000
            borrow = 1
        } else {
            borrow = 0
        }
        out = append(out, s)
        i = i + 1
    }
    return Int { digits: trim(out), neg: false }
}

fn trim(d: []int) -> []int {
    let mut n = len(d)
    while n > 1 && d[n - 1] == 0 {
        n = n - 1
    }
    if n == len(d) { return d }
    let mut out = make([]int, 0, n)
    let mut i = 0
    while i < n {
        out = append(out, d[i])
        i = i + 1
    }
    return out
}

fn to_string(x: Int) -> string {
    if is_zero(x) { return "0" }
    let mut out = ""
    let mut i = len(x.digits) - 1
    out = format_int(x.digits[i])
    i = i - 1
    while i >= 0 {
        out = out + format_int_pad9(x.digits[i])
        i = i - 1
    }
    if x.neg { return "-" + out }
    return out
}

fn format_int_pad9(n: int) -> string {
    let s = format_int(n)
    let mut out = s
    while str_len(out) < 9 {
        out = "0" + out
    }
    return out
}

fn bit_len(x: Int) -> int {
    if is_zero(x) { return 0 }
    let top = x.digits[len(x.digits) - 1]
    let mut n = (len(x.digits) - 1) * 30
    let mut v = top
    let mut bits = 0
    while v > 0 {
        v = v / 2
        bits = bits + 1
    }
    return n + bits
}

fn abs_int(x: Int) -> Int { return with_sign(x, false) }

fn rem_small(a: Int, m: int) -> int {
    if m <= 0 { return 0 }
    let mut r = 0
    let mut i = len(a.digits) - 1
    while i >= 0 {
        r = (r * 1000000000 + a.digits[i]) % m
        i = i - 1
    }
    return r
}

fn gcd_small(a: int, b: int) -> int {
    let mut x = a
    let mut y = b
    if x < 0 { x = 0 - x }
    if y < 0 { y = 0 - y }
    while y != 0 {
        let t = y
        y = x % y
        x = t
    }
    return x
}

fn gcd(a: Int, b: Int) -> Int {
    let mut x = abs_int(a)
    let mut y = abs_int(b)
    let mut guard = 0
    while !is_zero(y) && guard < 100000 {
        guard = guard + 1
        if len(y.digits) == 1 {
            let r = rem_small(x, y.digits[0])
            return from_int(gcd_small(y.digits[0], r))
        }
        if cmp_abs(x, y) < 0 {
            let t = x
            x = y
            y = t
        } else {
            x = sub_abs(x, y)
        }
    }
    return x
}

// Rat is a reduced rational (Go math/big.Rat).
struct Rat {
    num: Int
    den: Int
}

fn rat_zero() -> Rat { return Rat { num: zero(), den: from_int(1) } }

fn rat_from_int(n: int) -> Rat {
    return Rat { num: from_int(n), den: from_int(1) }
}

fn rat_new(num: Int, den: Int) -> Rat {
    if is_zero(den) { return rat_zero() }
    let g = gcd(num, den)
    let mut nsign = num.neg != den.neg
    let an = abs_int(num)
    let ad = abs_int(den)
    // divide by g when g is a small int
    if len(g.digits) == 1 && g.digits[0] > 1 {
        let d = g.digits[0]
        return Rat {
            num: with_sign(rem_wait_div(an, d), nsign),
            den: rem_wait_div(ad, d),
        }
    }
    return Rat { num: with_sign(an, nsign), den: ad }
}

fn rem_wait_div(a: Int, d: int) -> Int {
    if d <= 0 { return a }
    if len(a.digits) == 1 { return from_int(a.digits[0] / d) }
    // long division by a single limb
    let mut out = make([]int, 0, len(a.digits))
    let mut rem = 0
    let mut i = len(a.digits) - 1
    while i >= 0 {
        let cur = rem * 1000000000 + a.digits[i]
        let q = cur / d
        rem = cur % d
        out = append(out, q)
        i = i - 1
    }
    // reverse out (we appended high to low)
    let mut digits = make([]int, 0, len(out))
    let mut j = len(out) - 1
    while j >= 0 {
        digits = append(digits, out[j])
        j = j - 1
    }
    return Int { digits: trim(digits), neg: false }
}

fn rat_add(a: Rat, b: Rat) -> Rat {
    // a.n/a.d + b.n/b.d = (a.n*b.d + b.n*a.d) / (a.d*b.d)
    let n = add(mul(a.num, b.den), mul(b.num, a.den))
    let d = mul(a.den, b.den)
    return rat_new(n, d)
}

fn rat_sub(a: Rat, b: Rat) -> Rat {
    let n = sub(mul(a.num, b.den), mul(b.num, a.den))
    let d = mul(a.den, b.den)
    return rat_new(n, d)
}

fn rat_mul(a: Rat, b: Rat) -> Rat {
    return rat_new(mul(a.num, b.num), mul(a.den, b.den))
}

fn rat_quo(a: Rat, b: Rat) -> Rat {
    if is_zero(b.num) { return rat_zero() }
    return rat_new(mul(a.num, b.den), mul(a.den, b.num))
}

fn rat_cmp(a: Rat, b: Rat) -> int {
    return cmp(mul(a.num, b.den), mul(b.num, a.den))
}

fn rat_string(r: Rat) -> string {
    if is_zero(r.num) { return "0" }
    if len(r.den.digits) == 1 && r.den.digits[0] == 1 {
        return to_string(r.num)
    }
    return to_string(r.num) + "/" + to_string(r.den)
}
