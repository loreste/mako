// std/index/suffixarray — suffix array over a string.
// Go equivalent: index/suffixarray. Built naively (fine for modest texts).

fn new_index(s: string) -> []int {
    let n = str_len(s)
    let mut sa = make([]int, 0, n)
    let mut i = 0
    while i < n {
        sa = append(sa, i)
        i = i + 1
    }
    return sort_sa(s, sa)
}

fn lookup(s: string, sa: []int, needle: string) -> []int {
    let mut out = make([]int, 0)
    if str_len(needle) == 0 { return out }
    let mut i = 0
    while i < len(sa) {
        let off = sa[i]
        if off >= 0 && off + str_len(needle) <= str_len(s) {
            if str_slice_eq(s, off, str_len(needle), needle) == 1 {
                out = append(out, off)
            }
        }
        i = i + 1
    }
    return out
}

fn contains(s: string, sa: []int, needle: string) -> bool {
    return len(lookup(s, sa, needle)) > 0
}

fn sort_sa(s: string, sa: []int) -> []int {
    // Insertion sort by suffix order. n is small in tests.
    let mut a = sa
    let mut i = 1
    while i < len(a) {
        let key = a[i]
        let mut j = i - 1
        while j >= 0 {
            if suffix_less(s, a[j], key) { break }
            a[j + 1] = a[j]
            j = j - 1
        }
        a[j + 1] = key
        i = i + 1
    }
    return a
}

fn suffix_less(s: string, i: int, j: int) -> bool {
    let n = str_len(s)
    let mut a = i
    let mut b = j
    while a < n && b < n {
        let ca = str_byte_at(s, a)
        let cb = str_byte_at(s, b)
        if ca < cb { return true }
        if ca > cb { return false }
        a = a + 1
        b = b + 1
    }
    return a >= n && b < n
}
