// std/crypto/tls — OpenSSL-backed when linked (see docs/SECURITY.md).
fn serve(port: int, cert: string, key: string, body: string) -> int {
    return tls_serve(port, cert, key, body)
}
fn serve_once(port: int, cert: string, key: string, body: string) -> int {
    return tls_serve_once(port, cert, key, body)
}
fn server_new(cert: string, key: string) -> TlsServer {
    return tls_server_new(cert, key)
}
fn server_new_mtls(cert: string, key: string, client_ca: string) -> TlsServer {
    return tls_server_new_mtls(cert, key, client_ca)
}
// Add an exact or left-most wildcard SNI certificate to a live server.
fn server_sni_add(server: TlsServer, hostname: string, cert: string, key: string) -> int {
    return tls_server_sni_add(server, hostname, cert, key)
}
// Strict replace of an existing SNI name (use add for a new hostname).
fn server_sni_update(server: TlsServer, hostname: string, cert: string, key: string) -> int {
    return tls_server_sni_update(server, hostname, cert, key)
}
// Remove an SNI certificate; future handshakes fall back to the default cert.
fn server_sni_remove(server: TlsServer, hostname: string) -> int {
    return tls_server_sni_remove(server, hostname)
}
fn client_new_mtls(ca: string, cert: string, key: string) -> TlsClient {
    return tls_client_new_mtls(ca, cert, key)
}
// Pooled outbound TLS: CA verify, historical 1200 ms connect timeout.
fn pool_open(host: string, port: int, ca: string) -> int {
    return tls_pool_open(host, port, ca)
}
// Pooled outbound TLS with configurable connect timeout_ms.
fn pool_open_timeout(host: string, port: int, ca: string, timeout_ms: int) -> int {
    return tls_pool_open_timeout(host, port, ca, timeout_ms)
}
// Pooled mTLS: present client cert+key, verify peer with CA.
fn pool_open_mtls(
    host: string, port: int, ca: string, cert: string, key: string, timeout_ms: int
) -> int {
    return tls_pool_open_mtls(host, port, ca, cert, key, timeout_ms)
}
// mTLS with independent connect + I/O timeouts (ms).
fn pool_open_mtls_full(
    host: string, port: int, ca: string, cert: string, key: string,
    connect_ms: int, io_ms: int
) -> int {
    return tls_pool_open_mtls_full(host, port, ca, cert, key, connect_ms, io_ms)
}
fn pool_set_timeout(handle: int, io_ms: int) -> int {
    return tls_pool_set_timeout(handle, io_ms)
}
fn pool_send(handle: int, data: string) -> int {
    return tls_pool_send(handle, data)
}
fn pool_recv(handle: int, max: int) -> string {
    return tls_pool_recv(handle, max)
}
fn pool_fd(handle: int) -> int {
    return tls_pool_fd(handle)
}
fn pool_close(handle: int) -> int {
    return tls_pool_close(handle)
}
fn unique(conn: TlsConn) -> string {
    return tls_unique(conn)
}
// Hot-reload server cert/key (rotation without process restart).
fn server_reload(server: TlsServer, cert: string, key: string) -> int {
    return tls_server_reload(server, cert, key)
}
fn make_self_signed(cert: string, key: string, cn: string, days: int) -> int {
    return tls_make_self_signed(cert, key, cn, days)
}
fn make_csr(csr: string, key: string, cn: string, bits: int) -> int {
    return tls_make_csr(csr, key, cn, bits)
}
