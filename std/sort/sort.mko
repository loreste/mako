// std/sort — sorting and searching for slices
//
// Typed sort for int, string, and float slices.
// All sorts are in-place and return the sorted slice.

pack sort

fn ints(a: []int) -> []int { return sort_ints(a) }
fn strings(a: []string) -> []string { return sort_strings(a) }

fn ints_reverse(a: []int) -> []int {
    let sorted = sort_ints(a)
    return slices_reverse(sorted)
}

fn strings_reverse(a: []string) -> []string {
    let sorted = sort_strings(a)
    return slices_reverse_strs(sorted)
}

fn is_sorted_ints(a: []int) -> bool {
    if len(a) < 2 { return true }
    let mut i = 1
    while i < len(a) {
        if a[i] < a[i - 1] { return false }
        i = i + 1
    }
    return true
}

fn is_sorted_strings(a: []string) -> bool {
    if len(a) < 2 { return true }
    let mut i = 1
    while i < len(a) {
        if str_compare(a[i - 1], a[i]) > 0 { return false }
        i = i + 1
    }
    return true
}

// search_ints is Go sort.SearchInts: first index >= v on a sorted slice.
fn search_ints(a: []int, v: int) -> int {
    let mut lo = 0
    let mut hi = len(a)
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if a[mid] < v {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

fn search_strings(a: []string, v: string) -> int {
    let mut lo = 0
    let mut hi = len(a)
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if str_compare(a[mid], v) < 0 {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}
