// std/encoding/asn1 — DER integers (Go encoding/asn1 subset).
// Built as []byte so values 128–255 stay raw (not UTF-8).

fn encode_int(n: int) -> string {
    if n == 0 {
        let z: []byte = [2, 1, 0]
        return string(z)
    }
    let mut v = n
    let mut neg = false
    if v < 0 {
        neg = true
        v = 0 - v
    }
    let mut bytes = make([]int, 0)
    while v > 0 {
        bytes = append(bytes, v & 255)
        v = v >> 8
    }
    let mut be = make([]int, 0, len(bytes) + 1)
    let mut i = len(bytes) - 1
    while i >= 0 {
        be = append(be, bytes[i])
        i = i - 1
    }
    if !neg && be[0] >= 128 {
        let mut padded = [0]
        let mut j = 0
        while j < len(be) {
            padded = append(padded, be[j])
            j = j + 1
        }
        be = padded
    }
    if neg {
        let mut k = len(be) - 1
        while k >= 0 {
            be[k] = 255 - be[k]
            k = k - 1
        }
        let mut c = 1
        k = len(be) - 1
        while k >= 0 && c > 0 {
            let t = be[k] + c
            be[k] = t & 255
            c = t >> 8
            k = k - 1
        }
        if be[0] < 128 {
            let mut padded = [255]
            let mut j = 0
            while j < len(be) {
                padded = append(padded, be[j])
                j = j + 1
            }
            be = padded
        }
    }
    let mut out = make([]byte, 0, 2 + len(be))
    out = append(out, byte(2))
    out = append(out, byte(len(be)))
    let mut p = 0
    while p < len(be) {
        out = append(out, byte(be[p]))
        p = p + 1
    }
    return string(out)
}

fn decode_int(der: string) -> (int, string) {
    if str_len(der) < 3 { return (0, "short") }
    if str_byte_at(der, 0) != 2 { return (0, "not integer") }
    let ln = str_byte_at(der, 1)
    if ln < 1 || ln > 8 { return (0, "too wide") }
    if 2 + ln > str_len(der) { return (0, "truncated") }
    let mut v = 0
    let mut i = 0
    while i < ln {
        v = (v << 8) | str_byte_at(der, 2 + i)
        i = i + 1
    }
    if str_byte_at(der, 2) >= 128 {
        let bits = ln * 8
        if bits >= 63 { return (0, "too wide") }
        v = v - (1 << bits)
    }
    return (v, "")
}

fn sequence_wrap(body: string) -> string {
    let n = str_len(body)
    let mut out = make([]byte, 0, 2 + n)
    out = append(out, byte(48))
    out = append(out, byte(n))
    let mut i = 0
    while i < n {
        out = append(out, byte(str_byte_at(body, i)))
        i = i + 1
    }
    return string(out)
}
