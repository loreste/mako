// std/encoding/protobuf — wire codec helpers (varint/key/bytes/simple message)
//
// Wire types: 0 = varint, 1 = 64-bit, 2 = length-delimited, 5 = 32-bit
//
// Usage:
//   pull "encoding/protobuf" as pb
//   let msg = pb.encode_field_varint(1, 42)   // field 1, value 42
//   let key = pb.encode_key(2, 2)             // field 2, wire type 2 (bytes)
//   let framed = key + pb.encode_bytes(data)

pack protobuf

// ── Varint encoding (wire type 0) ──────────────────────────────
export fn encode_varint(v: int) -> string { return pb_encode_varint(v) }
export fn decode_varint(s: string) -> int { return pb_decode_varint(s) }
export fn varint_len(s: string) -> int { return pb_varint_len(s) }

// ── Field key (field number + wire type) ───────────────────────
export fn encode_key(field: int, wire: int) -> string { return pb_encode_key(field, wire) }
export fn key_field(s: string) -> int { return pb_key_field(s) }
export fn key_wire(s: string) -> int { return pb_key_wire(s) }

// ── Signed integers (zigzag encoding for sint32/sint64) ────────
export fn zigzag_encode(n: int) -> int { return pb_zigzag_encode(n) }
export fn zigzag_decode(n: int) -> int { return pb_zigzag_decode(n) }
export fn encode_sint(n: int) -> string { return pb_encode_sint(n) }
export fn decode_sint(s: string) -> int { return pb_decode_sint(s) }

// ── Length-delimited (wire type 2: bytes, strings, submessages) ─
export fn encode_bytes(payload: string) -> string { return pb_encode_bytes(payload) }
export fn bytes_len(s: string) -> int { return pb_bytes_len(s) }

// ── Field + value helpers ──────────────────────────────────────
export fn encode_field_varint(field: int, value: int) -> string {
    return pb_encode_field_varint(field, value)
}

// ── Simple message (name + id) ─────────────────────────────────
export fn encode_simple(name: string, id: int) -> string { return pb_encode_simple(name, id) }
export fn simple_name(msg: string) -> string { return pb_simple_name(msg) }
export fn simple_id(msg: string) -> int { return pb_simple_id(msg) }

// ── Nested messages ────────────────────────────────────────────
export fn encode_nested(name: string, id: int, inner_name: string, inner_id: int) -> string {
    return pb_encode_nested(name, id, inner_name, inner_id)
}
export fn nested_inner(msg: string) -> string { return pb_nested_inner(msg) }

// ── Repeated fields (packed varint) ────────────────────────────
export fn encode_repeated_varint(a: int, b: int, c: int) -> string {
    return pb_encode_repeated_varint(a, b, c)
}
export fn repeated_count(msg: string, field: int) -> int { return pb_repeated_count(msg, field) }
export fn repeated_at(msg: string, field: int, idx: int) -> int {
    return pb_repeated_at(msg, field, idx)
}

// ── Wire type constants ────────────────────────────────────────
export const WIRE_VARINT = 0
export const WIRE_64BIT = 1
export const WIRE_BYTES = 2
export const WIRE_32BIT = 5

// ── Hex conversion ─────────────────────────────────────────────
export fn to_hex(bin: string) -> string { return bytes_to_hex(bin) }
export fn from_hex(hex: string) -> string { return hex_to_bytes(hex) }
