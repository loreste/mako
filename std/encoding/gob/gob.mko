// std/encoding/gob — Go binary encoding.
fn encode_int(v: int) -> string { return gob_encode_int(v) }
fn decode_int(data: string) -> int { return gob_decode_int(data) }
fn encode_string(s: string) -> string { return gob_encode_string(s) }
fn decode_string(data: string) -> string { return gob_decode_string(data) }
fn encode_strs(v: []string) -> string { return gob_encode_strs(v) }
fn decode_strs(data: string) -> []string { return gob_decode_strs(data) }
