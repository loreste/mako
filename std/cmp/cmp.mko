// std/cmp — ordered comparison helpers.
// Go equivalent: cmp.Compare / cmp.Less / cmp.Or.

fn compare_int(a: int, b: int) -> int {
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

fn compare_str(a: string, b: string) -> int { return str_compare(a, b) }

fn compare_float(a: float, b: float) -> int {
    if math_is_nan(a) == 1 && math_is_nan(b) == 1 { return 0 }
    if math_is_nan(a) == 1 { return -1 }
    if math_is_nan(b) == 1 { return 1 }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

fn less_int(a: int, b: int) -> bool { return a < b }
fn less_str(a: string, b: string) -> bool { return str_compare(a, b) < 0 }
fn less_float(a: float, b: float) -> bool { return a < b }

fn or_int(a: int, b: int) -> int {
    if a != 0 { return a }
    return b
}

fn or_str(a: string, b: string) -> string {
    if str_len(a) > 0 { return a }
    return b
}

fn clamp_int(x: int, lo: int, hi: int) -> int { return clamp(x, lo, hi) }
