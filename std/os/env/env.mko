// std/os/env — process environment (Go os.Getenv / LookupEnv / ExpandEnv).

fn get(k: string) -> string { return env_get(k) }
fn set(k: string, v: string) -> int { return env_set(k, v) }
fn unset(k: string) -> int { return env_unset(k) }
fn has(k: string) -> bool { return env_has(k) == 1 }
fn keys() -> []string { return env_keys() }

fn lookup(k: string) -> (string, int) {
    if env_has(k) == 1 {
        return (env_get(k), 1)
    }
    return ("", 0)
}

fn expand(s: string) -> string {
    let mut out = ""
    let n = str_len(s)
    let mut i = 0
    while i < n {
        let c = str_byte_at(s, i)
        if c == 36 && i + 1 < n {
            if str_byte_at(s, i + 1) == 123 {
                let mut j = i + 2
                while j < n && str_byte_at(s, j) != 125 {
                    j = j + 1
                }
                if j < n {
                    let name = str_slice(s, i + 2, j)
                    out = out + env_get(name)
                    i = j + 1
                    continue
                }
            } else {
                let mut j = i + 1
                while j < n {
                    let ch = str_byte_at(s, j)
                    let letter = (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95
                    let digit = ch >= 48 && ch <= 57
                    if !(letter || (digit && j > i + 1)) { break }
                    j = j + 1
                }
                if j > i + 1 {
                    let name = str_slice(s, i + 1, j)
                    out = out + env_get(name)
                    i = j
                    continue
                }
            }
        }
        out = out + str_slice(s, i, i + 1)
        i = i + 1
    }
    return out
}
