// strconv — parse and format numbers and quoted strings.
// Go equivalent: strconv. Parse failures are Result, never panic.

fn atoi(s: string) -> Result[int, string] { return parse_int(s) }
fn atof(s: string) -> float { return parse_float(s) }
fn atob(s: string) -> Result[int, string] { return parse_bool(s) }
fn itoa(n: int) -> string { return format_int(n) }

// Format
fn FormatInt(n: int) -> string { return format_int(n) }
fn FormatIntDec(n: int) -> string { return format_int_dec(n) }
fn FormatIntHex(n: int) -> string { return format_int_hex(n) }
fn FormatIntHexUpper(n: int) -> string { return format_int_hex_upper(n) }
fn FormatIntBin(n: int) -> string { return format_int_bin(n) }
fn FormatIntOct(n: int) -> string { return format_int_oct(n) }
fn FormatIntBase(n: int, base: int) -> string { return format_int_base(n, base) }
fn FormatIntHexPad(n: int, width: int) -> string { return format_int_hex_pad(n, width) }
fn FormatIntHexPrefix(n: int) -> string { return format_int_hex_prefix(n) }
fn FormatFloat(v: float, prec: int) -> string { return format_float(v, prec) }
fn FormatBool(b: bool) -> string { return format_bool(b) }
fn FormatPad(s: string, width: int, zero: int) -> string {
    return format_pad(s, width, zero)
}

fn format_uint(n: int, base: int) -> string {
    if n < 0 { return format_int_base(n, base) }
    return format_int_base(n, base)
}

// Parse
fn ParseInt(s: string) -> Result[int, string] { return parse_int(s) }
fn ParseIntBase(s: string, base: int) -> Result[int, string] {
    return parse_int_base(s, base)
}
fn ParseIntHex(s: string) -> Result[int, string] { return parse_int_hex(s) }
fn ParseIntBin(s: string) -> Result[int, string] { return parse_int_bin(s) }
fn ParseIntOct(s: string) -> Result[int, string] { return parse_int_oct(s) }
fn ParseIntAuto(s: string) -> Result[int, string] { return parse_int_auto(s) }
fn ParseFloat(s: string) -> float { return parse_float(s) }
fn ParseBool(s: string) -> Result[int, string] { return parse_bool(s) }

fn parse_uint(s: string, base: int) -> Result[int, string] {
    return parse_int_base(s, base)
}

// lowercase aliases
fn format_hex(n: int) -> string { return format_int_hex(n) }
fn format_bin(n: int) -> string { return format_int_bin(n) }
fn format_oct(n: int) -> string { return format_int_oct(n) }
fn format_dec(n: int) -> string { return format_int_dec(n) }

fn is_print(r: int) -> bool {
    return unicode_is_print(r) == 1
}

fn is_graphic(r: int) -> bool {
    return unicode_is_graphic(r) == 1
}

fn can_backquote(s: string) -> bool {
    let mut i = 0
    while i < str_len(s) {
        let b = str_byte_at(s, i)
        if b == 96 { return false }
        if b == 0 { return false }
        if b == 13 { return false }
        i = i + 1
    }
    return true
}

// quote wraps s in double quotes and escapes controls (Go strconv.Quote).
fn quote(s: string) -> string {
    let mut out = "\""
    let mut i = 0
    let n = str_len(s)
    while i < n {
        let sz = utf8_decode_size(s, i)
        let mut step = sz
        if step <= 0 { step = 1 }
        if i + step > n { step = n - i }
        let r = utf8_decode_rune(s, i)
        if step == 1 && str_byte_at(s, i) < 128 {
            let b = str_byte_at(s, i)
            if b == 34 {
                out = out + "\\\""
            } else if b == 92 {
                out = out + "\\\\"
            } else if b == 10 {
                out = out + "\\n"
            } else if b == 13 {
                out = out + "\\r"
            } else if b == 9 {
                out = out + "\\t"
            } else if b >= 32 && b <= 126 {
                out = out + str_slice(s, i, i + 1)
            } else {
                out = out + "\\x" + format_int_hex_pad(b, 2)
            }
        } else if r < 0 || utf8_valid_rune(r) == 0 {
            out = out + "\\x" + format_int_hex_pad(str_byte_at(s, i), 2)
            step = 1
        } else if unicode_is_print(r) == 1 {
            out = out + str_slice(s, i, i + step)
        } else if r <= 65535 {
            out = out + "\\u" + format_int_hex_pad(r, 4)
        } else {
            out = out + "\\U" + format_int_hex_pad(r, 8)
        }
        i = i + step
    }
    return out + "\""
}

fn quote_rune(r: int) -> string {
    return quote(utf8_encode_rune(r))
}

fn quote_to_ascii(s: string) -> string {
    let mut out = "\""
    let mut i = 0
    let n = str_len(s)
    while i < n {
        let sz = utf8_decode_size(s, i)
        let mut step = sz
        if step <= 0 { step = 1 }
        if i + step > n { step = n - i }
        let r = utf8_decode_rune(s, i)
        if step == 1 && str_byte_at(s, i) < 128 {
            let b = str_byte_at(s, i)
            if b == 34 {
                out = out + "\\\""
            } else if b == 92 {
                out = out + "\\\\"
            } else if b == 10 {
                out = out + "\\n"
            } else if b == 13 {
                out = out + "\\r"
            } else if b == 9 {
                out = out + "\\t"
            } else if b >= 32 && b <= 126 {
                out = out + str_slice(s, i, i + 1)
            } else {
                out = out + "\\x" + format_int_hex_pad(b, 2)
            }
        } else if r <= 65535 {
            out = out + "\\u" + format_int_hex_pad(r, 4)
        } else {
            out = out + "\\U" + format_int_hex_pad(r, 8)
        }
        i = i + step
    }
    return out + "\""
}

fn unquote(s: string) -> (string, string) {
    let n = str_len(s)
    if n < 2 { return ("", "invalid syntax") }
    let first = str_byte_at(s, 0)
    let last = str_byte_at(s, n - 1)
    if first == 96 && last == 96 {
        return (str_slice(s, 1, n - 1), "")
    }
    if !(first == 34 && last == 34) {
        return ("", "invalid syntax")
    }
    let mut out = ""
    let mut i = 1
    while i < n - 1 {
        let b = str_byte_at(s, i)
        if b != 92 {
            out = out + str_slice(s, i, i + 1)
            i = i + 1
            continue
        }
        if i + 1 >= n - 1 { return ("", "invalid syntax") }
        let e = str_byte_at(s, i + 1)
        if e == 34 {
            out = out + "\""
            i = i + 2
        } else if e == 92 {
            out = out + "\\"
            i = i + 2
        } else if e == 110 {
            out = out + "\n"
            i = i + 2
        } else if e == 114 {
            out = out + "\r"
            i = i + 2
        } else if e == 116 {
            out = out + "\t"
            i = i + 2
        } else if e == 120 {
            if i + 3 >= n - 1 { return ("", "invalid syntax") }
            match parse_int_hex(str_slice(s, i + 2, i + 4)) {
                Ok(v) => {
                    out = out + utf8_encode_rune(v)
                    i = i + 4
                }
                Err(_) => { return ("", "invalid syntax") }
            }
        } else if e == 117 {
            if i + 5 >= n - 1 { return ("", "invalid syntax") }
            match parse_int_hex(str_slice(s, i + 2, i + 6)) {
                Ok(v) => {
                    out = out + utf8_encode_rune(v)
                    i = i + 6
                }
                Err(_) => { return ("", "invalid syntax") }
            }
        } else {
            return ("", "invalid syntax")
        }
    }
    return (out, "")
}

fn append_int(dst: string, n: int) -> string { return dst + format_int(n) }
fn append_bool(dst: string, b: bool) -> string { return dst + format_bool(b) }
fn append_quote(dst: string, s: string) -> string { return dst + quote(s) }
