// std/sync — synchronization primitives.
// Modeled after Go's sync package.

// ---- Mutex ----

fn mutex() -> Mutex { return mutex_new() }
fn lock(m: Mutex) { mutex_lock(m) }
fn unlock(m: Mutex) { mutex_unlock(m) }

// ---- RWMutex ----

fn rwmutex() -> RWMutex { return rwmutex_new() }
fn rlock(m: RWMutex) { rwmutex_rlock(m) }
fn runlock(m: RWMutex) { rwmutex_runlock(m) }
fn wlock(m: RWMutex) { rwmutex_lock(m) }
fn wunlock(m: RWMutex) { rwmutex_unlock(m) }

// ---- WaitGroup ----

fn wait_group() -> WaitGroup { return wait_group_new() }
fn add(wg: WaitGroup, n: int) { wait_group_add(wg, n) }
fn done(wg: WaitGroup) { wait_group_done(wg) }
fn wait(wg: WaitGroup) { wait_group_wait(wg) }

// ---- Atomic ----
// Wrappers cannot share the builtin name (that would recurse).

fn new_atomic(val: int) -> AtomicInt { return atomic_new(val) }
fn load(a: AtomicInt) -> int { return atomic_load(a) }
fn store(a: AtomicInt, val: int) { atomic_store(a, val) }
fn add_atomic(a: AtomicInt, delta: int) -> int { return atomic_add(a, delta) }
fn cas(a: AtomicInt, old: int, newv: int) -> int { return atomic_cas(a, old, newv) }

// once is Go sync.Once: a handle that lets a function run at most once.
fn once() -> AtomicInt { return atomic_new(0) }

fn do_once(h: AtomicInt, f: fn() -> int) -> int {
    if atomic_cas(h, 0, 1) == 1 {
        return f()
    }
    return 0
}

fn once_done(h: AtomicInt) -> int {
    if atomic_load(h) != 0 { return 1 }
    return 0
}
