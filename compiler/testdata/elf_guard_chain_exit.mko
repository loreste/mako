fn probe(n: int) -> int {
    return n * 3
}

fn main() {
    if probe(1) != 3 {
        print("probe one failed")
        exit(70)
    }
    if probe(2) != 6 {
        print("probe two failed")
        exit(71)
    }
    if probe(3) != 9 {
        print("probe three failed")
        exit(72)
    }
    print("all probes ok")
    exit(11)
}
