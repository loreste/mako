// The inner literal must set every inner field; a missing one is refused.
struct X86Code {
    bytes: []int
    status: int
    error: string
}

struct X86Body {
    code: X86Code
    edge_callees: []int
}

fn main() {
    let b = X86Body { code: X86Code { bytes: make([]int, 0, 0), status: 1 }, edge_callees: make([]int, 0, 0) }
    exit(0)
}
