fn compute(value: int) -> int {
    let mut total = 0
    let mut bonus = 1
    if value > 1 {
        total = 5
        bonus = 2
    } else {
        total = 10
        bonus = 3
    }
    let mut i = 0
    while i < value * 2 {
        total = total + i
        i = i + 1
    }
    while i < value * 4 {
        total = total + bonus
        i = i + 1
    }
    return total
}
