// 20k construct-return-drop cycles of a struct holding a []Token field: the
// field clone and the block must both be freed each iteration, with the
// struct-slice stride override sizing the unmap. Exit 3.
struct Token {
    kind: int
    start: int
    end: int
    line: int
    col: int
}

struct LexResult {
    tokens: []Token
    ok: bool
    error: string
    error_line: int
    error_col: int
}

fn make_lex() -> LexResult {
    let toks: []Token = make([]Token, 1, 1)
    return LexResult { tokens: toks, ok: true, error: "", error_line: 0, error_col: 0 }
}

fn main() {
    let mut i = 0
    while i < 20000 {
        let r = make_lex()
        let n = len(r.tokens)
        i = i + 1 + n - n
    }
    exit(3)
}
