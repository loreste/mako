fn compute(value: int) -> int {
    let mut total = 0
    let mut i = 0
    while i < value * 2 {
        total = total + 1
        i = i + 1
    }
    while i < value * 6 {
        i = i + 2
        if total > 4 {
            continue
        }
        total = total + 2
    }
    return total + i
}
