// Deterministic Linux x86-64 instruction encoding for the self-hosted backend.
// Unsupported IR remains an explicit error; it never falls back to C.

const X86_OK = 0
const X86_UNSUPPORTED = 1
const X86_RANGE = 2

// Slot ceiling for the general returning-CFG encoder: 4096 values is a 32 KB
// frame. Beyond this a function needs real register allocation, not one slot
// per SSA value.
const X86_MAX_CFG_VALUES = 4096

struct X86Code {
    bytes: []int
    status: int
    error: string
}

fn x86_error(status: int, message: string) -> X86Code {
    return X86Code { bytes: make([]int, 0, 0), status: status, error: message }
}

fn x86_emit_u32(bytes: []int, value: int) -> []int {
    let mut out = bytes
    out = append(out, value & 255)
    out = append(out, (value >> 8) & 255)
    out = append(out, (value >> 16) & 255)
    out = append(out, (value >> 24) & 255)
    return out
}

fn x86_emit_u64(bytes: []int, value: int) -> []int {
    let mut out = bytes
    out = append(out, value & 255)
    out = append(out, (value >> 8) & 255)
    out = append(out, (value >> 16) & 255)
    out = append(out, (value >> 24) & 255)
    out = append(out, (value >> 32) & 255)
    out = append(out, (value >> 40) & 255)
    out = append(out, (value >> 48) & 255)
    out = append(out, (value >> 56) & 255)
    return out
}

// Materialize a full-width signed Mako int in rax. The imm32 form preserves
// unsigned values above INT32_MAX; the sign-extending form handles negatives;
// movabs covers the remaining 64-bit values.
fn x86_emit_int_rax(bytes: []int, value: int) -> []int {
    let mut out = bytes
    if value >= 0 and value <= 4294967295 {
        out = append(out, 184)
        return x86_emit_u32(out, value)
    }
    if value >= -2147483648 and value < 0 {
        out = append(out, 72); out = append(out, 199); out = append(out, 192)
        return x86_emit_u32(out, value)
    }
    out = append(out, 72); out = append(out, 184)
    return x86_emit_u64(out, value)
}

// SysV x86-64: mov eax, imm32; ret.
fn x86_emit_return_int(value: int) -> X86Code {
    if value < 0 or value > 4294967295 {
    return x86_error(X86_RANGE, "x86 imm32 return is out of range")
    }
    let mut bytes: []int = make([]int, 0, 6)
 bytes = x86_emit_int_rax(bytes, value)
    bytes = append(bytes, 195)
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}

// Linux x86-64 process exit: mov eax, 60; mov edi, status; syscall.
fn x86_emit_exit_int(value: int) -> X86Code {
    if value < 0 or value > 4294967295 {
        return x86_error(X86_RANGE, "x86 exit status is out of range")
    }
    let mut bytes: []int = make([]int, 0, 12)
    bytes = append(bytes, 184)
    bytes = x86_emit_u32(bytes, 60)
    bytes = append(bytes, 191)
    bytes = x86_emit_u32(bytes, value)
    bytes = append(bytes, 15)
    bytes = append(bytes, 5)
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}

// SysV scalar addition: mov eax, lhs; add eax, rhs; ret.
fn x86_emit_add_return(lhs: int, rhs: int) -> X86Code {
    if lhs < 0 or lhs > 4294967295 or rhs < 0 or rhs > 4294967295 {
        return x86_error(X86_RANGE, "x86 add operand is out of range")
    }
    let mut bytes: []int = make([]int, 0, 11)
    bytes = append(bytes, 184)
    bytes = x86_emit_u32(bytes, lhs)
    bytes = append(bytes, 5)
    bytes = x86_emit_u32(bytes, rhs)
    bytes = append(bytes, 195)
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}

// Linux process exit after evaluating lhs + rhs in edi.
fn x86_emit_exit_add(lhs: int, rhs: int) -> X86Code {
    if lhs < 0 or lhs > 4294967295 or rhs < 0 or rhs > 4294967295 {
        return x86_error(X86_RANGE, "x86 add exit operand is out of range")
    }
    let mut bytes: []int = make([]int, 0, 17)
    bytes = append(bytes, 191)
    bytes = x86_emit_u32(bytes, lhs)
    bytes = append(bytes, 129)
    bytes = append(bytes, 199)
    bytes = x86_emit_u32(bytes, rhs)
    bytes = append(bytes, 184)
    bytes = x86_emit_u32(bytes, 60)
    bytes = append(bytes, 15)
    bytes = append(bytes, 5)
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}

// SysV function with one integer selector in edi:
// test edi, edi; je zero; mov eax, nonzero; ret; mov eax, zero; ret.
// A non-zero selector falls through to the first mov; a zero selector takes
// the short jump (+6) over it. Parameter order names the machine result, so
// callers never depend on remembering which arm falls through.
fn x86_emit_select_return(zero_value: int, nonzero_value: int) -> X86Code {
    if zero_value < 0 or zero_value > 4294967295 or nonzero_value < 0 or nonzero_value > 4294967295 {
        return x86_error(X86_RANGE, "x86 branch return operand is out of range")
    }
    let mut bytes: []int = make([]int, 0, 16)
    bytes = append(bytes, 133)
    bytes = append(bytes, 255)
    bytes = append(bytes, 116)
    bytes = append(bytes, 6)
    bytes = append(bytes, 184)
    bytes = x86_emit_u32(bytes, nonzero_value)
    bytes = append(bytes, 195)
    bytes = append(bytes, 184)
    bytes = x86_emit_u32(bytes, zero_value)
    bytes = append(bytes, 195)
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}

// Map a comparison operator to the short-jump opcode that selects the false
// arm (signed 64-bit predicates, matching Mako int semantics), or -1 when the
// operator is not a comparison.
fn x86_compare_false_jump(token: int) -> int {
    if token == TK_GT { return 126 }
    if token == TK_GE { return 124 }
    if token == TK_LT { return 125 }
    if token == TK_LE { return 127 }
    if token == TK_EQ_EQ { return 117 }
    if token == TK_BANG_EQ { return 116 }
    return -1
}

// SysV function with one integer parameter in rdi compared against a signed
// 32-bit immediate: cmp rdi, imm; jcc +6; mov eax, true; ret; mov eax, false;
// ret. The jump selects the false arm when the comparison does not hold; the
// fallthrough returns the true arm. The 64-bit compare preserves full Mako
// int semantics instead of truncating the parameter to 32 bits.
fn x86_emit_compare_return(false_value: int, true_value: int, false_jump: int, compare_value: int) -> X86Code {
    if false_value < 0 or false_value > 4294967295 or true_value < 0 or true_value > 4294967295 {
        return x86_error(X86_RANGE, "x86 compare return operand is out of range")
    }
    if compare_value < -2147483648 or compare_value > 2147483647 {
        return x86_error(X86_RANGE, "x86 compare immediate is out of range")
    }
    if false_jump < 0 or false_jump > 255 {
        return x86_error(X86_UNSUPPORTED, "x86 compare jump opcode is invalid")
    }
    let mut bytes: []int = make([]int, 0, 21)
    bytes = append(bytes, 72)
    bytes = append(bytes, 129)
    bytes = append(bytes, 255)
    bytes = x86_emit_u32(bytes, compare_value)
    bytes = append(bytes, false_jump)
    bytes = append(bytes, 6)
    bytes = append(bytes, 184)
    bytes = x86_emit_u32(bytes, true_value)
    bytes = append(bytes, 195)
    bytes = append(bytes, 184)
    bytes = x86_emit_u32(bytes, false_value)
    bytes = append(bytes, 195)
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}
// Linux x86-64 process-entry bridge. At ELF entry the kernel places argc at
// [rsp]; this prologue loads it into edi as the SysV first integer argument,
// calls the function body at the given rel32 displacement, and exits with its
// eax result as the process status.
fn x86_emit_bridge(call_disp: int) -> X86Code {
    if call_disp < -2147483648 or call_disp > 2147483647 {
        return x86_error(X86_RANGE, "x86 bridge displacement is out of range")
    }
    let mut bytes: []int = make([]int, 0, 17)
    bytes = append(bytes, 139)
    bytes = append(bytes, 60)
    bytes = append(bytes, 36)
    bytes = append(bytes, 232)
    bytes = x86_emit_u32(bytes, call_disp)
    bytes = append(bytes, 137)
    bytes = append(bytes, 199)
    bytes = append(bytes, 184)
    bytes = x86_emit_u32(bytes, 60)
    bytes = append(bytes, 15)
    bytes = append(bytes, 5)
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}

// Entry bridge plus one body: the body begins 9 bytes after the call
// instruction's end, so the displacement is fixed by this layout.
fn x86_emit_argc_call_exit(body: []int) -> X86Code {
    if len(body) == 0 {
        return x86_error(X86_UNSUPPORTED, "x86 entry bridge requires a function body")
    }
    let bridge = x86_emit_bridge(9)
    let mut bytes: []int = make([]int, 0, 17 + len(body))
    let mut i = 0
    while i < 17 {
        bytes = append(bytes, bridge.bytes[i])
        i = i + 1
    }
    i = 0
    while i < len(body) {
        bytes = append(bytes, body[i])
        i = i + 1
    }
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}

// Identity body: mov eax, edi; ret — one int parameter returned unchanged.
fn x86_emit_param_return() -> X86Code {
    let mut bytes: []int = make([]int, 0, 3)
    bytes = append(bytes, 137)
    bytes = append(bytes, 248)
    bytes = append(bytes, 195)
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}

// Scalar call body: mov edi, imm32; call rel32; ret. The displacement is
// patched once every function offset is known; pass zero when laying out.
fn x86_emit_const_call_return(argument: int, call_disp: int) -> X86Code {
    if argument < 0 or argument > 4294967295 {
        return x86_error(X86_RANGE, "x86 call argument is out of range")
    }
    if call_disp < -2147483648 or call_disp > 2147483647 {
        return x86_error(X86_RANGE, "x86 call displacement is out of range")
    }
    let mut bytes: []int = make([]int, 0, 11)
    bytes = append(bytes, 191)
    bytes = x86_emit_u32(bytes, argument)
    bytes = append(bytes, 232)
    bytes = x86_emit_u32(bytes, call_disp)
    bytes = append(bytes, 195)
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}

// Supported ALU operators for the current body shapes. All arithmetic is
// 64-bit so full-width Mako ints never truncate.
fn x86_alu_supported(op: int) -> bool {
    return op == TK_PLUS or op == TK_MINUS or op == TK_STAR
}

fn x86_unary_supported(op: int) -> bool {
    return op == TK_MINUS or op == TK_CARET
}

// Emit a 64-bit unary integer operation in rax. Mako integer negation and
// complement intentionally use the machine's two's-complement bit pattern;
// this also keeps INT_MIN defined without a representability check.
fn x86_emit_unary_rax(bytes: []int, op: int) -> []int {
    let mut out = bytes
    out = append(out, 72)
    out = append(out, 247)
    if op == TK_MINUS {
        out = append(out, 216) // neg rax
    } else {
        out = append(out, 208) // not rax
    }
    return out
}

// Emit a logical negation of rax: rax becomes 1 when it was zero and 0
// otherwise. Unlike `not rax` this never depends on the operand already being
// normalized to 0 or 1.
fn x86_emit_logical_not_rax(bytes: []int) -> []int {
    let mut out = bytes
    // test rax, rax
    out = append(out, 72)
    out = append(out, 133)
    out = append(out, 192)
    // sete al
    out = append(out, 15)
    out = append(out, 148)
    out = append(out, 192)
    // movzx rax, al
    out = append(out, 72)
    out = append(out, 15)
    out = append(out, 182)
    out = append(out, 192)
    return out
}

// Emit OP rax, imm32 for a supported operator: add/sub use the dedicated
// accumulator opcodes, imul the three-operand form. Caller pre-validates op.
fn x86_emit_alu_imm(bytes: []int, op: int, operand: int) -> []int {
    let mut out = bytes
    out = append(out, 72)
    if op == TK_STAR {
        out = append(out, 105)
        out = append(out, 192)
    } else if op == TK_PLUS {
        out = append(out, 5)
    } else {
        out = append(out, 45)
    }
    out = x86_emit_u32(out, operand)
    return out
}

// Parameter OP constant body: mov rax, rdi; OP rax, imm32; ret. 64-bit
// arithmetic keeps full Mako int semantics for the parameter.
fn x86_emit_param_op_return(op: int, operand: int) -> X86Code {
    if operand < -2147483648 or operand > 2147483647 {
        return x86_error(X86_RANGE, "x86 ALU immediate is out of range")
    }
    if not x86_alu_supported(op) {
        return x86_error(X86_UNSUPPORTED, "x86 ALU operator is not implemented")
    }
    let mut bytes: []int = make([]int, 0, 11)
    bytes = append(bytes, 72)
    bytes = append(bytes, 137)
    bytes = append(bytes, 248)
    bytes = x86_emit_alu_imm(bytes, op, operand)
    bytes = append(bytes, 195)
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}

// Call-OP body: mov edi, imm32; call rel32; OP rax, imm32; ret. The call
// displacement field sits at body offset 6 and is patched after layout.
fn x86_emit_call_op_return(argument: int, call_disp: int, op: int, operand: int) -> X86Code {
    if argument < 0 or argument > 4294967295 {
        return x86_error(X86_RANGE, "x86 call argument is out of range")
    }
    if call_disp < -2147483648 or call_disp > 2147483647 {
        return x86_error(X86_RANGE, "x86 call displacement is out of range")
    }
    if operand < -2147483648 or operand > 2147483647 {
        return x86_error(X86_RANGE, "x86 ALU immediate is out of range")
    }
    if not x86_alu_supported(op) {
        return x86_error(X86_UNSUPPORTED, "x86 ALU operator is not implemented")
    }
    let mut bytes: []int = make([]int, 0, 18)
    bytes = append(bytes, 191)
    bytes = x86_emit_u32(bytes, argument)
    bytes = append(bytes, 232)
    bytes = x86_emit_u32(bytes, call_disp)
    bytes = x86_emit_alu_imm(bytes, op, operand)
    bytes = append(bytes, 195)
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}

// Two-parameter OP body: mov rax, rdi; OP rax, rsi; ret. SysV argument
// order: first parameter in rdi, second in rsi.
fn x86_emit_param_op_param_return(op: int) -> X86Code {
    if not x86_alu_supported(op) {
        return x86_error(X86_UNSUPPORTED, "x86 ALU operator is not implemented")
    }
    let mut bytes: []int = make([]int, 0, 8)
    bytes = append(bytes, 72)
    bytes = append(bytes, 137)
    bytes = append(bytes, 248)
    if op == TK_STAR {
        bytes = append(bytes, 72)
        bytes = append(bytes, 15)
        bytes = append(bytes, 175)
        bytes = append(bytes, 198)
    } else {
        bytes = append(bytes, 72)
        if op == TK_PLUS {
            bytes = append(bytes, 1)
        } else {
            bytes = append(bytes, 41)
        }
        bytes = append(bytes, 240)
    }
    bytes = append(bytes, 195)
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}

// Frame prologue with an explicit size (a 16-byte multiple, at most 120
// bytes). Keeps rsp 16-byte aligned at every call site inside the frame.
fn x86_emit_frame_prologue_sized(bytes: []int, frame: int) -> []int {
    let mut out = bytes
    out = append(out, 85)
    out = append(out, 72)
    out = append(out, 137)
    out = append(out, 229)
    out = append(out, 72)
    if frame <= 127 {
        out = append(out, 131)
        out = append(out, 236)
        out = append(out, frame & 255)
    } else {
        out = append(out, 129)
        out = append(out, 236)
        out = x86_emit_u32(out, frame)
    }
    return out
}

// Frame prologue: push rbp; mov rbp, rsp; sub rsp, 16. Keeps rsp 16-byte
// aligned at every call site inside the frame.
fn x86_emit_frame_prologue(bytes: []int) -> []int {
    return x86_emit_frame_prologue_sized(bytes, 16)
}

// Frame combine and epilogue: OP rax with the saved first call result at
// [rbp - 8], then leave; ret. Subtraction reloads the saved first operand so
// operand order is preserved. Caller pre-validates op.
fn x86_emit_frame_combine(bytes: []int, op: int) -> []int {
    let mut out = bytes
    if op == TK_MINUS {
        out = append(out, 72)
        out = append(out, 137)
        out = append(out, 194)
        out = append(out, 72)
        out = append(out, 139)
        out = append(out, 69)
        out = append(out, 248)
        out = append(out, 72)
        out = append(out, 41)
        out = append(out, 208)
    } else if op == TK_STAR {
        out = append(out, 72)
        out = append(out, 15)
        out = append(out, 175)
        out = append(out, 69)
        out = append(out, 248)
    } else {
        out = append(out, 72)
        out = append(out, 3)
        out = append(out, 69)
        out = append(out, 248)
    }
    out = append(out, 201)
    out = append(out, 195)
    return out
}

// Two-call body with a stack frame: call, save the first result, call again,
// then combine both results. The 64-bit store preserves full Mako int width.
// The call displacement fields sit at body offsets 14 and 28 and are patched
// after layout.
fn x86_emit_call_call_op_return(first_arg: int, first_disp: int, second_arg: int, second_disp: int, op: int) -> X86Code {
    if first_arg < 0 or first_arg > 4294967295 or second_arg < 0 or second_arg > 4294967295 {
        return x86_error(X86_RANGE, "x86 call argument is out of range")
    }
    if first_disp < -2147483648 or first_disp > 2147483647 or second_disp < -2147483648 or second_disp > 2147483647 {
        return x86_error(X86_RANGE, "x86 call displacement is out of range")
    }
    if not x86_alu_supported(op) {
        return x86_error(X86_UNSUPPORTED, "x86 ALU operator is not implemented")
    }
    let mut bytes: []int = make([]int, 0, 42)
    bytes = x86_emit_frame_prologue(bytes)
    bytes = append(bytes, 191)
    bytes = x86_emit_u32(bytes, first_arg)
    bytes = append(bytes, 232)
    bytes = x86_emit_u32(bytes, first_disp)
    bytes = append(bytes, 72)
    bytes = append(bytes, 137)
    bytes = append(bytes, 69)
    bytes = append(bytes, 248)
    bytes = append(bytes, 191)
    bytes = x86_emit_u32(bytes, second_arg)
    bytes = append(bytes, 232)
    bytes = x86_emit_u32(bytes, second_disp)
    bytes = x86_emit_frame_combine(bytes, op)
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}

// Two-argument call pair body: the same frame shape with two-argument call
// sequences (edi then esi). The call displacement fields sit at body offsets
// 19 and 38 and are patched after layout.
fn x86_emit_call2_pair_op_return(first_a: int, first_b: int, first_disp: int, second_a: int, second_b: int, second_disp: int, op: int) -> X86Code {
    if first_a < 0 or first_a > 4294967295 or first_b < 0 or first_b > 4294967295 or
        second_a < 0 or second_a > 4294967295 or second_b < 0 or second_b > 4294967295 {
        return x86_error(X86_RANGE, "x86 call argument is out of range")
    }
    if first_disp < -2147483648 or first_disp > 2147483647 or second_disp < -2147483648 or second_disp > 2147483647 {
        return x86_error(X86_RANGE, "x86 call displacement is out of range")
    }
    if not x86_alu_supported(op) {
        return x86_error(X86_UNSUPPORTED, "x86 ALU operator is not implemented")
    }
    let mut bytes: []int = make([]int, 0, 48)
    bytes = x86_emit_frame_prologue(bytes)
    bytes = append(bytes, 191)
    bytes = x86_emit_u32(bytes, first_a)
    bytes = append(bytes, 190)
    bytes = x86_emit_u32(bytes, first_b)
    bytes = append(bytes, 232)
    bytes = x86_emit_u32(bytes, first_disp)
    bytes = append(bytes, 72)
    bytes = append(bytes, 137)
    bytes = append(bytes, 69)
    bytes = append(bytes, 248)
    bytes = append(bytes, 191)
    bytes = x86_emit_u32(bytes, second_a)
    bytes = append(bytes, 190)
    bytes = x86_emit_u32(bytes, second_b)
    bytes = append(bytes, 232)
    bytes = x86_emit_u32(bytes, second_disp)
    bytes = x86_emit_frame_combine(bytes, op)
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}

// Two-argument call body: mov edi, imm32; mov esi, imm32; call rel32; ret.
// The call displacement field sits at body offset 11 and is patched after
// layout.
fn x86_emit_const_call2_return(first: int, second: int, call_disp: int) -> X86Code {
    if first < 0 or first > 4294967295 or second < 0 or second > 4294967295 {
        return x86_error(X86_RANGE, "x86 call argument is out of range")
    }
    if call_disp < -2147483648 or call_disp > 2147483647 {
        return x86_error(X86_RANGE, "x86 call displacement is out of range")
    }
    let mut bytes: []int = make([]int, 0, 16)
    bytes = append(bytes, 191)
    bytes = x86_emit_u32(bytes, first)
    bytes = append(bytes, 190)
    bytes = x86_emit_u32(bytes, second)
    bytes = append(bytes, 232)
    bytes = x86_emit_u32(bytes, call_disp)
    bytes = append(bytes, 195)
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}

// Patch a little-endian rel32 field in an already-emitted stream.
fn x86_patch_u32(bytes: []int, offset: int, value: int) -> []int {
    let mut out = bytes
    out[offset] = value & 255
    out[offset + 1] = (value >> 8) & 255
    out[offset + 2] = (value >> 16) & 255
    out[offset + 3] = (value >> 24) & 255
    return out
}

fn x86_patch_u8(bytes: []int, offset: int, value: int) -> []int {
    let mut out = bytes
    out[offset] = value & 255
    return out
}

struct X86Body {
    code: X86Code
    edge_callees: []int
    edge_fields: []int
}

struct X86Edges {
    callees: []int
    fields: []int
}

fn x86_plain_body(code: X86Code) -> X86Body {
    return X86Body { code: code, edge_callees: make([]int, 0, 0), edge_fields: make([]int, 0, 0) }
}

fn x86_call_body(code: X86Code, callee: int, field: int) -> X86Body {
    return X86Body { code: code, edge_callees: append(make([]int, 0, 1), callee), edge_fields: append(make([]int, 0, 1), field) }
}

fn x86_pair_body(code: X86Code, callee: int, field: int, callee2: int, field2: int) -> X86Body {
    return X86Body {
        code: code,
        edge_callees: append(append(make([]int, 0, 2), callee), callee2),
        edge_fields: append(append(make([]int, 0, 2), field), field2),
    }
}

fn x86_find_callee(functions: []IrFunction, item: int) -> int {
    let mut i = 0
    while i < len(functions) {
        if functions[i].item == item { return i }
        i = i + 1
    }
    return -1
}

// Slot displacement byte for SSA value slots: slot 1 lives at [rbp - 8].
fn x86_slot_byte(slot: int) -> int {
    return (256 - 8 * slot) & 255
}

// One [rbp - 8*slot] memory operand: the mod=01 disp8 form for the first
// fifteen slots, the mod=10 disp32 form beyond them. `modrm` is the mod=01
// base byte; the displacement is always negative, emitted little-endian.
fn x86_emit_slot_operand(bytes: []int, modrm: int, slot: int) -> []int {
    let mut out = bytes
    if slot <= 15 {
        out = append(out, modrm)
        out = append(out, x86_slot_byte(slot))
    } else {
        out = append(out, modrm + 64)
        out = x86_emit_u32(out, 4294967296 - 8 * slot)
    }
    return out
}

// mov [rbp - 8*slot], rax
fn x86_emit_store_rax(bytes: []int, slot: int) -> []int {
    let mut out = bytes
    out = append(out, 72)
    out = append(out, 137)
    out = x86_emit_slot_operand(out, 69, slot)
    return out
}

// mov rax, [rbp - 8*slot]
fn x86_emit_load_rax(bytes: []int, slot: int) -> []int {
    let mut out = bytes
    out = append(out, 72)
    out = append(out, 139)
    out = x86_emit_slot_operand(out, 69, slot)
    return out
}

// Explicit unsafe byte load/store primitives. The caller owns pointer validity.
fn x86_emit_unsafe_load8(bytes: []int, pointer_slot: int, result_slot: int) []int {
    let mut out = x86_emit_load_rax(bytes, pointer_slot)
    out = append(out, 15)
    out = append(out, 182)
    out = append(out, 0)
    return x86_emit_store_rax(out, result_slot)
}

fn x86_emit_unsafe_store8(bytes: []int, pointer_slot: int, value_slot: int, result_slot: int) []int {
    let mut out = x86_emit_load_rax(bytes, pointer_slot)
    out = append(out, 72)
    out = append(out, 139)
    out = x86_emit_slot_operand(out, 77, value_slot)
    out = append(out, 136)
    out = append(out, 8)
    out = append(out, 72)
    out = append(out, 137)
    out = append(out, 200)
    return x86_emit_store_rax(out, result_slot)
}

// Load a constant into a syscall argument register. Positions 1..6 are
// rdi/rsi/rdx/r10/r8/r9.
//
// This must never route through rax: callers set the syscall number in rax
// and then fill the argument registers, so a staging `mov reg, rax` would
// overwrite the number with the last argument value. It writes the immediate
// straight into the target register instead.
//
// Positions 4/5/6 address r10/r8/r9 and need REX.B (0x49); the rdi/rsi/rdx
// tier uses plain REX.W (0x48). Position 4 shares ModRM 0xC2 with rdx, so a
// missing REX.B silently writes rdx and leaves the fourth argument unset.
fn x86_emit_syscall_const(bytes: []int, value: int, position: int) []int {
    let mut out = bytes
    let rex = if position >= 4 { 73 } else { 72 }
    if value >= -2147483648 and value <= 2147483647 {
        // REX.W C7 /0 id: mov r64, imm32 (sign-extended).
        out = append(out, rex)
        out = append(out, 199)
        out = append(out, if position == 1 { 199 } else if position == 2 { 198 } else if position == 3 { 194 } else if position == 4 { 194 } else if position == 5 { 192 } else { 193 })
        return x86_emit_u32(out, value)
    }
    // REX.W B8+rd io: movabs r64, imm64.
    out = append(out, rex)
    out = append(out, if position == 1 { 191 } else if position == 2 { 190 } else if position == 3 { 186 } else if position == 4 { 186 } else if position == 5 { 184 } else { 185 })
    return x86_emit_u64(out, value)
}

// Allocate a byte-slice header plus payload with mmap. The header is
// [length, capacity, data-pointer]; the slice value is its header pointer.
// Duplicate a slice into an independent allocation: same length and capacity,
// a fresh payload, and the copied elements. This is what `IR_CLONE` means for a
// slice — the callee receives its own value and the caller's original stays
// valid, so both are dropped exactly once.
//
// The source header, length and capacity all have to survive the mmap, so they
// live in r12/r13/r14; r15 holds the new header across the copy. `syscall`
// destroys rax, rcx and r11, and mmap's own arguments cover rdi/rsi/rdx/r10/
// r8/r9.
fn x86_emit_clone_slice(bytes: []int, source_slot: int, result_slot: int, element_size: int) []int {
    // Byte slices are packed; every other element is slot-based, so its stride
    // is a whole number of slots. The arithmetic here is stride-generic, so a
    // struct element only has to pass this shape check.
    if element_size != 1 and (element_size < 8 or element_size - (element_size / 8) * 8 != 0) { return bytes }
    let mut out = x86_emit_load_rax(bytes, source_slot)
    out = append(out, 73); out = append(out, 137); out = append(out, 196)
    out = append(out, 77); out = append(out, 139); out = append(out, 44); out = append(out, 36)
    out = append(out, 77); out = append(out, 139); out = append(out, 116); out = append(out, 36); out = append(out, 8)
    // mmap(0, capacity * stride + 24, PROT_READ|WRITE, PRIVATE|ANON, -1, 0)
    out = append(out, 49); out = append(out, 255)
    out = append(out, 76); out = append(out, 137); out = append(out, 246)
    if element_size == 8 {
        out = append(out, 72); out = append(out, 193); out = append(out, 230); out = append(out, 3)
    }
    out = append(out, 72); out = append(out, 131); out = append(out, 198); out = append(out, 24)
    out = append(out, 186); out = x86_emit_u32(out, 3)
    out = append(out, 65); out = append(out, 186); out = x86_emit_u32(out, 34)
    out = append(out, 73); out = append(out, 199); out = append(out, 192); out = x86_emit_u32(out, 4294967295)
    out = append(out, 69); out = append(out, 49); out = append(out, 201)
    out = append(out, 184); out = x86_emit_u32(out, 9)
    out = append(out, 15); out = append(out, 5)
    // Initialize the new header, then keep it in r15 across the copy.
    out = append(out, 76); out = append(out, 137); out = append(out, 40)
    out = append(out, 76); out = append(out, 137); out = append(out, 112); out = append(out, 8)
    out = append(out, 76); out = append(out, 141); out = append(out, 80); out = append(out, 24)
    out = append(out, 76); out = append(out, 137); out = append(out, 80); out = append(out, 16)
    out = append(out, 73); out = append(out, 137); out = append(out, 199)
    // Copy length * stride bytes from the source payload.
    out = append(out, 76); out = append(out, 137); out = append(out, 215)
    out = append(out, 73); out = append(out, 139); out = append(out, 116); out = append(out, 36); out = append(out, 16)
    out = append(out, 76); out = append(out, 137); out = append(out, 233)
    if element_size == 8 {
        out = append(out, 72); out = append(out, 193); out = append(out, 225); out = append(out, 3)
    }
    out = append(out, 243); out = append(out, 164)
    out = append(out, 76); out = append(out, 137); out = append(out, 248)
    return x86_emit_store_rax(out, result_slot)
}

// A value that fits one 64-bit slot: a scalar, or a pointer to an owned
// allocation. Multi-word aggregates are not in this set.
fn x86_one_slot_type(kind: int) -> bool {
    return kind == SEM_INT or kind == SEM_BOOL or kind == SEM_BYTE or
        kind == SEM_STRING or kind == SEM_ARRAY_INT or kind == SEM_ARRAY_FLOAT or
        kind == SEM_ARRAY_BOOL or kind == SEM_ARRAY_STRING or kind == SEM_ARRAY_BYTE or
        kind == SEM_MAP or semantic_is_struct_array(kind) or semantic_is_struct_value(kind)
}

// Byte stride of one element for a supported slice type, or 0.
fn x86_slice_element_size(type_kind: int) -> int {
    if type_kind == SEM_ARRAY_BYTE { return 1 }
    if type_kind == SEM_ARRAY_INT { return 8 }
    // Every field of an eligible struct is one slot, so the stride is the
    // field count in slots. This one function governs make, index, append,
    // clone and drop for slices, so the struct case reaches all of them here
    // rather than at five separate sites.
    if semantic_is_struct_array(type_kind) { return 8 * struct_kind_fields(type_kind) }
    return 0
}

// Allocate a slice header plus payload. `element_size` is the stride in bytes
// (1 for []byte, 8 for []int); the header's length and capacity stay in
// elements, so only the payload allocation and the addressing scale.
// Callers must reject out-of-range lengths before calling; returning the
// input buffer unchanged is not a success path and must not be relied on.
fn x86_emit_make_byte(bytes: []int, length: int, result_slot: int, element_size: int) []int {
    // 24-byte header + length*stride must fit a non-wrapping mmap size.
    if length < 0 or element_size < 1 { return bytes }
    if length > (9223372036854775807 - 24) / element_size { return bytes }
    // Byte slices are packed; every other element is slot-based, so its stride
    // is a whole number of slots. The arithmetic here is stride-generic, so a
    // struct element only has to pass this shape check.
    if element_size != 1 and (element_size < 8 or element_size - (element_size / 8) * 8 != 0) { return bytes }
    let mut out = x86_emit_int_rax(bytes, 9)
    out = x86_emit_syscall_const(out, 0, 1)
    out = x86_emit_syscall_const(out, length * element_size + 24, 2)
    out = x86_emit_syscall_const(out, 3, 3)
    out = x86_emit_syscall_const(out, 34, 4)
    out = x86_emit_syscall_const(out, -1, 5)
    out = x86_emit_syscall_const(out, 0, 6)
    out = append(out, 15); out = append(out, 5)
    out = x86_emit_store_rax(out, result_slot)
    out = x86_emit_load_rax(out, result_slot)
    out = append(out, 72); out = append(out, 199); out = append(out, 0)
    out = x86_emit_u32(out, length)
    out = append(out, 72); out = append(out, 199); out = append(out, 64); out = append(out, 8)
    out = x86_emit_u32(out, length)
    out = append(out, 72); out = append(out, 141); out = append(out, 80); out = append(out, 24)
    out = append(out, 72); out = append(out, 137); out = append(out, 80); out = append(out, 16)
    return out
}

// Load one field of one element of a slice of structs, bounds-checked, as a
// single addressed read: data + index * stride + 8 * slot.
//
// `x86_emit_index_byte` cannot serve here: it scales only by 1 or 8 and adds
// no field offset, so it would read field zero whatever field was named.
// Read one field of an already-borrowed element: the slot holds a pointer to
// the element itself, so there is no length to check and no index to scale.
// Address of one element, bounds-checked. Same arithmetic as the fused field
// read without the final load, so a borrowed element can be passed on.
fn x86_emit_element_addr(bytes: []int, slice_slot: int, index_slot: int, result_slot: int, stride: int) []int {
    if stride < 8 { return bytes }
    let mut out = x86_emit_load_rax(bytes, slice_slot)
    out = append(out, 73); out = append(out, 137); out = append(out, 192)
    out = append(out, 72); out = append(out, 139); out = append(out, 8)
    out = x86_emit_load_rax(out, index_slot)
    out = append(out, 72); out = append(out, 137); out = append(out, 194)
    out = append(out, 72); out = append(out, 133); out = append(out, 210)
    out = append(out, 15); out = append(out, 136)
    let negative_disp = len(out)
    out = x86_emit_u32(out, 0)
    out = append(out, 72); out = append(out, 57); out = append(out, 202)
    out = append(out, 15); out = append(out, 131)
    let bounds_disp = len(out)
    out = x86_emit_u32(out, 0)
    out = append(out, 72); out = append(out, 105); out = append(out, 210)
    out = x86_emit_u32(out, stride)
    out = append(out, 73); out = append(out, 139); out = append(out, 64); out = append(out, 16)
    out = append(out, 72); out = append(out, 1); out = append(out, 208)
    out = x86_emit_store_rax(out, result_slot)
    out = append(out, 233)
    let skip_disp = len(out)
    out = x86_emit_u32(out, 0)
    let failure = len(out)
    out = append(out, 184); out = x86_emit_u32(out, 60)
    out = append(out, 191); out = x86_emit_u32(out, 70)
    out = append(out, 15); out = append(out, 5)
    out = x86_patch_u32(out, skip_disp, len(out) - (skip_disp + 4))
    out = x86_patch_u32(out, negative_disp, failure - (negative_disp + 4))
    out = x86_patch_u32(out, bounds_disp, failure - (bounds_disp + 4))
    return out
}

fn x86_emit_field_at(bytes: []int, pointer_slot: int, result_slot: int, field_slot: int) []int {
    if field_slot < 0 { return bytes }
    let mut out = x86_emit_load_rax(bytes, pointer_slot)
    if field_slot > 0 {
        out = append(out, 72); out = append(out, 5)
        out = x86_emit_u32(out, 8 * field_slot)
    }
    out = append(out, 72); out = append(out, 139); out = append(out, 0)
    return x86_emit_store_rax(out, result_slot)
}

fn x86_emit_index_field(bytes: []int, slice_slot: int, index_slot: int, result_slot: int, stride: int, field_slot: int) []int {
    if stride < 8 or field_slot < 0 or 8 * field_slot >= stride { return bytes }
    let mut out = x86_emit_load_rax(bytes, slice_slot)
    // r8 = header, rcx = header.length
    out = append(out, 73); out = append(out, 137); out = append(out, 192)
    out = append(out, 72); out = append(out, 139); out = append(out, 8)
    out = x86_emit_load_rax(out, index_slot)
    out = append(out, 72); out = append(out, 137); out = append(out, 194)
    // Reject a negative index before it is scaled.
    out = append(out, 72); out = append(out, 133); out = append(out, 210)
    out = append(out, 15); out = append(out, 136)
    let negative_disp = len(out)
    out = x86_emit_u32(out, 0)
    // Compare against the length in elements, before scaling to bytes.
    out = append(out, 72); out = append(out, 57); out = append(out, 202)
    out = append(out, 15); out = append(out, 131)
    let bounds_disp = len(out)
    out = x86_emit_u32(out, 0)
    // imul rdx, rdx, stride
    out = append(out, 72); out = append(out, 105); out = append(out, 210)
    out = x86_emit_u32(out, stride)
    // rax = header.data; rax += rdx; rax += 8 * field_slot
    out = append(out, 73); out = append(out, 139); out = append(out, 64); out = append(out, 16)
    out = append(out, 72); out = append(out, 1); out = append(out, 208)
    if field_slot > 0 {
        out = append(out, 72); out = append(out, 5)
        out = x86_emit_u32(out, 8 * field_slot)
    }
    out = append(out, 72); out = append(out, 139); out = append(out, 0)
    out = x86_emit_store_rax(out, result_slot)
    // Jump past the trap that the two failed checks branch into.
    out = append(out, 233)
    let skip_disp = len(out)
    out = x86_emit_u32(out, 0)
    let trap_at = len(out)
    out = x86_patch_u32(out, negative_disp, trap_at - (negative_disp + 4))
    out = x86_patch_u32(out, bounds_disp, trap_at - (bounds_disp + 4))
    out = append(out, 184); out = x86_emit_u32(out, 60)
    out = append(out, 191); out = x86_emit_u32(out, 70)
    out = append(out, 15); out = append(out, 5)
    out = x86_patch_u32(out, skip_disp, len(out) - (skip_disp + 4))
    return out
}

fn x86_emit_index_byte(bytes: []int, slice_slot: int, index_slot: int, result_slot: int, element_size: int) []int {
    let mut out = x86_emit_load_rax(bytes, slice_slot)
    out = append(out, 73); out = append(out, 137); out = append(out, 192)
    out = append(out, 72); out = append(out, 139); out = append(out, 8)
    out = x86_emit_load_rax(out, index_slot)
    out = append(out, 72); out = append(out, 137); out = append(out, 194)
    out = append(out, 72); out = append(out, 133); out = append(out, 210)
    out = append(out, 15); out = append(out, 136)
    let negative_disp = len(out); out = append(out, 0); out = append(out, 0); out = append(out, 0); out = append(out, 0)
    out = append(out, 72); out = append(out, 57); out = append(out, 202)
    out = append(out, 15); out = append(out, 131)
    let bounds_disp = len(out); out = append(out, 0); out = append(out, 0); out = append(out, 0); out = append(out, 0)
    // The bounds check compared the index against the length in elements, so
    // scaling to bytes happens only now.
    if element_size == 8 {
        out = append(out, 72); out = append(out, 193); out = append(out, 226); out = append(out, 3)
    }
    // rax = header.data (49 8b 40 10), then offset by the checked index.
    // `add r8, rdx` would advance the header pointer and leave the load
    // reading element zero, so the index has to be added to rax itself.
    out = append(out, 73); out = append(out, 139); out = append(out, 64); out = append(out, 16)
    out = append(out, 72); out = append(out, 1); out = append(out, 208)
    if element_size == 8 {
        out = append(out, 72); out = append(out, 139); out = append(out, 0)
    } else {
        out = append(out, 15); out = append(out, 182); out = append(out, 0)
    }
    out = x86_emit_store_rax(out, result_slot)
    // Jump past the out-of-bounds trap; without it every in-bounds index
    // falls straight into exit(70).
    out = append(out, 233)
    let skip_failure = len(out); out = append(out, 0); out = append(out, 0); out = append(out, 0); out = append(out, 0)
    let failure = len(out)
    out = append(out, 184); out = x86_emit_u32(out, 60)
    out = append(out, 191); out = x86_emit_u32(out, 70)
    out = append(out, 15); out = append(out, 5)
    let done = len(out)
    out = x86_patch_u32(out, skip_failure, done - (skip_failure + 4))
    out = x86_patch_u32(out, negative_disp, failure - (negative_disp + 4))
    out = x86_patch_u32(out, bounds_disp, failure - (bounds_disp + 4))
    return out
}

// Reallocate a full byte slice at double capacity, copy the payload, append
// one byte, and leave the new header pointer in rax.
//
// Entry: r8 = old header, rcx = old length, rdx = old capacity.
//
// Everything that must survive a syscall lives in r12..r15. `syscall` itself
// destroys rax, rcx, and r11, and mmap's own argument registers cover rdi,
// rsi, rdx, r10, r8, and r9 — so the old header, old length, old capacity and
// new capacity cannot be parked in any of those. Doing so previously fed the
// copy a garbage source pointer, wrote the mmap protection value into the
// capacity field, and unmapped an arbitrary address.
fn x86_emit_append_growth(bytes: []int, value_slot: int, result_slot: int, element_size: int) []int {
    let mut out = bytes
    // Preserve the incoming header/length/capacity out of the syscall path.
    out = append(out, 77); out = append(out, 137); out = append(out, 196)
    out = append(out, 73); out = append(out, 137); out = append(out, 205)
    out = append(out, 73); out = append(out, 137); out = append(out, 214)
    // r15 = (old capacity | 1) * 2, so a zero-capacity slice still grows.
    out = append(out, 77); out = append(out, 137); out = append(out, 247)
    out = append(out, 73); out = append(out, 131); out = append(out, 207); out = append(out, 1)
    out = append(out, 73); out = append(out, 209); out = append(out, 231)
    // mmap(0, new capacity * stride + 24, PROT_READ|WRITE, PRIVATE|ANON, -1, 0)
    out = append(out, 49); out = append(out, 255)
    if element_size == 8 {
        out = append(out, 76); out = append(out, 137); out = append(out, 254)
        out = append(out, 72); out = append(out, 193); out = append(out, 230); out = append(out, 3)
        out = append(out, 72); out = append(out, 131); out = append(out, 198); out = append(out, 24)
    } else {
        out = append(out, 73); out = append(out, 141); out = append(out, 119); out = append(out, 24)
    }
    out = append(out, 186); out = x86_emit_u32(out, 3)
    out = append(out, 65); out = append(out, 186); out = x86_emit_u32(out, 34)
    out = append(out, 73); out = append(out, 199); out = append(out, 192); out = x86_emit_u32(out, 4294967295)
    out = append(out, 69); out = append(out, 49); out = append(out, 201)
    out = append(out, 184); out = x86_emit_u32(out, 9)
    out = append(out, 15); out = append(out, 5)
    // Initialize the new header: length, capacity, inline data pointer.
    out = append(out, 76); out = append(out, 137); out = append(out, 40)
    out = append(out, 76); out = append(out, 137); out = append(out, 120); out = append(out, 8)
    out = append(out, 76); out = append(out, 141); out = append(out, 80); out = append(out, 24)
    out = append(out, 76); out = append(out, 137); out = append(out, 80); out = append(out, 16)
    out = append(out, 73); out = append(out, 137); out = append(out, 199)
    // Copy the old payload, then release the old mapping.
    out = append(out, 76); out = append(out, 137); out = append(out, 215)
    out = append(out, 73); out = append(out, 139); out = append(out, 116); out = append(out, 36); out = append(out, 16)
    out = append(out, 76); out = append(out, 137); out = append(out, 233)
    if element_size == 8 {
        out = append(out, 72); out = append(out, 193); out = append(out, 225); out = append(out, 3)
    }
    out = append(out, 243); out = append(out, 164)
    out = append(out, 76); out = append(out, 137); out = append(out, 231)
    if element_size == 8 {
        out = append(out, 76); out = append(out, 137); out = append(out, 246)
        out = append(out, 72); out = append(out, 193); out = append(out, 230); out = append(out, 3)
        out = append(out, 72); out = append(out, 131); out = append(out, 198); out = append(out, 24)
    } else {
        out = append(out, 73); out = append(out, 141); out = append(out, 118); out = append(out, 24)
    }
    out = append(out, 184); out = x86_emit_u32(out, 11)
    out = append(out, 15); out = append(out, 5)
    // Store the new byte at data + old length and bump the length.
    out = append(out, 77); out = append(out, 139); out = append(out, 103); out = append(out, 16)
    if element_size == 8 {
        // lea r12, [r12 + r13*8]
        out = append(out, 79); out = append(out, 141); out = append(out, 36); out = append(out, 236)
    } else {
        out = append(out, 77); out = append(out, 1); out = append(out, 236)
    }
    out = x86_emit_load_rax(out, value_slot)
    if element_size == 8 {
        out = append(out, 73); out = append(out, 137); out = append(out, 4); out = append(out, 36)
    } else {
        out = append(out, 65); out = append(out, 136); out = append(out, 4); out = append(out, 36)
    }
    out = append(out, 73); out = append(out, 255); out = append(out, 7)
    out = append(out, 76); out = append(out, 137); out = append(out, 248)
    return x86_emit_store_rax(out, result_slot)
}

fn x86_emit_drop_byte_slice(bytes: []int, slice_slot: int, element_size: int) []int {
    let mut out = x86_emit_load_rax(bytes, slice_slot)
    out = append(out, 73); out = append(out, 137); out = append(out, 192)
    out = append(out, 73); out = append(out, 139); out = append(out, 112); out = append(out, 8)
    if element_size == 8 {
        out = append(out, 72); out = append(out, 193); out = append(out, 230); out = append(out, 3)
    }
    out = append(out, 72); out = append(out, 131); out = append(out, 198); out = append(out, 24)
    out = append(out, 76); out = append(out, 137); out = append(out, 199)
    out = append(out, 184); out = x86_emit_u32(out, 11)
    out = append(out, 49); out = append(out, 210)
    out = append(out, 15); out = append(out, 5)
    return out
}

fn x86_emit_write_byte_slice(bytes: []int, fd_slot: int, slice_slot: int, result_slot: int) []int {
    let mut out = x86_emit_load_syscall_arg(bytes, fd_slot, 1)
    out = x86_emit_load_rax(out, slice_slot)
    out = append(out, 73); out = append(out, 137); out = append(out, 192)
    out = append(out, 73); out = append(out, 139); out = append(out, 80); out = append(out, 0)
    out = append(out, 73); out = append(out, 139); out = append(out, 112); out = append(out, 16)
    out = append(out, 184); out = x86_emit_u32(out, 1)
    out = append(out, 15); out = append(out, 5)
    return x86_emit_store_rax(out, result_slot)
}

fn x86_emit_read_byte_slice(bytes: []int, fd_slot: int, slice_slot: int, result_slot: int) []int {
    let mut out = x86_emit_load_syscall_arg(bytes, fd_slot, 1)
    out = x86_emit_load_rax(out, slice_slot)
    out = append(out, 73); out = append(out, 137); out = append(out, 192)
    out = append(out, 73); out = append(out, 139); out = append(out, 112); out = append(out, 16)
    out = append(out, 73); out = append(out, 139); out = append(out, 80); out = append(out, 0)
    out = append(out, 49); out = append(out, 192)
    out = append(out, 15); out = append(out, 5)
    return x86_emit_store_rax(out, result_slot)
}

fn x86_emit_open_byte_slice(bytes: []int, slice_slot: int, result_slot: int) []int {
    // The slice pointer is staged through rax, so the openat number must be
    // loaded after it rather than before: setting rax first left the syscall
    // dispatching on the header pointer.
    let mut out = x86_emit_load_rax(bytes, slice_slot)
    // mov r9, rax is ModRM 0xC1; 0xC9 selects rcx as the source and left the
    // path pointer reading out of an unrelated register.
    out = append(out, 73); out = append(out, 137); out = append(out, 193)
    out = append(out, 73); out = append(out, 139); out = append(out, 113); out = append(out, 16)
    out = x86_emit_syscall_const(out, -100, 1)
    out = x86_emit_syscall_const(out, 577, 3)
    out = x86_emit_syscall_const(out, 493, 4)
    out = x86_emit_syscall_const(out, 0, 5)
    out = x86_emit_syscall_const(out, 0, 6)
    out = x86_emit_int_rax(out, 257)
    out = append(out, 15); out = append(out, 5)
    return x86_emit_store_rax(out, result_slot)
}

// Store one byte at header.data + length and bump the length, leaving the
// slice header pointer in rax.
//
// The destination has to be parked in r11 first: loading the byte value goes
// through rax, so computing the address into rax and then loading the value
// would overwrite the address and store through the value instead.
fn x86_emit_append_byte_in_place(bytes: []int, value_slot: int, element_size: int) []int {
    let mut out = bytes
    out = append(out, 73); out = append(out, 139); out = append(out, 64); out = append(out, 16)
    if element_size == 8 {
        // lea rax, [rax + rcx*8] — rcx is the length in elements.
        out = append(out, 72); out = append(out, 141); out = append(out, 4); out = append(out, 200)
    } else {
        out = append(out, 72); out = append(out, 1); out = append(out, 200)
    }
    out = append(out, 73); out = append(out, 137); out = append(out, 195)
    out = x86_emit_load_rax(out, value_slot)
    if element_size == 8 {
        out = append(out, 73); out = append(out, 137); out = append(out, 3)
    } else {
        out = append(out, 65); out = append(out, 136); out = append(out, 3)
    }
    out = append(out, 73); out = append(out, 255); out = append(out, 0)
    out = append(out, 76); out = append(out, 137); out = append(out, 192)
    return out
}

fn x86_emit_append_byte_grow(bytes: []int, slice_slot: int, value_slot: int, result_slot: int, element_size: int) []int {
    let mut out = x86_emit_load_rax(bytes, slice_slot)
    out = append(out, 73); out = append(out, 137); out = append(out, 192)
    out = append(out, 73); out = append(out, 139); out = append(out, 8)
    out = append(out, 73); out = append(out, 139); out = append(out, 80); out = append(out, 8)
    out = append(out, 72); out = append(out, 57); out = append(out, 209)
    out = append(out, 15); out = append(out, 131)
    let full_disp = len(out); out = append(out, 0); out = append(out, 0); out = append(out, 0); out = append(out, 0)
    out = x86_emit_append_byte_in_place(out, value_slot, element_size)
    out = x86_emit_store_rax(out, result_slot)
    out = append(out, 233)
    let skip_growth = len(out); out = append(out, 0); out = append(out, 0); out = append(out, 0); out = append(out, 0)
    let growth = len(out)
    out = x86_emit_append_growth(out, value_slot, result_slot, element_size)
    let after_growth = len(out)
    out = x86_patch_u32(out, skip_growth, after_growth - (skip_growth + 4))
    out = x86_patch_u32(out, full_disp, growth - (full_disp + 4))
    return out
}

// REX byte for a SysV argument register by position: rdi/rsi/rdx/rcx need
// only REX.W; r8/r9 also need REX.R.
fn x86_param_rex(position: int) -> int {
    if position >= 5 {
        return 76
    }
    return 72
}

// ModRM byte ([rbp - disp8] form) for a SysV argument register by position.
fn x86_param_modrm(position: int) -> int {
    if position == 1 { return 125 }
    if position == 2 { return 117 }
    if position == 3 { return 85 }
    if position == 4 { return 77 }
    if position == 5 { return 69 }
    return 77
}

// mov [rbp - 8*slot], argument register at the given SysV position (1-6).
fn x86_emit_store_param(bytes: []int, slot: int, position: int) -> []int {
    let mut out = bytes
    out = append(out, x86_param_rex(position))
    out = append(out, 137)
    out = x86_emit_slot_operand(out, x86_param_modrm(position), slot)
    return out
}

// mov argument register at the given SysV position (1-6), [rbp - 8*slot]
fn x86_emit_load_param(bytes: []int, slot: int, position: int) -> []int {
    let mut out = bytes
    out = append(out, x86_param_rex(position))
    out = append(out, 139)
    out = x86_emit_slot_operand(out, x86_param_modrm(position), slot)
    return out
}

// Load one integer syscall argument from a value slot. Linux x86-64 uses
// rax, rdi, rsi, rdx, r10, r8, and r9 for the syscall number and six args;
// r10 replaces the SysV call ABI's rcx because syscall clobbers rcx.
fn x86_emit_load_syscall_arg(bytes: []int, slot: int, position: int) -> []int {
    if position == 0 { return x86_emit_load_rax(bytes, slot) }
    let mut out = bytes
    if position == 1 {
        out = append(out, 72); out = append(out, 139)
        return x86_emit_slot_operand(out, 125, slot)
    }
    if position == 2 {
        out = append(out, 72); out = append(out, 139)
        return x86_emit_slot_operand(out, 117, slot)
    }
    if position == 3 {
        out = append(out, 72); out = append(out, 139)
        return x86_emit_slot_operand(out, 85, slot)
    }
    if position == 4 {
        out = append(out, 76); out = append(out, 139)
        return x86_emit_slot_operand(out, 85, slot)
    }
    if position == 5 {
        out = append(out, 76); out = append(out, 139)
        return x86_emit_slot_operand(out, 69, slot)
    }
    out = append(out, 76); out = append(out, 139)
    return x86_emit_slot_operand(out, 77, slot)
}

// Checked byte conversion. Mako's byte is an unsigned 8-bit value: constant
// and runtime values outside 0..255 terminate with the standard compiler
// runtime error status instead of silently truncating.
fn x86_emit_byte_cast(bytes: []int, source_slot: int, result_slot: int) -> []int {
    let mut out = x86_emit_load_rax(bytes, source_slot)
    out = append(out, 72); out = append(out, 133); out = append(out, 192)
    let sign_jump = len(out)
    out = append(out, 120); out = append(out, 0)
    out = append(out, 72); out = append(out, 61)
    out = append(out, 255); out = append(out, 0); out = append(out, 0); out = append(out, 0)
    let high_jump = len(out)
    out = append(out, 127); out = append(out, 0)
    out = x86_emit_store_rax(out, result_slot)
    // Skip the range trap. Without this jump an in-range conversion falls
    // straight into exit(70), so every `byte(n)` terminated the program.
    out = append(out, 235)
    let skip_failure = len(out); out = append(out, 0)
    let failure = len(out)
    out = x86_patch_u8(out, sign_jump + 1, failure - (sign_jump + 2))
    out = x86_patch_u8(out, high_jump + 1, failure - (high_jump + 2))
    out = append(out, 191); out = x86_emit_u32(out, 70)
    out = append(out, 184); out = x86_emit_u32(out, 60)
    out = append(out, 15); out = append(out, 5)
    out = x86_patch_u8(out, skip_failure, len(out) - (skip_failure + 1))
    return out
}

// OP rax, [rbp - 8*slot] for a supported ALU operator. Caller pre-validates.
fn x86_emit_alu_mem(bytes: []int, op: int, slot: int) -> []int {
    let mut out = bytes
    if op == TK_STAR {
        out = append(out, 72)
        out = append(out, 15)
        out = append(out, 175)
    } else {
        out = append(out, 72)
        if op == TK_PLUS {
            out = append(out, 3)
        } else {
            out = append(out, 43)
        }
    }
    out = x86_emit_slot_operand(out, 69, slot)
    return out
}

// cmp rax, [rbp - 8*slot]
fn x86_emit_cmp_mem(bytes: []int, slot: int) -> []int {
    let mut out = bytes
    out = append(out, 72)
    out = append(out, 59)
    out = x86_emit_slot_operand(out, 69, slot)
    return out
}

// Division operators lower through idiv instead of the ALU forms: the
// dividend must be sign-extended with cqo and the remainder lands in rdx.
fn x86_div_supported(op: int) -> bool {
    return op == TK_SLASH or op == TK_PERCENT
}

// cqo; idiv [rbp - 8*slot]. Caller pre-validates the operator separately.
fn x86_emit_div_mem(bytes: []int, slot: int) -> []int {
    let mut out = bytes
    out = append(out, 72)
    out = append(out, 153)
    out = append(out, 72)
    out = append(out, 247)
    out = x86_emit_slot_operand(out, 125, slot)
    return out
}

// mov [rbp - 8*slot], rdx (the idiv remainder)
fn x86_emit_store_rdx(bytes: []int, slot: int) -> []int {
    let mut out = bytes
    out = append(out, 72)
    out = append(out, 137)
    out = x86_emit_slot_operand(out, 85, slot)
    return out
}

// sub rsp, imm8 / add rsp, imm8 — caller-side stack-argument area. The amount
// is always a multiple of 16 so rsp stays call-site aligned.
fn x86_emit_rsp_adjust(bytes: []int, opcode: int, amount: int) -> []int {
    let mut out = bytes
    out = append(out, 72)
    out = append(out, 131)
    out = append(out, opcode)
    out = append(out, amount)
    return out
}

// mov [rsp + disp8], rax — one outgoing stack argument.
fn x86_emit_store_rsp_rax(bytes: []int, disp: int) -> []int {
    let mut out = bytes
    out = append(out, 72)
    out = append(out, 137)
    out = append(out, 68)
    out = append(out, 36)
    out = append(out, disp)
    return out
}

// Callee side of a stack-passed parameter (SysV position 7+): the value sits
// above the saved rbp and return address at [rbp + 16 + 8*(position - 7)].
// mov rax, [rbp + disp]; mov [rbp - 8*slot], rax
fn x86_emit_load_stack_param(bytes: []int, slot: int, position: int) -> []int {
    let mut out = bytes
    out = append(out, 72)
    out = append(out, 139)
    out = append(out, 69)
    out = append(out, 16 + 8 * (position - 7))
    out = x86_emit_store_rax(out, slot)
    return out
}

// Lower a general straight-line scalar body: leading integer parameters,
// integer constants, +,-,*,/,% binaries and calls over earlier values, ending
// in a return. Every SSA value gets one 64-bit stack slot — the naive but
// correct model; register allocation replaces it in a later milestone. At
// most fifteen parameters (six SysV registers, the rest stack-passed) and
// 127 values (slots past fifteen use disp32 addressing) are supported. Calls take up to fifteen
// slot arguments — register tier first, the remainder spilled to a 16-byte
// padded outgoing area — and their displacement fields are patched after
// layout through the returned edges.
fn x86_lower_scalar_body(instructions: []IrInstruction, constants: []IrConstant, block: IrBlock, call_sites: []IrCallSite, call_arguments: []int, jump_arguments: []int, functions: []IrFunction, function: IrFunction, string_literals: []string, constant_string_index: []int) -> X86Body {
    let start = block.instruction_start
    if start < 0 or block.terminator != start + block.instruction_count - 1 or
        block.terminator >= len(instructions) or block.successor_count != 0 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar body has an invalid block shape"))
    }
    if function.parameter_count < 0 or function.parameter_count > 15 or
        function.value_start < 0 or function.value_count < 1 or function.value_count > 127 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar body requires at most fifteen parameters and 127 values"))
    }
    let mut bytes: []int = make([]int, 0, 64)
    bytes = x86_emit_frame_prologue_sized(bytes, (8 * function.value_count + 15) & 4294967280)
    let prologue_len = len(bytes)
    let segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        start, start + block.instruction_count, true
    , string_literals, constant_string_index)
    if segment.code.status != X86_OK {
        return x86_plain_body(segment.code)
    }
    bytes = x86_append_code(bytes, segment.code)
    let mut body_fields: []int = make([]int, 0, len(segment.edge_fields))
    let mut field_index = 0
    while field_index < len(segment.edge_fields) {
        body_fields = append(body_fields, segment.edge_fields[field_index] + prologue_len)
        field_index = field_index + 1
    }
    return X86Body {
        code: X86Code { bytes: bytes, status: X86_OK, error: "" },
        edge_callees: segment.edge_callees, edge_fields: body_fields,
    }
}

// Emit one scalar instruction range as slot-per-value code: parameters,
// constants, binaries, and calls, with returns allowed only when
// allow_return is set and the instruction is the last in the range. Shared by
// the straight-line body lowering and the branch entry prefix. Call
// displacement fields are patched after layout through the returned edges.
fn x86_emit_scalar_segment(instructions: []IrInstruction, constants: []IrConstant, call_sites: []IrCallSite, call_arguments: []int, jump_arguments: []int, functions: []IrFunction, function: IrFunction, start: int, end: int, allow_return: bool, string_literals: []string, constant_string_index: []int) -> X86Body {
    let mut bytes: []int = make([]int, 0, 64)
    let mut edge_callees: []int = make([]int, 0, 2)
    let mut edge_fields: []int = make([]int, 0, 2)
    // Slot whose value rax still holds, set when an instruction ends by storing
    // rax and cleared otherwise. The slot model gives every SSA value a frame
    // slot, so a value produced and immediately consumed makes a round trip
    // through memory it does not need: 15 of 38 loads across the pinned images
    // were a store followed straight away by a load of the same slot.
    let mut rax_holds_slot = -1
    // Where the previous instruction's trailing store begins, and whether that
    // store is removable: its emitter is straight-line and nothing else in the
    // function reads the value. Set to -1 when either does not hold.
    let mut removable_store_at = -1
    let mut removable_store_producer = -1
    let mut removable_store_value = -1
    let mut i = 0
    while i < end - start {
        let instruction = instructions[start + i]
        let slot = instruction.result - function.value_start + 1
        let instruction_byte_start = len(bytes)
        let instruction_edge_start = len(edge_fields)
        if instruction.op == IR_PARAM {
            // Every supported parameter type occupies exactly one slot and
            // arrives the same way, so the load does not depend on the type;
            // only multi-word values would need a different sequence.
            if i != slot - 1 or slot < 1 or slot > function.parameter_count or
                not x86_one_slot_type(instruction.type_kind) {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar body parameters must lead the block"))
            }
            if slot > 6 {
                bytes = x86_emit_load_stack_param(bytes, slot, slot)
            } else {
                bytes = x86_emit_store_param(bytes, slot, slot)
            }
        } else if instruction.op == IR_CONST {
            if instruction.type_kind == SEM_STRING {
                // String literal: an inline {len, bytes} struct after a jump,
                // addressed RIP-relative — no relocations needed.
                if instruction.aux < 0 or instruction.aux >= len(constants) or
                    instruction.aux >= len(constant_string_index) or
                    constant_string_index[instruction.aux] < 0 or
                    slot < 1 or slot > function.value_count {
                    return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar body string constant is invalid"))
                }
                let literal = string_literals[constant_string_index[instruction.aux]]
                // lea rax, [rip + 5] (the struct follows the jump)
                bytes = append(bytes, 72)
                bytes = append(bytes, 141)
                bytes = append(bytes, 5)
                bytes = append(bytes, 5)
                bytes = append(bytes, 0)
                bytes = append(bytes, 0)
                bytes = append(bytes, 0)
                // jmp over len + bytes + NUL + newline
                bytes = append(bytes, 233)
                bytes = x86_emit_u32(bytes, 10 + len(literal))
                // The struct: length, then bytes, then a NUL terminator, then
                // a newline (print appends one, matching the stage-0 runtime).
                // The NUL is what lets a literal be handed straight to a
                // path-taking syscall; without it openat sees "name\n...".
                let mut char_index = 0
                while char_index < 8 {
                    bytes = append(bytes, (len(literal) >> (char_index * 8)) & 255)
                    char_index = char_index + 1
                }
                char_index = 0
                while char_index < len(literal) {
                    bytes = append(bytes, str_byte_at(literal, char_index))
                    char_index = char_index + 1
                }
                bytes = append(bytes, 0)
                bytes = append(bytes, 10)
                bytes = x86_emit_store_rax(bytes, slot)
            } else {
                // A bool is materialized the same way as an int: the lowering
                // already normalized it to 1 or 0, and both occupy one slot.
                if (instruction.type_kind != SEM_INT and instruction.type_kind != SEM_BOOL) or
                    instruction.aux < 0 or instruction.aux >= len(constants) or slot < 1 or slot > function.value_count {
                    return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar body constant is invalid"))
                }
                let value = constants[instruction.aux].int_value
                bytes = x86_emit_int_rax(bytes, value)
                bytes = x86_emit_store_rax(bytes, slot)
            }
        } else if instruction.op == IR_MAKE {
            let make_stride = x86_slice_element_size(instruction.type_kind)
            // Reject before emit: a silent no-op from x86_emit_make_byte would
            // leave the result slot uninitialized (fail-open miscompile).
            if make_stride == 0 or instruction.aux < 0 or slot < 1 or slot > function.value_count or
                instruction.aux > (9223372036854775807 - 24) / make_stride {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 slice make invalid"))
            }
            let make_before = len(bytes)
            bytes = x86_emit_make_byte(bytes, instruction.aux, slot, make_stride)
            if len(bytes) == make_before {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 slice make invalid"))
            }
        } else if instruction.op == IR_ELEM_ADDR {
            let addr_slice = instruction.left - function.value_start + 1
            let addr_index = instruction.right - function.value_start + 1
            if instruction.aux < 8 or addr_slice < 1 or addr_slice >= slot or
                addr_index < 1 or addr_index >= slot or slot < 1 or slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 element address is invalid"))
            }
            let addr_before = len(bytes)
            bytes = x86_emit_element_addr(bytes, addr_slice, addr_index, slot, instruction.aux)
            if len(bytes) == addr_before {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 element address is invalid"))
            }
        } else if instruction.op == IR_FIELD {
            // aux packs the element width in slots with the field's slot, so
            // no struct table is needed here.
            let field_slot = instruction.aux - (instruction.aux / IR_FIELD_AUX_UNIT) * IR_FIELD_AUX_UNIT
            let field_stride = 8 * (instruction.aux / IR_FIELD_AUX_UNIT)
            let slice_slot = instruction.left - function.value_start + 1
            let index_slot = instruction.right - function.value_start + 1
            let field_index_ok = if instruction.right < 0 { true } else { index_slot >= 1 and index_slot < slot }
            if instruction.aux < 0 or not x86_one_slot_type(instruction.type_kind) or
                slice_slot < 1 or slice_slot >= slot or not field_index_ok or
                slot < 1 or slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 struct field read is invalid"))
            }
            let field_before = len(bytes)
            if instruction.right < 0 {
                bytes = x86_emit_field_at(bytes, slice_slot, slot, field_slot)
            } else {
                bytes = x86_emit_index_field(bytes, slice_slot, index_slot, slot, field_stride, field_slot)
            }
            if len(bytes) == field_before {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 struct field read is invalid"))
            }
        } else if instruction.op == IR_PRINT {
            let arg_slot = instruction.left - function.value_start + 1
            if (instruction.type_kind != SEM_STRING and instruction.type_kind != SEM_INT) or
                arg_slot < 1 or arg_slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 print argument is invalid"))
            }
            if instruction.type_kind == SEM_INT {
                // itoa into the red zone: the newline is pre-stored at
                // [rsp - 8] and digits are built backward below it (unsigned
                // division, so INT_MIN survives the negation), then
                // write(1, digits, n) + write(1, newline, 1).
                bytes = x86_emit_load_rax(bytes, arg_slot)
                // lea rdi, [rsp - 8]; mov byte [rdi], 10
                bytes = append(bytes, 72)
                bytes = append(bytes, 141)
                bytes = append(bytes, 124)
                bytes = append(bytes, 36)
                bytes = append(bytes, 248)
                bytes = append(bytes, 198)
                bytes = append(bytes, 7)
                bytes = append(bytes, 10)
                // mov r8, 10 (divisor)
                bytes = append(bytes, 73)
                bytes = append(bytes, 199)
                bytes = append(bytes, 192)
                bytes = append(bytes, 10)
                bytes = append(bytes, 0)
                bytes = append(bytes, 0)
                bytes = append(bytes, 0)
                // xor r9d, r9d (sign flag); xor ecx, ecx (length)
                bytes = append(bytes, 69)
                bytes = append(bytes, 49)
                bytes = append(bytes, 201)
                bytes = append(bytes, 49)
                bytes = append(bytes, 201)
                // test rax, rax; jns +9 (skip the negation)
                bytes = append(bytes, 72)
                bytes = append(bytes, 133)
                bytes = append(bytes, 192)
                bytes = append(bytes, 121)
                bytes = append(bytes, 9)
                // mov r9d, 1; neg rax
                bytes = append(bytes, 65)
                bytes = append(bytes, 185)
                bytes = append(bytes, 1)
                bytes = append(bytes, 0)
                bytes = append(bytes, 0)
                bytes = append(bytes, 0)
