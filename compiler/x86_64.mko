    }
    let two_call_sub = x86_emit_call_call_op_return(50, 0, 8, 0, TK_MINUS)
    if two_call_sub.status != X86_OK or len(two_call_sub.bytes) != 44 or
        two_call_sub.bytes[32] != 72 or two_call_sub.bytes[33] != 137 or two_call_sub.bytes[34] != 194 or
        two_call_sub.bytes[35] != 72 or two_call_sub.bytes[36] != 139 or two_call_sub.bytes[37] != 69 or
        two_call_sub.bytes[38] != 248 or two_call_sub.bytes[39] != 72 or two_call_sub.bytes[40] != 41 or
        two_call_sub.bytes[41] != 208 or two_call_sub.bytes[42] != 201 or two_call_sub.bytes[43] != 195 {
        return false
    }
    let two_call_mul = x86_emit_call_call_op_return(6, 0, 7, 0, TK_STAR)
    if two_call_mul.status != X86_OK or len(two_call_mul.bytes) != 39 or
        two_call_mul.bytes[32] != 72 or two_call_mul.bytes[33] != 15 or two_call_mul.bytes[34] != 175 or
        two_call_mul.bytes[35] != 69 or two_call_mul.bytes[36] != 248 or
        two_call_mul.bytes[37] != 201 or two_call_mul.bytes[38] != 195 {
        return false
    }
    if x86_emit_call_call_op_return(0, 0, 0, 0, TK_SLASH).status != X86_UNSUPPORTED {
        return false
    }
    let pair = x86_emit_call2_pair_op_return(20, 1, 0, 20, 1, 0, TK_PLUS)
    if pair.status != X86_OK or len(pair.bytes) != 48 or pair.bytes[0] != 85 or
        pair.bytes[8] != 191 or pair.bytes[9] != 20 or pair.bytes[13] != 190 or
        pair.bytes[14] != 1 or pair.bytes[18] != 232 or pair.bytes[23] != 72 or
        pair.bytes[24] != 137 or pair.bytes[25] != 69 or pair.bytes[26] != 248 or
        pair.bytes[27] != 191 or pair.bytes[32] != 190 or pair.bytes[37] != 232 or
        pair.bytes[42] != 72 or pair.bytes[43] != 3 or pair.bytes[44] != 69 or
        pair.bytes[45] != 248 or pair.bytes[46] != 201 or pair.bytes[47] != 195 {
        return false
    }
    let pair_sub = x86_emit_call2_pair_op_return(50, 8, 0, 10, 10, 0, TK_MINUS)
    if pair_sub.status != X86_OK or len(pair_sub.bytes) != 54 or pair_sub.bytes[42] != 72 or
        pair_sub.bytes[43] != 137 or pair_sub.bytes[44] != 194 or pair_sub.bytes[49] != 72 or
        pair_sub.bytes[50] != 41 or pair_sub.bytes[51] != 208 or pair_sub.bytes[52] != 201 or pair_sub.bytes[53] != 195 {
        return false
    }
    if x86_emit_call2_pair_op_return(0, 0, 0, 0, 0, 0, TK_SLASH).status != X86_UNSUPPORTED {
        return false
    }
    let call_arm = x86_emit_arm(3, 0, 0, 0)
    if call_arm.status != X86_OK or len(call_arm.bytes) != 6 or call_arm.bytes[0] != 232 or
        call_arm.bytes[5] != 195 {
        return false
    }
    let merge_arm = x86_emit_arm(2, 42, 0, 1)
    if merge_arm.status != X86_OK or len(merge_arm.bytes) != 10 or merge_arm.bytes[0] != 191 or
        merge_arm.bytes[1] != 42 or merge_arm.bytes[5] != 232 {
        return false
    }
    let store_r8 = x86_emit_store_param(make([]int, 0, 4), 2, 5)
    if len(store_r8) != 4 or store_r8[0] != 76 or store_r8[1] != 137 or store_r8[2] != 69 or store_r8[3] != 240 {
        return false
    }
    let load_rcx = x86_emit_load_param(make([]int, 0, 4), 3, 4)
    if len(load_rcx) != 4 or load_rcx[0] != 72 or load_rcx[1] != 139 or load_rcx[2] != 77 or load_rcx[3] != 232 {
        return false
    }
    let load_r9 = x86_emit_load_param(make([]int, 0, 4), 1, 6)
    if len(load_r9) != 4 or load_r9[0] != 76 or load_r9[1] != 139 or load_r9[2] != 77 or load_r9[3] != 248 {
        return false
    }
    let condition = x86_branch_condition(branch_instructions, add_constants, branch_blocks[0])
    if condition.error != "" or condition.compare or condition.false_jump != 116 {
        return false
    }
    let div_slot2 = x86_emit_div_mem(make([]int, 0, 8), 2)
    if len(div_slot2) != 6 or div_slot2[0] != 72 or div_slot2[1] != 153 or
        div_slot2[2] != 72 or div_slot2[3] != 247 or div_slot2[4] != 125 or div_slot2[5] != 240 {
        return false
    }
    let rem_slot3 = x86_emit_store_rdx(make([]int, 0, 4), 3)
    if len(rem_slot3) != 4 or rem_slot3[0] != 72 or rem_slot3[1] != 137 or rem_slot3[2] != 85 or rem_slot3[3] != 232 {
        return false
    }
    if x86_div_supported(TK_SLASH) != true or x86_div_supported(TK_PERCENT) != true or
        x86_div_supported(TK_PLUS) != false {
        return false
    }
    let stack_param7 = x86_emit_load_stack_param(make([]int, 0, 8), 3, 7)
    if len(stack_param7) != 8 or stack_param7[0] != 72 or stack_param7[1] != 139 or
        stack_param7[2] != 69 or stack_param7[3] != 16 or stack_param7[4] != 72 or
        stack_param7[5] != 137 or stack_param7[6] != 69 or stack_param7[7] != 232 {
        return false
    }
    let stack_param9 = x86_emit_load_stack_param(make([]int, 0, 8), 1, 9)
    if len(stack_param9) != 8 or stack_param9[3] != 32 or stack_param9[7] != 248 {
        return false
    }
    let rsp_area = x86_emit_rsp_adjust(make([]int, 0, 4), 236, 16)
    if len(rsp_area) != 4 or rsp_area[0] != 72 or rsp_area[1] != 131 or rsp_area[2] != 236 or rsp_area[3] != 16 {
        return false
    }
    let rsp_free = x86_emit_rsp_adjust(make([]int, 0, 4), 196, 32)
    if len(rsp_free) != 4 or rsp_free[2] != 196 or rsp_free[3] != 32 {
        return false
    }
    let outgoing = x86_emit_store_rsp_rax(make([]int, 0, 5), 8)
    if len(outgoing) != 5 or outgoing[0] != 72 or outgoing[1] != 137 or
        outgoing[2] != 68 or outgoing[3] != 36 or outgoing[4] != 8 {
        return false
    }
    let wide_load = x86_emit_load_rax(make([]int, 0, 7), 16)
    if len(wide_load) != 7 or wide_load[0] != 72 or wide_load[1] != 139 or
        wide_load[2] != 133 or wide_load[3] != 128 or wide_load[4] != 255 or
        wide_load[5] != 255 or wide_load[6] != 255 {
        return false
    }
    let wide_store = x86_emit_store_rax(make([]int, 0, 7), 16)
    if len(wide_store) != 7 or wide_store[0] != 72 or wide_store[1] != 137 or
        wide_store[2] != 133 or wide_store[3] != 128 or wide_store[4] != 255 {
        return false
    }
    let narrow_load = x86_emit_load_rax(make([]int, 0, 4), 15)
    if len(narrow_load) != 4 or narrow_load[2] != 69 or narrow_load[3] != 136 {
        return false
    }
    let wide_frame = x86_emit_frame_prologue_sized(make([]int, 0, 11), 1024)
    if len(wide_frame) != 11 or wide_frame[4] != 72 or wide_frame[5] != 129 or
        wide_frame[6] != 236 or wide_frame[7] != 0 or wide_frame[8] != 4 or
        wide_frame[9] != 0 or wide_frame[10] != 0 {
        return false
    }
    let narrow_frame = x86_emit_frame_prologue_sized(make([]int, 0, 8), 120)
    if len(narrow_frame) != 8 or narrow_frame[5] != 131 or narrow_frame[7] != 120 {
        return false
    }
    let mut loop_instructions: []IrInstruction = make([]IrInstruction, 0, 11)
    loop_instructions = append(loop_instructions, IrInstruction { op: IR_PARAM, result: 0, type_kind: SEM_INT, left: -1, right: -1, aux: 0, token: 0 })
    loop_instructions = append(loop_instructions, IrInstruction { op: IR_CONST, result: 1, type_kind: SEM_INT, left: -1, right: -1, aux: 0, token: 0 })
    loop_instructions = append(loop_instructions, IrInstruction { op: IR_JUMP, result: -1, type_kind: SEM_INT, left: 1, right: -1, aux: -1, token: 0 })
    loop_instructions = append(loop_instructions, IrInstruction { op: IR_BLOCK_PARAM, result: 2, type_kind: SEM_INT, left: -1, right: -1, aux: 0, token: 0 })
    loop_instructions = append(loop_instructions, IrInstruction { op: IR_CONST, result: 3, type_kind: SEM_INT, left: -1, right: -1, aux: 1, token: 0 })
    loop_instructions = append(loop_instructions, IrInstruction { op: IR_BINARY, result: 4, type_kind: SEM_BOOL, left: 2, right: 3, aux: TK_LT, token: 0 })
    loop_instructions = append(loop_instructions, IrInstruction { op: IR_BRANCH, result: -1, type_kind: SEM_BOOL, left: 4, right: -1, aux: -1, token: 0 })
    loop_instructions = append(loop_instructions, IrInstruction { op: IR_CONST, result: 5, type_kind: SEM_INT, left: -1, right: -1, aux: 2, token: 0 })
    loop_instructions = append(loop_instructions, IrInstruction { op: IR_BINARY, result: 6, type_kind: SEM_INT, left: 2, right: 5, aux: TK_PLUS, token: 0 })
    loop_instructions = append(loop_instructions, IrInstruction { op: IR_JUMP, result: -1, type_kind: SEM_INT, left: 6, right: -1, aux: -1, token: 0 })
    loop_instructions = append(loop_instructions, IrInstruction { op: IR_RETURN, result: -1, type_kind: SEM_INT, left: 2, right: -1, aux: -1, token: 0 })
    let mut loop_blocks: []IrBlock = make([]IrBlock, 0, 4)
    loop_blocks = append(loop_blocks, IrBlock { function: 0, instruction_start: 0, instruction_count: 3, terminator: 2, successor_start: 0, successor_count: 1 })
    loop_blocks = append(loop_blocks, IrBlock { function: 0, instruction_start: 3, instruction_count: 4, terminator: 6, successor_start: 1, successor_count: 2 })
    loop_blocks = append(loop_blocks, IrBlock { function: 0, instruction_start: 7, instruction_count: 3, terminator: 9, successor_start: 3, successor_count: 1 })
    loop_blocks = append(loop_blocks, IrBlock { function: 0, instruction_start: 10, instruction_count: 1, terminator: 10, successor_start: 4, successor_count: 0 })
    let mut loop_successors: []int = make([]int, 0, 4)
    loop_successors = append(loop_successors, 1)
    loop_successors = append(loop_successors, 2)
    loop_successors = append(loop_successors, 3)
    loop_successors = append(loop_successors, 1)
    let mut loop_constants: []IrConstant = make([]IrConstant, 0, 3)
    loop_constants = append(loop_constants, IrConstant { type_kind: SEM_INT, int_value: 0, float_value: 0.0, start: 0, end: 1 })
    loop_constants = append(loop_constants, IrConstant { type_kind: SEM_INT, int_value: 5, float_value: 0.0, start: 0, end: 1 })
    loop_constants = append(loop_constants, IrConstant { type_kind: SEM_INT, int_value: 7, float_value: 0.0, start: 0, end: 1 })
    let loop_function = IrFunction { item: 0, entry_block: 0, block_count: 4, parameter_count: 1, value_start: 0, value_count: 7 }
    if not x86_function_has_backedge(loop_instructions, loop_blocks, loop_successors, loop_function) {
        return false
    }
    let loop_body = x86_encode_function(
        loop_instructions, loop_constants, loop_blocks, loop_successors,
        make([]IrCallSite, 0, 0), make([]int, 0, 0), make([]int, 0, 0), make([]IrFunction, 0, 0), loop_function
    , make([]string, 0, 0), make([]int, 0, 0))
    if loop_body.code.status != X86_OK or len(loop_body.code.bytes) != 97 or len(loop_body.edge_callees) != 0 {
        return false
    }
    // What the encoding must contain, asserted by shape rather than by offset.
    // These were eighteen absolute positions, which every layout change
    // invalidates — including a correct one, such as folding a literal into an
    // ALU immediate. Stated this way they survive the layout and are stronger:
    // the jump *counts* were not checked before at all.
    if loop_body.code.bytes[0] != 85 {
        return false
    }
    if loop_body.code.bytes[len(loop_body.code.bytes) - 2] != 201 or
        loop_body.code.bytes[len(loop_body.code.bytes) - 1] != 195 {
        return false
    }
    // sub rsp, 64 — seven values rounded up to a sixteen-byte frame. The
    // displacement byte is checked separately so the run stays three long.
    if x86_bytes_count3(loop_body.code.bytes, 72, 131, 236) != 1 {
        return false
    }
    // The loop limit is materialised once: mov eax, 5.
    if x86_bytes_count3(loop_body.code.bytes, 184, 5, 0) != 1 {
        return false
    }
    // One conditional exit (jge rel32) and exactly one backedge. Two near jumps
    // in total: the entry edge into the header and the backedge out of the
    // body. A body that fell out instead of looping would have neither.
    if x86_bytes_count2(loop_body.code.bytes, 15, 141) != 1 {
        return false
    }
    if x86_backward_jump_count(loop_body.code.bytes) != 1 {
        return false
    }
    if x86_bytes_count1(loop_body.code.bytes, 233) != 2 {
        return false
    }
    // The general returning-CFG encoder accepts this same loop arena. That is
    // the block-parameter and jump-argument support rather than the matched
    // four-block shape above; reusing one arena keeps the two paths honest
    // about the same program.
    let general_loop = x86_lower_returning_cfg(
        loop_instructions, loop_constants, loop_blocks, loop_successors,
        make([]IrCallSite, 0, 0), make([]int, 0, 0), make([]int, 0, 0),
        make([]IrFunction, 0, 0), loop_function,
        make([]string, 0, 0), make([]int, 0, 0)
    )
    if general_loop.code.status != X86_OK {
        return false
    }
    // The backedge must be a *backward* near jmp — E9 with a negative
    // displacement, so its top displacement byte is 0xFF. Encoding every jump
    // forward would run the body once and fall out.
    let mut backedge_jump = false
    let mut jump_scan = 0
    while jump_scan + 4 < len(general_loop.code.bytes) {
        if general_loop.code.bytes[jump_scan] == 233 and general_loop.code.bytes[jump_scan + 4] == 255 {
            backedge_jump = true
        }
        jump_scan = jump_scan + 1
    }
    if not backedge_jump {
        return false
    }
    // The backedge must also *copy* the carried value into the header's
    // parameter slot. Status and a backward jump do not prove that: without the
    // copy the header re-tests its initial value and the loop never advances.
    // The carried value is 6 (slot 7) and the header parameter is 2 (slot 3).
    let carried_copy = x86_emit_store_rax(x86_emit_load_rax(make([]int, 0, 8), 7), 3)
    let mut copy_found = false
    let mut copy_at = 0
    while copy_at + len(carried_copy) <= len(general_loop.code.bytes) {
        let mut copy_matched = true
        let mut copy_byte = 0
        while copy_byte < len(carried_copy) {
            if general_loop.code.bytes[copy_at + copy_byte] != carried_copy[copy_byte] {
                copy_matched = false
            }
            copy_byte = copy_byte + 1
        }
        if copy_matched { copy_found = true }
        copy_at = copy_at + 1
    }
    if not copy_found {
        return false
    }
    // A backedge whose arguments permute the header's parameter slots cannot be
    // emitted as sequential copies — the second copy would read a slot the
    // first already overwrote. It must be refused, not silently mis-encoded.
    let mut swap_instructions: []IrInstruction = make([]IrInstruction, 0, 13)
    swap_instructions = append(swap_instructions, IrInstruction { op: IR_PARAM, result: 0, type_kind: SEM_INT, left: -1, right: -1, aux: 0, token: 0 })
    swap_instructions = append(swap_instructions, IrInstruction { op: IR_CONST, result: 1, type_kind: SEM_INT, left: -1, right: -1, aux: 0, token: 0 })
    swap_instructions = append(swap_instructions, IrInstruction { op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN, left: -1, right: -1, aux: 0, token: 0 })
    swap_instructions = append(swap_instructions, IrInstruction { op: IR_BLOCK_PARAM, result: 2, type_kind: SEM_INT, left: -1, right: -1, aux: 0, token: 0 })
    swap_instructions = append(swap_instructions, IrInstruction { op: IR_BLOCK_PARAM, result: 3, type_kind: SEM_INT, left: -1, right: -1, aux: 0, token: 0 })
    swap_instructions = append(swap_instructions, IrInstruction { op: IR_CONST, result: 4, type_kind: SEM_INT, left: -1, right: -1, aux: 1, token: 0 })
    swap_instructions = append(swap_instructions, IrInstruction { op: IR_BINARY, result: 5, type_kind: SEM_BOOL, left: 2, right: 4, aux: TK_LT, token: 0 })
    swap_instructions = append(swap_instructions, IrInstruction { op: IR_BRANCH, result: -1, type_kind: SEM_BOOL, left: 5, right: -1, aux: -1, token: 0 })
    swap_instructions = append(swap_instructions, IrInstruction { op: IR_CONST, result: 6, type_kind: SEM_INT, left: -1, right: -1, aux: 2, token: 0 })
    swap_instructions = append(swap_instructions, IrInstruction { op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN, left: -1, right: -1, aux: 2, token: 0 })
    swap_instructions = append(swap_instructions, IrInstruction { op: IR_RETURN, result: -1, type_kind: SEM_INT, left: 2, right: -1, aux: -1, token: 0 })
    let mut swap_blocks: []IrBlock = make([]IrBlock, 0, 4)
    swap_blocks = append(swap_blocks, IrBlock { function: 0, instruction_start: 0, instruction_count: 3, terminator: 2, successor_start: 0, successor_count: 1 })
    swap_blocks = append(swap_blocks, IrBlock { function: 0, instruction_start: 3, instruction_count: 5, terminator: 7, successor_start: 1, successor_count: 2 })
    swap_blocks = append(swap_blocks, IrBlock { function: 0, instruction_start: 8, instruction_count: 2, terminator: 9, successor_start: 3, successor_count: 1 })
    swap_blocks = append(swap_blocks, IrBlock { function: 0, instruction_start: 10, instruction_count: 1, terminator: 10, successor_start: 4, successor_count: 0 })
    // Entry passes (v1, v1); the backedge passes (param b, param a) — a swap.
    let mut swap_jump_arguments: []int = make([]int, 0, 4)
    swap_jump_arguments = append(swap_jump_arguments, 1)
    swap_jump_arguments = append(swap_jump_arguments, 1)
    swap_jump_arguments = append(swap_jump_arguments, 3)
    swap_jump_arguments = append(swap_jump_arguments, 2)
    let swap_function = IrFunction { item: 0, entry_block: 0, block_count: 4, parameter_count: 1, value_start: 0, value_count: 7 }
    if x86_lower_returning_cfg(
        swap_instructions, loop_constants, swap_blocks, loop_successors,
        make([]IrCallSite, 0, 0), make([]int, 0, 0), swap_jump_arguments,
        make([]IrFunction, 0, 0), swap_function,
        make([]string, 0, 0), make([]int, 0, 0)
    ).code.status != X86_UNSUPPORTED {
        return false
    }
    let mut forward_successors: []int = make([]int, 0, 4)
    forward_successors = append(forward_successors, 1)
    forward_successors = append(forward_successors, 2)
    forward_successors = append(forward_successors, 3)
    forward_successors = append(forward_successors, 3)
    if x86_function_has_backedge(loop_instructions, loop_blocks, forward_successors, loop_function) {
        return false
    }
    let bad_loop = x86_lower_loop(
        loop_instructions, loop_constants, loop_blocks, forward_successors,
        make([]IrCallSite, 0, 0), make([]int, 0, 0), make([]int, 0, 0), make([]IrFunction, 0, 0), loop_function, 0, false
    , make([]string, 0, 0), make([]int, 0, 0))
    if bad_loop.code.status != X86_UNSUPPORTED {
        return false
    }
    return x86_returning_cfg_smoke_test()
}

// Shape-independent branch-tree encoding: five blocks for
// `if v > 10 { if v > 20 { return 3 } return 2 } return 1`, a nesting depth no
// block-count shape covers. Also pins the rejections, since this encoder is
// the fallback and must not swallow shapes it cannot encode.
fn x86_returning_cfg_smoke_test() -> bool {
    let mut ir: []IrInstruction = make([]IrInstruction, 0, 13)
    ir = append(ir, IrInstruction { op: IR_PARAM, result: 0, type_kind: SEM_INT, left: -1, right: -1, aux: 0, token: 0 })
    ir = append(ir, IrInstruction { op: IR_CONST, result: 1, type_kind: SEM_INT, left: -1, right: -1, aux: 0, token: 0 })
    ir = append(ir, IrInstruction { op: IR_BINARY, result: 2, type_kind: SEM_BOOL, left: 0, right: 1, aux: TK_GT, token: 0 })
    ir = append(ir, IrInstruction { op: IR_BRANCH, result: -1, type_kind: SEM_BOOL, left: 2, right: -1, aux: -1, token: 0 })
    ir = append(ir, IrInstruction { op: IR_CONST, result: 3, type_kind: SEM_INT, left: -1, right: -1, aux: 1, token: 0 })
    ir = append(ir, IrInstruction { op: IR_BINARY, result: 4, type_kind: SEM_BOOL, left: 0, right: 3, aux: TK_GT, token: 0 })
    ir = append(ir, IrInstruction { op: IR_BRANCH, result: -1, type_kind: SEM_BOOL, left: 4, right: -1, aux: -1, token: 0 })
    ir = append(ir, IrInstruction { op: IR_CONST, result: 5, type_kind: SEM_INT, left: -1, right: -1, aux: 2, token: 0 })
    ir = append(ir, IrInstruction { op: IR_RETURN, result: -1, type_kind: SEM_INT, left: 5, right: -1, aux: -1, token: 0 })
    ir = append(ir, IrInstruction { op: IR_CONST, result: 6, type_kind: SEM_INT, left: -1, right: -1, aux: 3, token: 0 })
    ir = append(ir, IrInstruction { op: IR_RETURN, result: -1, type_kind: SEM_INT, left: 6, right: -1, aux: -1, token: 0 })
    ir = append(ir, IrInstruction { op: IR_CONST, result: 7, type_kind: SEM_INT, left: -1, right: -1, aux: 4, token: 0 })
    ir = append(ir, IrInstruction { op: IR_RETURN, result: -1, type_kind: SEM_INT, left: 7, right: -1, aux: -1, token: 0 })
    let mut pool: []IrConstant = make([]IrConstant, 0, 5)
    pool = append(pool, IrConstant { type_kind: SEM_INT, int_value: 10, float_value: 0.0, start: 0, end: 1 })
    pool = append(pool, IrConstant { type_kind: SEM_INT, int_value: 20, float_value: 0.0, start: 0, end: 1 })
    pool = append(pool, IrConstant { type_kind: SEM_INT, int_value: 3, float_value: 0.0, start: 0, end: 1 })
    pool = append(pool, IrConstant { type_kind: SEM_INT, int_value: 2, float_value: 0.0, start: 0, end: 1 })
    pool = append(pool, IrConstant { type_kind: SEM_INT, int_value: 1, float_value: 0.0, start: 0, end: 1 })
    let mut cfg_successors: []int = make([]int, 0, 4)
    cfg_successors = append(cfg_successors, 1)
    cfg_successors = append(cfg_successors, 4)
    cfg_successors = append(cfg_successors, 2)
    cfg_successors = append(cfg_successors, 3)
    let mut cfg_blocks: []IrBlock = make([]IrBlock, 0, 5)
    cfg_blocks = append(cfg_blocks, IrBlock { function: 0, instruction_start: 0, instruction_count: 4, terminator: 3, successor_start: 0, successor_count: 2 })
    cfg_blocks = append(cfg_blocks, IrBlock { function: 0, instruction_start: 4, instruction_count: 3, terminator: 6, successor_start: 2, successor_count: 2 })
    cfg_blocks = append(cfg_blocks, IrBlock { function: 0, instruction_start: 7, instruction_count: 2, terminator: 8, successor_start: 0, successor_count: 0 })
    cfg_blocks = append(cfg_blocks, IrBlock { function: 0, instruction_start: 9, instruction_count: 2, terminator: 10, successor_start: 0, successor_count: 0 })
    cfg_blocks = append(cfg_blocks, IrBlock { function: 0, instruction_start: 11, instruction_count: 2, terminator: 12, successor_start: 0, successor_count: 0 })
    let cfg_function = IrFunction { item: 0, entry_block: 0, block_count: 5, parameter_count: 1, value_start: 0, value_count: 8 }
    let body = x86_lower_returning_cfg(
        ir, pool, cfg_blocks, cfg_successors,
        make([]IrCallSite, 0, 0), make([]int, 0, 0), make([]int, 0, 0), make([]IrFunction, 0, 0), cfg_function,
        make([]string, 0, 0), make([]int, 0, 0)
    )
    if body.code.status != X86_OK {
        return false
    }
    // Both branches must emit a near jcc (0F 8E for `jle`, the false edge of
    // `>`) followed by a near jmp (E9), and every path must end in leave; ret.
    let mut jcc_count = 0
    let mut jmp_count = 0
    let mut leave_count = 0
    let mut scan = 0
    while scan < len(body.code.bytes) {
        if scan + 1 < len(body.code.bytes) and body.code.bytes[scan] == 15 and body.code.bytes[scan + 1] == 142 {
            jcc_count = jcc_count + 1
        }
        if body.code.bytes[scan] == 233 {
            jmp_count = jmp_count + 1
        }
        if scan + 1 < len(body.code.bytes) and body.code.bytes[scan] == 201 and body.code.bytes[scan + 1] == 195 {
            leave_count = leave_count + 1
        }
        scan = scan + 1
    }
    if jcc_count != 2 or jmp_count != 2 or leave_count != 3 {
        return false
    }
    // Every patched displacement must land exactly on a block boundary, which
    // is what proves the post-layout patching is right rather than merely
    // in-range. Block starts are recomputed here independently.
    if body.code.bytes[len(body.code.bytes) - 1] != 195 {
        return false
    }
    // A block parameter on a block the *branches* reach, and an out-of-function
    // successor, must each be refused rather than silently mis-encoded. Nothing
    // writes a parameter slot except an incoming jump, so a parameter here
    // would read whatever the frame happened to hold.
    let mut param_blocks: []IrBlock = make([]IrBlock, 0, 5)
    param_blocks = append(param_blocks, cfg_blocks[0])
    param_blocks = append(param_blocks, cfg_blocks[1])
    param_blocks = append(param_blocks, cfg_blocks[2])
    param_blocks = append(param_blocks, cfg_blocks[3])
    param_blocks = append(param_blocks, cfg_blocks[4])
    let mut param_ir: []IrInstruction = make([]IrInstruction, 0, 13)
    let mut copy_index = 0
    while copy_index < len(ir) {
        if copy_index == 11 {
            param_ir = append(param_ir, IrInstruction { op: IR_BLOCK_PARAM, result: 7, type_kind: SEM_INT, left: -1, right: -1, aux: -1, token: 0 })
        } else {
            param_ir = append(param_ir, ir[copy_index])
        }
        copy_index = copy_index + 1
    }
    if x86_lower_returning_cfg(
        param_ir, pool, param_blocks, cfg_successors,
        make([]IrCallSite, 0, 0), make([]int, 0, 0), make([]int, 0, 0), make([]IrFunction, 0, 0), cfg_function,
        make([]string, 0, 0), make([]int, 0, 0)
    ).code.status != X86_UNSUPPORTED {
        return false
    }
    let mut escaping: []int = make([]int, 0, 4)
    escaping = append(escaping, 1)
    escaping = append(escaping, 9)
    escaping = append(escaping, 2)
    escaping = append(escaping, 3)
    if x86_lower_returning_cfg(
        ir, pool, cfg_blocks, escaping,
        make([]IrCallSite, 0, 0), make([]int, 0, 0), make([]int, 0, 0), make([]IrFunction, 0, 0), cfg_function,
        make([]string, 0, 0), make([]int, 0, 0)
    ).code.status != X86_UNSUPPORTED {
        return false
    }
    return true
}
