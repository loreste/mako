 bytes = x86_emit_drop_owned_string(bytes, drop_slot)
 }
    } else if instruction.op == IR_UNARY {
        // `not` on a bool is a logical negation, not the integer complement:
        // complementing 1 gives -2, which every truth test still reads as
        // true. It is emitted as a zero test so the result is 1 or 0 whatever
        // bit pattern the operand carried.
        let logical_not = instruction.type_kind == SEM_BOOL and
            (instruction.aux == TK_NOT or instruction.aux == TK_BANG)
        if (not logical_not and
            (instruction.type_kind != SEM_INT or not x86_unary_supported(instruction.aux))) or
            slot < 1 or slot > function.value_count {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar body unary operator invalid"))
        }
        let operand_slot = instruction.left - function.value_start + 1
        if operand_slot < 1 or operand_slot >= slot {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar body unary operand not earlier value"))
        }
        bytes = x86_emit_load_rax(bytes, operand_slot)
        if logical_not {
            bytes = x86_emit_logical_not_rax(bytes)
        } else {
            bytes = x86_emit_unary_rax(bytes, instruction.aux)
        }
        bytes = x86_emit_store_rax(bytes, slot)
    } else if instruction.op == IR_BINARY and instruction.type_kind == SEM_STRING {
            // `+` on strings is the only string-typed binary the typer admits,
            // so anything else reaching here is a lowering bug rather than a
            // program error, and must fail closed rather than emit integer
            // arithmetic over two object pointers.
            if instruction.aux != TK_PLUS or slot < 1 or slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 string body operator is invalid"))
            }
            let concat_left = instruction.left - function.value_start + 1
            let concat_right = instruction.right - function.value_start + 1
            if concat_left < 1 or concat_left >= slot or concat_right < 1 or concat_right >= slot {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 string operand is not an earlier value"))
            }
            bytes = x86_emit_concat_string(bytes, concat_left, concat_right, slot)
    } else if instruction.op == IR_BINARY {
            if instruction.type_kind != SEM_INT or
                (not x86_alu_supported(instruction.aux) and not x86_div_supported(instruction.aux)) or
                slot < 1 or slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar body operator is invalid"))
            }
            let left_slot = instruction.left - function.value_start + 1
            let right_slot = instruction.right - function.value_start + 1
            if left_slot < 1 or left_slot >= slot or right_slot < 1 or right_slot >= slot {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar body operand is not an earlier value"))
            }
            bytes = x86_emit_load_rax(bytes, left_slot)
            if x86_div_supported(instruction.aux) {
                bytes = x86_emit_div_mem(bytes, right_slot)
                if instruction.aux == TK_PERCENT {
                    bytes = x86_emit_store_rdx(bytes, slot)
                } else {
                    bytes = x86_emit_store_rax(bytes, slot)
                }
            } else {
                bytes = x86_emit_alu_mem(bytes, instruction.aux, right_slot)
                bytes = x86_emit_store_rax(bytes, slot)
            }
        } else if instruction.op == IR_CALL and instruction.aux >= 0 and
                instruction.aux < len(call_sites) and call_sites[instruction.aux].callee_item == -8 {
            let site = call_sites[instruction.aux]
            if instruction.type_kind != SEM_INT or site.argument_count != 3 or site.argument_start < 0 or site.argument_start + 2 >= len(call_arguments) or slot < 1 or slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 unsafe_write call invalid"))
            }
            let fd_slot = call_arguments[site.argument_start] - function.value_start + 1
            let pointer_slot = call_arguments[site.argument_start + 1] - function.value_start + 1
            let length_slot = call_arguments[site.argument_start + 2] - function.value_start + 1
            if fd_slot < 1 or fd_slot >= slot or pointer_slot < 1 or pointer_slot >= slot or length_slot < 1 or length_slot >= slot {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 unsafe_write argument not earlier value"))
            }
            bytes = x86_emit_int_rax(bytes, 1)
            bytes = x86_emit_load_syscall_arg(bytes, fd_slot, 1)
            bytes = x86_emit_load_syscall_arg(bytes, pointer_slot, 2)
            bytes = x86_emit_load_syscall_arg(bytes, length_slot, 3)
            bytes = x86_emit_syscall_const(bytes, 0, 4)
            bytes = x86_emit_syscall_const(bytes, 0, 5)
            bytes = x86_emit_syscall_const(bytes, 0, 6)
            bytes = append(bytes, 15); bytes = append(bytes, 5)
            bytes = x86_emit_store_rax(bytes, slot)
        } else if instruction.op == IR_CALL and instruction.aux >= 0 and
                instruction.aux < len(call_sites) and call_sites[instruction.aux].callee_item == -6 {
            let site = call_sites[instruction.aux]
            if instruction.type_kind != SEM_INT or site.argument_count != 1 or site.argument_start < 0 or site.argument_start >= len(call_arguments) or slot < 1 or slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 unsafe_alloc call invalid"))
            }
            let size_slot = call_arguments[site.argument_start] - function.value_start + 1
            if size_slot < 1 or size_slot >= slot { return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 unsafe_alloc argument not earlier value")) }
            bytes = x86_emit_int_rax(bytes, 9)
            bytes = x86_emit_syscall_const(bytes, 0, 1)
            bytes = x86_emit_load_syscall_arg(bytes, size_slot, 2)
            bytes = x86_emit_syscall_const(bytes, 3, 3)
            bytes = x86_emit_syscall_const(bytes, 34, 4)
            bytes = x86_emit_syscall_const(bytes, -1, 5)
            bytes = x86_emit_syscall_const(bytes, 0, 6)
            bytes = append(bytes, 15); bytes = append(bytes, 5)
            bytes = x86_emit_store_rax(bytes, slot)
        } else if instruction.op == IR_CALL and instruction.aux >= 0 and
                instruction.aux < len(call_sites) and call_sites[instruction.aux].callee_item == -7 {
            let site = call_sites[instruction.aux]
            if instruction.type_kind != SEM_INT or site.argument_count != 2 or site.argument_start < 0 or site.argument_start + 1 >= len(call_arguments) or slot < 1 or slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 unsafe_free call invalid"))
            }
            let pointer_slot = call_arguments[site.argument_start] - function.value_start + 1
            let size_slot = call_arguments[site.argument_start + 1] - function.value_start + 1
            if pointer_slot < 1 or pointer_slot >= slot or size_slot < 1 or size_slot >= slot { return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 unsafe_free argument not earlier value")) }
            bytes = x86_emit_int_rax(bytes, 11)
            bytes = x86_emit_load_syscall_arg(bytes, pointer_slot, 1)
            bytes = x86_emit_load_syscall_arg(bytes, size_slot, 2)
            bytes = x86_emit_syscall_const(bytes, 0, 3)
            bytes = x86_emit_syscall_const(bytes, 0, 4)
            bytes = x86_emit_syscall_const(bytes, 0, 5)
            bytes = x86_emit_syscall_const(bytes, 0, 6)
            bytes = append(bytes, 15); bytes = append(bytes, 5)
            bytes = x86_emit_store_rax(bytes, slot)
        } else if instruction.op == IR_CALL and instruction.aux >= 0 and
                instruction.aux < len(call_sites) and call_sites[instruction.aux].callee_item == -4 {
            let site = call_sites[instruction.aux]
            if instruction.type_kind != SEM_INT or site.argument_count != 1 or
                    site.argument_start < 0 or site.argument_start >= len(call_arguments) or
                    slot < 1 or slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 unsafe_ptr_load8 call invalid"))
            }
            let argument_slot = call_arguments[site.argument_start] - function.value_start + 1
            if argument_slot < 1 or argument_slot >= slot {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 unsafe_ptr_load8 argument not earlier value"))
            }
            bytes = x86_emit_unsafe_load8(bytes, argument_slot, slot)
        } else if instruction.op == IR_CALL and instruction.aux >= 0 and
                instruction.aux < len(call_sites) and call_sites[instruction.aux].callee_item == -5 {
            let site = call_sites[instruction.aux]
            if instruction.type_kind != SEM_INT or site.argument_count != 2 or
                    site.argument_start < 0 or site.argument_start + 1 >= len(call_arguments) or
                    slot < 1 or slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 unsafe_ptr_store8 call invalid"))
            }
            let pointer_slot = call_arguments[site.argument_start] - function.value_start + 1
            let value_slot = call_arguments[site.argument_start + 1] - function.value_start + 1
            if pointer_slot < 1 or pointer_slot >= slot or value_slot < 1 or value_slot >= slot {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 unsafe_ptr_store8 argument not earlier value"))
            }
            bytes = x86_emit_unsafe_store8(bytes, pointer_slot, value_slot, slot)
        } else if instruction.op == IR_CALL and instruction.aux >= 0 and
            instruction.aux < len(call_sites) and call_sites[instruction.aux].callee_item == -3 {
            let site = call_sites[instruction.aux]
            if instruction.type_kind != SEM_BYTE or site.argument_count != 1 or
                site.argument_start < 0 or site.argument_start >= len(call_arguments) or
                slot < 1 or slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 byte conversion call is invalid"))
            }
            let argument_value = call_arguments[site.argument_start]
            let argument_slot = argument_value - function.value_start + 1
            if argument_slot < 1 or argument_slot >= slot {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 byte conversion argument is not an earlier value"))
            }
            bytes = x86_emit_byte_cast(bytes, argument_slot, slot)
        } else if instruction.op == IR_CALL and instruction.aux >= 0 and
            instruction.aux < len(call_sites) and call_sites[instruction.aux].callee_item == -2 {
            let site = call_sites[instruction.aux]
            if instruction.type_kind != SEM_INT or site.argument_count != 7 or
                site.argument_start < 0 or site.argument_start + 7 > len(call_arguments) or
                slot < 1 or slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 linux_syscall6 call is invalid"))
            }
            let mut syscall_argument = 0
            while syscall_argument < 7 {
                let argument_value = call_arguments[site.argument_start + syscall_argument]
                let argument_slot = argument_value - function.value_start + 1
                if argument_slot < 1 or argument_slot >= slot {
                    return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 linux_syscall6 argument is not an earlier value"))
                }
                bytes = x86_emit_load_syscall_arg(bytes, argument_slot, syscall_argument)
                syscall_argument = syscall_argument + 1
            }
            bytes = append(bytes, 15)
            bytes = append(bytes, 5)
            bytes = x86_emit_store_rax(bytes, slot)
        } else if instruction.op == IR_CALL {
            // An int and a bool result come back the same way in rax and land
            // in one slot; only the IR tag distinguishes them.
            if (instruction.type_kind != SEM_INT and instruction.type_kind != SEM_BOOL) or
                instruction.aux < 0 or instruction.aux >= len(call_sites) or slot < 1 or slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar body call is invalid"))
            }
            let site = call_sites[instruction.aux]
            let callee = x86_find_callee(functions, site.callee_item)
            if site.argument_count < 0 or site.argument_count > 15 or
                site.argument_start < 0 or site.argument_start + site.argument_count > len(call_arguments) or callee < 0 {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar body call site is invalid"))
            }
            let mut stack_count = site.argument_count - 6
            if stack_count < 0 {
                stack_count = 0
            }
            let stack_pad = (8 * stack_count + 15) & 4294967280
            if stack_count > 0 {
                bytes = x86_emit_rsp_adjust(bytes, 236, stack_pad)
                let mut stack_index = 0
                while stack_index < stack_count {
                    let stack_arg_slot = call_arguments[site.argument_start + 6 + stack_index] - function.value_start + 1
                    if stack_arg_slot < 1 or stack_arg_slot >= slot {
                        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar body call argument is not an earlier value"))
                    }
                    bytes = x86_emit_load_rax(bytes, stack_arg_slot)
                    bytes = x86_emit_store_rsp_rax(bytes, 8 * stack_index)
                    stack_index = stack_index + 1
                }
            }
            let mut arg_index = 0
            while arg_index < site.argument_count - stack_count {
                let arg_slot = call_arguments[site.argument_start + arg_index] - function.value_start + 1
                if arg_slot < 1 or arg_slot >= slot {
                    return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar body call argument is not an earlier value"))
                }
                bytes = x86_emit_load_param(bytes, arg_slot, arg_index + 1)
                arg_index = arg_index + 1
            }
            let field = len(bytes) + 1
            bytes = append(bytes, 232)
            bytes = x86_emit_u32(bytes, 0)
            if stack_count > 0 {
                bytes = x86_emit_rsp_adjust(bytes, 196, stack_pad)
            }
            bytes = x86_emit_store_rax(bytes, slot)
            edge_callees = append(edge_callees, callee)
            edge_fields = append(edge_fields, field)
        } else if instruction.op == IR_RETURN {
            if not allow_return or i != end - start - 1 {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar body return must be last"))
            }
            if instruction.left < 0 {
                // A result-less return (bare main) exits 0.
                bytes = append(bytes, 184)
                bytes = x86_emit_u32(bytes, 0)
                bytes = append(bytes, 201)
                bytes = append(bytes, 195)
            } else {
                let return_slot = instruction.left - function.value_start + 1
                if return_slot < 1 or return_slot > function.value_count {
                    return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar body return value is invalid"))
                }
                bytes = x86_emit_load_rax(bytes, return_slot)
                bytes = append(bytes, 201)
                bytes = append(bytes, 195)
            }
        } else {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar body instruction is not implemented"))
        }
        // If the previous instruction left rax holding this slot and this one
        // opens by loading that same slot, the load reads back what rax already
        // has. Dropping it is safe *only* at the head of an instruction: an
        // emitter's internal jumps are self-contained, so none of them can
        // target bytes emitted before this instruction began, and every
        // displacement inside it keeps its distance when the leading four bytes
        // go. A jump target is always a block start, never mid-segment.
        if rax_holds_slot >= 0 and len(bytes) >= instruction_byte_start + 4 and
            bytes[instruction_byte_start] == 72 and bytes[instruction_byte_start + 1] == 139 and
            bytes[instruction_byte_start + 2] == 69 and
            bytes[instruction_byte_start + 3] == x86_slot_byte(rax_holds_slot) {
            // Drop the redundant load, and with it the store that fed it when
            // that value has no other reader anywhere — a single-use temporary
            // then never reaches the frame at all. Both spans are cut in one
            // pass so the surviving offsets are computed once.
            // The store goes only if nothing else in the function reads the
            // value; the consumer here is the instruction whose load was just
            // dropped, so its own read does not count against it.
            let drop_store = removable_store_at >= 0 and
                x86_value_dead_after(instructions, call_sites, call_arguments, jump_arguments,
                    removable_store_producer, start + i, removable_store_value)
            let leading_cut = if drop_store { 4 } else { 0 }
            let mut trimmed: []int = make([]int, 0, len(bytes))
            let mut copy_index = 0
            while copy_index < len(bytes) {
                let in_store = drop_store and copy_index >= removable_store_at and
                    copy_index < removable_store_at + 4
                let in_load = copy_index >= instruction_byte_start and
                    copy_index < instruction_byte_start + 4
                if not in_store and not in_load {
                    trimmed = append(trimmed, bytes[copy_index])
                }
                copy_index = copy_index + 1
            }
            bytes = trimmed
            let mut edge_index = instruction_edge_start
            while edge_index < len(edge_fields) {
                edge_fields[edge_index] = edge_fields[edge_index] - 4 - leading_cut
                edge_index = edge_index + 1
            }
        }
        // What rax holds after this instruction: the slot it stored last, or
        // nothing. Only the disp8 store form is recognised, so a wide frame
        // simply keeps the round trip rather than risking a wrong match.
        rax_holds_slot = -1
        removable_store_at = -1
        removable_store_producer = -1
        removable_store_value = -1
        if len(bytes) >= instruction_byte_start + 4 and
            bytes[len(bytes) - 4] == 72 and bytes[len(bytes) - 3] == 137 and
            bytes[len(bytes) - 2] == 69 {
            // Recover the slot from the disp8 the store just emitted, and only
            // trust it when it round-trips — anything else is not this form.
            let disp = bytes[len(bytes) - 1]
            let candidate = (256 - disp) / 8
            if candidate >= 1 and candidate <= 15 and x86_slot_byte(candidate) == disp {
                rax_holds_slot = candidate
                // The store may go too, but only for an emitter that is
                // straight-line — one with an internal jump can target the
                // bytes after its store — and only when no other instruction,
                // call or jump anywhere in the function reads the value.
                if x86_op_ends_with_plain_store(instruction.op) and
                    len(edge_fields) == instruction_edge_start {
                    removable_store_at = len(bytes) - 4
                    removable_store_producer = start + i
                    removable_store_value = instruction.result
                }
            }
        }
        i = i + 1
    }
    return X86Body { code: X86Code { bytes: bytes, status: X86_OK, error: "" }, edge_callees: edge_callees, edge_fields: edge_fields }
}

// Encode one single-block function body. Supported shapes: identity return of
// the int parameter, integer constant return, constant add return, parameter
// combined with a constant or second parameter, one- and two-argument
// constant calls (optionally combined with a constant), two-call frame
// bodies, and — as the general fallback — straight-line scalar bodies with
// locals through the slot-per-value lowering. Anything else is an explicit
// error. `callee` carries the called function's arena index (or -1) so the caller can patch displacements after layout.
fn x86_encode_function_body(instructions: []IrInstruction, constants: []IrConstant, block: IrBlock, call_sites: []IrCallSite, call_arguments: []int, jump_arguments: []int, functions: []IrFunction, function: IrFunction, string_literals: []string, constant_string_index: []int) -> X86Body {
    let start = block.instruction_start
    if start < 0 or block.terminator != start + block.instruction_count - 1 or
        block.terminator >= len(instructions) or block.successor_count != 0 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 function body has an invalid block shape"))
    }
    if block.instruction_count == 2 {
        let parameter = instructions[start]
        let returned = instructions[start + 1]
        if parameter.op == IR_PARAM and parameter.type_kind == SEM_INT and
            returned.op == IR_RETURN and returned.left == parameter.result {
            return x86_plain_body(x86_emit_param_return())
        }
        let const_lowered = x86_lower_const_return(instructions, constants, start, start + 2)
        if const_lowered.status == X86_OK {
            return x86_plain_body(const_lowered)
        }
    }
    if block.instruction_count == 4 {
        let add_lowered = x86_lower_const_add_return(instructions, constants, start, start + 4)
        if add_lowered.status == X86_OK {
            return x86_plain_body(add_lowered)
        }
        let first = instructions[start]
        let second = instructions[start + 1]
        let third = instructions[start + 2]
        let returned = instructions[start + 3]
        if first.op == IR_PARAM and first.type_kind == SEM_INT and
            second.op == IR_CONST and second.type_kind == SEM_INT and
            second.aux >= 0 and second.aux < len(constants) and
            third.op == IR_BINARY and third.type_kind == SEM_INT and x86_alu_supported(third.aux) and
            third.left == first.result and third.right == second.result and
            returned.op == IR_RETURN and returned.left == third.result {
            return x86_plain_body(x86_emit_param_op_return(third.aux, constants[second.aux].int_value))
        }
        if first.op == IR_PARAM and first.type_kind == SEM_INT and
            second.op == IR_PARAM and second.type_kind == SEM_INT and
            third.op == IR_BINARY and third.type_kind == SEM_INT and x86_alu_supported(third.aux) and
            third.left == first.result and third.right == second.result and
            returned.op == IR_RETURN and returned.left == third.result {
            return x86_plain_body(x86_emit_param_op_param_return(third.aux))
        }
        if first.op == IR_CONST and first.type_kind == SEM_INT and
            first.aux >= 0 and first.aux < len(constants) and
            second.op == IR_CONST and second.type_kind == SEM_INT and
            second.aux >= 0 and second.aux < len(constants) and
            third.op == IR_CALL and third.type_kind == SEM_INT and
            third.aux >= 0 and third.aux < len(call_sites) and
            returned.op == IR_RETURN and returned.left == third.result {
            let site = call_sites[third.aux]
            let callee = x86_find_callee(functions, site.callee_item)
            if site.argument_count == 2 and site.argument_start >= 0 and
                site.argument_start + 1 < len(call_arguments) and
                call_arguments[site.argument_start] == first.result and
                call_arguments[site.argument_start + 1] == second.result and callee >= 0 {
                return x86_call_body(x86_emit_const_call2_return(constants[first.aux].int_value, constants[second.aux].int_value, 0), callee, 11)
            }
        }
    }
    if block.instruction_count == 3 or block.instruction_count == 5 {
        let constant = instructions[start]
        let call = instructions[start + 1]
        if constant.op == IR_CONST and constant.type_kind == SEM_INT and
            constant.aux >= 0 and constant.aux < len(constants) and
            call.op == IR_CALL and call.type_kind == SEM_INT and
            call.aux >= 0 and call.aux < len(call_sites) {
            let site = call_sites[call.aux]
            let callee = x86_find_callee(functions, site.callee_item)
            if site.argument_count == 1 and site.argument_start >= 0 and
                site.argument_start < len(call_arguments) and
                call_arguments[site.argument_start] == constant.result and callee >= 0 {
                if block.instruction_count == 3 {
                    let returned = instructions[start + 2]
                    if returned.op == IR_RETURN and returned.left == call.result {
                        return x86_call_body(x86_emit_const_call_return(constants[constant.aux].int_value, 0), callee, 6)
                    }
                } else {
                    let addend = instructions[start + 2]
                    let binary = instructions[start + 3]
                    let returned = instructions[start + 4]
                    if addend.op == IR_CONST and addend.type_kind == SEM_INT and
                        addend.aux >= 0 and addend.aux < len(constants) and
                        binary.op == IR_BINARY and binary.type_kind == SEM_INT and x86_alu_supported(binary.aux) and
                        binary.left == call.result and binary.right == addend.result and
                        returned.op == IR_RETURN and returned.left == binary.result {
                        return x86_call_body(x86_emit_call_op_return(constants[constant.aux].int_value, 0, binary.aux, constants[addend.aux].int_value), callee, 6)
                    }
                }
            }
        }
    }
    if block.instruction_count == 6 {
        let first = instructions[start]
        let first_call = instructions[start + 1]
        let second = instructions[start + 2]
        let second_call = instructions[start + 3]
        let binary = instructions[start + 4]
        let returned = instructions[start + 5]
        if first.op == IR_CONST and first.type_kind == SEM_INT and
            first.aux >= 0 and first.aux < len(constants) and
            first_call.op == IR_CALL and first_call.type_kind == SEM_INT and
            first_call.aux >= 0 and first_call.aux < len(call_sites) and
            second.op == IR_CONST and second.type_kind == SEM_INT and
            second.aux >= 0 and second.aux < len(constants) and
            second_call.op == IR_CALL and second_call.type_kind == SEM_INT and
            second_call.aux >= 0 and second_call.aux < len(call_sites) and
            binary.op == IR_BINARY and binary.type_kind == SEM_INT and x86_alu_supported(binary.aux) and
            binary.left == first_call.result and binary.right == second_call.result and
            returned.op == IR_RETURN and returned.left == binary.result {
            let first_site = call_sites[first_call.aux]
            let second_site = call_sites[second_call.aux]
            let first_callee = x86_find_callee(functions, first_site.callee_item)
            let second_callee = x86_find_callee(functions, second_site.callee_item)
            if first_site.argument_count == 1 and first_site.argument_start >= 0 and
                first_site.argument_start < len(call_arguments) and
                call_arguments[first_site.argument_start] == first.result and first_callee >= 0 and
                second_site.argument_count == 1 and second_site.argument_start >= 0 and
                second_site.argument_start < len(call_arguments) and
                call_arguments[second_site.argument_start] == second.result and second_callee >= 0 {
                return x86_pair_body(
                    x86_emit_call_call_op_return(constants[first.aux].int_value, 0, constants[second.aux].int_value, 0, binary.aux),
                    first_callee, 14, second_callee, 28
                )
            }
        }
    }
    if block.instruction_count == 8 {
        let first_a = instructions[start]
        let first_b = instructions[start + 1]
        let first_call = instructions[start + 2]
        let second_a = instructions[start + 3]
        let second_b = instructions[start + 4]
        let second_call = instructions[start + 5]
        let binary = instructions[start + 6]
        let returned = instructions[start + 7]
        if first_a.op == IR_CONST and first_a.type_kind == SEM_INT and
            first_a.aux >= 0 and first_a.aux < len(constants) and
            first_b.op == IR_CONST and first_b.type_kind == SEM_INT and
            first_b.aux >= 0 and first_b.aux < len(constants) and
            first_call.op == IR_CALL and first_call.type_kind == SEM_INT and
            first_call.aux >= 0 and first_call.aux < len(call_sites) and
            second_a.op == IR_CONST and second_a.type_kind == SEM_INT and
            second_a.aux >= 0 and second_a.aux < len(constants) and
            second_b.op == IR_CONST and second_b.type_kind == SEM_INT and
            second_b.aux >= 0 and second_b.aux < len(constants) and
            second_call.op == IR_CALL and second_call.type_kind == SEM_INT and
            second_call.aux >= 0 and second_call.aux < len(call_sites) and
            binary.op == IR_BINARY and binary.type_kind == SEM_INT and x86_alu_supported(binary.aux) and
            binary.left == first_call.result and binary.right == second_call.result and
            returned.op == IR_RETURN and returned.left == binary.result {
            let first_site = call_sites[first_call.aux]
            let second_site = call_sites[second_call.aux]
            let first_callee = x86_find_callee(functions, first_site.callee_item)
            let second_callee = x86_find_callee(functions, second_site.callee_item)
            if first_site.argument_count == 2 and first_site.argument_start >= 0 and
                first_site.argument_start + 1 < len(call_arguments) and
                call_arguments[first_site.argument_start] == first_a.result and
                call_arguments[first_site.argument_start + 1] == first_b.result and first_callee >= 0 and
                second_site.argument_count == 2 and second_site.argument_start >= 0 and
                second_site.argument_start + 1 < len(call_arguments) and
                call_arguments[second_site.argument_start] == second_a.result and
                call_arguments[second_site.argument_start + 1] == second_b.result and second_callee >= 0 {
                return x86_pair_body(
                    x86_emit_call2_pair_op_return(
                        constants[first_a.aux].int_value, constants[first_b.aux].int_value, 0,
                        constants[second_a.aux].int_value, constants[second_b.aux].int_value, 0,
                        binary.aux
                    ),
                    first_callee, 19, second_callee, 38
                )
            }
        }
    }
    return x86_lower_scalar_body(instructions, constants, block, call_sites, call_arguments, jump_arguments, functions, function, string_literals, constant_string_index)
}

// Encode a function whose every block ends in IR_RETURN or IR_BRANCH: an
// arbitrarily nested if/else tree in which every path returns.
//
// This is the first lowering here that is general in its control-flow shape
// rather than matched against a fixed block count. Because no path rejoins,
// there are no merge blocks, no block parameters and no jumps, so the
// slot-per-value model needs nothing beyond branch displacements: each block
// is emitted independently in arena order, its offset recorded, and every
// displacement patched once all offsets are known. Nesting depth is therefore
// not a shape the encoder has to recognize.
//
// Each branch emits `jcc false_target` followed by `jmp true_target` rather
// than relying on one arm falling through. That costs five bytes per branch
// and makes correctness independent of block layout order.
// True when nothing outside `producer` reads this value anywhere in the
// function: no other instruction names it as an operand, no call or jump passes
// it, and it is not carried by a block parameter.
//
// This is what makes a store removable. It is deliberately whole-function and
// conservative — a use in any block, reachable or not, counts — because the
// cost of missing one is a slot that never got written and a later read of
// whatever the frame happened to hold.
fn x86_value_dead_after(instructions: []IrInstruction, call_sites: []IrCallSite, call_arguments: []int, jump_arguments: []int, producer: int, consumer: int, value: int) -> bool {
    if value < 0 { return false }
    let mut i = 0
    while i < len(instructions) {
        // The consumer is excluded: its read of the value is the one already
        // satisfied out of rax, which is exactly why the store can go.
        if i != producer and i != consumer {
            let other = instructions[i]
            if other.left == value or other.right == value { return false }
            // A jump carries its single argument in `left`, which the check
            // above already covers, and wider ones through the arena below.
            if other.op == IR_CALL and other.aux >= 0 and other.aux < len(call_sites) {
                let site = call_sites[other.aux]
                let mut argument = site.argument_start
                while argument < site.argument_start + site.argument_count {
                    if argument >= 0 and argument < len(call_arguments) and
                        call_arguments[argument] == value { return false }
                    argument = argument + 1
                }
            }
        }
        i = i + 1
    }
    let mut jump_index = 0
    while jump_index < len(jump_arguments) {
        if jump_arguments[jump_index] == value { return false }
        jump_index = jump_index + 1
    }
    return true
}

// Opcodes whose emitters are straight-line and finish by storing rax. Only
// these may have that store removed: an emitter with an internal jump — the
// bounds trap in an indexed load, say — can target the bytes after its store,
// so dropping it would retarget the jump into the middle of something else.
fn x86_op_ends_with_plain_store(op: int) -> bool {
    return op == IR_CONST or op == IR_BINARY or op == IR_UNARY or op == IR_MOVE or op == IR_LEN
}

// Occurrences of a short byte run in an encoded body. The run is passed as
// scalars rather than a slice: building a pattern slice with `append` and then
// handing it to a call is the shape that trips the stage-0 slice defect this
// roadmap records, and these helpers run inside the compiler's own self-check.
//
// Used so the encoder's self-checks can assert what an encoding contains rather
// than where it sits. An absolute offset breaks on any layout change, including
// a correct one, and recomputing a wall of them by inference is how a
// self-check quietly stops checking.
fn x86_bytes_count3(bytes: []int, b0: int, b1: int, b2: int) -> int {
    let mut found = 0
    let mut at = 0
    while at + 2 < len(bytes) {
        if bytes[at] == b0 and bytes[at + 1] == b1 and bytes[at + 2] == b2 {
            found = found + 1
        }
        at = at + 1
    }
    return found
}

fn x86_bytes_count2(bytes: []int, b0: int, b1: int) -> int {
    let mut found = 0
    let mut at = 0
    while at + 1 < len(bytes) {
        if bytes[at] == b0 and bytes[at + 1] == b1 { found = found + 1 }
        at = at + 1
    }
    return found
}

fn x86_bytes_count1(bytes: []int, b0: int) -> int {
    let mut found = 0
    let mut at = 0
    while at < len(bytes) {
        if bytes[at] == b0 { found = found + 1 }
        at = at + 1
    }
    return found
}

// Near `jmp rel32` instructions whose displacement is negative — a backedge.
// The top displacement byte is 0xFF for every backward jump this encoder emits,
// since no body approaches 16 MB.
fn x86_backward_jump_count(bytes: []int) -> int {
    let mut found = 0
    let mut at = 0
    while at + 4 < len(bytes) {
        if bytes[at] == 233 and bytes[at + 4] == 255 { found = found + 1 }
        at = at + 1
    }
    return found
}

// Leading block parameters of a block. They emit no code — the slot model gives
// every value a frame slot, so a block parameter is a slot the incoming jump
// writes before it transfers. Only a leading run counts; a block parameter
// anywhere else is not this shape and the caller rejects the function.
fn x86_block_parameter_count(instructions: []IrInstruction, block: IrBlock) -> int {
    let mut count = 0
    while count < block.instruction_count and
        block.instruction_start + count < len(instructions) and
        instructions[block.instruction_start + count].op == IR_BLOCK_PARAM {
        count = count + 1
    }
    return count
}

fn x86_lower_returning_cfg(instructions: []IrInstruction, constants: []IrConstant, blocks: []IrBlock, successors: []int, call_sites: []IrCallSite, call_arguments: []int, jump_arguments: []int, functions: []IrFunction, function: IrFunction, string_literals: []string, constant_string_index: []int) -> X86Body {
    // Slots past the fifteenth address through disp32 and the prologue takes
    // an imm32 frame, so this path is not held to the 127-value ceiling the
    // fixed shapes above document. The bound that remains keeps one frame
    // inside 32 KB, well under any stack guard.
    if function.parameter_count < 0 or function.parameter_count > 15 or
        function.value_start < 0 or function.value_count < 1 or
        function.value_count > X86_MAX_CFG_VALUES {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG exceeds the slot model limits"))
    }
    if function.block_count < 2 or function.entry_block < 0 or
        function.entry_block + function.block_count > len(blocks) {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG blocks are out of range"))
    }
    let mut check = 0
    while check < function.block_count {
        let block = blocks[function.entry_block + check]
        if block.instruction_count < 1 or block.instruction_start < 0 or
            block.terminator != block.instruction_start + block.instruction_count - 1 or
            block.terminator >= len(instructions) {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG block shape is invalid"))
        }
        // Block parameters must be a leading run: the incoming jump writes
        // their slots, so one appearing after real work would be written after
        // the code that reads it.
        let leading_parameters = x86_block_parameter_count(instructions, block)
        let mut stray = leading_parameters
        while stray < block.instruction_count {
            if instructions[block.instruction_start + stray].op == IR_BLOCK_PARAM {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG block parameter is not leading"))
            }
            stray = stray + 1
        }
        if leading_parameters >= block.instruction_count {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG block is only parameters"))
        }
        if leading_parameters > 0 {
            // Nothing writes a parameter slot except an incoming jump, so a
            // block with parameters reached by a branch — or by the call, as
            // the entry block is — would read whatever the frame held. Every
            // predecessor edge has to be a jump, and there has to be one.
            if function.entry_block + check == function.entry_block {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG entry block cannot take parameters"))
            }
            let mut predecessors = 0
            let mut source = 0
            while source < function.block_count {
                let candidate = blocks[function.entry_block + source]
                let mut edge = candidate.successor_start
                while edge < candidate.successor_start + candidate.successor_count {
                    if edge >= 0 and edge < len(successors) and
                        successors[edge] == function.entry_block + check {
                        if candidate.terminator < 0 or candidate.terminator >= len(instructions) or
                            instructions[candidate.terminator].op != IR_JUMP {
                            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG block parameter is reached without arguments"))
                        }
                        predecessors = predecessors + 1
                    }
                    edge = edge + 1
                }
                source = source + 1
            }
            if predecessors == 0 {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG block parameter has no incoming jump"))
            }
        }
        let terminator = instructions[block.terminator]
        if terminator.op == IR_RETURN {
            if block.successor_count != 0 {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG return block has successors"))
            }
        } else if terminator.op == IR_JUMP {
            if block.successor_count != 1 or block.successor_start < 0 or
                block.successor_start >= len(successors) {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG jump needs one successor"))
            }
            let jump_target = successors[block.successor_start]
            if jump_target < function.entry_block or
                jump_target >= function.entry_block + function.block_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG successor leaves the function"))
            }
        } else if terminator.op == IR_BRANCH {
            if block.successor_count != 2 or block.successor_start < 0 or
                block.successor_start + 1 >= len(successors) {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG branch needs two successors"))
            }
            let true_target = successors[block.successor_start]
            let false_target = successors[block.successor_start + 1]
            if true_target < function.entry_block or true_target >= function.entry_block + function.block_count or
                false_target < function.entry_block or false_target >= function.entry_block + function.block_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG successor leaves the function"))
            }
        } else {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG terminator is not a branch or return"))
        }
        check = check + 1
    }
    let mut bytes: []int = make([]int, 0, 128)
    bytes = x86_emit_frame_prologue_sized(bytes, (8 * function.value_count + 15) & 4294967280)
    let mut block_offsets: []int = make([]int, 0, function.block_count)
    let mut patch_fields: []int = make([]int, 0, 4)
    let mut patch_targets: []int = make([]int, 0, 4)
    let mut edge_callees: []int = make([]int, 0, 2)
    let mut edge_fields: []int = make([]int, 0, 2)
    let mut emit = 0
    while emit < function.block_count {
        let block = blocks[function.entry_block + emit]
        block_offsets = append(block_offsets, len(bytes))
        let terminator = instructions[block.terminator]
        let returns = terminator.op == IR_RETURN
        let jumps = terminator.op == IR_JUMP
        // A comparison never materializes into a slot, so when the condition
        // is the compare immediately before the branch it stays out of the
        // segment and fuses into the jcc instead. A jump has no condition, so
        // nothing fuses into it.
        let mut fused = false
        let mut left_slot = 0
        let mut right_slot = 0
        let mut false_jump = 116
        if not returns and not jumps {
            let previous = block.terminator - 1
            if previous >= block.instruction_start and
                instructions[previous].op == IR_BINARY and
                instructions[previous].type_kind == SEM_BOOL and
                instructions[previous].result == terminator.left {
                false_jump = x86_compare_false_jump(instructions[previous].aux)
                if false_jump < 0 {
                    return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG compare operator is not implemented"))
                }
                left_slot = instructions[previous].left - function.value_start + 1
                right_slot = instructions[previous].right - function.value_start + 1
                if left_slot < 1 or left_slot > function.value_count or
                    right_slot < 1 or right_slot > function.value_count {
                    return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG compare operand is invalid"))
                }
                fused = true
            }
        }
        let body_end = if returns {
            block.terminator + 1
        } else if fused {
            block.terminator - 1
        } else {
            block.terminator
        }
        // Block parameters are slots the incoming jump already wrote, so the
        // segment starts after them.
        let segment = x86_emit_scalar_segment(
            instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
            block.instruction_start + x86_block_parameter_count(instructions, block), body_end, returns,
            string_literals, constant_string_index
        )
        if segment.code.status != X86_OK {
            return x86_plain_body(segment.code)
        }
        let segment_offset = len(bytes)
        bytes = x86_append_code(bytes, segment.code)
        let mut field_index = 0
        while field_index < len(segment.edge_fields) {
            edge_callees = append(edge_callees, segment.edge_callees[field_index])
            edge_fields = append(edge_fields, segment.edge_fields[field_index] + segment_offset)
            field_index = field_index + 1
        }
        if jumps {
            // Transfer to a join: copy each argument into the target's
            // parameter slot, then jump. This is what a phi is in the slot
            // model — no register allocation, because every value already owns
            // a frame slot.
            let jump_target = successors[block.successor_start]
            let target_parameters = x86_block_parameter_count(instructions, blocks[jump_target])
            let mut argument_values: []int = make([]int, 0, 4)
            if target_parameters == 0 {
                if terminator.left >= 0 {
                    return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG jump passes an argument to a parameterless block"))
                }
            } else if target_parameters == 1 and terminator.left >= 0 {
                // Single-argument jumps carry the value in `left`; wider ones
                // index `jump_arguments` from `aux`. Both forms are produced by
                // the IR, so both are accepted here.
                argument_values = append(argument_values, terminator.left)
            } else if terminator.left < 0 and terminator.aux >= 0 and
                terminator.aux + target_parameters <= len(jump_arguments) {
                let mut take = 0
                while take < target_parameters {
                    argument_values = append(argument_values, jump_arguments[terminator.aux + take])
                    take = take + 1
                }
            } else {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG jump arguments do not match the target parameters"))
            }
            let target_block = blocks[jump_target]
            let mut parameter_slots: []int = make([]int, 0, 4)
            let mut argument_slots: []int = make([]int, 0, 4)
            let mut resolve = 0
            while resolve < target_parameters {
                let parameter_slot = instructions[target_block.instruction_start + resolve].result - function.value_start + 1
                let argument_slot = argument_values[resolve] - function.value_start + 1
                if parameter_slot < 1 or parameter_slot > function.value_count or
                    argument_slot < 1 or argument_slot > function.value_count {
                    return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG jump slot is out of range"))
                }
                parameter_slots = append(parameter_slots, parameter_slot)
                argument_slots = append(argument_slots, argument_slot)
                resolve = resolve + 1
            }
            // The copies run in sequence, so an argument that names a *different*
            // parameter's slot would read a value the previous copy already
            // overwrote. A carried value passing through itself is the common
            // case and is safe; a genuine permutation needs a temporary this
            // path does not allocate, so it is refused rather than miscompiled.
            let mut check_from = 0
            while check_from < target_parameters {
                let mut check_to = 0
                while check_to < target_parameters {
                    if check_from != check_to and argument_slots[check_from] == parameter_slots[check_to] {
                        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG jump arguments permute their parameter slots"))
                    }
                    check_to = check_to + 1
                }
                check_from = check_from + 1
            }
            let mut copy = 0
            while copy < target_parameters {
                if argument_slots[copy] != parameter_slots[copy] {
                    bytes = x86_emit_load_rax(bytes, argument_slots[copy])
                    bytes = x86_emit_store_rax(bytes, parameter_slots[copy])
                }
                copy = copy + 1
            }
            bytes = append(bytes, 233)
            patch_fields = append(patch_fields, len(bytes))
            patch_targets = append(patch_targets, jump_target)
            bytes = x86_emit_u32(bytes, 0)
        } else if not returns {
            if fused {
                bytes = x86_emit_load_rax(bytes, left_slot)
                bytes = x86_emit_cmp_mem(bytes, right_slot)
            } else {
                let condition_slot = terminator.left - function.value_start + 1
                if condition_slot < 1 or condition_slot > function.value_count {
                    return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG branch condition is invalid"))
                }
                bytes = x86_emit_load_rax(bytes, condition_slot)
                // test rax, rax
                bytes = append(bytes, 72)
                bytes = append(bytes, 133)
                bytes = append(bytes, 192)
            }
            // Near jcc to the false successor, then near jmp to the true one.
            bytes = append(bytes, 15)
            bytes = append(bytes, false_jump + 16)
            patch_fields = append(patch_fields, len(bytes))
            patch_targets = append(patch_targets, successors[block.successor_start + 1])
            bytes = x86_emit_u32(bytes, 0)
            bytes = append(bytes, 233)
            patch_fields = append(patch_fields, len(bytes))
            patch_targets = append(patch_targets, successors[block.successor_start])
            bytes = x86_emit_u32(bytes, 0)
        }
        emit = emit + 1
    }
    let mut patch = 0
    while patch < len(patch_fields) {
        let target = patch_targets[patch] - function.entry_block
        if target < 0 or target >= len(block_offsets) {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 returning CFG branch target is out of range"))
        }
        bytes = x86_patch_u32(bytes, patch_fields[patch], block_offsets[target] - (patch_fields[patch] + 4))
        patch = patch + 1
    }
    return X86Body {
        code: X86Code { bytes: bytes, status: X86_OK, error: "" },
        edge_callees: edge_callees, edge_fields: edge_fields,
    }
}

// Encode one function: single-block bodies through the shape encoder,
// four-block loop shapes (a jump backedge) through the loop lowering, and
// three/four-block branch shapes through the branch lowering. Anything else
// is an explicit error.
fn x86_encode_function(instructions: []IrInstruction, constants: []IrConstant, blocks: []IrBlock, successors: []int, call_sites: []IrCallSite, call_arguments: []int, jump_arguments: []int, functions: []IrFunction, function: IrFunction, string_literals: []string, constant_string_index: []int) -> X86Body {
    if function.block_count == 1 {
        return x86_encode_function_body(instructions, constants, blocks[function.entry_block], call_sites, call_arguments, jump_arguments, functions, function, string_literals, constant_string_index)
    }
    if function.block_count >= 7 and
        x86_function_has_backedge(instructions, blocks, successors, function) and
        blocks[function.entry_block].terminator >= 0 and
        blocks[function.entry_block].terminator < len(instructions) and
        instructions[blocks[function.entry_block].terminator].op == IR_BRANCH and
        function.entry_block + 3 < len(blocks) and
        blocks[function.entry_block + 3].terminator >= 0 and
        blocks[function.entry_block + 3].terminator < len(instructions) and
        instructions[blocks[function.entry_block + 3].terminator].op == IR_JUMP {
        // A merge-if group leading the chain: the function opens with a
        // branch and the fourth block jumps into the first header.
        return x86_lower_pre_if_chain(instructions, constants, blocks, successors, call_sites, call_arguments, jump_arguments, functions, function, string_literals, constant_string_index)
    }
    if function.block_count == 4 and
        x86_function_has_backedge(instructions, blocks, successors, function) {
        let matched_loop = x86_lower_loop(instructions, constants, blocks, successors, call_sites, call_arguments, jump_arguments, functions, function, 0, false, string_literals, constant_string_index)
        if matched_loop.code.status == X86_OK {
            return matched_loop
        }
        // The matched four-block loop wants its own layout — an exit block that
        // just returns, among others. A loop the general lowering built may
        // have anything after it, so fall through to the shape-independent
        // encoder rather than reporting this shape's complaint as the reason
        // the function cannot be encoded.
    }
    if function.block_count >= 10 and
        ((function.block_count - 4) % 3 == 0 or (function.block_count - 5) % 3 == 0) and
        x86_function_has_backedge(instructions, blocks, successors, function) {
        // A chain of plain loops whose last loop is guarded. The guarded
        // group's pre block is the only jump in the design that carries no
        // argument, which separates the shape from a plain loop chain.
        let pre_index = if (function.block_count - 4) % 3 == 0 {
            function.entry_block + function.block_count - 5
        } else {
            function.entry_block + function.block_count - 6
        }
        if pre_index >= 0 and pre_index < len(blocks) and
            blocks[pre_index].terminator >= 0 and blocks[pre_index].terminator < len(instructions) and
            instructions[blocks[pre_index].terminator].op == IR_JUMP and
            instructions[blocks[pre_index].terminator].left < 0 and
            instructions[blocks[pre_index].terminator].aux < 0 {
            return x86_lower_guarded_chain(instructions, constants, blocks, successors, call_sites, call_arguments, jump_arguments, functions, function, string_literals, constant_string_index)
        }
    }
    if (function.block_count == 7 or
        (function.block_count >= 10 and (function.block_count - 1) % 3 == 0)) and
        x86_function_has_backedge(instructions, blocks, successors, function) and
        function.entry_block + 3 < len(blocks) and
        blocks[function.entry_block + 3].terminator >= 0 and
        blocks[function.entry_block + 3].terminator < len(instructions) and
        instructions[blocks[function.entry_block + 3].terminator].op == IR_JUMP {
        // A chain of sequential plain loops: the fourth block is a junction
        // (a jump), never a branch.
        let matched_chain = x86_lower_loop_chain(instructions, constants, blocks, successors, call_sites, call_arguments, jump_arguments, functions, function, -1, 0, false, string_literals, constant_string_index)
        if matched_chain.code.status == X86_OK {
            return matched_chain
        }
        // As with the single loop: this shape's layout is not the only one a
        // chain of loops can have, so fall through instead of reporting its
        // complaint as the function's reason.
    }
    if (function.block_count == 7 or function.block_count == 8) and
        x86_function_has_backedge(instructions, blocks, successors, function) {
        // The merge-if shape's sixth block jumps back to the header; the
        // guarded shapes route that position to the exit or header arm.
        let sixth = blocks[function.entry_block + 6]
        if function.block_count == 8 and sixth.successor_count == 1 and
            sixth.successor_start >= 0 and sixth.successor_start < len(successors) and
            successors[sixth.successor_start] == function.entry_block + 1 and
            blocks[function.entry_block + 5].successor_count == 1 and
            successors[blocks[function.entry_block + 5].successor_start] == function.entry_block + 6 {
            return x86_lower_merge_loop(instructions, constants, blocks, successors, call_sites, call_arguments, jump_arguments, functions, function, string_literals, constant_string_index)
        }
        let matched_guarded = x86_lower_guarded_loop(instructions, constants, blocks, successors, call_sites, call_arguments, jump_arguments, functions, function, 0, false, string_literals, constant_string_index)
        if matched_guarded.code.status == X86_OK {
            return matched_guarded
        }
    }
    if function.block_count == 3 or function.block_count == 4 {
        let branch = x86_lower_branch_return(instructions, constants, blocks, successors, function)
        if branch.status == X86_OK {
            return x86_plain_body(branch)
        }
        let branch_call = x86_lower_branch_call_return(instructions, constants, blocks, successors, call_sites, call_arguments, functions, function)
        if branch_call.code.status == X86_OK {
            return branch_call
        }
        // Both narrow branch shapes declined; fall through to the general
        // returning-CFG encoder rather than reporting their shape complaint,
        // which is not the reason a three-block function cannot be encoded.
    }
    // Shape-independent fallback: any all-paths-return branch tree. Tried last
    // so every shape above keeps its existing encoding, which is what lets the
    // pinned fixture images stay byte-identical.
    return x86_lower_returning_cfg(instructions, constants, blocks, successors, call_sites, call_arguments, jump_arguments, functions, function, string_literals, constant_string_index)
}

// Lower a multi-function package into one code stream: the entry bridge, then
// every function body in arena order. The bridge calls the root. Call
// displacements are patched after layout, so encoding order never affects the
// result.
//
// The root is the function owning `entry_item` — `fn main`. Selecting it as
// "the function no call site references" instead only works when the file
// declares nothing else uncalled, which no real source does; a single unused
// helper made the whole image unbuildable. `entry_item` may be -1 when the
// caller has no item arena to name one, in which case the uncalled rule is
// still the best available answer.
fn x86_lower_functions(instructions: []IrInstruction, constants: []IrConstant, blocks: []IrBlock, successors: []int, call_sites: []IrCallSite, call_arguments: []int, jump_arguments: []int, functions: []IrFunction, string_literals: []string, constant_string_index: []int, entry_item: int) -> X86Code {
    let count = len(functions)
    let mut root = -1
    let mut i = 0
    while i < count {
        if entry_item >= 0 {
            if functions[i].item == entry_item { root = i }
        } else {
            let mut is_callee = false
            let mut site_index = 0
            while site_index < len(call_sites) {
                if call_sites[site_index].callee_item == functions[i].item { is_callee = true }
                site_index = site_index + 1
            }
            if not is_callee {
                if root >= 0 {
                    return x86_error(X86_UNSUPPORTED, "x86 image requires one uncalled root function")
                }
                root = i
            }
        }
        i = i + 1
    }
    if root < 0 {
        return x86_error(X86_UNSUPPORTED, "x86 image has no entry function")
    }
    if functions[root].parameter_count > 1 {
        return x86_error(X86_UNSUPPORTED, "x86 root function takes at most one parameter")
    }
    let bridge = x86_emit_bridge(0)
    if bridge.status != X86_OK {
        return bridge
    }
    let mut code = bridge.bytes
    let mut offsets: []int = make([]int, 0, count)
    let mut edge_functions: []int = make([]int, 0, count)
    let mut edge_callees: []int = make([]int, 0, count)
    let mut edge_fields: []int = make([]int, 0, count)
    i = 0
    while i < count {
        let function = functions[i]
        if function.block_count < 1 or function.entry_block < 0 or function.entry_block >= len(blocks) {
            return x86_error(X86_UNSUPPORTED, "x86 function has an invalid block range")
        }
        offsets = append(offsets, len(code))
        let body = x86_encode_function(instructions, constants, blocks, successors, call_sites, call_arguments, jump_arguments, functions, function, string_literals, constant_string_index)
        if body.code.status != X86_OK {
            return body.code
        }
        let mut edge_index = 0
        while edge_index < len(body.edge_callees) {
            edge_functions = append(edge_functions, i)
            edge_callees = append(edge_callees, body.edge_callees[edge_index])
            edge_fields = append(edge_fields, body.edge_fields[edge_index])
            edge_index = edge_index + 1
        }
        let mut byte_index = 0
        while byte_index < len(body.code.bytes) {
            code = append(code, body.code.bytes[byte_index])
            byte_index = byte_index + 1
        }
        i = i + 1
    }
    code = x86_patch_u32(code, 4, offsets[root] - 8)
    i = 0
    while i < len(edge_callees) {
        let field = offsets[edge_functions[i]] + edge_fields[i]
        code = x86_patch_u32(code, field, offsets[edge_callees[i]] - (field + 4))
        i = i + 1
    }
    return X86Code { bytes: code, status: X86_OK, error: "" }
}
// Lower the first complete verified-IR shape: one integer constant and return.
fn x86_lower_const_return(instructions: []IrInstruction, constants: []IrConstant, start: int, end: int) -> X86Code {
    let mut constant_value = 0
    let mut have_constant = false
    let mut constant_result = -1
    let mut return_value = -1
    let mut i = start
    while i < end {
        let instruction = instructions[i]
        if instruction.op == IR_CONST {
            if instruction.aux < 0 or instruction.aux >= len(constants) {
                return x86_error(X86_UNSUPPORTED, "x86 IR constant index is invalid")
            }
            if instruction.type_kind != SEM_INT {
                return x86_error(X86_UNSUPPORTED, "x86 constant-return lowering requires int")
            }
            constant_value = constants[instruction.aux].int_value
            constant_result = instruction.result
            have_constant = true
        } else if instruction.op == IR_RETURN {
            return_value = instruction.left
        } else {
            return x86_error(X86_UNSUPPORTED, "x86 IR instruction is not implemented")
        }
        i = i + 1
    }
    if not have_constant or return_value < 0 or return_value != constant_result {
        return x86_error(X86_UNSUPPORTED, "x86 function has no constant return")
    }
    return x86_emit_return_int(constant_value)
}

fn x86_lower_const_add_return(instructions: []IrInstruction, constants: []IrConstant, start: int, end: int) -> X86Code {
    if end - start != 4 {
        return x86_error(X86_UNSUPPORTED, "x86 add lowering requires four instructions")
    }
    let left = instructions[start]
    let right = instructions[start + 1]
    let binary = instructions[start + 2]
    let returned = instructions[start + 3]
    if left.op != IR_CONST or right.op != IR_CONST or binary.op != IR_BINARY or returned.op != IR_RETURN {
        return x86_error(X86_UNSUPPORTED, "x86 add lowering has an invalid IR shape")
    }
    if left.aux < 0 or left.aux >= len(constants) or right.aux < 0 or right.aux >= len(constants) {
        return x86_error(X86_UNSUPPORTED, "x86 add constant index is invalid")
    }
    if left.type_kind != SEM_INT or right.type_kind != SEM_INT or binary.type_kind != SEM_INT or returned.left != binary.result {
        return x86_error(X86_UNSUPPORTED, "x86 add lowering has an invalid type or result")
    }
    if binary.left != left.result or binary.right != right.result or binary.aux != TK_PLUS {
        return x86_error(X86_UNSUPPORTED, "x86 add lowering has invalid operands")
    }
    return x86_emit_add_return(constants[left.aux].int_value, constants[right.aux].int_value)
}

// Validate one constant branch arm and return its constant pool index, or -1
// when the block is not exactly `IR_CONST int` followed by an edge carrying
// that constant. `edge_op` is IR_RETURN for a direct-return arm (no
// successors) or IR_JUMP for a merge arm (exactly one successor).
fn x86_branch_arm_constant(instructions: []IrInstruction, constants: []IrConstant, block: IrBlock, edge_op: int) -> int {
    if block.instruction_count != 2 or block.terminator != block.instruction_start + 1 {
        return -1
    }
    if block.instruction_start < 0 or block.terminator >= len(instructions) {
        return -1
    }
    if edge_op == IR_RETURN and block.successor_count != 0 {
        return -1
    }
    if edge_op == IR_JUMP and block.successor_count != 1 {
        return -1
    }
    let constant = instructions[block.instruction_start]
    let edge = instructions[block.terminator]
    if constant.op != IR_CONST or constant.type_kind != SEM_INT {
        return -1
    }
    if constant.aux < 0 or constant.aux >= len(constants) {
        return -1
    }
    if edge.op != edge_op or edge.left != constant.result {
        return -1
    }
    return constant.aux
}

// Classify a branch entry block: either a boolean parameter tested directly
// (compare stays false) or a signed comparison of an integer parameter
// against one constant. `false_jump` carries the short-jump opcode that
// selects the false arm; `error` is set when the entry is neither form.
struct X86Condition {
    compare: bool
    false_jump: int
    compare_value: int
    error: string
}

fn x86_branch_condition(instructions: []IrInstruction, constants: []IrConstant, entry: IrBlock) -> X86Condition {
    if entry.successor_count != 2 {
        return X86Condition { compare: false, false_jump: -1, compare_value: 0, error: "x86 branch entry must end in a two-way branch" }
    }
    if entry.instruction_start < 0 or entry.terminator >= len(instructions) {
        return X86Condition { compare: false, false_jump: -1, compare_value: 0, error: "x86 branch entry instructions are out of range" }
    }
    if entry.instruction_count == 2 and entry.terminator == entry.instruction_start + 1 {
        let parameter = instructions[entry.instruction_start]
        let branch = instructions[entry.terminator]
        if parameter.op != IR_PARAM or parameter.type_kind != SEM_BOOL {
            return X86Condition { compare: false, false_jump: -1, compare_value: 0, error: "x86 branch lowering requires one bool parameter" }
        }
        if branch.op != IR_BRANCH or branch.left != parameter.result {
            return X86Condition { compare: false, false_jump: -1, compare_value: 0, error: "x86 branch lowering requires a branch on the parameter" }
        }
        return X86Condition { compare: false, false_jump: 116, compare_value: 0, error: "" }
    }
    if entry.instruction_count == 4 and entry.terminator == entry.instruction_start + 3 {
        let parameter = instructions[entry.instruction_start]
        let operand = instructions[entry.instruction_start + 1]
        let compare = instructions[entry.instruction_start + 2]
        let branch = instructions[entry.terminator]
        if parameter.op != IR_PARAM or parameter.type_kind != SEM_INT {
            return X86Condition { compare: false, false_jump: -1, compare_value: 0, error: "x86 compare lowering requires one int parameter" }
        }
        if operand.op != IR_CONST or operand.type_kind != SEM_INT or operand.aux < 0 or operand.aux >= len(constants) {
            return X86Condition { compare: false, false_jump: -1, compare_value: 0, error: "x86 compare lowering requires an int constant operand" }
        }
        if compare.op != IR_BINARY or compare.type_kind != SEM_BOOL or
            compare.left != parameter.result or compare.right != operand.result {
            return X86Condition { compare: false, false_jump: -1, compare_value: 0, error: "x86 compare lowering requires a parameter-constant comparison" }
        }
        let false_jump = x86_compare_false_jump(compare.aux)
        if false_jump < 0 {
            return X86Condition { compare: false, false_jump: -1, compare_value: 0, error: "x86 compare operator is not implemented" }
        }
        if branch.op != IR_BRANCH or branch.left != compare.result {
            return X86Condition { compare: false, false_jump: -1, compare_value: 0, error: "x86 branch lowering requires a branch on the comparison" }
        }
        return X86Condition { compare: true, false_jump: false_jump, compare_value: constants[operand.aux].int_value, error: "" }
    }
    return X86Condition { compare: false, false_jump: -1, compare_value: 0, error: "x86 branch entry must hold one parameter and one branch" }
}

// Validate that two jump arms share one merge block returning its integer
// block parameter; return the merge block index or -1.
fn x86_branch_merge_index(instructions: []IrInstruction, blocks: []IrBlock, successors: []int, true_block: IrBlock, false_block: IrBlock) -> int {
    if true_block.successor_start < 0 or true_block.successor_start >= len(successors) or
        false_block.successor_start < 0 or false_block.successor_start >= len(successors) {
        return -1
    }
    let merge_index = successors[true_block.successor_start]
    if successors[false_block.successor_start] != merge_index {
        return -1
    }
    if merge_index < 0 or merge_index >= len(blocks) {
        return -1
    }
    let merge = blocks[merge_index]
    if merge.instruction_count != 2 or merge.successor_count != 0 or
        merge.terminator != merge.instruction_start + 1 {
        return -1
    }
    if merge.instruction_start < 0 or merge.terminator >= len(instructions) {
        return -1
    }
    let merged = instructions[merge.instruction_start]
    let returned = instructions[merge.terminator]
    if merged.op != IR_BLOCK_PARAM or merged.type_kind != SEM_INT or merged.aux != 0 {
        return -1
    }
    if returned.op != IR_RETURN or returned.left != merged.result {
        return -1
    }
    return merge_index
}

// Lower the verified CFG branch shapes into a conditional machine function:
// one parameter, an entry block ending in IR_BRANCH, and two arms that each
// produce one integer constant. Both verified forms are accepted: arms
// returning directly (three blocks) and arms jumping to a shared merge block
// that returns its block parameter (four blocks). The condition is either a
// boolean parameter (test edi, edi) or a signed comparison of an integer
// parameter against one constant (cmp rdi, imm). IR construction records the
// true (then) arm as the first successor; the encodings return the true arm
// when the condition holds, so the arms map in order.
fn x86_lower_branch_return(instructions: []IrInstruction, constants: []IrConstant, blocks: []IrBlock, successors: []int, function: IrFunction) -> X86Code {
    if function.parameter_count != 1 or (function.block_count != 3 and function.block_count != 4) {
        return x86_error(X86_UNSUPPORTED, "x86 branch lowering requires one parameter and three or four blocks")
    }
    if function.entry_block < 0 or function.entry_block >= len(blocks) {
        return x86_error(X86_UNSUPPORTED, "x86 branch entry block is out of range")
    }
    let entry = blocks[function.entry_block]
    let condition = x86_branch_condition(instructions, constants, entry)
    if condition.error != "" {
        return x86_error(X86_UNSUPPORTED, condition.error)
    }
    if entry.successor_start < 0 or entry.successor_start + 1 >= len(successors) {
        return x86_error(X86_UNSUPPORTED, "x86 branch successors are out of range")
    }
    let true_index = successors[entry.successor_start]
    let false_index = successors[entry.successor_start + 1]
    if true_index < 0 or true_index >= len(blocks) or false_index < 0 or false_index >= len(blocks) {
        return x86_error(X86_UNSUPPORTED, "x86 branch successor block is out of range")
    }
    let mut edge_op = IR_RETURN
    if function.block_count == 4 {
        edge_op = IR_JUMP
    }
    let true_constant = x86_branch_arm_constant(instructions, constants, blocks[true_index], edge_op)
    let false_constant = x86_branch_arm_constant(instructions, constants, blocks[false_index], edge_op)
    if true_constant < 0 or false_constant < 0 {
        return x86_error(X86_UNSUPPORTED, "x86 branch arms must produce integer constants")
    }
    if function.block_count == 4 {
        if x86_branch_merge_index(instructions, blocks, successors, blocks[true_index], blocks[false_index]) < 0 {
            return x86_error(X86_UNSUPPORTED, "x86 branch merge block has an invalid shape")
        }
    }
    if condition.compare {
        return x86_emit_compare_return(constants[false_constant].int_value, constants[true_constant].int_value, condition.false_jump, condition.compare_value)
    }
    return x86_emit_select_return(constants[false_constant].int_value, constants[true_constant].int_value)
}

// Classify one branch arm that returns directly: an integer constant return
// (kind 1), a one-argument constant call return (kind 2), a zero-argument
// call return (kind 3), or a two-argument constant call return (kind 4).
// Kind 0 means the arm is none of these.
struct X86Arm {
    kind: int
    constant: int
    constant2: int
    callee: int
}

fn x86_branch_arm(instructions: []IrInstruction, constants: []IrConstant, block: IrBlock, call_sites: []IrCallSite, call_arguments: []int, functions: []IrFunction, edge_op: int) -> X86Arm {
    let start = block.instruction_start
    let mut expected_successors = 0
    if edge_op == IR_JUMP {
        expected_successors = 1
    }
    if block.successor_count != expected_successors or block.terminator != start + block.instruction_count - 1 or
        start < 0 or block.terminator >= len(instructions) {
        return X86Arm { kind: 0, constant: -1, constant2: -1, callee: -1 }
    }
    if block.instruction_count == 2 {
        let first = instructions[start]
        let returned = instructions[start + 1]
        if returned.op == edge_op and returned.left == first.result {
            if first.op == IR_CONST and first.type_kind == SEM_INT and
                first.aux >= 0 and first.aux < len(constants) {
                return X86Arm { kind: 1, constant: first.aux, constant2: -1, callee: -1 }
            }
            if first.op == IR_CALL and first.type_kind == SEM_INT and
                first.aux >= 0 and first.aux < len(call_sites) {
                let site = call_sites[first.aux]
                let callee = x86_find_callee(functions, site.callee_item)
                if site.argument_count == 0 and callee >= 0 {
                    return X86Arm { kind: 3, constant: -1, constant2: -1, callee: callee }
                }
            }
        }
    }
    if block.instruction_count == 3 {
        let constant = instructions[start]
        let call = instructions[start + 1]
        let returned = instructions[start + 2]
        if constant.op == IR_CONST and constant.type_kind == SEM_INT and
            constant.aux >= 0 and constant.aux < len(constants) and
            call.op == IR_CALL and call.type_kind == SEM_INT and
            call.aux >= 0 and call.aux < len(call_sites) and
            returned.op == edge_op and returned.left == call.result {
            let site = call_sites[call.aux]
            let callee = x86_find_callee(functions, site.callee_item)
            if site.argument_count == 1 and site.argument_start >= 0 and
                site.argument_start < len(call_arguments) and
                call_arguments[site.argument_start] == constant.result and callee >= 0 {
                return X86Arm { kind: 2, constant: constant.aux, constant2: -1, callee: callee }
            }
        }
    }
    if block.instruction_count == 4 {
        let first = instructions[start]
        let second = instructions[start + 1]
        let call = instructions[start + 2]
        let returned = instructions[start + 3]
        if first.op == IR_CONST and first.type_kind == SEM_INT and
            first.aux >= 0 and first.aux < len(constants) and
            second.op == IR_CONST and second.type_kind == SEM_INT and
            second.aux >= 0 and second.aux < len(constants) and
            call.op == IR_CALL and call.type_kind == SEM_INT and
            call.aux >= 0 and call.aux < len(call_sites) and
            returned.op == edge_op and returned.left == call.result {
            let site = call_sites[call.aux]
            let callee = x86_find_callee(functions, site.callee_item)
            if site.argument_count == 2 and site.argument_start >= 0 and
                site.argument_start + 1 < len(call_arguments) and
                call_arguments[site.argument_start] == first.result and
                call_arguments[site.argument_start + 1] == second.result and callee >= 0 {
                return X86Arm { kind: 4, constant: first.aux, constant2: second.aux, callee: callee }
            }
        }
    }
    return X86Arm { kind: 0, constant: -1, constant2: -1, callee: -1 }
}

// Append one emitter's bytes to an output stream.
fn x86_append_code(bytes: []int, code: X86Code) -> []int {
    let mut out = bytes
    let mut i = 0
    while i < len(code.bytes) {
        out = append(out, code.bytes[i])
        i = i + 1
    }
    return out
}

// Offset of the call displacement field within an emitted arm body, by arm
// kind (1: no call; 2: one-argument call; 3: zero-argument call; 4:
// two-argument call).
fn x86_arm_disp_offset(kind: int) -> int {
    if kind == 2 { return 6 }
    if kind == 3 { return 1 }
    if kind == 4 { return 11 }
    return -1
}

// Emit one branch arm body: constant, zero/one/two-argument call. The tail
// mode picks the terminator: 0 = ret (value in eax), 1 = none (the caller
// appends a merge jump), 2 = leave; ret (arm inside a stack frame). Call
// displacement fields are patched after layout.
fn x86_emit_arm(kind: int, value: int, value2: int, tail: int) -> X86Code {
    if value < 0 or value > 4294967295 or value2 < 0 or value2 > 4294967295 {
        return x86_error(X86_RANGE, "x86 branch arm operand is out of range")
    }
    let mut bytes: []int = make([]int, 0, 17)
    if kind == 1 {
        bytes = append(bytes, 184)
        bytes = x86_emit_u32(bytes, value)
    } else if kind == 2 {
        bytes = append(bytes, 191)
        bytes = x86_emit_u32(bytes, value)
        bytes = append(bytes, 232)
        bytes = x86_emit_u32(bytes, 0)
    } else if kind == 3 {
        bytes = append(bytes, 232)
        bytes = x86_emit_u32(bytes, 0)
    } else if kind == 4 {
        bytes = append(bytes, 191)
        bytes = x86_emit_u32(bytes, value)
        bytes = append(bytes, 190)
        bytes = x86_emit_u32(bytes, value2)
        bytes = append(bytes, 232)
        bytes = x86_emit_u32(bytes, 0)
    } else {
        return x86_error(X86_UNSUPPORTED, "x86 branch arm kind is not implemented")
    }
    if tail == 0 {
        bytes = append(bytes, 195)
    }
    if tail == 2 {
        bytes = append(bytes, 201)
        bytes = append(bytes, 195)
    }
    return X86Code { bytes: bytes, status: X86_OK, error: "" }
}

// Lower the three-block branch shape whose arms return directly but may call:
// entry condition, a near jcc to the false arm, then both arms in order. The
// jcc displacement equals the true arm's length; call displacements are
// patched after layout through the usual X86Body edges.
fn x86_lower_branch_call_return(instructions: []IrInstruction, constants: []IrConstant, blocks: []IrBlock, successors: []int, call_sites: []IrCallSite, call_arguments: []int, functions: []IrFunction, function: IrFunction) -> X86Body {
    if function.parameter_count != 1 or (function.block_count != 3 and function.block_count != 4) {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 branch-call lowering requires one parameter and three or four blocks"))
    }
    if function.entry_block < 0 or function.entry_block >= len(blocks) {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 branch entry block is out of range"))
    }
    let entry = blocks[function.entry_block]
    let condition = x86_branch_condition(instructions, constants, entry)
    if condition.error != "" {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, condition.error))
    }
    if condition.compare and (condition.compare_value < -2147483648 or condition.compare_value > 2147483647) {
        return x86_plain_body(x86_error(X86_RANGE, "x86 compare immediate is out of range"))
    }
    if entry.successor_start < 0 or entry.successor_start + 1 >= len(successors) {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 branch successors are out of range"))
    }
    let true_index = successors[entry.successor_start]
    let false_index = successors[entry.successor_start + 1]
    if true_index < 0 or true_index >= len(blocks) or false_index < 0 or false_index >= len(blocks) {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 branch successor block is out of range"))
    }
    let mut edge_op = IR_RETURN
    if function.block_count == 4 {
        edge_op = IR_JUMP
    }
    let true_arm = x86_branch_arm(instructions, constants, blocks[true_index], call_sites, call_arguments, functions, edge_op)
    let false_arm = x86_branch_arm(instructions, constants, blocks[false_index], call_sites, call_arguments, functions, edge_op)
    if true_arm.kind == 0 or false_arm.kind == 0 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 branch-call arms must return constants or call results"))
    }
    if function.block_count == 4 and
        x86_branch_merge_index(instructions, blocks, successors, blocks[true_index], blocks[false_index]) < 0 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 branch-call merge block has an invalid shape"))
    }
    let mut bytes: []int = make([]int, 0, 35)
    if condition.compare {
        bytes = append(bytes, 72)
        bytes = append(bytes, 129)
        bytes = append(bytes, 255)
        bytes = x86_emit_u32(bytes, condition.compare_value)
    } else {
        bytes = append(bytes, 133)
        bytes = append(bytes, 255)
    }
    bytes = append(bytes, 15)
    bytes = append(bytes, condition.false_jump + 16)
    let jcc_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    let entry_len = len(bytes)
    let merging = function.block_count == 4
    let true_code = x86_emit_arm(
        true_arm.kind,
        if true_arm.constant >= 0 { constants[true_arm.constant].int_value } else { 0 },
        if true_arm.constant2 >= 0 { constants[true_arm.constant2].int_value } else { 0 },
        if merging { 1 } else { 0 }
    )
    if true_code.status != X86_OK {
        return x86_plain_body(true_code)
    }
    let mut true_field = x86_arm_disp_offset(true_arm.kind)
    if true_field >= 0 {
        true_field = true_field + len(bytes)
    }
    bytes = x86_append_code(bytes, true_code)
    let mut jmp_field = -1
    if merging {
        bytes = append(bytes, 233)
        jmp_field = len(bytes)
        bytes = x86_emit_u32(bytes, 0)
    }
    bytes = x86_patch_u32(bytes, jcc_field, len(bytes) - entry_len)
    let false_code = x86_emit_arm(
        false_arm.kind,
        if false_arm.constant >= 0 { constants[false_arm.constant].int_value } else { 0 },
        if false_arm.constant2 >= 0 { constants[false_arm.constant2].int_value } else { 0 },
        if merging { 1 } else { 0 }
    )
    if false_code.status != X86_OK {
        return x86_plain_body(false_code)
    }
    let mut false_field = x86_arm_disp_offset(false_arm.kind)
    if false_field >= 0 {
        false_field = false_field + len(bytes)
    }
    bytes = x86_append_code(bytes, false_code)
    if merging {
        bytes = x86_patch_u32(bytes, jmp_field, len(bytes) - (jmp_field + 4))
        bytes = append(bytes, 195)
    }
    let mut edge_callees: []int = make([]int, 0, 2)
    let mut edge_fields: []int = make([]int, 0, 2)
    if true_arm.callee >= 0 {
        edge_callees = append(edge_callees, true_arm.callee)
        edge_fields = append(edge_fields, true_field)
    }
    if false_arm.callee >= 0 {
        edge_callees = append(edge_callees, false_arm.callee)
        edge_fields = append(edge_fields, false_field)
    }
    return X86Body {
        code: X86Code { bytes: bytes, status: X86_OK, error: "" },
        edge_callees: edge_callees, edge_fields: edge_fields,
    }
}

// Lower a branch function whose entry block computes: a scalar prefix (the
// same instructions as straight-line bodies), then either a comparison of two
// earlier values fused with the branch, or a direct test of an earlier
// boolean value. Arms are the usual four kinds, framed with leave; ret
// (three-block form) or a merge jump and a shared leave; ret (four-block
// form). This is the general form behind the tighter parameter-only entries.
fn x86_lower_branch_scalar_entry(instructions: []IrInstruction, constants: []IrConstant, blocks: []IrBlock, successors: []int, call_sites: []IrCallSite, call_arguments: []int, jump_arguments: []int, functions: []IrFunction, function: IrFunction, string_literals: []string, constant_string_index: []int) -> X86Body {
    if function.parameter_count < 0 or function.parameter_count > 15 or
        (function.block_count != 3 and function.block_count != 4) or
        function.value_start < 0 or function.value_count < 1 or function.value_count > 127 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar-entry branch requires at most fifteen parameters, three or four blocks, and 127 values"))
    }
    if function.entry_block < 0 or function.entry_block >= len(blocks) {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 branch entry block is out of range"))
    }
    let entry = blocks[function.entry_block]
    if entry.successor_count != 2 or entry.instruction_start < 0 or
        entry.terminator >= len(instructions) or entry.instruction_count < 2 or
        entry.terminator != entry.instruction_start + entry.instruction_count - 1 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar-entry branch entry has an invalid shape"))
    }
    let branch = instructions[entry.terminator]
    if branch.op != IR_BRANCH {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar-entry branch must end in a branch"))
    }
    let condition_slot = branch.left - function.value_start + 1
    if condition_slot < 1 or condition_slot > function.value_count {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar-entry branch condition is invalid"))
    }
    let mut fused = false
    let mut false_jump = 116
    if entry.instruction_count >= 3 {
        let candidate = instructions[entry.terminator - 1]
        if candidate.op == IR_BINARY and candidate.type_kind == SEM_BOOL and candidate.result == branch.left {
            false_jump = x86_compare_false_jump(candidate.aux)
            if false_jump < 0 {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 compare operator is not implemented"))
            }
            fused = true
        }
    }
    if entry.successor_start < 0 or entry.successor_start + 1 >= len(successors) {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 branch successors are out of range"))
    }
    let true_index = successors[entry.successor_start]
    let false_index = successors[entry.successor_start + 1]
    if true_index < 0 or true_index >= len(blocks) or false_index < 0 or false_index >= len(blocks) {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 branch successor block is out of range"))
    }
    let mut edge_op = IR_RETURN
    if function.block_count == 4 {
        edge_op = IR_JUMP
    }
    let true_arm = x86_branch_arm(instructions, constants, blocks[true_index], call_sites, call_arguments, functions, edge_op)
    let false_arm = x86_branch_arm(instructions, constants, blocks[false_index], call_sites, call_arguments, functions, edge_op)
    if true_arm.kind == 0 or false_arm.kind == 0 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 branch-call arms must return constants or call results"))
    }
    if function.block_count == 4 and
        x86_branch_merge_index(instructions, blocks, successors, blocks[true_index], blocks[false_index]) < 0 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 branch-call merge block has an invalid shape"))
    }
    let mut bytes: []int = make([]int, 0, 64)
    bytes = x86_emit_frame_prologue_sized(bytes, (8 * function.value_count + 15) & 4294967280)
    let prologue_len = len(bytes)
    let mut prefix_end = entry.terminator
    if fused {
        prefix_end = entry.terminator - 1
    }
    let segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        entry.instruction_start, prefix_end, false
    , string_literals, constant_string_index)
    if segment.code.status != X86_OK {
        return x86_plain_body(segment.code)
    }
    bytes = x86_append_code(bytes, segment.code)
    if fused {
        let compare = instructions[entry.terminator - 1]
        let left_slot = compare.left - function.value_start + 1
        let right_slot = compare.right - function.value_start + 1
        if left_slot < 1 or left_slot >= condition_slot or right_slot < 1 or right_slot >= condition_slot {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 scalar-entry compare operand is not an earlier value"))
        }
        bytes = x86_emit_load_rax(bytes, left_slot)
        bytes = x86_emit_cmp_mem(bytes, right_slot)
    } else {
        bytes = x86_emit_load_rax(bytes, condition_slot)
        bytes = append(bytes, 72)
        bytes = append(bytes, 133)
        bytes = append(bytes, 192)
    }
    bytes = append(bytes, 15)
    bytes = append(bytes, false_jump + 16)
    let jcc_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    let entry_len = len(bytes)
    let merging = function.block_count == 4
    let mut arm_tail = 2
    if merging {
        arm_tail = 1
    }
    let true_code = x86_emit_arm(
        true_arm.kind,
        if true_arm.constant >= 0 { constants[true_arm.constant].int_value } else { 0 },
        if true_arm.constant2 >= 0 { constants[true_arm.constant2].int_value } else { 0 },
        arm_tail
    )
    if true_code.status != X86_OK {
        return x86_plain_body(true_code)
    }
    let mut true_field = x86_arm_disp_offset(true_arm.kind)
    if true_field >= 0 {
        true_field = true_field + len(bytes)
    }
    bytes = x86_append_code(bytes, true_code)
    let mut jmp_field = -1
    if merging {
        bytes = append(bytes, 233)
        jmp_field = len(bytes)
        bytes = x86_emit_u32(bytes, 0)
    }
    bytes = x86_patch_u32(bytes, jcc_field, len(bytes) - entry_len)
    let false_code = x86_emit_arm(
        false_arm.kind,
        if false_arm.constant >= 0 { constants[false_arm.constant].int_value } else { 0 },
        if false_arm.constant2 >= 0 { constants[false_arm.constant2].int_value } else { 0 },
        arm_tail
    )
    if false_code.status != X86_OK {
        return x86_plain_body(false_code)
    }
    let mut false_field = x86_arm_disp_offset(false_arm.kind)
    if false_field >= 0 {
        false_field = false_field + len(bytes)
    }
    bytes = x86_append_code(bytes, false_code)
    if merging {
        bytes = x86_patch_u32(bytes, jmp_field, len(bytes) - (jmp_field + 4))
        bytes = append(bytes, 201)
        bytes = append(bytes, 195)
    }
    let mut edge_callees = segment.edge_callees
    let mut edge_fields: []int = make([]int, 0, len(segment.edge_fields) + 2)
    let mut segment_field_index = 0
    while segment_field_index < len(segment.edge_fields) {
        edge_fields = append(edge_fields, segment.edge_fields[segment_field_index] + prologue_len)
        segment_field_index = segment_field_index + 1
    }
    if true_arm.callee >= 0 {
        edge_callees = append(edge_callees, true_arm.callee)
        edge_fields = append(edge_fields, true_field)
    }
    if false_arm.callee >= 0 {
        edge_callees = append(edge_callees, false_arm.callee)
        edge_fields = append(edge_fields, false_field)
    }
    return X86Body {
        code: X86Code { bytes: bytes, status: X86_OK, error: "" },
        edge_callees: edge_callees, edge_fields: edge_fields,
    }
}

// Detect a loop backedge: a block whose jump terminator targets an earlier
// block of the same function. Checked before the branch lowering so the
// four-block merge-if shape (whose jumps only target later blocks) is
// unaffected.
fn x86_function_has_backedge(instructions: []IrInstruction, blocks: []IrBlock, successors: []int, function: IrFunction) -> bool {
    let mut index = function.entry_block
    while index >= 0 and index < function.entry_block + function.block_count and index < len(blocks) {
        let block = blocks[index]
        if block.terminator >= 0 and block.terminator < len(instructions) and
            instructions[block.terminator].op == IR_JUMP and block.successor_count == 1 and
            block.successor_start >= 0 and block.successor_start < len(successors) and
            successors[block.successor_start] < index {
            return true
        }
        index = index + 1
    }
    return false
}

// Lower the verified four-block while-loop shape: an entry block that jumps
// to a header carrying one or more integer block parameters, a header that
// ends in a conditional branch to the body or the exit, a body that jumps
// back to the header, and an exit block that returns. The slot-per-value
// model makes the block parameters concrete: each jump copies its argument
// slots into the parameter slots, so the header simply reads its own slots.
// With more than one parameter the copies go through per-jump scratch slots
// appended after the value slots, so an argument that still lives in another
// parameter's slot cannot be clobbered by an earlier copy (parallel-copy
// safety); a single parameter keeps the direct copy. The condition reuses
// the fused compare (or boolean test) of the scalar-entry branch lowering;
// the exit falls through to the usual scalar return sequence.
fn x86_lower_loop(instructions: []IrInstruction, constants: []IrConstant, blocks: []IrBlock, successors: []int, call_sites: []IrCallSite, call_arguments: []int, jump_arguments: []int, functions: []IrFunction, function: IrFunction, entry_params: int, prologue_done: bool, string_literals: []string, constant_string_index: []int) -> X86Body {
    if function.parameter_count < 0 or function.parameter_count > 15 or function.block_count != 4 or
        function.value_start < 0 or function.value_count < 1 or function.value_count > 127 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop lowering requires at most fifteen parameters, four blocks, and 127 values"))
    }
    if function.entry_block < 0 or function.entry_block + 3 >= len(blocks) {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop blocks are out of range"))
    }
    let entry = blocks[function.entry_block]
    let header = blocks[function.entry_block + 1]
    let body = blocks[function.entry_block + 2]
    let exit = blocks[function.entry_block + 3]
    if entry.instruction_start < 0 or entry.instruction_count < 1 or
        entry.terminator != entry.instruction_start + entry.instruction_count - 1 or
        header.instruction_start < 0 or header.instruction_count < 2 or
        header.terminator != header.instruction_start + header.instruction_count - 1 or
        body.instruction_start < 0 or body.instruction_count < 1 or
        body.terminator != body.instruction_start + body.instruction_count - 1 or
        exit.instruction_start < 0 or exit.instruction_count < 1 or
        exit.terminator != exit.instruction_start + exit.instruction_count - 1 or
        exit.terminator >= len(instructions) {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop blocks have an invalid instruction range"))
    }
    if entry.successor_count != 1 or header.successor_count != 2 or
        body.successor_count != 1 or exit.successor_count != 0 or
        entry.successor_start < 0 or entry.successor_start >= len(successors) or
        header.successor_start < 0 or header.successor_start + 1 >= len(successors) or
        body.successor_start < 0 or body.successor_start >= len(successors) {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop successors are out of range"))
    }
    if successors[entry.successor_start] != function.entry_block + 1 or
        successors[header.successor_start] != function.entry_block + 2 or
        successors[header.successor_start + 1] != function.entry_block + 3 or
        successors[body.successor_start] != function.entry_block + 1 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop successors do not form a loop"))
    }
    let entry_jump = instructions[entry.terminator]
    let header_branch = instructions[header.terminator]
    let body_jump = instructions[body.terminator]
    let exit_return = instructions[exit.terminator]
    // Leading integer block parameters at the header: one per carried local.
    let mut parameter_count = 0
    let mut parameter_scan = header.instruction_start
    while parameter_scan < header.terminator and
        instructions[parameter_scan].op == IR_BLOCK_PARAM and
        instructions[parameter_scan].type_kind == SEM_INT and instructions[parameter_scan].aux == 0 {
        parameter_count = parameter_count + 1
        parameter_scan = parameter_scan + 1
    }
    if parameter_count < 1 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop header must start with an integer block parameter"))
    }
    if header_branch.op != IR_BRANCH or header_branch.left < 0 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop header must end in a branch"))
    }
    if exit_return.op != IR_RETURN or exit_return.left < 0 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop exit must return"))
    }
    let mut entry_arguments: []int = make([]int, 0, parameter_count)
    let mut body_arguments: []int = make([]int, 0, parameter_count)
    if parameter_count == 1 {
        if entry_jump.op != IR_JUMP or entry_jump.left < 0 or entry_jump.type_kind != SEM_INT {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop entry must jump with an integer argument"))
        }
        if body_jump.op != IR_JUMP or body_jump.left < 0 or body_jump.type_kind != SEM_INT {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop body must jump back with an integer argument"))
        }
        entry_arguments = append(entry_arguments, entry_jump.left)
        body_arguments = append(body_arguments, body_jump.left)
    } else {
        if entry_jump.op != IR_JUMP or entry_jump.left >= 0 or entry_jump.aux < 0 or
            entry_jump.aux + parameter_count > len(jump_arguments) {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop entry must jump with matching integer arguments"))
        }
        if body_jump.op != IR_JUMP or body_jump.left >= 0 or body_jump.aux < 0 or
            body_jump.aux + parameter_count > len(jump_arguments) {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop body must jump back with matching integer arguments"))
        }
        let mut argument_index = 0
        while argument_index < parameter_count {
            entry_arguments = append(entry_arguments, jump_arguments[entry_jump.aux + argument_index])
            body_arguments = append(body_arguments, jump_arguments[body_jump.aux + argument_index])
            argument_index = argument_index + 1
        }
    }
    let condition_slot = header_branch.left - function.value_start + 1
    if condition_slot < 1 or condition_slot > function.value_count {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop slot is out of range"))
    }
    let mut parameter_slots: []int = make([]int, 0, parameter_count)
    let mut entry_slots: []int = make([]int, 0, parameter_count)
    let mut body_slots: []int = make([]int, 0, parameter_count)
    let mut slot_index = 0
    while slot_index < parameter_count {
        let parameter_slot = instructions[header.instruction_start + slot_index].result - function.value_start + 1
        let entry_slot = entry_arguments[slot_index] - function.value_start + 1
        let body_slot = body_arguments[slot_index] - function.value_start + 1
        if parameter_slot < 1 or parameter_slot > function.value_count or
            entry_slot < 1 or entry_slot > function.value_count or
            body_slot < 1 or body_slot > function.value_count {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop slot is out of range"))
        }
        parameter_slots = append(parameter_slots, parameter_slot)
        entry_slots = append(entry_slots, entry_slot)
        body_slots = append(body_slots, body_slot)
        slot_index = slot_index + 1
    }
    // Multi-parameter jumps reserve one scratch slot per argument after the
    // value slots; the frame prologue and disp8 slot encoding cap the total.
    let mut slot_count = function.value_count
    if parameter_count > 1 {
        slot_count = slot_count + parameter_count
    }
    if slot_count > 127 {
        return x86_plain_body(x86_error(X86_RANGE, "x86 loop value and scratch slots exceed the stack frame"))
    }
    let mut fused = false
    let mut false_jump = 116
    if header.instruction_count >= 3 {
        let candidate = instructions[header.terminator - 1]
        if candidate.op == IR_BINARY and candidate.type_kind == SEM_BOOL and candidate.result == header_branch.left {
            false_jump = x86_compare_false_jump(candidate.aux)
            if false_jump < 0 {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 compare operator is not implemented"))
            }
            fused = true
        }
    }
    let mut prefix_end = header.terminator
    if fused {
        prefix_end = header.terminator - 1
    }
    let mut bytes: []int = make([]int, 0, 96)
    if not prologue_done {
        bytes = x86_emit_frame_prologue_sized(bytes, (8 * slot_count + 15) & 4294967280)
    }
    let mut edge_callees: []int = make([]int, 0, 2)
    let mut edge_fields: []int = make([]int, 0, 2)
    if entry_params < 0 or entry.instruction_start + entry_params > entry.terminator {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop entry parameters are out of range"))
    }
    let mut entry_param_index = 0
    while entry_param_index < entry_params {
        let entry_param = instructions[entry.instruction_start + entry_param_index]
        if entry_param.op != IR_BLOCK_PARAM or entry_param.type_kind != SEM_INT or entry_param.aux != 0 {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop entry parameters must be integer block parameters"))
        }
        entry_param_index = entry_param_index + 1
    }
    let entry_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        entry.instruction_start + entry_params, entry.terminator, false
    , string_literals, constant_string_index)
    if entry_segment.code.status != X86_OK {
        return x86_plain_body(entry_segment.code)
    }
    let entry_segment_offset = len(bytes)
    bytes = x86_append_code(bytes, entry_segment.code)
    let mut segment_field_index = 0
    while segment_field_index < len(entry_segment.edge_fields) {
        edge_callees = append(edge_callees, entry_segment.edge_callees[segment_field_index])
        edge_fields = append(edge_fields, entry_segment.edge_fields[segment_field_index] + entry_segment_offset)
        segment_field_index = segment_field_index + 1
    }
    if parameter_count == 1 {
        bytes = x86_emit_load_rax(bytes, entry_slots[0])
        bytes = x86_emit_store_rax(bytes, parameter_slots[0])
    } else {
        // Parallel copy through the scratch slots: every argument lands in
        // its own scratch slot before any parameter slot is overwritten.
        let mut copy_index = 0
        while copy_index < parameter_count {
            bytes = x86_emit_load_rax(bytes, entry_slots[copy_index])
            bytes = x86_emit_store_rax(bytes, function.value_count + 1 + copy_index)
            copy_index = copy_index + 1
        }
        copy_index = 0
        while copy_index < parameter_count {
            bytes = x86_emit_load_rax(bytes, function.value_count + 1 + copy_index)
            bytes = x86_emit_store_rax(bytes, parameter_slots[copy_index])
            copy_index = copy_index + 1
        }
    }
    bytes = append(bytes, 233)
    let entry_jump_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    let header_offset = len(bytes)
    let header_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        header.instruction_start + parameter_count, prefix_end, false
    , string_literals, constant_string_index)
    if header_segment.code.status != X86_OK {
        return x86_plain_body(header_segment.code)
    }
    let header_segment_offset = len(bytes)
    bytes = x86_append_code(bytes, header_segment.code)
    segment_field_index = 0
    while segment_field_index < len(header_segment.edge_fields) {
        edge_callees = append(edge_callees, header_segment.edge_callees[segment_field_index])
        edge_fields = append(edge_fields, header_segment.edge_fields[segment_field_index] + header_segment_offset)
        segment_field_index = segment_field_index + 1
    }
    if fused {
        let compare = instructions[header.terminator - 1]
        let left_slot = compare.left - function.value_start + 1
        let right_slot = compare.right - function.value_start + 1
        if left_slot < 1 or left_slot >= condition_slot or right_slot < 1 or right_slot >= condition_slot {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop compare operand is not an earlier value"))
        }
        bytes = x86_emit_load_rax(bytes, left_slot)
        bytes = x86_emit_cmp_mem(bytes, right_slot)
    } else {
        bytes = x86_emit_load_rax(bytes, condition_slot)
        bytes = append(bytes, 72)
        bytes = append(bytes, 133)
        bytes = append(bytes, 192)
    }
    bytes = append(bytes, 15)
    bytes = append(bytes, false_jump + 16)
    let exit_jcc_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    let body_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        body.instruction_start, body.terminator, false
    , string_literals, constant_string_index)
    if body_segment.code.status != X86_OK {
        return x86_plain_body(body_segment.code)
    }
    let body_segment_offset = len(bytes)
    bytes = x86_append_code(bytes, body_segment.code)
    segment_field_index = 0
    while segment_field_index < len(body_segment.edge_fields) {
        edge_callees = append(edge_callees, body_segment.edge_callees[segment_field_index])
        edge_fields = append(edge_fields, body_segment.edge_fields[segment_field_index] + body_segment_offset)
        segment_field_index = segment_field_index + 1
    }
    if parameter_count == 1 {
        bytes = x86_emit_load_rax(bytes, body_slots[0])
        bytes = x86_emit_store_rax(bytes, parameter_slots[0])
    } else {
        let mut copy_index = 0
        while copy_index < parameter_count {
            bytes = x86_emit_load_rax(bytes, body_slots[copy_index])
            bytes = x86_emit_store_rax(bytes, function.value_count + 1 + copy_index)
            copy_index = copy_index + 1
        }
        copy_index = 0
        while copy_index < parameter_count {
            bytes = x86_emit_load_rax(bytes, function.value_count + 1 + copy_index)
            bytes = x86_emit_store_rax(bytes, parameter_slots[copy_index])
            copy_index = copy_index + 1
        }
    }
    bytes = append(bytes, 233)
    let back_jump_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    bytes = x86_patch_u32(bytes, back_jump_field, header_offset - (back_jump_field + 4))
    let exit_offset = len(bytes)
    bytes = x86_patch_u32(bytes, entry_jump_field, header_offset - (entry_jump_field + 4))
    bytes = x86_patch_u32(bytes, exit_jcc_field, exit_offset - (exit_jcc_field + 4))
    let exit_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        exit.instruction_start, exit.instruction_start + exit.instruction_count, true
    , string_literals, constant_string_index)
    if exit_segment.code.status != X86_OK {
        return x86_plain_body(exit_segment.code)
    }
    let exit_segment_offset = len(bytes)
    bytes = x86_append_code(bytes, exit_segment.code)
    segment_field_index = 0
    while segment_field_index < len(exit_segment.edge_fields) {
        edge_callees = append(edge_callees, exit_segment.edge_callees[segment_field_index])
        edge_fields = append(edge_fields, exit_segment.edge_fields[segment_field_index] + exit_segment_offset)
        segment_field_index = segment_field_index + 1
    }
    return X86Body {
        code: X86Code { bytes: bytes, status: X86_OK, error: "" },
        edge_callees: edge_callees, edge_fields: edge_fields,
    }
}

// Collect the scalar-segment call edges of one loop block, rebasing the
// segment-relative displacement fields to body coordinates.
fn x86_loop_collect_edges(segment: X86Body, offset: int, edge_callees: []int, edge_fields: []int) -> X86Edges {
    let mut out_callees = edge_callees
    let mut out_fields = edge_fields
    let mut field_index = 0
    while field_index < len(segment.edge_fields) {
        out_callees = append(out_callees, segment.edge_callees[field_index])
        out_fields = append(out_fields, segment.edge_fields[field_index] + offset)
        field_index = field_index + 1
    }
    return X86Edges { callees: out_callees, fields: out_fields }
}

// The true-polarity twin of a false-jump opcode-2 byte: jcc opcodes pair by
// the low bit (jle/jg, jge/jl, ...), so flip it arithmetically.
fn x86_true_jump_byte(false_byte: int) -> int {
    if false_byte % 2 == 0 { return false_byte + 1 }
    return false_byte - 1
}

// Lower the verified seven-block guarded-loop shape: entry, header, pre-guard
// updates, guard, post-guard updates, arm, exit. The arm is a break (plain
// jump to the exit) or a continue (jump back to the header carrying each
// local's value as of the guard). Copies follow the same rules as the plain
// loop lowering: direct for one parameter, scratch slots beyond.
fn x86_lower_guarded_loop(instructions: []IrInstruction, constants: []IrConstant, blocks: []IrBlock, successors: []int, call_sites: []IrCallSite, call_arguments: []int, jump_arguments: []int, functions: []IrFunction, function: IrFunction, entry_params: int, prologue_done: bool, string_literals: []string, constant_string_index: []int) -> X86Body {
    if function.parameter_count < 0 or function.parameter_count > 15 or
        (function.block_count != 7 and function.block_count != 8) or
        function.value_start < 0 or function.value_count < 1 or function.value_count > 127 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop requires at most fifteen parameters, seven or eight blocks, and 127 values"))
    }
    if function.entry_block < 0 or function.entry_block + function.block_count - 1 >= len(blocks) {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop blocks are out of range"))
    }
    let breaking = function.block_count == 8
    let entry = blocks[function.entry_block]
    let header = blocks[function.entry_block + 1]
    let pre = blocks[function.entry_block + 2]
    let guard = blocks[function.entry_block + 3]
    let post = blocks[function.entry_block + 4]
    let arm = blocks[function.entry_block + 5]
    let trampoline = blocks[function.entry_block + 6]
    let exit = blocks[function.entry_block + function.block_count - 1]
    let mut shape_index = 0
    let mut shape_ok = true
    while shape_index < function.block_count {
        let block = blocks[function.entry_block + shape_index]
        if block.instruction_start < 0 or block.instruction_count < 1 or
            block.terminator != block.instruction_start + block.instruction_count - 1 or
            block.terminator >= len(instructions) or block.successor_start < 0 or
            block.successor_start + block.successor_count > len(successors) {
            shape_ok = false
        }
        shape_index = shape_index + 1
    }
    if not shape_ok {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop blocks have an invalid instruction range"))
    }
    if entry.successor_count != 1 or header.successor_count != 2 or pre.successor_count != 1 or
        guard.successor_count != 2 or post.successor_count != 1 or arm.successor_count != 1 or
        exit.successor_count != 0 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop successors are out of range"))
    }
    if successors[entry.successor_start] != function.entry_block + 1 or
        successors[header.successor_start] != function.entry_block + 2 or
        successors[header.successor_start + 1] != function.entry_block + 6 or
        successors[pre.successor_start] != function.entry_block + 3 or
        successors[guard.successor_start] != function.entry_block + 5 or
        successors[guard.successor_start + 1] != function.entry_block + 4 or
        successors[post.successor_start] != function.entry_block + 1 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop successors do not form a guarded loop"))
    }
    let continuing = successors[arm.successor_start] == function.entry_block + 1
    if continuing != not breaking {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop arm must jump to the header or the exit"))
    }
    if breaking {
        if trampoline.successor_count != 1 or successors[trampoline.successor_start] != function.entry_block + 7 or
            successors[arm.successor_start] != function.entry_block + 7 {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop break edges must reach the exit"))
        }
    }
    let entry_jump = instructions[entry.terminator]
    let header_branch = instructions[header.terminator]
    let guard_branch = instructions[guard.terminator]
    let post_jump = instructions[post.terminator]
    let arm_jump = instructions[arm.terminator]
    let exit_return = instructions[exit.terminator]
    if header_branch.op != IR_BRANCH or header_branch.left < 0 or
        guard_branch.op != IR_BRANCH or guard_branch.left < 0 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop branches are invalid"))
    }
    if exit_return.op != IR_RETURN or exit_return.left < 0 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop exit must return"))
    }
    // Leading integer block parameters at the header: one per carried local.
    let mut parameter_count = 0
    let mut parameter_scan = header.instruction_start
    while parameter_scan < header.terminator and
        instructions[parameter_scan].op == IR_BLOCK_PARAM and
        instructions[parameter_scan].type_kind == SEM_INT and instructions[parameter_scan].aux == 0 {
        parameter_count = parameter_count + 1
        parameter_scan = parameter_scan + 1
    }
    if parameter_count < 1 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop header must start with an integer block parameter"))
    }
    // Argument lists for the entry jump, the post-guard backedge, the arm
    // jump (continue to the header, break to the exit parameters), and the
    // break trampoline: `left` for one parameter, the arena beyond.
    let mut entry_arguments: []int = make([]int, 0, parameter_count)
    let mut post_arguments: []int = make([]int, 0, parameter_count)
    let mut arm_arguments: []int = make([]int, 0, parameter_count)
    let mut trampoline_arguments: []int = make([]int, 0, parameter_count)
    let mut jump_index = 0
    while jump_index < 4 {
        if jump_index == 3 and not breaking {
            jump_index = jump_index + 1
            continue
        }
        let jump = if jump_index == 0 { entry_jump } else if jump_index == 1 { post_jump } else if jump_index == 2 { arm_jump } else { instructions[trampoline.terminator] }
        if parameter_count == 1 {
            if jump.op != IR_JUMP or jump.left < 0 or jump.type_kind != SEM_INT {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop jumps must carry integer arguments"))
            }
            if jump_index == 0 { entry_arguments = append(entry_arguments, jump.left) }
            if jump_index == 1 { post_arguments = append(post_arguments, jump.left) }
            if jump_index == 2 { arm_arguments = append(arm_arguments, jump.left) }
            if jump_index == 3 { trampoline_arguments = append(trampoline_arguments, jump.left) }
        } else {
            if jump.op != IR_JUMP or jump.left >= 0 or jump.aux < 0 or
                jump.aux + parameter_count > len(jump_arguments) {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop jumps must carry matching integer arguments"))
            }
            let mut argument_index = 0
            while argument_index < parameter_count {
                if jump_index == 0 { entry_arguments = append(entry_arguments, jump_arguments[jump.aux + argument_index]) }
                if jump_index == 1 { post_arguments = append(post_arguments, jump_arguments[jump.aux + argument_index]) }
                if jump_index == 2 { arm_arguments = append(arm_arguments, jump_arguments[jump.aux + argument_index]) }
                if jump_index == 3 { trampoline_arguments = append(trampoline_arguments, jump_arguments[jump.aux + argument_index]) }
                argument_index = argument_index + 1
            }
        }
        jump_index = jump_index + 1
    }
    let mut parameter_slots: []int = make([]int, 0, parameter_count)
    let mut entry_slots: []int = make([]int, 0, parameter_count)
    let mut post_slots: []int = make([]int, 0, parameter_count)
    let mut arm_slots: []int = make([]int, 0, parameter_count)
    let mut trampoline_slots: []int = make([]int, 0, parameter_count)
    let mut exit_param_slots: []int = make([]int, 0, parameter_count)
    let mut slot_index = 0
    while slot_index < parameter_count {
        let parameter_slot = instructions[header.instruction_start + slot_index].result - function.value_start + 1
        let entry_slot = entry_arguments[slot_index] - function.value_start + 1
        let post_slot = post_arguments[slot_index] - function.value_start + 1
        let arm_slot = arm_arguments[slot_index] - function.value_start + 1
        if parameter_slot < 1 or parameter_slot > function.value_count or
            entry_slot < 1 or entry_slot > function.value_count or
            post_slot < 1 or post_slot > function.value_count or
            arm_slot < 1 or arm_slot > function.value_count {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop slot is out of range"))
        }
        if breaking {
            let exit_param = instructions[exit.instruction_start + slot_index]
            let exit_param_slot = exit_param.result - function.value_start + 1
            let trampoline_slot = trampoline_arguments[slot_index] - function.value_start + 1
            if exit_param.op != IR_BLOCK_PARAM or exit_param.type_kind != SEM_INT or exit_param.aux != 0 or
                exit_param_slot < 1 or exit_param_slot > function.value_count or
                trampoline_slot < 1 or trampoline_slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop exit parameters are invalid"))
            }
            exit_param_slots = append(exit_param_slots, exit_param_slot)
            trampoline_slots = append(trampoline_slots, trampoline_slot)
        }
        parameter_slots = append(parameter_slots, parameter_slot)
        entry_slots = append(entry_slots, entry_slot)
        post_slots = append(post_slots, post_slot)
        arm_slots = append(arm_slots, arm_slot)
        slot_index = slot_index + 1
    }
    let mut slot_count = function.value_count
    if parameter_count > 1 {
        slot_count = slot_count + parameter_count
    }
    if slot_count > 127 {
        return x86_plain_body(x86_error(X86_RANGE, "x86 loop value and scratch slots exceed the stack frame"))
    }
    // Fused compare detection for the header and guard conditions.
    let mut fused_header = false
    let mut header_false_jump = 116
    if header.instruction_count >= parameter_count + 2 {
        let candidate = instructions[header.terminator - 1]
        if candidate.op == IR_BINARY and candidate.type_kind == SEM_BOOL and candidate.result == header_branch.left {
            header_false_jump = x86_compare_false_jump(candidate.aux)
            if header_false_jump < 0 {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 compare operator is not implemented"))
            }
            fused_header = true
        }
    }
    let mut fused_guard = false
    let mut guard_false_jump = 116
    if guard.instruction_count >= 2 {
        let candidate = instructions[guard.terminator - 1]
        if candidate.op == IR_BINARY and candidate.type_kind == SEM_BOOL and candidate.result == guard_branch.left {
            guard_false_jump = x86_compare_false_jump(candidate.aux)
            if guard_false_jump < 0 {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 compare operator is not implemented"))
            }
            fused_guard = true
        }
    }
    let header_condition_slot = header_branch.left - function.value_start + 1
    let guard_condition_slot = guard_branch.left - function.value_start + 1
    if header_condition_slot < 1 or header_condition_slot > function.value_count or
        guard_condition_slot < 1 or guard_condition_slot > function.value_count {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop slot is out of range"))
    }
    let mut bytes: []int = make([]int, 0, 128)
    if not prologue_done {
        bytes = x86_emit_frame_prologue_sized(bytes, (8 * slot_count + 15) & 4294967280)
    }
    let mut edge_callees: []int = make([]int, 0, 2)
    let mut edge_fields: []int = make([]int, 0, 2)
    if entry_params < 0 or entry.instruction_start + entry_params > entry.terminator {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop entry parameters are out of range"))
    }
    let mut entry_param_index = 0
    while entry_param_index < entry_params {
        let entry_param = instructions[entry.instruction_start + entry_param_index]
        if entry_param.op != IR_BLOCK_PARAM or entry_param.type_kind != SEM_INT or entry_param.aux != 0 {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded loop entry parameters must be integer block parameters"))
        }
        entry_param_index = entry_param_index + 1
    }
    // Entry block: scalar prefix, argument copies, jump into the header.
    let entry_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        entry.instruction_start + entry_params, entry.terminator, false
    , string_literals, constant_string_index)
    if entry_segment.code.status != X86_OK {
        return x86_plain_body(entry_segment.code)
    }
    let collected = x86_loop_collect_edges(entry_segment, len(bytes), edge_callees, edge_fields)
    edge_callees = collected.callees
    edge_fields = collected.fields
    bytes = x86_append_code(bytes, entry_segment.code)
    if parameter_count == 1 {
        bytes = x86_emit_load_rax(bytes, entry_slots[0])
        bytes = x86_emit_store_rax(bytes, parameter_slots[0])
    } else {
        let mut copy_index = 0
        while copy_index < parameter_count {
            bytes = x86_emit_load_rax(bytes, entry_slots[copy_index])
            bytes = x86_emit_store_rax(bytes, function.value_count + 1 + copy_index)
            copy_index = copy_index + 1
        }
        copy_index = 0
        while copy_index < parameter_count {
            bytes = x86_emit_load_rax(bytes, function.value_count + 1 + copy_index)
            bytes = x86_emit_store_rax(bytes, parameter_slots[copy_index])
            copy_index = copy_index + 1
        }
    }
    bytes = append(bytes, 233)
    let entry_jump_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    let header_offset = len(bytes)
    bytes = x86_patch_u32(bytes, entry_jump_field, header_offset - (entry_jump_field + 4))
    // Header: block parameters, condition, false edge to the exit.
    let header_prefix_end = if fused_header { header.terminator - 1 } else { header.terminator }
    let header_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        header.instruction_start + parameter_count, header_prefix_end, false
    , string_literals, constant_string_index)
    if header_segment.code.status != X86_OK {
        return x86_plain_body(header_segment.code)
    }
    let collected2 = x86_loop_collect_edges(header_segment, len(bytes), edge_callees, edge_fields)
    edge_callees = collected2.callees
    edge_fields = collected2.fields
    bytes = x86_append_code(bytes, header_segment.code)
    if fused_header {
        let compare = instructions[header.terminator - 1]
        let left_slot = compare.left - function.value_start + 1
        let right_slot = compare.right - function.value_start + 1
        if left_slot < 1 or left_slot >= header_condition_slot or right_slot < 1 or right_slot >= header_condition_slot {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop compare operand is not an earlier value"))
        }
        bytes = x86_emit_load_rax(bytes, left_slot)
        bytes = x86_emit_cmp_mem(bytes, right_slot)
    } else {
        bytes = x86_emit_load_rax(bytes, header_condition_slot)
        bytes = append(bytes, 72)
        bytes = append(bytes, 133)
        bytes = append(bytes, 192)
    }
    bytes = append(bytes, 15)
    bytes = append(bytes, header_false_jump + 16)
    let exit_jcc_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    // Pre-guard updates, then a plain jump into the guard.
    let pre_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        pre.instruction_start, pre.terminator, false
    , string_literals, constant_string_index)
    if pre_segment.code.status != X86_OK {
        return x86_plain_body(pre_segment.code)
    }
    let collected3 = x86_loop_collect_edges(pre_segment, len(bytes), edge_callees, edge_fields)
    edge_callees = collected3.callees
    edge_fields = collected3.fields
    bytes = x86_append_code(bytes, pre_segment.code)
    bytes = append(bytes, 233)
    let pre_jump_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    let guard_offset = len(bytes)
    bytes = x86_patch_u32(bytes, pre_jump_field, guard_offset - (pre_jump_field + 4))
    // Guard: condition, true edge to the arm, false edge (fallthrough) to the
    // post-guard updates.
    let guard_prefix_end = if fused_guard { guard.terminator - 1 } else { guard.terminator }
    let guard_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        guard.instruction_start, guard_prefix_end, false
    , string_literals, constant_string_index)
    if guard_segment.code.status != X86_OK {
        return x86_plain_body(guard_segment.code)
    }
    let collected4 = x86_loop_collect_edges(guard_segment, len(bytes), edge_callees, edge_fields)
    edge_callees = collected4.callees
    edge_fields = collected4.fields
    bytes = x86_append_code(bytes, guard_segment.code)
    if fused_guard {
        let compare = instructions[guard.terminator - 1]
        let left_slot = compare.left - function.value_start + 1
        let right_slot = compare.right - function.value_start + 1
        if left_slot < 1 or left_slot >= guard_condition_slot or right_slot < 1 or right_slot >= guard_condition_slot {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop compare operand is not an earlier value"))
        }
        bytes = x86_emit_load_rax(bytes, left_slot)
        bytes = x86_emit_cmp_mem(bytes, right_slot)
    } else {
        bytes = x86_emit_load_rax(bytes, guard_condition_slot)
        bytes = append(bytes, 72)
        bytes = append(bytes, 133)
        bytes = append(bytes, 192)
    }
    bytes = append(bytes, 15)
    bytes = append(bytes, x86_true_jump_byte(guard_false_jump + 16))
    let arm_jcc_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    // Post-guard updates, copies, and the backedge.
    let post_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        post.instruction_start, post.terminator, false
    , string_literals, constant_string_index)
    if post_segment.code.status != X86_OK {
        return x86_plain_body(post_segment.code)
    }
    let collected5 = x86_loop_collect_edges(post_segment, len(bytes), edge_callees, edge_fields)
    edge_callees = collected5.callees
    edge_fields = collected5.fields
    bytes = x86_append_code(bytes, post_segment.code)
    if parameter_count == 1 {
        bytes = x86_emit_load_rax(bytes, post_slots[0])
        bytes = x86_emit_store_rax(bytes, parameter_slots[0])
    } else {
        let mut copy_index = 0
        while copy_index < parameter_count {
            bytes = x86_emit_load_rax(bytes, post_slots[copy_index])
            bytes = x86_emit_store_rax(bytes, function.value_count + 1 + copy_index)
            copy_index = copy_index + 1
        }
        copy_index = 0
        while copy_index < parameter_count {
            bytes = x86_emit_load_rax(bytes, function.value_count + 1 + copy_index)
            bytes = x86_emit_store_rax(bytes, parameter_slots[copy_index])
            copy_index = copy_index + 1
        }
    }
    bytes = append(bytes, 233)
    let back_jump_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    bytes = x86_patch_u32(bytes, back_jump_field, header_offset - (back_jump_field + 4))
    // The arm: a continue copies into the header parameters and jumps back; a
    // break copies into the exit parameters and falls out.
    let arm_offset = len(bytes)
    bytes = x86_patch_u32(bytes, arm_jcc_field, arm_offset - (arm_jcc_field + 4))
    let mut break_jump_field = -1
    if continuing {
        let mut copy_index = 0
        while copy_index < parameter_count {
            if arm_slots[copy_index] != parameter_slots[copy_index] {
                bytes = x86_emit_load_rax(bytes, arm_slots[copy_index])
                bytes = x86_emit_store_rax(bytes, parameter_slots[copy_index])
            }
            copy_index = copy_index + 1
        }
        bytes = append(bytes, 233)
        let continue_jump_field = len(bytes)
        bytes = x86_emit_u32(bytes, 0)
        bytes = x86_patch_u32(bytes, continue_jump_field, header_offset - (continue_jump_field + 4))
    } else {
        let mut copy_index = 0
        while copy_index < parameter_count {
            if arm_slots[copy_index] != exit_param_slots[copy_index] {
                bytes = x86_emit_load_rax(bytes, arm_slots[copy_index])
                bytes = x86_emit_store_rax(bytes, exit_param_slots[copy_index])
            }
            copy_index = copy_index + 1
        }
        bytes = append(bytes, 233)
        break_jump_field = len(bytes)
        bytes = x86_emit_u32(bytes, 0)
    }
    if breaking {
        // The header's false edge reaches the exit parameters through the
        // trampoline: header parameter slots into exit parameter slots.
        let trampoline_offset = len(bytes)
        bytes = x86_patch_u32(bytes, exit_jcc_field, trampoline_offset - (exit_jcc_field + 4))
        let mut copy_index = 0
        while copy_index < parameter_count {
            if trampoline_slots[copy_index] != exit_param_slots[copy_index] {
                bytes = x86_emit_load_rax(bytes, trampoline_slots[copy_index])
                bytes = x86_emit_store_rax(bytes, exit_param_slots[copy_index])
            }
            copy_index = copy_index + 1
        }
        bytes = append(bytes, 233)
        let trampoline_jump_field = len(bytes)
        bytes = x86_emit_u32(bytes, 0)
        let exit_offset_for_trampoline = len(bytes)
        bytes = x86_patch_u32(bytes, trampoline_jump_field, exit_offset_for_trampoline - (trampoline_jump_field + 4))
        bytes = x86_patch_u32(bytes, break_jump_field, exit_offset_for_trampoline - (break_jump_field + 4))
    }
    if not breaking {
        let exit_offset = len(bytes)
        bytes = x86_patch_u32(bytes, exit_jcc_field, exit_offset - (exit_jcc_field + 4))
    }
    let exit_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        exit.instruction_start + (if breaking { parameter_count } else { 0 }),
        exit.instruction_start + exit.instruction_count, true
    , string_literals, constant_string_index)
    if exit_segment.code.status != X86_OK {
        return x86_plain_body(exit_segment.code)
    }
    let collected6 = x86_loop_collect_edges(exit_segment, len(bytes), edge_callees, edge_fields)
    edge_callees = collected6.callees
    edge_fields = collected6.fields
    bytes = x86_append_code(bytes, exit_segment.code)
    return X86Body {
        code: X86Code { bytes: bytes, status: X86_OK, error: "" },
        edge_callees: edge_callees, edge_fields: edge_fields,
    }
}

// Lower the verified eight-block merge-if loop shape: entry, header, pre-if
// updates, if condition, then arm, else arm, merge, exit. The merge block's
// leading parameters are fed by both arms; the backedge carries the merged
// values and the straight-line updates back to the header.
fn x86_lower_merge_loop(instructions: []IrInstruction, constants: []IrConstant, blocks: []IrBlock, successors: []int, call_sites: []IrCallSite, call_arguments: []int, jump_arguments: []int, functions: []IrFunction, function: IrFunction, string_literals: []string, constant_string_index: []int) -> X86Body {
    if function.parameter_count < 0 or function.parameter_count > 15 or function.block_count != 8 or
        function.value_start < 0 or function.value_count < 1 or function.value_count > 127 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 merge loop requires at most fifteen parameters, eight blocks, and 127 values"))
    }
    if function.entry_block < 0 or function.entry_block + 7 >= len(blocks) {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 merge loop blocks are out of range"))
    }
    let entry = blocks[function.entry_block]
    let header = blocks[function.entry_block + 1]
    let pre = blocks[function.entry_block + 2]
    let cond = blocks[function.entry_block + 3]
    let then_block = blocks[function.entry_block + 4]
    let else_block = blocks[function.entry_block + 5]
    let merge = blocks[function.entry_block + 6]
    let exit = blocks[function.entry_block + 7]
    let mut shape_index = 0
    let mut shape_ok = true
    while shape_index < 8 {
        let block = blocks[function.entry_block + shape_index]
        if block.instruction_start < 0 or block.instruction_count < 1 or
            block.terminator != block.instruction_start + block.instruction_count - 1 or
            block.terminator >= len(instructions) or block.successor_start < 0 or
            block.successor_start + block.successor_count > len(successors) {
            shape_ok = false
        }
        shape_index = shape_index + 1
    }
    if not shape_ok {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 merge loop blocks have an invalid instruction range"))
    }
    if entry.successor_count != 1 or header.successor_count != 2 or pre.successor_count != 1 or
        cond.successor_count != 2 or then_block.successor_count != 1 or else_block.successor_count != 1 or
        merge.successor_count != 1 or exit.successor_count != 0 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 merge loop successors are out of range"))
    }
    if successors[entry.successor_start] != function.entry_block + 1 or
        successors[header.successor_start] != function.entry_block + 2 or
        successors[header.successor_start + 1] != function.entry_block + 7 or
        successors[pre.successor_start] != function.entry_block + 3 or
        successors[cond.successor_start] != function.entry_block + 4 or
        successors[cond.successor_start + 1] != function.entry_block + 5 or
        successors[then_block.successor_start] != function.entry_block + 6 or
        successors[else_block.successor_start] != function.entry_block + 6 or
        successors[merge.successor_start] != function.entry_block + 1 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 merge loop successors do not form a merge loop"))
    }
    let entry_jump = instructions[entry.terminator]
    let header_branch = instructions[header.terminator]
    let cond_branch = instructions[cond.terminator]
    let then_jump = instructions[then_block.terminator]
    let else_jump = instructions[else_block.terminator]
    let merge_jump = instructions[merge.terminator]
    let exit_return = instructions[exit.terminator]
    if header_branch.op != IR_BRANCH or header_branch.left < 0 or
        cond_branch.op != IR_BRANCH or cond_branch.left < 0 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 merge loop branches are invalid"))
    }
    if exit_return.op != IR_RETURN or exit_return.left < 0 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 merge loop exit must return"))
    }
    // Header block parameters (carried locals) and merge block parameters
    // (arm-assigned locals).
    let mut parameter_count = 0
    let mut parameter_scan = header.instruction_start
    while parameter_scan < header.terminator and
        instructions[parameter_scan].op == IR_BLOCK_PARAM and
        instructions[parameter_scan].type_kind == SEM_INT and instructions[parameter_scan].aux == 0 {
        parameter_count = parameter_count + 1
        parameter_scan = parameter_scan + 1
    }
    if parameter_count < 1 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 merge loop header must start with an integer block parameter"))
    }
    let mut merge_count = 0
    parameter_scan = merge.instruction_start
    while parameter_scan < merge.terminator and
        instructions[parameter_scan].op == IR_BLOCK_PARAM and
        instructions[parameter_scan].type_kind == SEM_INT and instructions[parameter_scan].aux == 0 {
        merge_count = merge_count + 1
        parameter_scan = parameter_scan + 1
    }
    if merge_count < 1 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 merge loop merge block must start with an integer block parameter"))
    }
    // Argument lists: entry jump (K), then/else jumps (K'), backedge (K).
    let mut entry_arguments: []int = make([]int, 0, parameter_count)
    let mut merge_arguments: []int = make([]int, 0, parameter_count)
    let mut then_arguments: []int = make([]int, 0, merge_count)
    let mut else_arguments: []int = make([]int, 0, merge_count)
    let mut jump_index = 0
    while jump_index < 4 {
        let jump = if jump_index == 0 { entry_jump } else if jump_index == 1 { then_jump } else if jump_index == 2 { else_jump } else { merge_jump }
        let expected = if jump_index == 1 or jump_index == 2 { merge_count } else { parameter_count }
        if expected == 1 {
            if jump.op != IR_JUMP or jump.left < 0 or jump.type_kind != SEM_INT {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 merge loop jumps must carry integer arguments"))
            }
            if jump_index == 0 { entry_arguments = append(entry_arguments, jump.left) }
            if jump_index == 1 { then_arguments = append(then_arguments, jump.left) }
            if jump_index == 2 { else_arguments = append(else_arguments, jump.left) }
            if jump_index == 3 { merge_arguments = append(merge_arguments, jump.left) }
        } else {
            if jump.op != IR_JUMP or jump.left >= 0 or jump.aux < 0 or
                jump.aux + expected > len(jump_arguments) {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 merge loop jumps must carry matching integer arguments"))
            }
            let mut argument_index = 0
            while argument_index < expected {
                if jump_index == 0 { entry_arguments = append(entry_arguments, jump_arguments[jump.aux + argument_index]) }
                if jump_index == 1 { then_arguments = append(then_arguments, jump_arguments[jump.aux + argument_index]) }
                if jump_index == 2 { else_arguments = append(else_arguments, jump_arguments[jump.aux + argument_index]) }
                if jump_index == 3 { merge_arguments = append(merge_arguments, jump_arguments[jump.aux + argument_index]) }
                argument_index = argument_index + 1
            }
        }
        jump_index = jump_index + 1
    }
    let mut parameter_slots: []int = make([]int, 0, parameter_count)
    let mut entry_slots: []int = make([]int, 0, parameter_count)
    let mut merge_arg_slots: []int = make([]int, 0, parameter_count)
    let mut merge_param_slots: []int = make([]int, 0, merge_count)
    let mut then_slots: []int = make([]int, 0, merge_count)
    let mut else_slots: []int = make([]int, 0, merge_count)
    let mut slot_index = 0
    while slot_index < parameter_count {
        let parameter_slot = instructions[header.instruction_start + slot_index].result - function.value_start + 1
        let entry_slot = entry_arguments[slot_index] - function.value_start + 1
        let backedge_slot = merge_arguments[slot_index] - function.value_start + 1
        if parameter_slot < 1 or parameter_slot > function.value_count or
            entry_slot < 1 or entry_slot > function.value_count or
            backedge_slot < 1 or backedge_slot > function.value_count {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 merge loop slot is out of range"))
        }
        parameter_slots = append(parameter_slots, parameter_slot)
        entry_slots = append(entry_slots, entry_slot)
        merge_arg_slots = append(merge_arg_slots, backedge_slot)
        slot_index = slot_index + 1
    }
    slot_index = 0
    while slot_index < merge_count {
        let merge_param_slot = instructions[merge.instruction_start + slot_index].result - function.value_start + 1
        let then_slot = then_arguments[slot_index] - function.value_start + 1
        let else_slot = else_arguments[slot_index] - function.value_start + 1
        if merge_param_slot < 1 or merge_param_slot > function.value_count or
            then_slot < 1 or then_slot > function.value_count or
            else_slot < 1 or else_slot > function.value_count {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 merge loop slot is out of range"))
        }
        merge_param_slots = append(merge_param_slots, merge_param_slot)
        then_slots = append(then_slots, then_slot)
        else_slots = append(else_slots, else_slot)
        slot_index = slot_index + 1
    }
    let scratch_needed = if parameter_count > merge_count { parameter_count } else { merge_count }
    let mut slot_count = function.value_count
    if scratch_needed > 1 {
        slot_count = slot_count + scratch_needed
    }
    if slot_count > 127 {
        return x86_plain_body(x86_error(X86_RANGE, "x86 loop value and scratch slots exceed the stack frame"))
    }
    // Fused compares for the header and if conditions.
    let mut fused_header = false
    let mut header_false_jump = 116
    if header.instruction_count >= parameter_count + 2 {
        let candidate = instructions[header.terminator - 1]
        if candidate.op == IR_BINARY and candidate.type_kind == SEM_BOOL and candidate.result == header_branch.left {
            header_false_jump = x86_compare_false_jump(candidate.aux)
            if header_false_jump < 0 {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 compare operator is not implemented"))
            }
            fused_header = true
        }
    }
    let mut fused_cond = false
    let mut cond_false_jump = 116
    if cond.instruction_count >= 2 {
        let candidate = instructions[cond.terminator - 1]
        if candidate.op == IR_BINARY and candidate.type_kind == SEM_BOOL and candidate.result == cond_branch.left {
            cond_false_jump = x86_compare_false_jump(candidate.aux)
            if cond_false_jump < 0 {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 compare operator is not implemented"))
            }
            fused_cond = true
        }
    }
    let header_condition_slot = header_branch.left - function.value_start + 1
    let cond_condition_slot = cond_branch.left - function.value_start + 1
    if header_condition_slot < 1 or header_condition_slot > function.value_count or
        cond_condition_slot < 1 or cond_condition_slot > function.value_count {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 merge loop slot is out of range"))
    }
    let mut bytes: []int = make([]int, 0, 128)
    bytes = x86_emit_frame_prologue_sized(bytes, (8 * slot_count + 15) & 4294967280)
    let mut edge_callees: []int = make([]int, 0, 2)
    let mut edge_fields: []int = make([]int, 0, 2)
    // Entry: scalar prefix, argument copies into the header parameters, jump.
    let entry_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        entry.instruction_start, entry.terminator, false
    , string_literals, constant_string_index)
    if entry_segment.code.status != X86_OK {
        return x86_plain_body(entry_segment.code)
    }
    let collected = x86_loop_collect_edges(entry_segment, len(bytes), edge_callees, edge_fields)
    edge_callees = collected.callees
    edge_fields = collected.fields
    bytes = x86_append_code(bytes, entry_segment.code)
    if parameter_count == 1 {
        bytes = x86_emit_load_rax(bytes, entry_slots[0])
        bytes = x86_emit_store_rax(bytes, parameter_slots[0])
    } else {
        let mut copy_index = 0
        while copy_index < parameter_count {
            bytes = x86_emit_load_rax(bytes, entry_slots[copy_index])
            bytes = x86_emit_store_rax(bytes, function.value_count + 1 + copy_index)
            copy_index = copy_index + 1
        }
        copy_index = 0
        while copy_index < parameter_count {
            bytes = x86_emit_load_rax(bytes, function.value_count + 1 + copy_index)
            bytes = x86_emit_store_rax(bytes, parameter_slots[copy_index])
            copy_index = copy_index + 1
        }
    }
    bytes = append(bytes, 233)
    let entry_jump_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    let header_offset = len(bytes)
    bytes = x86_patch_u32(bytes, entry_jump_field, header_offset - (entry_jump_field + 4))
    // Header: block parameters, while condition, false edge to the exit.
    let header_prefix_end = if fused_header { header.terminator - 1 } else { header.terminator }
    let header_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        header.instruction_start + parameter_count, header_prefix_end, false
    , string_literals, constant_string_index)
    if header_segment.code.status != X86_OK {
        return x86_plain_body(header_segment.code)
    }
    let collected2 = x86_loop_collect_edges(header_segment, len(bytes), edge_callees, edge_fields)
    edge_callees = collected2.callees
    edge_fields = collected2.fields
    bytes = x86_append_code(bytes, header_segment.code)
    if fused_header {
        let compare = instructions[header.terminator - 1]
        let left_slot = compare.left - function.value_start + 1
        let right_slot = compare.right - function.value_start + 1
        if left_slot < 1 or left_slot >= header_condition_slot or right_slot < 1 or right_slot >= header_condition_slot {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop compare operand is not an earlier value"))
        }
        bytes = x86_emit_load_rax(bytes, left_slot)
        bytes = x86_emit_cmp_mem(bytes, right_slot)
    } else {
        bytes = x86_emit_load_rax(bytes, header_condition_slot)
        bytes = append(bytes, 72)
        bytes = append(bytes, 133)
        bytes = append(bytes, 192)
    }
    bytes = append(bytes, 15)
    bytes = append(bytes, header_false_jump + 16)
    let exit_jcc_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    // Pre-if updates, plain jump into the if condition.
    let pre_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        pre.instruction_start, pre.terminator, false
    , string_literals, constant_string_index)
    if pre_segment.code.status != X86_OK {
        return x86_plain_body(pre_segment.code)
    }
    let collected3 = x86_loop_collect_edges(pre_segment, len(bytes), edge_callees, edge_fields)
    edge_callees = collected3.callees
    edge_fields = collected3.fields
    bytes = x86_append_code(bytes, pre_segment.code)
    bytes = append(bytes, 233)
    let pre_jump_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    let cond_offset = len(bytes)
    bytes = x86_patch_u32(bytes, pre_jump_field, cond_offset - (pre_jump_field + 4))
    // If condition: true edge falls into the then arm, false edge to the else.
    let cond_prefix_end = if fused_cond { cond.terminator - 1 } else { cond.terminator }
    let cond_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        cond.instruction_start, cond_prefix_end, false
    , string_literals, constant_string_index)
    if cond_segment.code.status != X86_OK {
        return x86_plain_body(cond_segment.code)
    }
    let collected4 = x86_loop_collect_edges(cond_segment, len(bytes), edge_callees, edge_fields)
    edge_callees = collected4.callees
    edge_fields = collected4.fields
    bytes = x86_append_code(bytes, cond_segment.code)
    if fused_cond {
        let compare = instructions[cond.terminator - 1]
        let left_slot = compare.left - function.value_start + 1
        let right_slot = compare.right - function.value_start + 1
        if left_slot < 1 or left_slot >= cond_condition_slot or right_slot < 1 or right_slot >= cond_condition_slot {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop compare operand is not an earlier value"))
        }
        bytes = x86_emit_load_rax(bytes, left_slot)
        bytes = x86_emit_cmp_mem(bytes, right_slot)
    } else {
        bytes = x86_emit_load_rax(bytes, cond_condition_slot)
        bytes = append(bytes, 72)
        bytes = append(bytes, 133)
        bytes = append(bytes, 192)
    }
    bytes = append(bytes, 15)
    bytes = append(bytes, cond_false_jump + 16)
    let else_jcc_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    // The arms: scalar updates, argument copies into the merge parameters,
    // and a jump into the merge block.
    let mut arm_index = 0
    let mut then_jump_field = -1
    while arm_index < 2 {
        let arm_block = if arm_index == 0 { then_block } else { else_block }
        let arm_segment = x86_emit_scalar_segment(
            instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
            arm_block.instruction_start, arm_block.terminator, false
        , string_literals, constant_string_index)
        if arm_segment.code.status != X86_OK {
            return x86_plain_body(arm_segment.code)
        }
        let collected_arm = x86_loop_collect_edges(arm_segment, len(bytes), edge_callees, edge_fields)
        edge_callees = collected_arm.callees
        edge_fields = collected_arm.fields
        bytes = x86_append_code(bytes, arm_segment.code)
        if merge_count == 1 {
            let arm_slot = if arm_index == 0 { then_slots[0] } else { else_slots[0] }
            bytes = x86_emit_load_rax(bytes, arm_slot)
            bytes = x86_emit_store_rax(bytes, merge_param_slots[0])
        } else {
            let mut copy_index = 0
            while copy_index < merge_count {
                let arm_slot = if arm_index == 0 { then_slots[copy_index] } else { else_slots[copy_index] }
                bytes = x86_emit_load_rax(bytes, arm_slot)
                bytes = x86_emit_store_rax(bytes, function.value_count + 1 + copy_index)
                copy_index = copy_index + 1
            }
            copy_index = 0
            while copy_index < merge_count {
                bytes = x86_emit_load_rax(bytes, function.value_count + 1 + copy_index)
                bytes = x86_emit_store_rax(bytes, merge_param_slots[copy_index])
                copy_index = copy_index + 1
            }
        }
        bytes = append(bytes, 233)
        let arm_jump_field = len(bytes)
        bytes = x86_emit_u32(bytes, 0)
        if arm_index == 0 {
            then_jump_field = arm_jump_field
            // The else block starts right after the then arm's jump.
            bytes = x86_patch_u32(bytes, else_jcc_field, (then_jump_field + 4) - (else_jcc_field + 4))
        } else {
            let merge_offset = len(bytes)
            bytes = x86_patch_u32(bytes, arm_jump_field, merge_offset - (arm_jump_field + 4))
            bytes = x86_patch_u32(bytes, then_jump_field, merge_offset - (then_jump_field + 4))
        }
        arm_index = arm_index + 1
    }
    // Merge: skip the block parameters, post-if updates, backedge copies, and
    // the jump back to the header.
    let merge_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        merge.instruction_start + merge_count, merge.terminator, false
    , string_literals, constant_string_index)
    if merge_segment.code.status != X86_OK {
        return x86_plain_body(merge_segment.code)
    }
    let collected5 = x86_loop_collect_edges(merge_segment, len(bytes), edge_callees, edge_fields)
    edge_callees = collected5.callees
    edge_fields = collected5.fields
    bytes = x86_append_code(bytes, merge_segment.code)
    if parameter_count == 1 {
        bytes = x86_emit_load_rax(bytes, merge_arg_slots[0])
        bytes = x86_emit_store_rax(bytes, parameter_slots[0])
    } else {
        let mut copy_index = 0
        while copy_index < parameter_count {
            bytes = x86_emit_load_rax(bytes, merge_arg_slots[copy_index])
            bytes = x86_emit_store_rax(bytes, function.value_count + 1 + copy_index)
            copy_index = copy_index + 1
        }
        copy_index = 0
        while copy_index < parameter_count {
            bytes = x86_emit_load_rax(bytes, function.value_count + 1 + copy_index)
            bytes = x86_emit_store_rax(bytes, parameter_slots[copy_index])
            copy_index = copy_index + 1
        }
    }
    bytes = append(bytes, 233)
    let back_jump_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    bytes = x86_patch_u32(bytes, back_jump_field, header_offset - (back_jump_field + 4))
    let exit_offset = len(bytes)
    bytes = x86_patch_u32(bytes, exit_jcc_field, exit_offset - (exit_jcc_field + 4))
    let exit_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        exit.instruction_start, exit.instruction_start + exit.instruction_count, true
    , string_literals, constant_string_index)
    if exit_segment.code.status != X86_OK {
        return x86_plain_body(exit_segment.code)
    }
    let collected6 = x86_loop_collect_edges(exit_segment, len(bytes), edge_callees, edge_fields)
    edge_callees = collected6.callees
    edge_fields = collected6.fields
    bytes = x86_append_code(bytes, exit_segment.code)
    return X86Body {
        code: X86Code { bytes: bytes, status: X86_OK, error: "" },
        edge_callees: edge_callees, edge_fields: edge_fields,
    }
}

// Lower a merge-if group leading a loop chain: the if entry (condition,
// branch), then and else arms (assignments, argument jumps), and the merge
// block (leading parameters, entry jump into the first header). The merge
// block then plays the chain entry's role and the remainder goes through the
// loop chain lowering.
fn x86_lower_pre_if_chain(instructions: []IrInstruction, constants: []IrConstant, blocks: []IrBlock, successors: []int, call_sites: []IrCallSite, call_arguments: []int, jump_arguments: []int, functions: []IrFunction, function: IrFunction, string_literals: []string, constant_string_index: []int) -> X86Body {
    if function.parameter_count < 0 or function.parameter_count > 15 or function.block_count < 7 or
        function.value_start < 0 or function.value_count < 1 or function.value_count > 127 or
        function.entry_block < 0 or function.entry_block + function.block_count - 1 >= len(blocks) {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 pre-if chain requires at most fifteen parameters, seven blocks, and 127 values"))
    }
    let entry = blocks[function.entry_block]
    let then_block = blocks[function.entry_block + 1]
    let else_block = blocks[function.entry_block + 2]
    let merge = blocks[function.entry_block + 3]
    let mut shape_index = 0
    let mut shape_ok = true
    while shape_index < 4 {
        let block = blocks[function.entry_block + shape_index]
        if block.instruction_start < 0 or block.instruction_count < 1 or
            block.terminator != block.instruction_start + block.instruction_count - 1 or
            block.terminator >= len(instructions) or block.successor_start < 0 or
            block.successor_start + block.successor_count > len(successors) {
            shape_ok = false
        }
        shape_index = shape_index + 1
    }
    if not shape_ok {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 pre-if chain blocks have an invalid instruction range"))
    }
    let entry_branch = instructions[entry.terminator]
    let then_jump = instructions[then_block.terminator]
    let else_jump = instructions[else_block.terminator]
    let merge_jump = instructions[merge.terminator]
    if entry.successor_count != 2 or then_block.successor_count != 1 or else_block.successor_count != 1 or
        merge.successor_count != 1 or
        successors[entry.successor_start] != function.entry_block + 1 or
        successors[entry.successor_start + 1] != function.entry_block + 2 or
        successors[then_block.successor_start] != function.entry_block + 3 or
        successors[else_block.successor_start] != function.entry_block + 3 or
        successors[merge.successor_start] != function.entry_block + 4 or
        entry_branch.op != IR_BRANCH or entry_branch.left < 0 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 pre-if chain successors are invalid"))
    }
    // Merge block parameters: one per arm-assigned local.
    let mut merge_count = 0
    let mut parameter_scan = merge.instruction_start
    while parameter_scan < merge.terminator and
        instructions[parameter_scan].op == IR_BLOCK_PARAM and
        instructions[parameter_scan].type_kind == SEM_INT and instructions[parameter_scan].aux == 0 {
        merge_count = merge_count + 1
        parameter_scan = parameter_scan + 1
    }
    if merge_count < 1 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 pre-if chain merge block must start with an integer block parameter"))
    }
    let mut then_arguments: []int = make([]int, 0, merge_count)
    let mut else_arguments: []int = make([]int, 0, merge_count)
    let mut jump_index = 0
    while jump_index < 2 {
        let jump = if jump_index == 0 { then_jump } else { else_jump }
        if merge_count == 1 {
            if jump.op != IR_JUMP or jump.left < 0 or jump.type_kind != SEM_INT {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 pre-if chain jumps must carry integer arguments"))
            }
            if jump_index == 0 { then_arguments = append(then_arguments, jump.left) }
            if jump_index == 1 { else_arguments = append(else_arguments, jump.left) }
        } else {
            if jump.op != IR_JUMP or jump.left >= 0 or jump.aux < 0 or
                jump.aux + merge_count > len(jump_arguments) {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 pre-if chain jumps must carry matching integer arguments"))
            }
            let mut argument_index = 0
            while argument_index < merge_count {
                if jump_index == 0 { then_arguments = append(then_arguments, jump_arguments[jump.aux + argument_index]) }
                if jump_index == 1 { else_arguments = append(else_arguments, jump_arguments[jump.aux + argument_index]) }
                argument_index = argument_index + 1
            }
        }
        jump_index = jump_index + 1
    }
    let mut merge_param_slots: []int = make([]int, 0, merge_count)
    let mut then_slots: []int = make([]int, 0, merge_count)
    let mut else_slots: []int = make([]int, 0, merge_count)
    let mut slot_index = 0
    while slot_index < merge_count {
        let merge_param_slot = instructions[merge.instruction_start + slot_index].result - function.value_start + 1
        let then_slot = then_arguments[slot_index] - function.value_start + 1
        let else_slot = else_arguments[slot_index] - function.value_start + 1
        if merge_param_slot < 1 or merge_param_slot > function.value_count or
            then_slot < 1 or then_slot > function.value_count or
            else_slot < 1 or else_slot > function.value_count {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 pre-if chain slot is out of range"))
        }
        merge_param_slots = append(merge_param_slots, merge_param_slot)
        then_slots = append(then_slots, then_slot)
        else_slots = append(else_slots, else_slot)
        slot_index = slot_index + 1
    }
    let scratch_needed = if merge_count > 1 { merge_count } else { 0 }
    let mut slot_count = function.value_count
    if scratch_needed > 1 {
        slot_count = slot_count + scratch_needed
    }
    if slot_count > 127 {
        return x86_plain_body(x86_error(X86_RANGE, "x86 loop value and scratch slots exceed the stack frame"))
    }
    let condition_slot = entry_branch.left - function.value_start + 1
    if condition_slot < 1 or condition_slot > function.value_count {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 pre-if chain slot is out of range"))
    }
    let mut fused = false
    let mut false_jump = 116
    if entry.instruction_count >= 2 {
        let candidate = instructions[entry.terminator - 1]
        if candidate.op == IR_BINARY and candidate.type_kind == SEM_BOOL and candidate.result == entry_branch.left {
            false_jump = x86_compare_false_jump(candidate.aux)
            if false_jump < 0 {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 compare operator is not implemented"))
            }
            fused = true
        }
    }
    let mut bytes: []int = make([]int, 0, 128)
    bytes = x86_emit_frame_prologue_sized(bytes, (8 * slot_count + 15) & 4294967280)
    let mut edge_callees: []int = make([]int, 0, 2)
    let mut edge_fields: []int = make([]int, 0, 2)
    // If entry: leading instructions, condition, false edge to the else arm.
    let entry_prefix_end = if fused { entry.terminator - 1 } else { entry.terminator }
    let entry_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        entry.instruction_start, entry_prefix_end, false
    , string_literals, constant_string_index)
    if entry_segment.code.status != X86_OK {
        return x86_plain_body(entry_segment.code)
    }
    let collected = x86_loop_collect_edges(entry_segment, len(bytes), edge_callees, edge_fields)
    edge_callees = collected.callees
    edge_fields = collected.fields
    bytes = x86_append_code(bytes, entry_segment.code)
    if fused {
        let compare = instructions[entry.terminator - 1]
        let left_slot = compare.left - function.value_start + 1
        let right_slot = compare.right - function.value_start + 1
        if left_slot < 1 or left_slot >= condition_slot or right_slot < 1 or right_slot >= condition_slot {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop compare operand is not an earlier value"))
        }
        bytes = x86_emit_load_rax(bytes, left_slot)
        bytes = x86_emit_cmp_mem(bytes, right_slot)
    } else {
        bytes = x86_emit_load_rax(bytes, condition_slot)
        bytes = append(bytes, 72)
        bytes = append(bytes, 133)
        bytes = append(bytes, 192)
    }
    bytes = append(bytes, 15)
    bytes = append(bytes, false_jump + 16)
    let else_jcc_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    // The arms: scalar updates, argument copies into the merge parameters,
    // and a jump into the merge block.
    let mut arm_index = 0
    let mut then_jump_field = -1
    while arm_index < 2 {
        let arm_block = if arm_index == 0 { then_block } else { else_block }
        let arm_segment = x86_emit_scalar_segment(
            instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
            arm_block.instruction_start, arm_block.terminator, false
        , string_literals, constant_string_index)
        if arm_segment.code.status != X86_OK {
            return x86_plain_body(arm_segment.code)
        }
        let collected_arm = x86_loop_collect_edges(arm_segment, len(bytes), edge_callees, edge_fields)
        edge_callees = collected_arm.callees
        edge_fields = collected_arm.fields
        bytes = x86_append_code(bytes, arm_segment.code)
        if merge_count == 1 {
            let arm_slot = if arm_index == 0 { then_slots[0] } else { else_slots[0] }
            bytes = x86_emit_load_rax(bytes, arm_slot)
            bytes = x86_emit_store_rax(bytes, merge_param_slots[0])
        } else {
            let mut copy_index = 0
            while copy_index < merge_count {
                let arm_slot = if arm_index == 0 { then_slots[copy_index] } else { else_slots[copy_index] }
                bytes = x86_emit_load_rax(bytes, arm_slot)
                bytes = x86_emit_store_rax(bytes, function.value_count + 1 + copy_index)
                copy_index = copy_index + 1
            }
            copy_index = 0
            while copy_index < merge_count {
                bytes = x86_emit_load_rax(bytes, function.value_count + 1 + copy_index)
                bytes = x86_emit_store_rax(bytes, merge_param_slots[copy_index])
                copy_index = copy_index + 1
            }
        }
        bytes = append(bytes, 233)
        let arm_jump_field = len(bytes)
        bytes = x86_emit_u32(bytes, 0)
        if arm_index == 0 {
            then_jump_field = arm_jump_field
            bytes = x86_patch_u32(bytes, else_jcc_field, (then_jump_field + 4) - (else_jcc_field + 4))
        } else {
            let merge_offset = len(bytes)
            bytes = x86_patch_u32(bytes, arm_jump_field, merge_offset - (arm_jump_field + 4))
            bytes = x86_patch_u32(bytes, then_jump_field, merge_offset - (then_jump_field + 4))
        }
        arm_index = arm_index + 1
    }
    // The remainder of the function goes through the matching loop lowering
    // with the merge block as its entry.
    let chain_function = IrFunction {
        item: function.item, entry_block: function.entry_block + 3,
        block_count: function.block_count - 3,
        parameter_count: function.parameter_count,
        value_start: function.value_start, value_count: function.value_count,
    }
    let remainder = function.block_count - 3
    let mut chain = x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 pre-if chain remainder shape is not implemented"))
    if remainder == 4 {
        chain = x86_lower_loop(
            instructions, constants, blocks, successors, call_sites, call_arguments,
            jump_arguments, functions, chain_function, merge_count, true
        , string_literals, constant_string_index)
    } else if remainder >= 7 and
        blocks[function.entry_block + 6].terminator >= 0 and
        blocks[function.entry_block + 6].terminator < len(instructions) and
        instructions[blocks[function.entry_block + 6].terminator].op == IR_BRANCH {
        chain = x86_lower_guarded_loop(
            instructions, constants, blocks, successors, call_sites, call_arguments,
            jump_arguments, functions, chain_function, merge_count, true
        , string_literals, constant_string_index)
    } else if remainder >= 7 and (remainder - 1) % 3 == 0 {
        chain = x86_lower_loop_chain(
            instructions, constants, blocks, successors, call_sites, call_arguments,
            jump_arguments, functions, chain_function, -1, merge_count, true
        , string_literals, constant_string_index)
    }
    if chain.code.status != X86_OK {
        return chain
    }
    let mut merge_index = 0
    while merge_index < len(chain.edge_callees) {
        edge_callees = append(edge_callees, chain.edge_callees[merge_index])
        edge_fields = append(edge_fields, chain.edge_fields[merge_index] + len(bytes))
        merge_index = merge_index + 1
    }
    bytes = x86_append_code(bytes, chain.code)
    return X86Body {
        code: X86Code { bytes: bytes, status: X86_OK, error: "" },
        edge_callees: edge_callees, edge_fields: edge_fields,
    }
}

// Lower a chain of plain loops whose last loop is guarded (break/continue):
// the plain prefix goes through the chain lowering, and the guarded group —
// whose entry is the final junction — through the guarded-loop lowering.
fn x86_lower_guarded_chain(instructions: []IrInstruction, constants: []IrConstant, blocks: []IrBlock, successors: []int, call_sites: []IrCallSite, call_arguments: []int, jump_arguments: []int, functions: []IrFunction, function: IrFunction, string_literals: []string, constant_string_index: []int) -> X86Body {
    let plain_limit = if (function.block_count - 4) % 3 == 0 {
        (function.block_count - 4) / 3 - 1
    } else if (function.block_count - 5) % 3 == 0 {
        (function.block_count - 5) / 3 - 1
    } else {
        -1
    }
    if plain_limit < 1 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded chain requires at least one plain loop before the guarded one"))
    }
    return x86_lower_loop_chain(instructions, constants, blocks, successors, call_sites, call_arguments, jump_arguments, functions, function, plain_limit, 0, false, string_literals, constant_string_index)
}

// Lower a chain of N sequential plain loops (3N+1 blocks): entry, then per
// loop a header (block parameters, condition, branch), a body (updates,
// backedge), and a junction carrying the final parameters into the next
// header; the last block returns. Every header has the same parameter count
// (the carried union), so argument lists line up across the chain. With
// plain_limit >= 0 only that many plain groups are validated and emitted and
// the remainder of the function is delegated to the guarded-loop lowering
// (a guarded last loop whose entry is the final junction).
fn x86_lower_loop_chain(instructions: []IrInstruction, constants: []IrConstant, blocks: []IrBlock, successors: []int, call_sites: []IrCallSite, call_arguments: []int, jump_arguments: []int, functions: []IrFunction, function: IrFunction, plain_limit: int, entry_params: int, prologue_done: bool, string_literals: []string, constant_string_index: []int) -> X86Body {
    if function.parameter_count < 0 or function.parameter_count > 15 or
        function.block_count < 7 or (plain_limit < 0 and (function.block_count - 1) % 3 != 0) or
        function.value_start < 0 or function.value_count < 1 or function.value_count > 127 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain requires at most fifteen parameters, 3N+1 blocks, and 127 values"))
    }
    let mut loop_count = (function.block_count - 1) / 3
    if plain_limit >= 0 {
        if plain_limit < 1 or plain_limit > loop_count {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 guarded chain plain group limit is out of range"))
        }
        loop_count = plain_limit
    }
    if function.entry_block < 0 or function.entry_block + function.block_count - 1 >= len(blocks) {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain blocks are out of range"))
    }
    let mut shape_index = 0
    let mut shape_ok = true
    while shape_index < function.block_count {
        let block = blocks[function.entry_block + shape_index]
        if block.instruction_start < 0 or block.instruction_count < 1 or
            block.terminator != block.instruction_start + block.instruction_count - 1 or
            block.terminator >= len(instructions) or block.successor_start < 0 or
            block.successor_start + block.successor_count > len(successors) {
            shape_ok = false
        }
        shape_index = shape_index + 1
    }
    if not shape_ok {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain blocks have an invalid instruction range"))
    }
    let entry = blocks[function.entry_block]
    let exit = blocks[function.entry_block + function.block_count - 1]
    let exit_return = instructions[exit.terminator]
    if entry.successor_count != 1 or
        (plain_limit < 0 and (exit.successor_count != 0 or exit_return.op != IR_RETURN or exit_return.left < 0)) or
        (plain_limit >= 0 and (exit.successor_count < 0 or exit.terminator < 0)) or
        successors[entry.successor_start] != function.entry_block + 1 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain entry or exit is invalid"))
    }
    // Every header must lead with the same number of integer block parameters.
    let mut parameter_count = 0
    let mut parameter_scan = blocks[function.entry_block + 1].instruction_start
    while parameter_scan < blocks[function.entry_block + 1].terminator and
        instructions[parameter_scan].op == IR_BLOCK_PARAM and
        instructions[parameter_scan].type_kind == SEM_INT and instructions[parameter_scan].aux == 0 {
        parameter_count = parameter_count + 1
        parameter_scan = parameter_scan + 1
    }
    if parameter_count < 1 {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain header must start with an integer block parameter"))
    }
    // Validate every group and gather jump arguments per header.
    let mut header_args: []int = make([]int, 0, loop_count * parameter_count)
    let mut group_index = 0
    while group_index < loop_count {
        let header = blocks[function.entry_block + 1 + 3 * group_index]
        let body = blocks[function.entry_block + 2 + 3 * group_index]
        let next = blocks[function.entry_block + 3 + 3 * group_index]
        let mut group_params = 0
        parameter_scan = header.instruction_start
        while parameter_scan < header.terminator and
            instructions[parameter_scan].op == IR_BLOCK_PARAM and
            instructions[parameter_scan].type_kind == SEM_INT and instructions[parameter_scan].aux == 0 {
            group_params = group_params + 1
            parameter_scan = parameter_scan + 1
        }
        if group_params != parameter_count or header.successor_count != 2 or
            successors[header.successor_start] != function.entry_block + 2 + 3 * group_index or
            successors[header.successor_start + 1] != function.entry_block + 3 + 3 * group_index or
            instructions[header.terminator].op != IR_BRANCH or instructions[header.terminator].left < 0 or
            body.successor_count != 1 or successors[body.successor_start] != function.entry_block + 1 + 3 * group_index {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain group is invalid"))
        }
        if group_index + 1 < loop_count or plain_limit >= 0 {
            if next.successor_count != 1 or successors[next.successor_start] != function.entry_block + 4 + 3 * group_index {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain junction is invalid"))
            }
        } else if next.successor_count != 0 or instructions[next.terminator].op != IR_RETURN {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain exit is invalid"))
        }
        let mut jump_index = 0
        while jump_index < (if group_index == 0 { 2 } else { 1 }) + (if group_index + 1 < loop_count or plain_limit >= 0 { 1 } else { 0 }) {
            // Per group, in order: the entry jump (group 0 only), the body
            // backedge, and the junction into the next header (non-last).
            let jump = if group_index == 0 and jump_index == 0 {
                instructions[entry.terminator]
            } else if (group_index == 0 and jump_index == 1) or (group_index > 0 and jump_index == 0) {
                instructions[body.terminator]
            } else {
                instructions[next.terminator]
            }
            if parameter_count == 1 {
                if jump.op != IR_JUMP or jump.left < 0 or jump.type_kind != SEM_INT {
                    return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain jumps must carry integer arguments"))
                }
                header_args = append(header_args, jump.left)
            } else {
                if jump.op != IR_JUMP or jump.left >= 0 or jump.aux < 0 or
                    jump.aux + parameter_count > len(jump_arguments) {
                    return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain jumps must carry matching integer arguments"))
                }
                let mut argument_index = 0
                while argument_index < parameter_count {
                    header_args = append(header_args, jump_arguments[jump.aux + argument_index])
                    argument_index = argument_index + 1
                }
            }
            jump_index = jump_index + 1
        }
        group_index = group_index + 1
    }
    // Slot maps: header parameters and the argument slots for entry, each
    // backedge, and each junction.
    let mut slot_count = function.value_count
    if parameter_count > 1 {
        slot_count = slot_count + parameter_count
    }
    if slot_count > 127 {
        return x86_plain_body(x86_error(X86_RANGE, "x86 loop value and scratch slots exceed the stack frame"))
    }
    let mut bytes: []int = make([]int, 0, 160)
    if not prologue_done {
        bytes = x86_emit_frame_prologue_sized(bytes, (8 * slot_count + 15) & 4294967280)
    }
    let mut edge_callees: []int = make([]int, 0, 2)
    let mut edge_fields: []int = make([]int, 0, 2)
    if entry_params < 0 or entry.instruction_start + entry_params > entry.terminator {
        return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain entry parameters are out of range"))
    }
    let mut entry_param_index = 0
    while entry_param_index < entry_params {
        let entry_param = instructions[entry.instruction_start + entry_param_index]
        if entry_param.op != IR_BLOCK_PARAM or entry_param.type_kind != SEM_INT or entry_param.aux != 0 {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain entry parameters must be integer block parameters"))
        }
        entry_param_index = entry_param_index + 1
    }
    let entry_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        entry.instruction_start + entry_params, entry.terminator, false
    , string_literals, constant_string_index)
    if entry_segment.code.status != X86_OK {
        return x86_plain_body(entry_segment.code)
    }
    let collected = x86_loop_collect_edges(entry_segment, len(bytes), edge_callees, edge_fields)
    edge_callees = collected.callees
    edge_fields = collected.fields
    bytes = x86_append_code(bytes, entry_segment.code)
    // Copy helper emission is inlined per jump below.
    let mut arg_index = 0
    if parameter_count == 1 {
        let arg_slot = header_args[0] - function.value_start + 1
        let param_slot = instructions[blocks[function.entry_block + 1].instruction_start].result - function.value_start + 1
        if arg_slot < 1 or arg_slot > function.value_count or param_slot < 1 or param_slot > function.value_count {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain slot is out of range"))
        }
        bytes = x86_emit_load_rax(bytes, arg_slot)
        bytes = x86_emit_store_rax(bytes, param_slot)
    } else {
        let mut copy_index = 0
        while copy_index < parameter_count {
            let arg_slot = header_args[copy_index] - function.value_start + 1
            if arg_slot < 1 or arg_slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain slot is out of range"))
            }
            bytes = x86_emit_load_rax(bytes, arg_slot)
            bytes = x86_emit_store_rax(bytes, function.value_count + 1 + copy_index)
            copy_index = copy_index + 1
        }
        copy_index = 0
        while copy_index < parameter_count {
            let param_slot = instructions[blocks[function.entry_block + 1].instruction_start + copy_index].result - function.value_start + 1
            if param_slot < 1 or param_slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain slot is out of range"))
            }
            bytes = x86_emit_load_rax(bytes, function.value_count + 1 + copy_index)
            bytes = x86_emit_store_rax(bytes, param_slot)
            copy_index = copy_index + 1
        }
    }
    arg_index = arg_index + parameter_count
    bytes = append(bytes, 233)
    let entry_jump_field = len(bytes)
    bytes = x86_emit_u32(bytes, 0)
    let header0_offset = len(bytes)
    bytes = x86_patch_u32(bytes, entry_jump_field, header0_offset - (entry_jump_field + 4))
    group_index = 0
    while group_index < loop_count {
        let header = blocks[function.entry_block + 1 + 3 * group_index]
        let body = blocks[function.entry_block + 2 + 3 * group_index]
        // The header segment starts here; its offset anchors the backedge.
        let this_header_offset = len(bytes)
        let header_branch = instructions[header.terminator]
        let condition_slot = header_branch.left - function.value_start + 1
        if condition_slot < 1 or condition_slot > function.value_count {
            return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain slot is out of range"))
        }
        let mut fused = false
        let mut false_jump = 116
        if header.instruction_count >= parameter_count + 2 {
            let candidate = instructions[header.terminator - 1]
            if candidate.op == IR_BINARY and candidate.type_kind == SEM_BOOL and candidate.result == header_branch.left {
                false_jump = x86_compare_false_jump(candidate.aux)
                if false_jump < 0 {
                    return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 compare operator is not implemented"))
                }
                fused = true
            }
        }
        let header_prefix_end = if fused { header.terminator - 1 } else { header.terminator }
        let header_segment = x86_emit_scalar_segment(
            instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
            header.instruction_start + parameter_count, header_prefix_end, false
        , string_literals, constant_string_index)
        if header_segment.code.status != X86_OK {
            return x86_plain_body(header_segment.code)
        }
        let collected2 = x86_loop_collect_edges(header_segment, len(bytes), edge_callees, edge_fields)
        edge_callees = collected2.callees
        edge_fields = collected2.fields
        bytes = x86_append_code(bytes, header_segment.code)
        if fused {
            let compare = instructions[header.terminator - 1]
            let left_slot = compare.left - function.value_start + 1
            let right_slot = compare.right - function.value_start + 1
            if left_slot < 1 or left_slot >= condition_slot or right_slot < 1 or right_slot >= condition_slot {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop compare operand is not an earlier value"))
            }
            bytes = x86_emit_load_rax(bytes, left_slot)
            bytes = x86_emit_cmp_mem(bytes, right_slot)
        } else {
            bytes = x86_emit_load_rax(bytes, condition_slot)
            bytes = append(bytes, 72)
            bytes = append(bytes, 133)
            bytes = append(bytes, 192)
        }
        bytes = append(bytes, 15)
        bytes = append(bytes, false_jump + 16)
        let next_jcc_field = len(bytes)
        bytes = x86_emit_u32(bytes, 0)
        let body_segment = x86_emit_scalar_segment(
            instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
            body.instruction_start, body.terminator, false
        , string_literals, constant_string_index)
        if body_segment.code.status != X86_OK {
            return x86_plain_body(body_segment.code)
        }
        let collected3 = x86_loop_collect_edges(body_segment, len(bytes), edge_callees, edge_fields)
        edge_callees = collected3.callees
        edge_fields = collected3.fields
        bytes = x86_append_code(bytes, body_segment.code)
        if parameter_count == 1 {
            let arg_slot = header_args[arg_index] - function.value_start + 1
            let param_slot = instructions[header.instruction_start].result - function.value_start + 1
            if arg_slot < 1 or arg_slot > function.value_count {
                return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain slot is out of range"))
            }
            bytes = x86_emit_load_rax(bytes, arg_slot)
            bytes = x86_emit_store_rax(bytes, param_slot)
        } else {
            let mut copy_index = 0
            while copy_index < parameter_count {
                let arg_slot = header_args[arg_index + copy_index] - function.value_start + 1
                if arg_slot < 1 or arg_slot > function.value_count {
                    return x86_plain_body(x86_error(X86_UNSUPPORTED, "x86 loop chain slot is out of range"))
                }
                bytes = x86_emit_load_rax(bytes, arg_slot)
                bytes = x86_emit_store_rax(bytes, function.value_count + 1 + copy_index)
                copy_index = copy_index + 1
            }
            copy_index = 0
            while copy_index < parameter_count {
                let param_slot = instructions[header.instruction_start + copy_index].result - function.value_start + 1
                bytes = x86_emit_load_rax(bytes, function.value_count + 1 + copy_index)
                bytes = x86_emit_store_rax(bytes, param_slot)
                copy_index = copy_index + 1
            }
        }
        arg_index = arg_index + parameter_count
        bytes = append(bytes, 233)
        let back_jump_field = len(bytes)
        bytes = x86_emit_u32(bytes, 0)
        bytes = x86_patch_u32(bytes, back_jump_field, this_header_offset - (back_jump_field + 4))
        let next_offset = len(bytes)
        bytes = x86_patch_u32(bytes, next_jcc_field, next_offset - (next_jcc_field + 4))
        if group_index + 1 < loop_count or plain_limit >= 0 {
            // Junction: copy this loop's final parameters into the next
            // header's parameter slots.
            let next_header = blocks[function.entry_block + 4 + 3 * group_index]
            if parameter_count == 1 {
                let arg_slot = header_args[arg_index] - function.value_start + 1
                let param_slot = instructions[next_header.instruction_start].result - function.value_start + 1
                bytes = x86_emit_load_rax(bytes, arg_slot)
                bytes = x86_emit_store_rax(bytes, param_slot)
            } else {
                let mut copy_index = 0
                while copy_index < parameter_count {
                    let arg_slot = header_args[arg_index + copy_index] - function.value_start + 1
                    bytes = x86_emit_load_rax(bytes, arg_slot)
                    bytes = x86_emit_store_rax(bytes, function.value_count + 1 + copy_index)
                    copy_index = copy_index + 1
                }
                copy_index = 0
                while copy_index < parameter_count {
                    let param_slot = instructions[next_header.instruction_start + copy_index].result - function.value_start + 1
                    bytes = x86_emit_load_rax(bytes, function.value_count + 1 + copy_index)
                    bytes = x86_emit_store_rax(bytes, param_slot)
                    copy_index = copy_index + 1
                }
            }
            arg_index = arg_index + parameter_count
            bytes = append(bytes, 233)
            let junction_jump_field = len(bytes)
            bytes = x86_emit_u32(bytes, 0)
            let next_header_offset = len(bytes)
            bytes = x86_patch_u32(bytes, junction_jump_field, next_header_offset - (junction_jump_field + 4))
        }
        group_index = group_index + 1
    }
    if plain_limit >= 0 {
        // The last plain group's junction is the guarded group's entry block;
        // delegate the rest of the function to the guarded-loop lowering.
        let guarded_function = IrFunction {
            item: function.item, entry_block: function.entry_block + 3 * plain_limit,
            block_count: function.block_count - 3 * plain_limit,
            parameter_count: function.parameter_count,
            value_start: function.value_start, value_count: function.value_count,
        }
        let guarded = x86_lower_guarded_loop(
            instructions, constants, blocks, successors, call_sites, call_arguments,
            jump_arguments, functions, guarded_function, 0, true
        , string_literals, constant_string_index)
        if guarded.code.status != X86_OK {
            return guarded
        }
        let mut merge_index = 0
        while merge_index < len(guarded.edge_callees) {
            edge_callees = append(edge_callees, guarded.edge_callees[merge_index])
            edge_fields = append(edge_fields, guarded.edge_fields[merge_index] + len(bytes))
            merge_index = merge_index + 1
        }
        bytes = x86_append_code(bytes, guarded.code)
        return X86Body {
            code: X86Code { bytes: bytes, status: X86_OK, error: "" },
            edge_callees: edge_callees, edge_fields: edge_fields,
        }
    }
    let exit_segment = x86_emit_scalar_segment(
        instructions, constants, call_sites, call_arguments, jump_arguments, functions, function,
        exit.instruction_start, exit.instruction_start + exit.instruction_count, true
    , string_literals, constant_string_index)
    if exit_segment.code.status != X86_OK {
        return x86_plain_body(exit_segment.code)
    }
    let collected9 = x86_loop_collect_edges(exit_segment, len(bytes), edge_callees, edge_fields)
    edge_callees = collected9.callees
    edge_fields = collected9.fields
    bytes = x86_append_code(bytes, exit_segment.code)
    return X86Body {
        code: X86Code { bytes: bytes, status: X86_OK, error: "" },
        edge_callees: edge_callees, edge_fields: edge_fields,
    }
}

fn x86_64_smoke_test() -> bool {
    let code = x86_emit_return_int(42)
    if code.status != X86_OK or len(code.bytes) != 6 {
        return false
    }
    if code.bytes[0] != 184 or code.bytes[1] != 42 or code.bytes[2] != 0 or code.bytes[3] != 0 or code.bytes[4] != 0 or code.bytes[5] != 195 {
        return false
    }
    let bad = x86_emit_return_int(-1)
    if bad.status != X86_RANGE {
        return false
    }
    let instructions: []IrInstruction = make([]IrInstruction, 0, 2)
    let constants: []IrConstant = make([]IrConstant, 0, 1)
    let mut ir_instructions = append(instructions, IrInstruction {
        op: IR_CONST, result: 0, type_kind: SEM_INT,
        left: -1, right: -1, aux: 0, token: 0,
    })
    ir_instructions = append(ir_instructions, IrInstruction {
        op: IR_RETURN, result: -1, type_kind: SEM_INT,
        left: 0, right: -1, aux: -1, token: 0,
    })
    let ir_constants = append(constants, IrConstant {
        type_kind: SEM_INT, int_value: 7, float_value: 0.0,
        start: 0, end: 1,
    })
    let lowered = x86_lower_const_return(ir_instructions, ir_constants, 0, 2)
    if lowered.status != X86_OK or len(lowered.bytes) != 6 or lowered.bytes[1] != 7 {
        return false
    }
    let mut add_instructions: []IrInstruction = make([]IrInstruction, 0, 4)
    add_instructions = append(add_instructions, IrInstruction { op: IR_CONST, result: 0, type_kind: SEM_INT, left: -1, right: -1, aux: 0, token: 0 })
    add_instructions = append(add_instructions, IrInstruction { op: IR_CONST, result: 1, type_kind: SEM_INT, left: -1, right: -1, aux: 1, token: 0 })
    add_instructions = append(add_instructions, IrInstruction { op: IR_BINARY, result: 2, type_kind: SEM_INT, left: 0, right: 1, aux: TK_PLUS, token: 0 })
    add_instructions = append(add_instructions, IrInstruction { op: IR_RETURN, result: -1, type_kind: SEM_INT, left: 2, right: -1, aux: -1, token: 0 })
    let mut add_constants: []IrConstant = make([]IrConstant, 0, 2)
    add_constants = append(add_constants, IrConstant { type_kind: SEM_INT, int_value: 40, float_value: 0.0, start: 0, end: 2 })
    add_constants = append(add_constants, IrConstant { type_kind: SEM_INT, int_value: 2, float_value: 0.0, start: 0, end: 1 })
    let add = x86_lower_const_add_return(add_instructions, add_constants, 0, 4)
    if add.status != X86_OK or len(add.bytes) != 11 or add.bytes[1] != 40 or add.bytes[5] != 5 or add.bytes[6] != 2 or add.bytes[10] != 195 {
        return false
    }
    let branch = x86_emit_select_return(42, 7)
    if branch.status != X86_OK or len(branch.bytes) != 16 or branch.bytes[0] != 133 or branch.bytes[1] != 255 or branch.bytes[2] != 116 or branch.bytes[3] != 6 or branch.bytes[4] != 184 or branch.bytes[9] != 195 or branch.bytes[10] != 184 or branch.bytes[15] != 195 {
        return false
    }
    if branch.bytes[5] != 7 or branch.bytes[11] != 42 {
        return false
    }
    let entry = x86_emit_argc_call_exit(branch.bytes)
    if entry.status != X86_OK or len(entry.bytes) != 33 {
        return false
    }
    if entry.bytes[0] != 139 or entry.bytes[1] != 60 or entry.bytes[2] != 36 or entry.bytes[3] != 232 or entry.bytes[4] != 9 or entry.bytes[8] != 137 or entry.bytes[9] != 199 or entry.bytes[10] != 184 or entry.bytes[15] != 15 or entry.bytes[16] != 5 or entry.bytes[17] != 133 {
        return false
    }
    if x86_emit_argc_call_exit(make([]int, 0, 0)).status != X86_UNSUPPORTED {
        return false
    }
    let mut branch_instructions: []IrInstruction = make([]IrInstruction, 0, 6)
    branch_instructions = append(branch_instructions, IrInstruction { op: IR_PARAM, result: 0, type_kind: SEM_BOOL, left: -1, right: -1, aux: 0, token: 0 })
    branch_instructions = append(branch_instructions, IrInstruction { op: IR_BRANCH, result: -1, type_kind: SEM_BOOL, left: 0, right: -1, aux: -1, token: 0 })
    branch_instructions = append(branch_instructions, IrInstruction { op: IR_CONST, result: 1, type_kind: SEM_INT, left: -1, right: -1, aux: 0, token: 0 })
    branch_instructions = append(branch_instructions, IrInstruction { op: IR_RETURN, result: -1, type_kind: SEM_INT, left: 1, right: -1, aux: -1, token: 0 })
    branch_instructions = append(branch_instructions, IrInstruction { op: IR_CONST, result: 2, type_kind: SEM_INT, left: -1, right: -1, aux: 1, token: 0 })
    branch_instructions = append(branch_instructions, IrInstruction { op: IR_RETURN, result: -1, type_kind: SEM_INT, left: 2, right: -1, aux: -1, token: 0 })
    let mut branch_blocks: []IrBlock = make([]IrBlock, 0, 3)
    branch_blocks = append(branch_blocks, IrBlock { function: 0, instruction_start: 0, instruction_count: 2, terminator: 1, successor_start: 0, successor_count: 2 })
    branch_blocks = append(branch_blocks, IrBlock { function: 0, instruction_start: 2, instruction_count: 2, terminator: 3, successor_start: 2, successor_count: 0 })
    branch_blocks = append(branch_blocks, IrBlock { function: 0, instruction_start: 4, instruction_count: 2, terminator: 5, successor_start: 2, successor_count: 0 })
    let mut branch_successors: []int = make([]int, 0, 2)
    branch_successors = append(branch_successors, 1)
    branch_successors = append(branch_successors, 2)
    let branch_function = IrFunction { item: 0, entry_block: 0, block_count: 3, parameter_count: 1, value_start: 0, value_count: 3 }
    let branch_lowered = x86_lower_branch_return(branch_instructions, add_constants, branch_blocks, branch_successors, branch_function)
    if branch_lowered.status != X86_OK or len(branch_lowered.bytes) != 16 or branch_lowered.bytes[5] != 40 or branch_lowered.bytes[11] != 2 {
        return false
    }
    let scalar_parameter = IrFunction { item: 0, entry_block: 0, block_count: 3, parameter_count: 2, value_start: 0, value_count: 3 }
    if x86_lower_branch_return(branch_instructions, add_constants, branch_blocks, branch_successors, scalar_parameter).status != X86_UNSUPPORTED {
        return false
    }
    if x86_compare_false_jump(TK_GT) != 126 or x86_compare_false_jump(TK_GE) != 124 or
        x86_compare_false_jump(TK_LT) != 125 or x86_compare_false_jump(TK_LE) != 127 or
        x86_compare_false_jump(TK_EQ_EQ) != 117 or x86_compare_false_jump(TK_BANG_EQ) != 116 or
        x86_compare_false_jump(TK_PLUS) != -1 {
        return false
    }
    let compared = x86_emit_compare_return(7, 42, 126, 1)
    if compared.status != X86_OK or len(compared.bytes) != 21 {
        return false
    }
    if compared.bytes[0] != 72 or compared.bytes[1] != 129 or compared.bytes[2] != 255 or
        compared.bytes[3] != 1 or compared.bytes[7] != 126 or compared.bytes[8] != 6 or
        compared.bytes[9] != 184 or compared.bytes[10] != 42 or compared.bytes[14] != 195 or
        compared.bytes[15] != 184 or compared.bytes[16] != 7 or compared.bytes[20] != 195 {
        return false
    }
    let negative_immediate = x86_emit_compare_return(0, 1, 126, -1)
    if negative_immediate.status != X86_OK or negative_immediate.bytes[3] != 255 or
        negative_immediate.bytes[4] != 255 or negative_immediate.bytes[5] != 255 or
        negative_immediate.bytes[6] != 255 {
        return false
    }
    if x86_emit_compare_return(0, 1, 126, 2147483648).status != X86_RANGE or
        x86_emit_compare_return(0, 1, 126, -2147483649).status != X86_RANGE {
        return false
    }
    let identity_body = x86_emit_param_return()
    if identity_body.status != X86_OK or len(identity_body.bytes) != 3 or
        identity_body.bytes[0] != 137 or identity_body.bytes[1] != 248 or identity_body.bytes[2] != 195 {
        return false
    }
    let call_body = x86_emit_const_call_return(1, -13)
    if call_body.status != X86_OK or len(call_body.bytes) != 11 or call_body.bytes[0] != 191 or
        call_body.bytes[1] != 1 or call_body.bytes[5] != 232 or call_body.bytes[6] != 243 or
        call_body.bytes[7] != 255 or call_body.bytes[10] != 195 {
        return false
    }
    if x86_emit_const_call_return(4294967296, 0).status != X86_RANGE {
        return false
    }
    let param_add = x86_emit_param_op_return(TK_PLUS, 1)
    if param_add.status != X86_OK or len(param_add.bytes) != 10 or param_add.bytes[0] != 72 or
        param_add.bytes[1] != 137 or param_add.bytes[2] != 248 or param_add.bytes[3] != 72 or
        param_add.bytes[4] != 5 or param_add.bytes[5] != 1 or param_add.bytes[9] != 195 {
        return false
    }
    let param_sub = x86_emit_param_op_return(TK_MINUS, 1)
    if param_sub.status != X86_OK or len(param_sub.bytes) != 10 or param_sub.bytes[4] != 45 {
        return false
    }
    let param_mul = x86_emit_param_op_return(TK_STAR, 21)
    if param_mul.status != X86_OK or len(param_mul.bytes) != 11 or param_mul.bytes[4] != 105 or
        param_mul.bytes[5] != 192 or param_mul.bytes[6] != 21 or param_mul.bytes[10] != 195 {
        return false
    }
    if x86_emit_param_op_return(TK_SLASH, 1).status != X86_UNSUPPORTED {
        return false
    }
    let call_add = x86_emit_call_op_return(40, -20, TK_PLUS, 1)
    if call_add.status != X86_OK or len(call_add.bytes) != 17 or call_add.bytes[0] != 191 or
        call_add.bytes[1] != 40 or call_add.bytes[5] != 232 or call_add.bytes[6] != 236 or
        call_add.bytes[10] != 72 or call_add.bytes[11] != 5 or call_add.bytes[12] != 1 or
        call_add.bytes[16] != 195 {
        return false
    }
    let call_sub = x86_emit_call_op_return(50, -20, TK_MINUS, 8)
    if call_sub.status != X86_OK or len(call_sub.bytes) != 17 or call_sub.bytes[11] != 45 or
        call_sub.bytes[12] != 8 {
        return false
    }
    if x86_emit_param_op_return(TK_PLUS, 2147483648).status != X86_RANGE or
        x86_emit_call_op_return(0, 0, TK_PLUS, 2147483648).status != X86_RANGE {
        return false
    }
    let param_add_param = x86_emit_param_op_param_return(TK_PLUS)
    if param_add_param.status != X86_OK or len(param_add_param.bytes) != 7 or
        param_add_param.bytes[0] != 72 or param_add_param.bytes[1] != 137 or param_add_param.bytes[2] != 248 or
        param_add_param.bytes[3] != 72 or param_add_param.bytes[4] != 1 or param_add_param.bytes[5] != 240 or
        param_add_param.bytes[6] != 195 {
        return false
    }
    let param_sub_param = x86_emit_param_op_param_return(TK_MINUS)
    if param_sub_param.status != X86_OK or len(param_sub_param.bytes) != 7 or
        param_sub_param.bytes[4] != 41 or param_sub_param.bytes[5] != 240 {
        return false
    }
    let param_mul_param = x86_emit_param_op_param_return(TK_STAR)
    if param_mul_param.status != X86_OK or len(param_mul_param.bytes) != 8 or
        param_mul_param.bytes[3] != 72 or param_mul_param.bytes[4] != 15 or
        param_mul_param.bytes[5] != 175 or param_mul_param.bytes[6] != 198 or
        param_mul_param.bytes[7] != 195 {
        return false
    }
    let call2 = x86_emit_const_call2_return(40, 2, -22)
    if call2.status != X86_OK or len(call2.bytes) != 16 or call2.bytes[0] != 191 or
        call2.bytes[1] != 40 or call2.bytes[5] != 190 or call2.bytes[6] != 2 or
        call2.bytes[10] != 232 or call2.bytes[11] != 234 or call2.bytes[12] != 255 or
        call2.bytes[15] != 195 {
