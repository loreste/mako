        two_call.bytes[20] != 69 or two_call.bytes[21] != 248 or two_call.bytes[22] != 191 or
        two_call.bytes[23] != 2 or two_call.bytes[27] != 232 or two_call.bytes[32] != 72 or
        two_call.bytes[33] != 3 or two_call.bytes[34] != 69 or two_call.bytes[35] != 248 or
        two_call.bytes[36] != 201 or two_call.bytes[37] != 195 {
