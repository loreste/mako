// Target-independent typed IR. This bootstrap slice lowers only straight-line
// functions whose parameters and attached expressions have known semantic
// types. Unsupported control flow is skipped until CFG construction lands;
// it is never silently represented as a linear block.

const IR_PARAM = 1
const IR_CONST = 2
const IR_UNARY = 3
const IR_BINARY = 4
const IR_CALL = 5
const IR_ARRAY = 6
const IR_INDEX = 7
const IR_SLICE = 8
const IR_MAKE = 9
const IR_RETURN = 10
const IR_BRANCH = 11
const IR_JUMP = 12
const IR_BLOCK_PARAM = 13
const IR_MOVE = 14
const IR_DROP = 15
const IR_CLONE = 16
const IR_PRINT = 17
const IR_EXIT = 18
const IR_LEN = 19
// A field of an element of a slice of structs, read as one addressed load.
// `left` is the slice, `right` the index, and `aux` packs the element width in
// slots with the field's slot so the encoder needs no struct table:
//     aux = field_count * IR_FIELD_AUX_UNIT + field_slot
const IR_FIELD = 20
const IR_FIELD_AUX_UNIT = 64

// Address of one element of a slice of structs, bounds-checked. It exists so a
// borrowed element can be handed to a struct parameter: `left` is the slice,
// `right` the index, `aux` the stride in bytes. The result is a pointer the
// callee may read fields through and must never free.
const IR_ELEM_ADDR = 21

struct IrInstruction {
    op: int
    result: int
    type_kind: int
    left: int
    right: int
    aux: int
    token: int
}

struct IrConstant {
    type_kind: int
    int_value: int
    float_value: float
    start: int
    end: int
}

struct IrBlock {
    function: int
    instruction_start: int
    instruction_count: int
    terminator: int
    successor_start: int
    successor_count: int
}

struct IrFunction {
    item: int
    entry_block: int
    block_count: int
    parameter_count: int
    value_start: int
    value_count: int
}

struct IrCallSite {
    callee_item: int
    argument_start: int
    argument_count: int
}

struct TypedIr {
    functions: []IrFunction
    blocks: []IrBlock
    instructions: []IrInstruction
    constants: []IrConstant
    successors: []int
    call_sites: []IrCallSite
    call_arguments: []int
    jump_arguments: []int
    string_literals: []string
    constant_string_index: []int
    expression_values: []int
    value_count: int
    skipped_functions: int
    // Why each declined function declined, joined for diagnostics only.
    // Never read on the success path, so it cannot affect lowering.
    skip_reason: string
    ok: bool
    error: string
}

struct IrVerification {
    ok: bool
    error: string
    checked_values: int
}

// True when an expression kind is allowed to emit no instruction of its own.
// An identifier aliases a binding, a type reference is part of the `make` it
// belongs to, and a call chain's inner links are consumed by the terminal
// call. Every other kind must produce an instruction, or lowering has silently
// dropped part of the program.
// Packed aux for a fused `slice[i].field`, or -1 when the expression is not
// that shape or names a field the struct does not have.
// The struct-slice index expression a field read reaches, following one hop
// through an immutable local bound directly to an element:
//
//     let node = types[root]
//     ... node.kind ...
//
// Forwarding the (slice, index) pair means no struct value is ever
// materialised, so each field read is the same fused load as the direct form.
// A `mut` local is refused: it could be rebound after the read's operands were
// captured, and the read would then answer for the wrong element.
fn ir_field_object_index(
    source: string, tokens: []Token, expressions: []ExprNode, expression_types: []int,
    expression_locals: []int, locals: []LocalBinding, object_expression: int
) -> int {
    if object_expression < 0 or object_expression >= len(expressions) { return -1 }
    let object = expressions[object_expression]
    if object.kind == EXPR_INDEX { return object_expression }
    if object.kind != EXPR_IDENT { return -1 }
    let binding = if object_expression < len(expression_locals) { expression_locals[object_expression] } else { -1 }
    if binding < 0 or binding >= len(locals) { return -1 }
    let local = locals[binding]
    if local.is_parameter { return -1 }
    let initializer = local.initializer_root
    if initializer < 0 or initializer >= len(expressions) { return -1 }
    if expressions[initializer].kind != EXPR_INDEX { return -1 }
    // The declaration must not be `let mut`: find the name token and look at
    // the one before it.
    let mut name_token = -1
    let mut scan = 0
    while scan < len(tokens) {
        if tokens[scan].start == local.name_start and tokens[scan].end == local.name_end {
            name_token = scan
            scan = len(tokens)
        } else {
            scan = scan + 1
        }
    }
    if name_token <= 0 or tokens[name_token - 1].kind == TK_MUT { return -1 }
    return initializer
}

fn ir_struct_field_aux(
    source: string, tokens: []Token, expressions: []ExprNode, expression_types: []int,
    expression_locals: []int, locals: []LocalBinding,
    layout: StructLayout, field_expression: int
) -> int {
    if field_expression < 0 or field_expression >= len(expressions) { return -1 }
    let node = expressions[field_expression]
    if node.kind != EXPR_FIELD or node.left < 0 or node.left >= len(expressions) { return -1 }
    if node.token < 0 or node.token >= len(tokens) { return -1 }
    let object_index = ir_field_object_index(source, tokens, expressions, expression_types, expression_locals, locals, node.left)
    if object_index < 0 {
        // No index underneath: the object is itself one borrowed element, so
        // its own type names the struct and the read is a plain offset load.
        let object_kind = if node.left < len(expression_types) { expression_types[node.left] } else { SEM_UNKNOWN }
        if not semantic_is_struct_value(object_kind) { return -1 }
        let borrowed_fields = struct_kind_fields(object_kind)
        if borrowed_fields < 1 or borrowed_fields >= IR_FIELD_AUX_UNIT { return -1 }
        let borrowed_slot = struct_field_slot(layout, source, struct_kind_index(object_kind), token_text(source, tokens[node.token]))
        if borrowed_slot < 0 or borrowed_slot >= borrowed_fields { return -1 }
        return borrowed_fields * IR_FIELD_AUX_UNIT + borrowed_slot
    }
    let object = expressions[object_index]
    if object.kind != EXPR_INDEX or object.left < 0 or object.left >= len(expression_types) { return -1 }
    let slice_kind = expression_types[object.left]
    if not semantic_is_struct_array(slice_kind) { return -1 }
    let fields = struct_kind_fields(slice_kind)
    if fields < 1 or fields >= IR_FIELD_AUX_UNIT { return -1 }
    let slot = struct_field_slot(layout, source, struct_kind_index(slice_kind), token_text(source, tokens[node.token]))
    if slot < 0 or slot >= fields { return -1 }
    return fields * IR_FIELD_AUX_UNIT + slot
}

// True when a struct-slice index must materialise as `IR_ELEM_ADDR` rather
// than being fused into a field read. Call arguments and local bindings need a
// free-standing pointer; an index that is *only* the object of field reads
// does not — and must not, because an address temporary is typed as an owned
// struct value and the ownership verifier would then demand a consumer the
// field load does not provide.
fn ir_struct_index_needs_address(
    expressions: []ExprNode, expression_locals: []int, locals: []LocalBinding, index_expression: int
) -> bool {
    if ir_expression_is_call_argument(expressions, index_expression) { return true }
    let mut local_index = 0
    while local_index < len(locals) {
        if locals[local_index].initializer_root == index_expression and not locals[local_index].is_parameter {
            return true
        }
        local_index = local_index + 1
    }
    let mut i = 0
    while i < len(expressions) {
        if i != index_expression and (expressions[i].left == index_expression or expressions[i].right == index_expression) {
            if expressions[i].kind != EXPR_FIELD or expressions[i].left != index_expression {
                return true
            }
        }
        i = i + 1
    }
    return false
}

// True when this index expression is the object of some field read, or a call
// argument, which are the positions a matched-path struct-slice index may
// appear in without materialising a free-standing value of its own.
fn ir_index_is_field_object(
    expressions: []ExprNode, expression_locals: []int, locals: []LocalBinding, index_expression: int
) -> bool {
    let mut i = 0
    while i < len(expressions) {
        if expressions[i].kind == EXPR_FIELD and expressions[i].left == index_expression { return true }
        i = i + 1
    }
    // A bare `take(pts[0])` materialises the element address at the call site.
    if ir_expression_is_call_argument(expressions, index_expression) { return true }
    // Or it initialises a local, in which case every reference to that local
    // has to be a field object or call argument too.
    let mut binding = -1
    let mut local_index = 0
    while local_index < len(locals) {
        if locals[local_index].initializer_root == index_expression and not locals[local_index].is_parameter {
            binding = local_index
        }
        local_index = local_index + 1
    }
    if binding < 0 { return false }
    let mut reference = 0
    let mut seen = false
    while reference < len(expressions) {
        if expressions[reference].kind == EXPR_IDENT and reference < len(expression_locals) and
            expression_locals[reference] == binding {
            seen = true
            // A reference may be a field object, or a call argument, where the
            // element's address is materialised and passed as a borrow.
            if not ir_index_is_field_object_of(expressions, reference) and
                not ir_expression_is_call_argument(expressions, reference) { return false }
        }
        reference = reference + 1
    }
    return seen
}

// True when some call names this node as an argument. Arguments hang off a
// chain link's right edge, one per link.
//
// A string argument is cloned at the call site and that clone always allocates,
// so a literal in argument position has a reader that turns it into something
// the callee can own — which is what lets one lower even though it is not the
// range's `owned_root`.
fn ir_expression_is_call_argument(expressions: []ExprNode, candidate: int) -> bool {
    if candidate < 0 { return false }
    let mut i = 0
    while i < len(expressions) {
        if expressions[i].kind == EXPR_CALL and expressions[i].right == candidate { return true }
        i = i + 1
    }
    return false
}

fn ir_index_is_field_object_of(expressions: []ExprNode, object_expression: int) -> bool {
    let mut i = 0
    while i < len(expressions) {
        if expressions[i].kind == EXPR_FIELD and expressions[i].left == object_expression { return true }
        i = i + 1
    }
    return false
}

fn ir_expression_emits_nothing(kind: int) -> bool {
    return kind == EXPR_IDENT or kind == EXPR_TYPE_REF
}

fn ir_expression_opcode(kind: int) -> int {
    if kind == EXPR_INT or kind == EXPR_FLOAT or kind == EXPR_BOOL or kind == EXPR_STRING { return IR_CONST }
    if kind == EXPR_UNARY { return IR_UNARY }
    if kind == EXPR_BINARY { return IR_BINARY }
    if kind == EXPR_CALL { return IR_CALL }
    if kind == EXPR_ARRAY { return IR_ARRAY }
    if kind == EXPR_INDEX { return IR_INDEX }
    if kind == EXPR_SLICE { return IR_SLICE }
    if kind == EXPR_MAKE { return IR_MAKE }
    if kind == EXPR_FIELD { return IR_FIELD }
    return 0
}

fn ir_type_is_owned(kind: int) -> bool {
    // A slice of an eligible struct is a plain heap block: every element is
    // scalar, so it drops as one allocation and no element needs a drop of its
    // own. It is owned for the same reason []int is.
    // `[]byte` belongs here for the same reason `[]int` does: `make` and
    // `append` are its only producers and both allocate. Leaving it out meant
    // no `IR_DROP` was ever emitted for one, so every `make([]byte, n)` leaked
    // its block — one mmap and no munmap, measured. It also made `[]byte`
    // unbindable in the general path, since that asks for a scalar or an owned
    // type and this was neither.
    // A struct value is owned when the program constructed it and borrowed when
    // it points into a slice. Both share a kind, so the IR emits a drop for
    // either and the backend refuses to unmap a borrow — the same split that
    // lets a string literal carry a drop that frees nothing.
    if semantic_is_struct_value(kind) { return true }
    return kind == SEM_STRING or kind == SEM_ARRAY_INT or kind == SEM_ARRAY_BYTE or
        kind == SEM_ARRAY_FLOAT or
        kind == SEM_ARRAY_BOOL or kind == SEM_ARRAY_STRING or kind == SEM_MAP or
        semantic_is_struct_array(kind)
}

fn ir_instruction_consumes_left(instruction: IrInstruction, instructions: []IrInstruction, definitions: []int) -> bool {
    if instruction.left < 0 or instruction.left >= len(definitions) or definitions[instruction.left] <= 0 { return false }
    let source_type = instructions[definitions[instruction.left] - 1].type_kind
    return instruction.op == IR_MOVE or instruction.op == IR_DROP or instruction.op == IR_SLICE or
        ((instruction.op == IR_ARRAY or instruction.op == IR_RETURN or instruction.op == IR_JUMP) and
            ir_type_is_owned(source_type))
}

fn ir_instruction_consumes_right(instruction: IrInstruction, instructions: []IrInstruction, definitions: []int) -> bool {
    if instruction.op != IR_ARRAY or instruction.right < 0 or instruction.right >= len(definitions) or
        definitions[instruction.right] <= 0 { return false }
    return ir_type_is_owned(instructions[definitions[instruction.right] - 1].type_kind)
}

fn ir_instruction_list_consumes_value(
    instructions: []IrInstruction,
    call_sites: []IrCallSite,
    call_arguments: []int,
    value: int
) -> bool {
    return ir_instruction_range_consumes_value(
        instructions, call_sites, call_arguments, 0, len(instructions), value
    )
}

fn ir_instruction_range_consumes_value(
    instructions: []IrInstruction,
    call_sites: []IrCallSite,
    call_arguments: []int,
    start: int,
    end: int,
    value: int
) -> bool {
    let mut instruction_index = start
    while instruction_index < end {
        let instruction = instructions[instruction_index]
        if instruction.left == value and
            (instruction.op == IR_MOVE or instruction.op == IR_DROP or
                instruction.op == IR_SLICE or instruction.op == IR_ARRAY) {
            return true
        }
        if instruction.right == value and instruction.op == IR_ARRAY { return true }
        if instruction.op == IR_CALL and instruction.aux >= 0 and instruction.aux < len(call_sites) and
            ir_call_consumes_arguments(call_sites[instruction.aux].callee_item,
                ir_cfg_value_type(instructions, value)) {
            let call_site = call_sites[instruction.aux]
            let mut argument_index = call_site.argument_start
            while argument_index < call_site.argument_start + call_site.argument_count {
                if call_arguments[argument_index] == value { return true }
                argument_index = argument_index + 1
            }
        }
        instruction_index = instruction_index + 1
    }
    return false
}

fn verify_owned_ir_paths(
    functions: []IrFunction,
    blocks: []IrBlock,
    instructions: []IrInstruction,
    successors: []int,
    call_sites: []IrCallSite,
    call_arguments: []int,
    jump_arguments: []int,
    definitions: []int
) -> IrVerification {
    let mut value = 0
    while value < len(definitions) {
        let definition = definitions[value] - 1
        if definition >= 0 and ir_type_is_owned(instructions[definition].type_kind) {
            let function_index = blocks[instruction_block(instructions, blocks, definition)].function
            let function = functions[function_index]
            let mut queue_blocks: []int = []
            let mut queue_states: []int = []
            let mut seen = make([]int, len(blocks) * 3, len(blocks) * 3)
            queue_blocks = append(queue_blocks, function.entry_block)
            queue_states = append(queue_states, 0)
            let mut queue_index = 0
            while queue_index < len(queue_blocks) {
                let block_index = queue_blocks[queue_index]
                let mut state = queue_states[queue_index]
                queue_index = queue_index + 1
                let seen_index = block_index * 3 + state
                if seen[seen_index] != 0 { continue }
                seen[seen_index] = 1
                let block = blocks[block_index]
                let mut instruction_index = block.instruction_start
                while instruction_index < block.instruction_start + block.instruction_count {
                    let instruction = instructions[instruction_index]
                    if instruction.result == value {
                        // Reaching a definition again is only an error while the
                        // previous value is still *live* (state 1) — that would
                        // lose an allocation nothing ever frees. Reaching it
                        // with the previous value already consumed (state 2) is
                        // a loop body re-entered through its backedge, which
                        // allocates afresh each iteration after dropping what
                        // the last one made.
                        if state == 1 and instructions[definition].op != IR_CONST {
                            return IrVerification { ok: false, error: "IR owned value is defined more than once on a path", checked_values: 0 }
                        }
                        // A constant re-materializes on every loop iteration;
                        // it is immutable compile-time data (a static view in
                        // the backend), so re-entering its definition through
                        // a backedge is fresh, never a double definition.
                        state = 1
                    }
                    if instruction.left == value or instruction.right == value {
                        if state == 0 {
                            return IrVerification { ok: false, error: "IR instruction uses undefined owned value on a path", checked_values: 0 }
                        }
                        if state == 2 {
                            let message = if instruction.op == IR_DROP { "IR owned value is dropped twice" } else { "IR instruction uses consumed owned value" }
                            return IrVerification { ok: false, error: message, checked_values: 0 }
                        }
                    }
                    if instruction.op == IR_CALL and instruction.aux >= 0 and instruction.aux < len(call_sites) {
                        let call_site = call_sites[instruction.aux]
                        let mut argument_index = call_site.argument_start
                        while argument_index < call_site.argument_start + call_site.argument_count {
                            if call_arguments[argument_index] == value {
                                if state == 0 {
                                    return IrVerification { ok: false, error: "IR call uses undefined owned value on a path", checked_values: 0 }
                                }
                                if state == 2 {
                                    return IrVerification { ok: false, error: "IR call uses consumed owned value", checked_values: 0 }
                                }
                                // A borrowing intrinsic reads through the value
                                // and leaves it with its owner, so the caller
                                // still has to drop it and may still use it.
                                if ir_call_consumes_arguments(call_site.callee_item,
                                    instructions[definition].type_kind) {
                                    state = 2
                                }
                            }
                            argument_index = argument_index + 1
                        }
                    }
                    if (instruction.left == value and ir_instruction_consumes_left(instruction, instructions, definitions)) or
                        (instruction.right == value and ir_instruction_consumes_right(instruction, instructions, definitions)) {
                        state = 2
                    }
                    // Multi-arg jumps carry values in the jump_arguments arena.
                    // A single-arg jump uses `left` and is covered above.
                    if instruction.op == IR_JUMP and instruction.left < 0 and instruction.aux >= 0 and
                        block.successor_count == 1 {
                        let jump_target = successors[block.successor_start]
                        let target_block = blocks[jump_target]
                        let mut target_params = 0
                        while target_block.instruction_start + target_params <
                            target_block.instruction_start + target_block.instruction_count and
                            instructions[target_block.instruction_start + target_params].op == IR_BLOCK_PARAM {
                            target_params = target_params + 1
                        }
                        let mut jump_arg = 0
                        while jump_arg < target_params and instruction.aux + jump_arg < len(jump_arguments) {
                            if jump_arguments[instruction.aux + jump_arg] == value {
                                if state == 0 {
                                    return IrVerification { ok: false, error: "IR instruction uses undefined owned value on a path", checked_values: 0 }
                                }
                                if state == 2 {
                                    return IrVerification { ok: false, error: "IR instruction uses consumed owned value", checked_values: 0 }
                                }
                                state = 2
                            }
                            jump_arg = jump_arg + 1
                        }
                    }
                    instruction_index = instruction_index + 1
                }
                if instructions[block.terminator].op == IR_RETURN {
                    if state == 1 {
                        return IrVerification { ok: false, error: "IR owned value is not consumed exactly once", checked_values: 0 }
                    }
                } else {
                    let mut edge = block.successor_start
                    while edge < block.successor_start + block.successor_count {
                        queue_blocks = append(queue_blocks, successors[edge])
                        queue_states = append(queue_states, state)
                        edge = edge + 1
                    }
                }
            }
        }
        value = value + 1
    }
    return IrVerification { ok: true, error: "", checked_values: 0 }
}

// Returned by `ir_intrinsic_callee_item` for a name that is not a statement or
// runtime intrinsic. Positive, so it can never collide with a sentinel (all
// negative) or with a real item index (non-negative but only ever compared
// against `signatures[..].item`).
const IR_NOT_INTRINSIC = 1

// Call-site sentinel for struct construction. It is an intrinsic so the
// bodiless-callee cascade leaves it alone, and it carries its field values in
// the call-argument arena.
const IR_STRUCT_NEW_ITEM = -29

// Lowest and highest intrinsic sentinel. A call site whose callee_item falls in
// this range names a builtin the backend emits inline, not a Mako function, so
// arity and parameter checks against a callee body do not apply to it.
const IR_INTRINSIC_ITEM_MIN = -29
const IR_INTRINSIC_ITEM_MAX = -2

// The single mapping from an intrinsic's source name to its call-site sentinel.
// Both the matched-shape lowering and the general CFG path resolve through
// here: a second copy of this table could drift, and a sentinel missing from
// one copy would be treated as a call to a Mako function that does not exist.
fn ir_intrinsic_callee_item(name: string) -> int {
    if name == "linux_syscall6" { return -2 }
    if name == "byte" { return -3 }
    if name == "unsafe_ptr_load8" { return -4 }
    if name == "unsafe_ptr_store8" { return -5 }
    if name == "unsafe_alloc" { return -6 }
    if name == "unsafe_free" { return -7 }
    if name == "unsafe_write" { return -8 }
    if name == "append" { return -10 }
    if name == "unsafe_write_bytes" { return -11 }
    if name == "unsafe_read_bytes" { return -12 }
    if name == "unsafe_open_bytes" { return -13 }
    if name == "unsafe_argv_ptr" { return -14 }
    if name == "unsafe_argv_len" { return -15 }
    if name == "argc" { return -16 }
    if name == "unsafe_argv_byte" { return -17 }
    if name == "unsafe_argv_copy" { return -18 }
    if name == "unsafe_bytes_to_string" { return -19 }
    if name == "arg_get" { return -20 }
    if name == "unsafe_close" { return -21 }
    if name == "unsafe_read_file" { return -22 }
    if name == "unsafe_write_file" { return -23 }
    if name == "unsafe_write_all" { return -24 }
    if name == "unsafe_read_all" { return -25 }
    if name == "unsafe_open_string" { return -26 }
    // Allocates and returns an owned string, so it belongs in the backend's
    // owned-producer set as well as here; a producer in one and not the other
    // either leaks the buffer per call or drops a borrow.
    if name == "format_int" { return -27 }
    // Reads a byte out of a string object; allocates nothing, so it is not an
    // owned producer. Out of range it yields -1, matching the runtime — the
    // lexer relies on that sentinel to detect end of input.
    if name == "str_byte_at" { return -28 }
    return IR_NOT_INTRINSIC
}

// True when a call site names an intrinsic rather than a Mako function.
fn ir_is_intrinsic_callee(item: int) -> bool {
    return item >= IR_INTRINSIC_ITEM_MIN and item <= IR_INTRINSIC_ITEM_MAX
}

// True when a call takes ownership of the owned values it is passed.
//
// A declared Mako function does: it drops its owned parameters. `append` does:
// it may move the block and hands back the replacement. Every other intrinsic
// **borrows** — the `unsafe_*` family reads through a slice and returns, and
// the caller still owns it afterwards.
//
// Treating a borrow as a consume is wrong in both directions: the value is
// never dropped, so `make([]byte, n)` passed to `unsafe_argv_copy` leaked its
// block, and reusing the slice afterwards was rejected as a use-after-move when
// it is perfectly valid.
// `argument_type` matters: the rule is deliberately confined to slices. A
// string argument keeps the old consuming behaviour, because a string parameter
// is borrowed from its caller and treating it as live here would demand a drop
// the callee must never emit — `str_byte_at(s, i)` on a string parameter is the
// case that showed it.
//
// Struct values are *never* consumed by a call. Parameters of struct type are
// borrowed element pointers: cloning one has no emitter (and would allocate a
// block for every `take(node)`), and consuming a construction into `append`
// would drop the ownership without freeing the block the element was copied
// out of. The element is always copied; the caller's value keeps its nature.
fn ir_call_consumes_arguments(callee_item: int, argument_type: int) -> bool {
    if semantic_is_struct_value(argument_type) { return false }
    // Construction stores each field into the block. The field value is
    // transferred into the struct's ownership — not dropped, not left live.
    if callee_item == IR_STRUCT_NEW_ITEM { return true }
    if not ir_is_intrinsic_callee(callee_item) { return true }
    // append moves the destination slice. The element is always copied — a
    // scalar by value, a struct by a stride-wide memcpy — so treating the
    // element as consumed leaked every `append(out, Pt { ... })`.
    if callee_item == -10 { return semantic_is_slice(argument_type) }
    if argument_type == SEM_STRING { return true }
    return false
}

// Dominator sets are bitsets over function-local block indices, packed into
// `IR_DOMINATOR_BITS` bits per int. Thirty-two keeps every shift well clear of
// the sign bit, so a set never has to reason about a negative word.
const IR_DOMINATOR_BITS = 32

// Per-function block ceiling. It bounds the dominator arena and the tree
// lowerer's worklist; a body that needs more is rejected, never truncated.
const IR_MAX_FUNCTION_BLOCKS = 512

// Words needed to hold one function's set. At least one, so a block always has
// a row to address even in a degenerate function.
fn ir_dominator_words(block_count: int) -> int {
    if block_count < 1 { return 1 }
    return (block_count + IR_DOMINATOR_BITS - 1) / IR_DOMINATOR_BITS
}

// True when function-local block `bit` is in the set stored for `block`.
fn ir_dominator_test(dominators: []int, words: int, block: int, bit: int) -> bool {
    if bit < 0 { return false }
    let word = bit / IR_DOMINATOR_BITS
    if word >= words { return false }
    let index = block * words + word
    if index < 0 or index >= len(dominators) { return false }
    return (dominators[index] & (1 << (bit - word * IR_DOMINATOR_BITS))) != 0
}

fn instruction_block(instructions: []IrInstruction, blocks: []IrBlock, instruction: int) -> int {
    let mut block = 0
    while block < len(blocks) {
        if instruction >= blocks[block].instruction_start and
            instruction < blocks[block].instruction_start + blocks[block].instruction_count { return block }
        block = block + 1
    }
    return -1
}

fn ir_parse_decimal_int(source: string, token: Token) -> int {
    let mut value = 0
    let mut i = token.start
    while i < token.end {
        let digit = str_byte_at(source, i) - 48
        if value > 922337203685477580 or (value == 922337203685477580 and digit > 7) {
            return -1
        }
        value = value * 10 + digit
        i = i + 1
    }
    return value
}

// Index of a statement in a list of statement indices, or -1.
fn stmt_list_index(list: []int, statement: int) -> int {
    let mut i = 0
    while i < len(list) {
        if list[i] == statement { return i }
        i = i + 1
    }
    return -1
}

// Result of the shape-independent CFG lowering. The arrays come back grown so
// the caller can adopt them; `ok` false leaves them untouched apart from
// whatever was appended before the failure, which the caller discards by
// returning the error.
struct IrCfgLowering {
    instructions: []IrInstruction
    constants: []IrConstant
    blocks: []IrBlock
    successors: []int
    call_sites: []IrCallSite
    call_arguments: []int
    // Kept index-parallel with `constants`: entry k is the `string_literals`
    // index of constant k, or -1 when that constant is not a string. The
    // backend reads a string constant through this table, so a missing entry
    // would make it address the wrong literal.
    string_literals: []string
    constant_string_index: []int
    // Arguments for every parameterised `IR_JUMP`, indexed from the jump's
    // `aux`. A loop header's block parameters are filled from here.
    jump_arguments: []int
    expression_values: []int
    next_value: int
    block_count: int
    ok: bool
    error: string
}

// Compile-time value of a global `const` whose initializer is an integer
// literal, with an optional leading minus. Returns a sentinel below
// -2147483648 when the item is not a const or its initializer is anything
// else, so an unsupported const fails closed instead of evaluating to zero.
//
// A const item records no body range: the parser stops it at end-of-line, so
// the initializer is the token run after the `=` inside the item's own span.
const IR_CONST_UNAVAILABLE = -9223372036854775807

fn ir_const_item_value(source: string, tokens: []Token, item: TopItem) -> int {
    if item.kind != ITEM_CONST { return IR_CONST_UNAVAILABLE }
    let mut scan = item.token_start
    let mut assign = -1
    while scan < item.token_end and scan < len(tokens) {
        if tokens[scan].kind == TK_ASSIGN {
            assign = scan
            scan = item.token_end
        } else {
            scan = scan + 1
        }
    }
    if assign < 0 { return IR_CONST_UNAVAILABLE }
    let mut value_index = assign + 1
    let mut negate = false
    if value_index < item.token_end and value_index < len(tokens) and tokens[value_index].kind == TK_MINUS {
        negate = true
        value_index = value_index + 1
    }
    if value_index >= item.token_end or value_index >= len(tokens) or
        tokens[value_index].kind != TK_INT {
        return IR_CONST_UNAVAILABLE
    }
    // Anything after the literal (arithmetic, a call, a second literal) is not
    // a form this evaluator models.
    if value_index + 1 < item.token_end and value_index + 1 < len(tokens) and
        tokens[value_index + 1].kind != TK_SEMICOLON {
        return IR_CONST_UNAVAILABLE
    }
    let magnitude = ir_parse_decimal_int(source, tokens[value_index])
    if magnitude < 0 { return IR_CONST_UNAVAILABLE }
    if negate { return 0 - magnitude }
    return magnitude
}

// Value of the global const an identifier expression resolves to, or the
// unavailable sentinel.
fn ir_const_reference_value(
    source: string, tokens: []Token, items: []TopItem, symbols: []Symbol,
    expression_symbols: []int, expression_index: int
) -> int {
    if expression_index < 0 or expression_index >= len(expression_symbols) {
        return IR_CONST_UNAVAILABLE
    }
    let symbol_index = expression_symbols[expression_index]
    if symbol_index < 0 or symbol_index >= len(symbols) { return IR_CONST_UNAVAILABLE }
    let item_index = symbols[symbol_index].item
    if item_index < 0 or item_index >= len(items) { return IR_CONST_UNAVAILABLE }
    return ir_const_item_value(source, tokens, items[item_index])
}

// A type that occupies exactly one slot and owns no allocation, so it needs
// neither ownership operations nor multi-word layout.
fn ir_cfg_scalar_type(kind: int) -> bool {
    return kind == SEM_INT or kind == SEM_BOOL or kind == SEM_BYTE
}

// A type this path can bind: either a plain scalar, or an owned one-slot value
// whose lifetime it tracks with explicit move/drop operations. SEM_ARRAY_BYTE
// is deliberately excluded — it is a one-slot allocation that
// `ir_type_is_owned` does not classify as owned, so this path cannot tell
// whether to drop it and declines instead of guessing.
fn ir_cfg_bindable_type(kind: int) -> bool {
    // A struct value is one slot holding a borrowed element pointer. It is
    // bindable but never owned: the slice it points into owns the storage, so
    // dropping it would free another value's memory.
    return ir_cfg_scalar_type(kind) or ir_type_is_owned(kind) or semantic_is_struct_value(kind)
}

// Number of parameters declared by one item's locals.
fn ir_parameter_count(locals: []LocalBinding, item: int) -> int {
    let mut count = 0
    let mut i = 0
    while i < len(locals) {
        if locals[i].item == item and locals[i].is_parameter { count = count + 1 }
        i = i + 1
    }
    return count
}

// Semantic type of an already-emitted SSA value, or SEM_UNKNOWN. Drops record
// the value's own type so the backend can pick the right release sequence.
fn ir_cfg_value_type(instructions: []IrInstruction, value: int) -> int {
    let mut i = 0
    while i < len(instructions) {
        if instructions[i].result == value { return instructions[i].type_kind }
        i = i + 1
    }
    return SEM_UNKNOWN
}

// Failure result for the CFG lowering; keeps the grown arrays so the caller can
// report the error without losing what was already appended.
// A failed lowering carries no artifacts: every caller checks `ok` before it
// reads a field, so the arenas are returned empty rather than half-built.
fn ir_cfg_failure(instructions: []IrInstruction, constants: []IrConstant, expression_values: []int, next_value: int, message: string) -> IrCfgLowering {
    return IrCfgLowering {
        instructions: instructions, constants: constants,
        blocks: make([]IrBlock, 0, 0), successors: make([]int, 0, 0),
        call_sites: make([]IrCallSite, 0, 0), call_arguments: make([]int, 0, 0),
        string_literals: make([]string, 0, 0), constant_string_index: make([]int, 0, 0),
        jump_arguments: make([]int, 0, 0),
        expression_values: expression_values, next_value: next_value,
        block_count: 0, ok: false, error: message,
    }
}

// True when some call node consumes this expression as its callee or as an
// earlier link of the same call chain. Such a node is never lowered on its own:
// only the terminal call emits, and the chain base is the callee name.
// Expression kind as a word, for diagnostics only. A bare number turns the
// largest decline bucket into something nobody reads.
fn ir_expression_kind_name(kind: int) -> string {
    if kind == EXPR_INT { return "integer literal" }
    if kind == EXPR_FLOAT { return "float literal" }
    if kind == EXPR_STRING { return "string literal" }
    if kind == EXPR_BOOL { return "boolean literal" }
    if kind == EXPR_IDENT { return "identifier" }
    if kind == EXPR_UNARY { return "unary operator" }
    if kind == EXPR_BINARY { return "binary operator" }
    if kind == EXPR_CALL { return "call" }
    if kind == EXPR_INDEX { return "index" }
    if kind == EXPR_FIELD { return "field read" }
    if kind == EXPR_ARRAY { return "array literal" }
    if kind == EXPR_STRUCT { return "struct literal" }
    if kind == EXPR_FIELD_INIT { return "field initializer" }
    if kind == EXPR_TUPLE { return "tuple" }
    if kind == EXPR_SLICE { return "slice expression" }
    if kind == EXPR_STRUCT_UPDATE { return "struct update" }
    if kind == EXPR_TYPE_REF { return "type reference" }
    if kind == EXPR_MAKE { return "make" }
    return "expression"
}

// True when this `EXPR_STRUCT` node is an inner link of a literal chain rather
// than the terminal construction. Each field adds a link; only the last one
// allocates.
fn ir_expression_is_continued_struct(expressions: []ExprNode, node: int) -> bool {
    let mut i = 0
    while i < len(expressions) {
        if expressions[i].kind == EXPR_STRUCT and expressions[i].left == node { return true }
        i = i + 1
    }
    return false
}

// Base of a call chain: the callee name node, reached by walking the chain's
// left edges. One argument per link, so the base is what names the function.
// True when this `make` node is an inner link of a `make` chain rather than the
// terminal construction. `make(T, n)` parses as a base node holding the type
// and one node per argument; only the last is the allocation.
fn ir_expression_is_continued_make(expressions: []ExprNode, node: int) -> bool {
    let mut i = 0
    while i < len(expressions) {
        if expressions[i].kind == EXPR_MAKE and expressions[i].left == node { return true }
        i = i + 1
    }
    return false
}

fn ir_call_chain_base(expressions: []ExprNode, call: int) -> int {
    let mut cursor = call
    let mut steps = 0
    while cursor >= 0 and cursor < len(expressions) and
        expressions[cursor].kind == EXPR_CALL and steps < len(expressions) {
        cursor = expressions[cursor].left
        steps = steps + 1
    }
    return cursor
}

fn ir_expression_is_call_target(expressions: []ExprNode, index: int) -> bool {
    let mut i = 0
    while i < len(expressions) {
        if expressions[i].kind == EXPR_CALL and expressions[i].left == index { return true }
        i = i + 1
    }
    return false
}

// Token index of the `else` that splits an if statement's child edges, or -1
// when the statement has no else arm. Only depth-zero tokens count, so an
// else belonging to a nested if is skipped.
fn ir_if_else_token(tokens: []Token, statement: StmtNode) -> int {
    let mut depth = 0
    let mut scan = statement.token_start
    while scan < statement.token_end and scan < len(tokens) {
        if tokens[scan].kind == TK_LBRACE { depth = depth + 1 }
        if tokens[scan].kind == TK_RBRACE { depth = depth - 1 }
        if tokens[scan].kind == TK_ELSE and depth == 0 { return scan }
        scan = scan + 1
    }
    return -1
}

// True when this statement is an assignment to a bare name — `target = expr`.
//
// There is no `STMT_ASSIGN`: the parser records both assignments and statement
// intrinsics as `STMT_EXPR`, and they are told apart by their first two tokens.
// A call has `ident (`; an assignment has `ident =`. Compound forms (`+=`) carry
// a different token and are refused, so they cannot be read as a plain store.
fn ir_statement_is_assignment(tokens: []Token, statement: StmtNode) -> bool {
    if statement.kind != STMT_EXPR { return false }
    if statement.token_start + 1 >= statement.token_end or
        statement.token_start + 1 >= len(tokens) { return false }
    return tokens[statement.token_start].kind == TK_IDENT and
        tokens[statement.token_start + 1].kind == TK_ASSIGN
}

// The local a `target = expr` statement stores into, or -1.
fn ir_assignment_target_local(
    source: string, tokens: []Token, statements: []StmtNode, locals: []LocalBinding,
    signature: FnSignature, statement: StmtNode
) -> int {
    let target = tokens[statement.token_start]
    let mut found = -1
    let mut i = 0
    while i < len(locals) {
        if locals[i].item == signature.item and
            span_equal(source, locals[i].name_start, locals[i].name_end, target.start, target.end) and
            locals[i].scope_start <= statement.token_start and
            statement.token_start < locals[i].scope_end {
            found = i
        }
        i = i + 1
    }
    return found
}

// True when some assignment inside [body_start, body_end) stores into `local`.
//
// This is what decides a loop's carried set: a local the body writes has a
// different value on the backedge than on entry, so the header needs a block
// parameter for it. A local the body only reads keeps one definition that
// dominates the whole loop and needs nothing.
fn ir_local_assigned_in_range(
    source: string, tokens: []Token, statements: []StmtNode, locals: []LocalBinding,
    signature: FnSignature, local: int, body_start: int, body_end: int
) -> bool {
    if local < 0 or local >= len(locals) { return false }
    let mut i = 0
    while i < len(statements) {
        let statement = statements[i]
        if statement.token_start >= body_start and statement.token_start < body_end and
            ir_statement_is_assignment(tokens, statement) {
            let target = tokens[statement.token_start]
            if span_equal(source, locals[local].name_start, locals[local].name_end,
                target.start, target.end) {
                return true
            }
        }
        i = i + 1
    }
    return false
}

// First `{` at or after `from` within the statement, which closes an if
// condition's token range.
fn ir_condition_end(tokens: []Token, from: int, limit: int) -> int {
    let mut scan = from
    while scan < limit and scan < len(tokens) {
        if tokens[scan].kind == TK_LBRACE { return scan }
        scan = scan + 1
    }
    return -1
}

// Lower every expression whose token lies in [range_start, range_end) into the
// instruction stream, and report the SSA value of the range's root.
//
// The expression arena is built bottom-up by the Pratt parser, so arena order
// is already a topological order: an operand always has a lower index than the
// parent that consumes it and is therefore already lowered when the parent is
// reached. That is what lets a single forward pass replace a recursive walk.
//
// Only scalar forms are accepted here: integer, boolean and string literals,
// parameter references, unary operators, and binary operators. Anything else
// fails, which keeps this path from silently lowering a construct it does not
// model.
//
// `skip_expression` names one node in the range that must not lower — the
// statement intrinsic call (`print`/`exit`) whose statement owns the range.
// Those have no signature, so lowering the node itself would be rejected as a
// call to an undeclared function; the caller emits the intrinsic instead and
// only needs its argument's value from here.
//
// `owned_root` names the one node allowed to produce an owned value — a
// string constant, or a call returning a string or slice. That is the value
// the caller itself consumes: a print argument, a let initializer bound to a
// tracked local, or a returned value. An owned value anywhere else would be
// defined and never consumed, which the ownership verifier rejects, so it
// fails closed here with a reason instead of producing IR that cannot verify.
// True when some string-typed binary reads this node as an operand.
//
// Concatenation copies both payloads into a fresh allocation and consumes
// neither, so an owned value in an operand position has a reader even though it
// is not the range's `owned_root`. Without this the only admissible string
// operand would be an already-bound local, which rules out every literal and
// every inline `format_int` — that is, nearly every concatenation written.
fn ir_expression_feeds_string_concat(expressions: []ExprNode, expression_types: []int, node: int) -> bool {
    if node < 0 { return false }
    let mut i = 0
    while i < len(expressions) {
        if expressions[i].kind == EXPR_BINARY and i < len(expression_types) and
            expression_types[i] == SEM_STRING and
            (expressions[i].left == node or expressions[i].right == node) {
            return true
        }
        i = i + 1
    }
    return false
}

// True when a field initialiser inside a struct literal names this node as its
// value. The construction stores it into the block, which is what gives an
// owned value there a reader — the same reason a call argument counts.
fn ir_expression_is_field_initializer(expressions: []ExprNode, node: int) -> bool {
    if node < 0 { return false }
    let mut i = 0
    while i < len(expressions) {
        if expressions[i].kind == EXPR_FIELD_INIT and expressions[i].right == node { return true }
        i = i + 1
    }
    return false
}

// `IR_DROP.aux` for a value of this type: for a struct value, the bitmask of
// its owned field slots, so the backend can release them without the struct
// table. Minus one for everything else, which is what the field has always
// meant for a drop.
fn ir_drop_aux(layout: StructLayout, source: string, type_kind: int) -> int {
    if not semantic_is_struct_value(type_kind) { return -1 }
    return struct_owned_slot_mask(layout, struct_kind_index(type_kind))
}

// Index of the node that reads this one as an operand, or -1. Expressions are
// built bottom-up, so a consumer always has a higher index than what it reads —
// which is what lets a temporary be dropped once its reader has been lowered.
fn ir_expression_consumer(expressions: []ExprNode, node: int) -> int {
    if node < 0 { return -1 }
    let mut i = 0
    while i < len(expressions) {
        if i != node and (expressions[i].left == node or expressions[i].right == node) {
            return i
        }
        i = i + 1
    }
    return -1
}

// True when a concat operand is a temporary rather than a binding.
//
// A concat consumes neither operand, so a temporary would be defined and never
// consumed and the ownership verifier rejects the function. It gets an
// `IR_DROP` after the concat has copied it — the same convention `print` uses
// for a printed temporary.
//
// A literal counts. It is a static view into the code image rather than an
// allocation, and the backend's owned-producer check is what stops the drop
// from unmapping read-only code; the drop exists here to close linearity, not
// to free anything. That split already governs `print("literal")`.
//
// An identifier does not count: it names a binding that is dropped at scope
// exit, so dropping it here would be a double free.
fn ir_string_operand_is_temporary(expressions: []ExprNode, expression_types: []int, node: int) -> bool {
    if node < 0 or node >= len(expressions) or node >= len(expression_types) { return false }
    if expression_types[node] != SEM_STRING { return false }
    return expressions[node].kind == EXPR_BINARY or expressions[node].kind == EXPR_CALL or
        expressions[node].kind == EXPR_STRING
}

fn ir_cfg_lower_range(
    source: string, tokens: []Token, items: []TopItem, symbols: []Symbol,
    expression_symbols: []int, signatures: []FnSignature, layout: StructLayout,
    expressions: []ExprNode, expression_types: []int, expression_locals: []int,
    locals: []LocalBinding, local_values: []int,
    instructions: []IrInstruction, constants: []IrConstant,
    call_sites: []IrCallSite, call_arguments: []int,
    string_literals: []string, constant_string_index: []int,
    expression_values: []int, next_value: int,
    range_start: int, range_end: int, skip_expression: int,
    owned_root: int
) -> IrCfgLowering {
    let mut out_instructions = instructions
    let mut out_constants = constants
    let mut out_call_sites = call_sites
    let mut out_call_arguments = call_arguments
    let mut out_strings = string_literals
    let mut out_string_index = constant_string_index
    let mut out_values = expression_values
    let mut value_cursor = next_value
    // Owned temporaries waiting for their reader. This path gives one owner per
    // range — the node the statement consumes — so anything else that allocates
    // has to be released once whatever reads it has been lowered. Expressions
    // are built bottom-up, so a consumer always has a higher index: flushing
    // everything whose consumer is already behind us is enough to place the
    // drop after the read and never before it.
    let mut pending_drop_after: []int = make([]int, 0, 4)
    let mut pending_drop_value: []int = make([]int, 0, 4)
    let mut pending_drop_type: []int = make([]int, 0, 4)
    let mut i = 0
    while i < len(expressions) {
        let expression = expressions[i]
        let mut pending_index = 0
        while pending_index < len(pending_drop_after) {
            if pending_drop_after[pending_index] >= 0 and pending_drop_after[pending_index] < i {
                out_instructions = append(out_instructions, IrInstruction {
                    op: IR_DROP, result: -1, type_kind: pending_drop_type[pending_index],
                    left: pending_drop_value[pending_index], right: -1, aux: -1,
                    token: expression.token,
                })
                pending_drop_after[pending_index] = -1
            }
            pending_index = pending_index + 1
        }
        if i == skip_expression {
            // The owning statement's intrinsic call; the caller emits it.
        } else if expression.token >= range_start and expression.token < range_end {
            // A callee name carries no value and therefore no semantic type, so
            // it has to be skipped before the type requirement is applied.
            if ir_expression_is_call_target(expressions, i) {
                // The callee name, or an earlier link of a call chain. Neither
                // produces a value; the terminal call node emits for the chain.
            } else if semantic_is_struct_literal_name(expressions, i) {
                // The `Pt` in `Pt { x: 1 }` names the struct, not a value.
            } else if expression.kind == EXPR_FIELD_INIT {
                // `a: x` inside a literal. It is a label on a value, not a value
                // of its own, so it carries no semantic type; the construction
                // reads it by field name.
            } else if expression.kind == EXPR_STRUCT and
                ir_expression_is_continued_struct(expressions, i) {
                // An inner link of the literal chain. Only the terminal node
                // constructs, and it reads every initialiser itself.
            } else if expression.kind == EXPR_TYPE_REF {
                // `[]int` inside `make([]int, n)` names a type, not a value, so
                // it carries no semantic type and belongs to the `make` around
                // it. Checking it for one would decline every `make`.
            } else if expression.kind == EXPR_MAKE and
                ir_expression_is_continued_make(expressions, i) {
                // `make(T, n)` parses as a chain; only the terminal node is the
                // construction. Lowering a prefix link too would allocate a
                // second buffer nothing reads or frees.
            } else if i >= len(expression_types) or expression_types[i] == SEM_UNKNOWN {
                // Naming the kind is what turns the largest decline bucket into
                // a list of things to fix, the way naming the callee showed
                // every "no intrinsic" decline was `len`.
                return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                    "CFG lowering needs a known type for this " +
                    ir_expression_kind_name(expression.kind))
            } else if expression.kind == EXPR_CALL {
                // Arguments hang off each chain link's right edge, innermost
                // last, so the walk collects them in reverse and the call site
                // records them in source order.
                // `len` is not a call the backend makes — it is one load of the
                // header word, which `IR_LEN` already encodes. Routing it
                // through the intrinsic table instead would have declined it as
                // an unknown callee, which is what kept every `len` in the
                // compiler's own sources out of this path. A slice header and a
                // string object both carry their length first, so one form
                // serves both.
                let len_callee = ir_call_chain_base(expressions, i)
                if len_callee >= 0 and expressions[len_callee].kind == EXPR_IDENT and
                    token_text(source, tokens[expressions[len_callee].token]) == "len" and
                    expression_types[i] == SEM_INT and expressions[i].left == len_callee {
                    let len_argument = expressions[i].right
                    if len_argument < 0 or len_argument >= len(out_values) or
                        out_values[len_argument] < 0 {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                            "CFG lowering could not resolve a len argument")
                    }
                    let len_result = value_cursor
                    value_cursor = value_cursor + 1
                    out_values[i] = len_result
                    out_instructions = append(out_instructions, IrInstruction {
                        op: IR_LEN, result: len_result, type_kind: SEM_INT,
                        left: out_values[len_argument], right: -1, aux: -1,
                        token: expression.token,
                    })
                    i = i + 1
                    continue
                }
                let mut reversed: []int = make([]int, 0, 4)
                let mut cursor = i
                let mut steps = 0
                while cursor >= 0 and cursor < len(expressions) and
                    expressions[cursor].kind == EXPR_CALL and steps < len(expressions) {
                    let argument = expressions[cursor].right
                    if argument >= 0 {
                        if argument >= len(out_values) or out_values[argument] < 0 {
                            return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor, "CFG lowering call argument is not available")
                        }
                        // Passing an owned binding to a call consumes it, so the
                        // callee receives a clone and the caller's original stays
                        // live for its own drop. Without this the value would be
                        // consumed twice on the same path and the ownership
                        // verifier would reject the function.
                        let mut passed = out_values[argument]
                        let argument_binding = if argument < len(expression_locals) { expression_locals[argument] } else { -1 }
                        let argument_is_binding = expressions[argument].kind == EXPR_IDENT and
                            argument_binding >= 0 and argument_binding < len(locals)
                        let argument_type = if argument < len(expression_types) { expression_types[argument] } else { SEM_UNKNOWN }
                        let argument_owned = ir_type_is_owned(argument_type)
                        // Struct values are always borrowed at call sites — there
                        // is no clone emitter for one, and parameters of struct
                        // type are element pointers. Strings and slices still
                        // clone so the callee can own what it is handed.
                        let clone_argument = argument_owned and
                            not semantic_is_struct_value(argument_type) and
                            (argument_is_binding or argument_type == SEM_STRING)
                        if clone_argument {
                            let cloned = value_cursor
                            value_cursor = value_cursor + 1
                            out_instructions = append(out_instructions, IrInstruction {
                                op: IR_CLONE, result: cloned, type_kind: argument_type,
                                left: passed, right: -1, aux: -1, token: expressions[argument].token,
                            })
                            // Cloning a temporary leaves the original with no
                            // reader. A binding keeps its scope-exit drop, so
                            // dropping one here would be a double free.
                            if not argument_is_binding {
                                out_instructions = append(out_instructions, IrInstruction {
                                    op: IR_DROP, result: -1, type_kind: argument_type,
                                    left: passed, right: -1, aux: -1, token: expressions[argument].token,
                                })
                            }
                            passed = cloned
                        }
                        // The call either clones (and drops the temp above) or
                        // consumes the temp as an owned argument. In both cases
                        // a pending drop of the same value — scheduled by an
                        // owned field read — would free it twice.
                        // `take(code.error)` and `pass_img(code.bytes)` both hit
                        // this.
                        if argument_owned and not argument_is_binding and
                            not semantic_is_struct_value(argument_type) {
                            let mut pend = 0
                            while pend < len(pending_drop_after) {
                                if pending_drop_value[pend] == out_values[argument] or
                                    pending_drop_value[pend] == passed {
                                    pending_drop_after[pend] = -1
                                }
                                pend = pend + 1
                            }
                        }
                        // A temporary owned struct (a construction, an element
                        // address) is not consumed by the call. Drop it once
                        // the call has read it — the backend no-ops a borrow
                        // and frees a construction.
                        if semantic_is_struct_value(argument_type) and not argument_is_binding {
                            pending_drop_after = append(pending_drop_after, i)
                            pending_drop_value = append(pending_drop_value, passed)
                            pending_drop_type = append(pending_drop_type, argument_type)
                        }
                        reversed = append(reversed, passed)
                    }
                    cursor = expressions[cursor].left
                    steps = steps + 1
                }
                let call_signature = semantic_function_signature(signatures, symbols, expression_symbols, cursor)
                // A callee with no signature is either an intrinsic the backend
                // emits inline, or a name this path cannot lower. The intrinsic
                // table is shared with the matched-shape lowering so the two
                // cannot disagree about what a sentinel means.
                let mut callee_item = -1
                if call_signature >= 0 {
                    callee_item = signatures[call_signature].item
                } else if cursor >= 0 and cursor < len(expressions) {
                    callee_item = ir_intrinsic_callee_item(token_text(source, tokens[expressions[cursor].token]))
                    if callee_item == IR_NOT_INTRINSIC {
                        // Naming the callee is the difference between "some
                        // builtin is missing" and a list of what to add.
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                            "CFG lowering has no intrinsic for call to " +
                            token_text(source, tokens[expressions[cursor].token]))
                    }
                } else {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor, "CFG lowering supports only calls to declared functions")
                }
                // Both result types occupy one slot and come back in rax, so
                // the call sequence is identical; only the tag differs, and it
                // is what lets a bool result feed a branch. An owned result
                // (a string, a slice) is excluded: this path has no owner for
                // a call temporary, so admitting one would leave a value the
                // ownership verifier cannot see consumed.
                if expression_types[i] != SEM_INT and expression_types[i] != SEM_BOOL and
                    not (ir_type_is_owned(expression_types[i]) and i == owned_root) and
                    not (expression_types[i] == SEM_STRING and
                        ir_expression_feeds_string_concat(expressions, expression_types, i)) {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor, "CFG lowering supports only integer- and boolean-returning calls")
                }
                let argument_start = len(out_call_arguments)
                let mut reverse_index = len(reversed) - 1
                while reverse_index >= 0 {
                    out_call_arguments = append(out_call_arguments, reversed[reverse_index])
                    reverse_index = reverse_index - 1
                }
                let site_index = len(out_call_sites)
                out_call_sites = append(out_call_sites, IrCallSite {
                    callee_item: callee_item,
                    argument_start: argument_start,
                    argument_count: len(reversed),
                })
                let call_result = value_cursor
                value_cursor = value_cursor + 1
                out_values[i] = call_result
                out_instructions = append(out_instructions, IrInstruction {
                    op: IR_CALL, result: call_result, type_kind: expression_types[i],
                    left: -1, right: -1, aux: site_index, token: expression.token,
                })
            } else if expression.kind == EXPR_IDENT {
                // An identifier aliases whatever SSA value its binding already
                // holds — a parameter, or a local bound earlier in a block that
                // dominates this one. The resolver has already picked the
                // correct binding for the reference's scope, so a sibling arm's
                // local is never visible here. An unbound binding (a forward
                // reference, or a name this path never lowered) fails closed
                // rather than aliasing value zero.
                let binding = if i < len(expression_locals) { expression_locals[i] } else { -1 }
                if binding < 0 or binding >= len(locals) or
                    binding >= len(local_values) or local_values[binding] < 0 {
                    // Not a local: a reference to a global integer `const`
                    // materializes as an ordinary constant in this block.
                    let global_value = ir_const_reference_value(
                        source, tokens, items, symbols, expression_symbols, i
                    )
                    if global_value == IR_CONST_UNAVAILABLE or expression_types[i] != SEM_INT {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor, "CFG lowering could not resolve an identifier to a bound value")
                    }
                    let const_aux = len(out_constants)
                    out_constants = append(out_constants, IrConstant {
                        type_kind: SEM_INT, int_value: global_value,
                        float_value: 0.0, start: tokens[expression.token].start,
                        end: tokens[expression.token].end,
                    })
                    out_string_index = append(out_string_index, -1)
                    let const_result = value_cursor
                    value_cursor = value_cursor + 1
                    out_values[i] = const_result
                    out_instructions = append(out_instructions, IrInstruction {
                        op: IR_CONST, result: const_result, type_kind: SEM_INT,
                        left: -1, right: -1, aux: const_aux, token: expression.token,
                    })
                } else {
                    out_values[i] = local_values[binding]
                }
            } else if expression.kind == EXPR_STRUCT and
                not ir_expression_is_continued_struct(expressions, i) {
                // `Name { a: x, b: y }`. One allocation of N slots, filled from
                // the field initialisers. Construction reuses the call
                // machinery: an `IrInstruction` has only `left`/`right` and a
                // literal has N fields, while a call site already carries an
                // operand arena.
                //
                // Initialisers may be written in any order, so each is placed at
                // its *declared* slot rather than where it appears. A literal
                // that names a field twice, omits one, or names one the struct
                // does not have is refused: a missing field would leave a slot
                // holding whatever the fresh block happened to contain.
                let owner = struct_kind_index(expression_types[i])
                let field_count = struct_kind_fields(expression_types[i])
                if owner < 0 or field_count < 1 {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering constructs only eligible structs")
                }
                let mut slot_values: []int = make([]int, field_count, field_count)
                let mut slot_exprs: []int = make([]int, field_count, field_count)
                let mut clear = 0
                while clear < field_count {
                    slot_values[clear] = -1
                    slot_exprs[clear] = -1
                    clear = clear + 1
                }
                let mut link = i
                let mut link_steps = 0
                while link >= 0 and link < len(expressions) and
                    expressions[link].kind == EXPR_STRUCT and link_steps < len(expressions) {
                    let init = expressions[link].right
                    if init >= 0 and init < len(expressions) {
                        if expressions[init].kind != EXPR_FIELD_INIT {
                            return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                                "CFG lowering requires named struct fields")
                        }
                        let field_slot = struct_field_slot(layout, source, owner,
                            token_text(source, tokens[expressions[init].token]))
                        let init_value = expressions[init].right
                        if field_slot < 0 or field_slot >= field_count or
                            init_value < 0 or init_value >= len(out_values) or
                            out_values[init_value] < 0 {
                            return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                                "CFG lowering could not resolve a struct field initializer")
                        }
                        if slot_values[field_slot] >= 0 {
                            return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                                "CFG lowering struct literal sets a field twice")
                        }
                        slot_values[field_slot] = out_values[init_value]
                        slot_exprs[field_slot] = init_value
                    }
                    link = expressions[link].left
                    link_steps = link_steps + 1
                }
                let mut check_slot = 0
                while check_slot < field_count {
                    if slot_values[check_slot] < 0 {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                            "CFG lowering struct literal leaves a field unset")
                    }
                    check_slot = check_slot + 1
                }
                // An owned field is cloned into the block. Without it the
                // struct can hold a *static* string — the view a literal is —
                // and its drop would try to unmap the code image. Cloning makes
                // "a struct owns its owned fields" true however it was built.
                //
                // Drop the source only when it is a temporary. A binding keeps
                // its scope-exit drop — dropping one here was a double free on
                // `Code { bytes: b, ... }` where `b` is a local.
                let mut emit_slot = 0
                while emit_slot < field_count {
                    let field_type = struct_field_type(layout, owner, emit_slot)
                    if ir_type_is_owned(field_type) {
                        let field_clone = value_cursor
                        value_cursor = value_cursor + 1
                        out_instructions = append(out_instructions, IrInstruction {
                            op: IR_CLONE, result: field_clone, type_kind: field_type,
                            left: slot_values[emit_slot], right: -1, aux: -1,
                            token: expression.token,
                        })
                        let src_expr = slot_exprs[emit_slot]
                        let src_binding = if src_expr >= 0 and src_expr < len(expression_locals) {
                            expression_locals[src_expr]
                        } else {
                            -1
                        }
                        let src_is_binding = src_expr >= 0 and src_expr < len(expressions) and
                            expressions[src_expr].kind == EXPR_IDENT and
                            src_binding >= 0 and src_binding < len(locals)
                        if not src_is_binding {
                            out_instructions = append(out_instructions, IrInstruction {
                                op: IR_DROP, result: -1, type_kind: field_type,
                                left: slot_values[emit_slot], right: -1, aux: -1,
                                token: expression.token,
                            })
                        }
                        slot_values[emit_slot] = field_clone
                    }
                    emit_slot = emit_slot + 1
                }
                let struct_argument_start = len(out_call_arguments)
                emit_slot = 0
                while emit_slot < field_count {
                    out_call_arguments = append(out_call_arguments, slot_values[emit_slot])
                    emit_slot = emit_slot + 1
                }
                let struct_site = len(out_call_sites)
                out_call_sites = append(out_call_sites, IrCallSite {
                    callee_item: IR_STRUCT_NEW_ITEM,
                    argument_start: struct_argument_start,
                    argument_count: field_count,
                })
                let struct_result = value_cursor
                value_cursor = value_cursor + 1
                out_values[i] = struct_result
                out_instructions = append(out_instructions, IrInstruction {
                    op: IR_CALL, result: struct_result, type_kind: expression_types[i],
                    left: -1, right: -1, aux: struct_site, token: expression.token,
                })
            } else if expression.kind == EXPR_ARRAY {
                // Left-associated chain: seed is empty (no left, no right) and
                // each later link appends one element onto the previous value.
                // The seed must already be a concrete slice kind — reverse type
                // propagation fills that in from the first element.
                if not ir_type_is_owned(expression_types[i]) {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering array literals require an owned slice type")
                }
                let mut array_left = -1
                let mut array_right = -1
                if expression.left >= 0 {
                    if expression.left >= len(out_values) or out_values[expression.left] < 0 {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                            "CFG lowering array prefix is not available")
                    }
                    array_left = out_values[expression.left]
                }
                if expression.right >= 0 {
                    if expression.right >= len(out_values) or out_values[expression.right] < 0 {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                            "CFG lowering array element is not available")
                    }
                    array_right = out_values[expression.right]
                }
                if (array_left < 0) != (array_right < 0) {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering array literal shape is invalid")
                }
                let array_result = value_cursor
                value_cursor = value_cursor + 1
                out_values[i] = array_result
                out_instructions = append(out_instructions, IrInstruction {
                    op: IR_ARRAY, result: array_result, type_kind: expression_types[i],
                    left: array_left, right: array_right, aux: -1, token: expression.token,
                })
            } else if expression.kind == EXPR_MAKE {
                // One allocation. The element stride comes from the result
                // type, and the length is the literal after the type — the same
                // reading the matched path uses, so the two cannot disagree
                // about how big a `make` is.
                if not ir_type_is_owned(expression_types[i]) {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering makes only owned slices")
                }
                let mut make_scan = expression.token + 1
                while make_scan < len(tokens) and tokens[make_scan].kind != TK_COMMA and
                    tokens[make_scan].kind != TK_RPAREN {
                    make_scan = make_scan + 1
                }
                let mut make_length = -1
                if make_scan < len(tokens) and tokens[make_scan].kind == TK_COMMA {
                    make_scan = make_scan + 1
                    if make_scan < len(tokens) and tokens[make_scan].kind == TK_INT {
                        make_length = ir_parse_decimal_int(source, tokens[make_scan])
                    }
                }
                if make_length < 0 {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering requires a literal make length")
                }
                let make_result = value_cursor
                value_cursor = value_cursor + 1
                out_values[i] = make_result
                out_instructions = append(out_instructions, IrInstruction {
                    op: IR_MAKE, result: make_result, type_kind: expression_types[i],
                    left: -1, right: -1, aux: make_length, token: expression.token,
                })
            } else if expression.kind == EXPR_FIELD {
                // Two shapes share this opcode:
                //   1. pointer form — object is a constructed struct or a
                //      materialised element address (one slot, no index);
                //   2. fused form — object is `slice[i]` that never materialised,
                //      so the field instruction carries the slice, the index and
                //      the slot, and the backend does one bounds-checked load.
                // Emitting a free-standing address for (2) would define an owned
                // temporary the field load does not consume.
                let object_kind = if expression.left >= 0 and expression.left < len(expression_types) {
                    expression_types[expression.left]
                } else {
                    SEM_UNKNOWN
                }
                let object_is_index = expression.left >= 0 and expression.left < len(expressions) and
                    expressions[expression.left].kind == EXPR_INDEX
                let object_has_value = expression.left >= 0 and expression.left < len(out_values) and
                    out_values[expression.left] >= 0
                if not semantic_is_struct_value(object_kind) and not object_is_index {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering reads a field only of a struct value")
                }
                let mut field_owner = -1
                let mut field_width = 0
                if semantic_is_struct_value(object_kind) {
                    field_owner = struct_kind_index(object_kind)
                    field_width = struct_kind_fields(object_kind)
                } else if object_is_index {
                    let index_node = expressions[expression.left]
                    let slice_kind = if index_node.left >= 0 and index_node.left < len(expression_types) {
                        expression_types[index_node.left]
                    } else {
                        SEM_UNKNOWN
                    }
                    if not semantic_is_struct_array(slice_kind) {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                            "CFG lowering fused field needs a struct slice")
                    }
                    field_owner = struct_kind_index(slice_kind)
                    field_width = struct_kind_fields(slice_kind)
                }
                let read_slot = struct_field_slot(layout, source, field_owner,
                    token_text(source, tokens[expression.token]))
                if field_owner < 0 or field_width < 1 or read_slot < 0 or read_slot >= field_width {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering could not resolve a struct field")
                }
                let read_result = value_cursor
                value_cursor = value_cursor + 1
                out_values[i] = read_result
                if object_has_value {
                    out_instructions = append(out_instructions, IrInstruction {
                        op: IR_FIELD, result: read_result, type_kind: expression_types[i],
                        left: out_values[expression.left], right: -1,
                        aux: field_width * IR_FIELD_AUX_UNIT + read_slot, token: expression.token,
                    })
                } else if object_is_index {
                    let index_node = expressions[expression.left]
                    if index_node.left < 0 or index_node.left >= len(out_values) or out_values[index_node.left] < 0 or
                        index_node.right < 0 or index_node.right >= len(out_values) or out_values[index_node.right] < 0 {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                            "CFG lowering fused field operands are not available")
                    }
                    out_instructions = append(out_instructions, IrInstruction {
                        op: IR_FIELD, result: read_result, type_kind: expression_types[i],
                        left: out_values[index_node.left], right: out_values[index_node.right],
                        aux: field_width * IR_FIELD_AUX_UNIT + read_slot, token: expression.token,
                    })
                } else {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering struct object is not available")
                }
                // Reading an *owned* field yields a borrow into the struct's
                // block, which the struct still owns and will free. Cloning it
                // is what dissolves the partial-move problem: the struct keeps
                // everything it ever owned, so its drop is unconditional and
                // there is no per-field moved-out state to get right on every
                // path. It costs a copy, the same trade as clone-on-pass.
                if ir_type_is_owned(expression_types[i]) {
                    let cloned_field = value_cursor
                    value_cursor = value_cursor + 1
                    out_values[i] = cloned_field
                    out_instructions = append(out_instructions, IrInstruction {
                        op: IR_CLONE, result: cloned_field, type_kind: expression_types[i],
                        left: read_result, right: -1, aux: -1, token: expression.token,
                    })
                    // The borrow is consumed here so the path leaves it defined
                    // and used exactly once. The backend emits nothing for it:
                    // its producer is a field read, which is not in the owned
                    // set, so no munmap is generated — the same split that lets
                    // a string literal carry a drop that frees nothing.
                    out_instructions = append(out_instructions, IrInstruction {
                        op: IR_DROP, result: -1, type_kind: expression_types[i],
                        left: read_result, right: -1, aux: -1, token: expression.token,
                    })
                    // The clone belongs to whatever reads it. If that is the
                    // node the statement consumes it is the statement's own
                    // value; otherwise it dies once its reader has been
                    // lowered.
                    if i != owned_root {
                        let clone_reader = ir_expression_consumer(expressions, i)
                        if clone_reader < 0 {
                            return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                                "CFG lowering owned field read has no reader on this path")
                        }
                        pending_drop_after = append(pending_drop_after, clone_reader)
                        pending_drop_value = append(pending_drop_value, cloned_field)
                        pending_drop_type = append(pending_drop_type, expression_types[i])
                    }
                }
            } else if expression.kind == EXPR_INDEX {
                // `xs[i]` on a slice of scalars: one bounds-checked load whose
                // stride the backend reads off the element type.
                //
                // A slice of structs is different. Its element is a *borrowed
                // pointer*, not a loaded word. Emitting `IR_INDEX` would hand
                // the encoder a word load at the wrong width — the fail-open
                // that once made `pts[0].x` and `pts[0].y` compile identically.
                // The address form (`IR_ELEM_ADDR`) is the only safe lowering:
                // field reads and call arguments then share one pointer, and
                // the backend's owned-producer check refuses to free it.
                let base = if expression.left >= 0 and expression.left < len(expression_types) {
                    expression_types[expression.left]
                } else {
                    SEM_UNKNOWN
                }
                if expression.left >= len(out_values) or out_values[expression.left] < 0 or
                    expression.right < 0 or expression.right >= len(out_values) or
                    out_values[expression.right] < 0 {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering index operand is not available")
                }
                if semantic_is_struct_array(base) {
                    if not semantic_is_struct_value(expression_types[i]) {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                            "CFG lowering struct-slice index has no element type")
                    }
                    // Field-only indexes stay fused: the field instruction
                    // re-reads the slice and index. Emitting an address here
                    // would define an owned temporary nobody consumes.
                    if not ir_struct_index_needs_address(expressions, expression_locals, locals, i) {
                        // out_values[i] stays -1; the field path fuses.
                    } else {
                        let stride = 8 * struct_kind_fields(base)
                        if stride < 8 {
                            return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                                "CFG lowering struct-slice index has no element stride")
                        }
                        let address_result = value_cursor
                        value_cursor = value_cursor + 1
                        out_values[i] = address_result
                        out_instructions = append(out_instructions, IrInstruction {
                            op: IR_ELEM_ADDR, result: address_result, type_kind: expression_types[i],
                            left: out_values[expression.left], right: out_values[expression.right],
                            aux: stride, token: expression.token,
                        })
                    }
                } else {
                    if (base != SEM_ARRAY_INT and base != SEM_ARRAY_BYTE) or
                        (expression_types[i] != SEM_INT and expression_types[i] != SEM_BYTE) {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                            "CFG lowering indexes only slices of int or byte")
                    }
                    let index_result = value_cursor
                    value_cursor = value_cursor + 1
                    out_values[i] = index_result
                    out_instructions = append(out_instructions, IrInstruction {
                        op: IR_INDEX, result: index_result, type_kind: expression_types[i],
                        left: out_values[expression.left], right: out_values[expression.right],
                        aux: -1, token: expression.token,
                    })
                }
            } else {
                let op = ir_expression_opcode(expression.kind)
                if op != IR_CONST and op != IR_UNARY and op != IR_BINARY {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor, "CFG lowering supports only scalar literal, unary, and binary expressions")
                }
                if op == IR_CONST and expression.kind != EXPR_INT and expression.kind != EXPR_BOOL and
                    expression.kind != EXPR_STRING {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor, "CFG lowering supports only integer, boolean, and string literals")
                }
                if op == IR_CONST and expression.kind == EXPR_STRING and i != owned_root and
                    not ir_expression_feeds_string_concat(expressions, expression_types, i) and
                    not ir_expression_is_call_argument(expressions, i) and
                    not ir_expression_is_field_initializer(expressions, i) {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor, "CFG lowering string literal has no owner on this path")
                }
                let mut left = -1
                let mut right = -1
                if op == IR_UNARY or op == IR_BINARY {
                    if expression.left < 0 or expression.left >= len(out_values) or out_values[expression.left] < 0 {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor, "CFG lowering operand is not available")
                    }
                    left = out_values[expression.left]
                }
                if op == IR_BINARY {
                    if expression.right < 0 or expression.right >= len(out_values) or out_values[expression.right] < 0 {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor, "CFG lowering operand is not available")
                    }
                    right = out_values[expression.right]
                }
                let mut aux = -1
                if op == IR_UNARY or op == IR_BINARY {
                    aux = tokens[expression.token].kind
                } else {
                    let token = tokens[expression.token]
                    let mut int_value = 0
                    let mut const_start = token.start
                    let mut const_end = token.end
                    let mut string_index = -1
                    if expression.kind == EXPR_INT {
                        int_value = ir_parse_decimal_int(source, token)
                        if int_value < 0 {
                            return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor, "integer constant is out of range")
                        }
                    } else if expression.kind == EXPR_STRING {
                        // The token span includes both quotes; the literal is
                        // what sits between them.
                        const_start = token.start + 1
                        const_end = token.end - 1
                        string_index = len(out_strings)
                        out_strings = append(out_strings, source[const_start:const_end])
                    } else {
                        int_value = if token.kind == TK_TRUE { 1 } else { 0 }
                    }
                    aux = len(out_constants)
                    out_constants = append(out_constants, IrConstant {
                        type_kind: expression_types[i], int_value: int_value,
                        float_value: 0.0, start: const_start, end: const_end,
                    })
                    out_string_index = append(out_string_index, string_index)
                }
                let result = value_cursor
                value_cursor = value_cursor + 1
                out_values[i] = result
                out_instructions = append(out_instructions, IrInstruction {
                    op: op, result: result, type_kind: expression_types[i],
                    left: left, right: right, aux: aux, token: expression.token,
                })
                // A concat copies both payloads and consumes neither, so an
                // operand that was itself an unnamed allocation has no other
                // reader and would leak once per evaluation. Dropping it here,
                // after the copy, is what keeps a chain like `a + b + c` to one
                // surviving allocation instead of one per link.
                if op == IR_BINARY and expression_types[i] == SEM_STRING {
                    if ir_string_operand_is_temporary(expressions, expression_types, expression.left) {
                        out_instructions = append(out_instructions, IrInstruction {
                            op: IR_DROP, result: -1, type_kind: SEM_STRING,
                            left: left, right: -1, aux: -1, token: expression.token,
                        })
                    }
                    if ir_string_operand_is_temporary(expressions, expression_types, expression.right) {
                        out_instructions = append(out_instructions, IrInstruction {
                            op: IR_DROP, result: -1, type_kind: SEM_STRING,
                            left: right, right: -1, aux: -1, token: expression.token,
                        })
                    }
                }
            }
        }
        i = i + 1
    }
    let mut trailing = 0
    while trailing < len(pending_drop_after) {
        if pending_drop_after[trailing] >= 0 {
            out_instructions = append(out_instructions, IrInstruction {
                op: IR_DROP, result: -1, type_kind: pending_drop_type[trailing],
                left: pending_drop_value[trailing], right: -1, aux: -1, token: range_start,
            })
        }
        trailing = trailing + 1
    }
    return IrCfgLowering {
        instructions: out_instructions, constants: out_constants,
        blocks: make([]IrBlock, 0, 0), successors: make([]int, 0, 0),
        call_sites: out_call_sites, call_arguments: out_call_arguments,
        string_literals: out_strings, constant_string_index: out_string_index,
        jump_arguments: make([]int, 0, 0),
        expression_values: out_values,
        next_value: value_cursor, block_count: 0, ok: true, error: "",
    }
}

// Lower a function body that is an arbitrarily nested tree of `if`/`else`,
// `let`, `print`, `exit` and `return` statements, where every path leaves the
// function — by returning, or by exiting the process.
//
// This is the shape-independent counterpart to the matched shapes below: it
// walks the statement tree instead of testing statement counts, so nesting
// depth is not a pattern it has to recognize. Because every path returns, no
// control flow rejoins, which means no merge blocks and no block parameters —
// that is what keeps this first slice free of dominance-frontier machinery.
//
// The walk is a FIFO over statement lists. Each list becomes exactly one
// block, and lists are discovered in the order their blocks are allocated, so
// a list's index is its block index and blocks come out in arena order.
// Statements after an `if` at the same level are that `if`'s else path, which
// is what makes a guard clause fall out of the same rule as an explicit else.
fn ir_lower_returning_if_tree(
    source: string, tokens: []Token, items: []TopItem, symbols: []Symbol,
    expression_symbols: []int, signatures: []FnSignature, layout: StructLayout,
    statements: []StmtNode, statement_edges: []int,
    expressions: []ExprNode, expression_types: []int, expression_locals: []int,
    locals: []LocalBinding, local_types: []int, local_values: []int,
    item: TopItem, signature: FnSignature, function_index: int,
    instructions: []IrInstruction, constants: []IrConstant,
    blocks: []IrBlock, successors: []int,
    call_sites: []IrCallSite, call_arguments: []int, jump_arguments: []int,
    string_literals: []string, constant_string_index: []int,
    expression_values: []int, next_value: int
) -> IrCfgLowering {
    let mut out_instructions = instructions
    let mut out_constants = constants
    let mut out_blocks = blocks
    let mut out_successors = successors
    let mut out_call_sites = call_sites
    let mut out_call_arguments = call_arguments
    let mut out_jump_arguments = jump_arguments
    let mut out_strings = string_literals
    let mut out_string_index = constant_string_index
    let mut out_values = expression_values
    let mut value_cursor = next_value
    let mut owned_locals = local_values
    // Successor edges are global block indices, and this function's blocks are
    // appended from here on, so a list's block index is entry_block + its
    // position in the list array.
    let entry_block = len(blocks)
    // A result-less function (`fn main()`) is allowed: its paths close with a
    // value-less return, which the backend emits as exit(0).
    let returns_value = signature.result_type >= 0
    // Parameters lead the entry block, matching the slot model's expectation.
    // The entry block must therefore start at the first parameter instruction,
    // not after them, or the params belong to no block and the verifier
    // rejects the function.
    let function_instruction_start = len(out_instructions)
    let mut parameter_index = 0
    while parameter_index < len(locals) {
        if locals[parameter_index].item == signature.item and locals[parameter_index].is_parameter {
            // Any non-owned scalar fits one slot and needs no ownership
            // operations. Owned types (string, []T, map) are excluded until
            // this path emits their drops, so they fail closed rather than
            // leaking a parameter the caller transferred.
            if parameter_index >= len(local_types) or
                not ir_cfg_bindable_type(local_types[parameter_index]) {
                return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                    "CFG lowering parameter type is not bindable")
            }
            let result = value_cursor
            value_cursor = value_cursor + 1
            owned_locals[parameter_index] = result
            out_instructions = append(out_instructions, IrInstruction {
                op: IR_PARAM, result: result, type_kind: local_types[parameter_index],
                left: -1, right: -1, aux: parameter_index, token: item.token_start,
            })
        }
        parameter_index = parameter_index + 1
    }
    // Flat storage for the pending statement lists. list_start/list_count index
    // into list_items; the list's position is also its block index.
    let mut list_items: []int = make([]int, 0, 8)
    let mut list_start: []int = make([]int, 0, 4)
    let mut list_count: []int = make([]int, 0, 4)
    // Owned values live at each block's entry. A block inherits its parent's
    // set, so the tree shape gives dominance for free: anything in scope here
    // was defined by a block that dominates this one.
    let mut scope_items: []int = make([]int, 0, 8)
    let mut scope_start: []int = make([]int, 0, 4)
    let mut scope_count: []int = make([]int, 0, 4)
    // Loop roles, one entry per pending list. A `while` pushes three lists —
    // header, body, continuation — and these say which is which. Everything
    // else is -1, so a function with no loop behaves exactly as before.
    // Which SSA value each local names, snapshotted per pending list. Bindings
    // are block-scoped: a store in one `if` arm must not be visible in its
    // sibling, which is reached by a different edge. Threading one array
    // through the whole function instead let an arm's rebinding leak sideways,
    // and the sibling then referenced a value defined in a block that does not
    // dominate it — `IR left value does not dominate its use`, from
    // `x86_emit_int_rax`, whose `out = append(out, ...)` appears in three arms.
    let mut list_bindings: []int = make([]int, 0, len(locals) * 4)
    let mut list_bindings_start: []int = make([]int, 0, 4)
    let mut list_loop_header: []int = make([]int, 0, 4)
    let mut list_loop_back: []int = make([]int, 0, 4)
    let mut list_loop_exit: []int = make([]int, 0, 4)
    // One entry per loop. `carried` names the locals the body assigns, which
    // are exactly the header's block parameters; `params` holds the value each
    // parameter defines, filled when the header is emitted.
    let mut loop_statement: []int = make([]int, 0, 2)
    let mut loop_carried_start: []int = make([]int, 0, 2)
    let mut loop_carried_count: []int = make([]int, 0, 2)
    let mut loop_carried: []int = make([]int, 0, 4)
    let mut loop_params: []int = make([]int, 0, 4)
    let mut loop_header_block: []int = make([]int, 0, 2)
    let mut loop_body_block: []int = make([]int, 0, 2)
    let mut loop_exit_block: []int = make([]int, 0, 2)
    // Owned values already live where the loop starts. The backedge drops
    // everything an iteration added *above* this mark; below it are values from
    // outside the loop, which survive every iteration and are dropped by the
    // path that leaves. Measured at the loop, not at the block that happens to
    // carry the backedge, which may be an if arm nested inside the body.
    let mut loop_entry_live: []int = make([]int, 0, 2)
    let top_start = len(list_items)
    let mut top_scan = 0
    while top_scan < len(statements) {
        if statements[top_scan].scope_start == item.body_start and
            statements[top_scan].token_start >= item.body_start and
            statements[top_scan].token_start < item.body_end {
            list_items = append(list_items, top_scan)
        }
        top_scan = top_scan + 1
    }
    if len(list_items) == top_start {
        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
            "CFG lowering found no statements in the body")
    }
    list_start = append(list_start, top_start)
    list_count = append(list_count, len(list_items) - top_start)
    list_bindings_start = append(list_bindings_start, len(list_bindings))
    let mut snap_0 = 0
    while snap_0 < len(owned_locals) {
        list_bindings = append(list_bindings, owned_locals[snap_0])
        snap_0 = snap_0 + 1
    }
    list_loop_header = append(list_loop_header, -1)
    list_loop_back = append(list_loop_back, -1)
    list_loop_exit = append(list_loop_exit, -1)
    let entry_scope = len(scope_items)
    let mut owned_param = 0
    while owned_param < len(locals) {
        if locals[owned_param].item == signature.item and locals[owned_param].is_parameter and
            owned_param < len(local_types) and ir_type_is_owned(local_types[owned_param]) and
            owned_locals[owned_param] >= 0 {
            scope_items = append(scope_items, owned_locals[owned_param])
        }
        owned_param = owned_param + 1
    }
    scope_start = append(scope_start, entry_scope)
    scope_count = append(scope_count, len(scope_items) - entry_scope)
    let mut list_index = 0
    while list_index < len(list_start) {
        if list_index >= IR_MAX_FUNCTION_BLOCKS {
            return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                "CFG lowering exceeds the per-function block limit")
        }
        let block_instruction_start = if list_index == 0 { function_instruction_start } else { len(out_instructions) }
        let mut live: []int = make([]int, 0, 4)
        let mut inherit = 0
        while inherit < scope_count[list_index] {
            live = append(live, scope_items[scope_start[list_index] + inherit])
            inherit = inherit + 1
        }
        // Restore the bindings this block was reached with. A store in a
        // sibling arm is invisible here, which is what keeps every referenced
        // value defined in a block that dominates this one.
        let mut restore_binding = 0
        while restore_binding < len(owned_locals) and
            list_bindings_start[list_index] + restore_binding < len(list_bindings) {
            owned_locals[restore_binding] = list_bindings[list_bindings_start[list_index] + restore_binding]
            restore_binding = restore_binding + 1
        }
        // Owned loop parameters re-enter `live` only on the exit continuation:
        // the entry/backedge jump consumed the previous allocation into the
        // header parameter, and the body/exit scopes were snapshotted without
        // that pre-loop value. The body must not inject the parameter into
        // `live` — rebinding already tracks the current value, and injecting
        // would leave a stale copy that a later scope-exit drop frees twice.
        if list_loop_exit[list_index] >= 0 {
            let exit_loop = list_loop_exit[list_index]
            let mut carried_live = 0
            while carried_live < loop_carried_count[exit_loop] {
                let carried_local = loop_carried[loop_carried_start[exit_loop] + carried_live]
                let param_value = loop_params[loop_carried_start[exit_loop] + carried_live]
                if param_value >= 0 and carried_local < len(local_types) and
                    ir_type_is_owned(local_types[carried_local]) {
                    // Dedupe: a nested-if snapshot can already name the param.
                    let mut already = false
                    let mut live_scan = 0
                    while live_scan < len(live) {
                        if live[live_scan] == param_value { already = true }
                        live_scan = live_scan + 1
                    }
                    if not already {
                        live = append(live, param_value)
                    }
                }
                carried_live = carried_live + 1
            }
        }
        let mut closed = false
        // Falling off the end of an if arm inside a loop body is falling off
        // the end of the body, so the arms this block spawns inherit its
        // backedge. Without this an `if` anywhere in a body silently drops the
        // loop: the arm runs once and returns.
        let inherited_back = list_loop_back[list_index]
        if list_loop_header[list_index] >= 0 {
            // A loop header carries no statements. It defines one block
            // parameter per carried local — binding each so the condition and
            // the whole body read the joined value, not the entry value — then
            // tests the condition and branches to the body or past the loop.
            let header_loop = list_loop_header[list_index]
            let header_statement = statements[loop_statement[header_loop]]
            let mut header_param = 0
            while header_param < loop_carried_count[header_loop] {
                let carried_local = loop_carried[loop_carried_start[header_loop] + header_param]
                let param_value = value_cursor
                value_cursor = value_cursor + 1
                loop_params[loop_carried_start[header_loop] + header_param] = param_value
                out_instructions = append(out_instructions, IrInstruction {
                    op: IR_BLOCK_PARAM, result: param_value, type_kind: local_types[carried_local],
                    left: -1, right: -1, aux: 0, token: header_statement.token_start,
                })
                owned_locals[carried_local] = param_value
                // The body's snapshot was taken at the `while`, before these
                // parameters existed, so it still names the pre-loop values.
                // The body has to read the joined value or the loop tests the
                // same thing forever. Header, body and continuation are pushed
                // consecutively, so the body is the next list.
                // Header, body and continuation are consecutive list entries.
                // Body and exit both read the joined parameter, not the
                // pre-loop value snapshotted at the `while`.
                let body_list = list_index + 1
                let exit_list = list_index + 2
                if body_list < len(list_bindings_start) and
                    list_bindings_start[body_list] + carried_local < len(list_bindings) {
                    list_bindings[list_bindings_start[body_list] + carried_local] = param_value
                }
                if exit_list < len(list_bindings_start) and
                    list_bindings_start[exit_list] + carried_local < len(list_bindings) {
                    list_bindings[list_bindings_start[exit_list] + carried_local] = param_value
                }
                header_param = header_param + 1
            }
            let header_condition_end = ir_condition_end(tokens, header_statement.token_start + 1, header_statement.token_end)
            let lowered = ir_cfg_lower_range(
                source, tokens, items, symbols, expression_symbols, signatures, layout,
                expressions, expression_types, expression_locals,
                locals, owned_locals, out_instructions, out_constants,
                out_call_sites, out_call_arguments,
                out_strings, out_string_index, out_values,
                value_cursor, header_statement.token_start + 1, header_condition_end, -1, -1
            )
            if not lowered.ok { return lowered }
            out_instructions = lowered.instructions
            out_constants = lowered.constants
            out_call_sites = lowered.call_sites
            out_call_arguments = lowered.call_arguments
            out_strings = lowered.string_literals
            out_string_index = lowered.constant_string_index
            out_values = lowered.expression_values
            value_cursor = lowered.next_value
            if header_statement.expr_root < 0 or header_statement.expr_root >= len(out_values) or
                out_values[header_statement.expr_root] < 0 or
                header_statement.expr_root >= len(expression_types) or
                expression_types[header_statement.expr_root] != SEM_BOOL {
                return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                    "CFG lowering requires a boolean while condition")
            }
            out_instructions = append(out_instructions, IrInstruction {
                op: IR_BRANCH, result: -1, type_kind: SEM_BOOL,
                left: out_values[header_statement.expr_root], right: -1, aux: -1,
                token: header_statement.token_start,
            })
            let header_successor_start = len(out_successors)
            out_successors = append(out_successors, loop_body_block[header_loop])
            out_successors = append(out_successors, loop_exit_block[header_loop])
            out_blocks = append(out_blocks, IrBlock {
                function: function_index, instruction_start: block_instruction_start,
                instruction_count: len(out_instructions) - block_instruction_start,
                terminator: len(out_instructions) - 1,
                successor_start: header_successor_start, successor_count: 2,
            })
            closed = true
        }
        if list_loop_exit[list_index] >= 0 {
            // The loop is left from the header, so past the loop every carried
            // local holds the header's parameter — not whatever the body last
            // computed, which is what `owned_locals` still points at.
            let exit_loop = list_loop_exit[list_index]
            let mut restore = 0
            while restore < loop_carried_count[exit_loop] {
                owned_locals[loop_carried[loop_carried_start[exit_loop] + restore]] =
                    loop_params[loop_carried_start[exit_loop] + restore]
                restore = restore + 1
            }
        }
        let mut position = 0
        while position < list_count[list_index] and not closed {
            let statement_index = list_items[list_start[list_index] + position]
            let statement = statements[statement_index]
            if statement.kind == STMT_RETURN {
                let value_start_token = statement.token_start + 1
                if value_start_token >= statement.token_end {
                    if returns_value {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                            "CFG lowering requires a returned value")
                    }
                    // Bare `return` in a result-less function: drop what is
                    // live and leave.
                    let mut bare_drop = len(live) - 1
                    while bare_drop >= 0 {
                        out_instructions = append(out_instructions, IrInstruction {
                            op: IR_DROP, result: -1, type_kind: ir_cfg_value_type(out_instructions, live[bare_drop]),
                            left: live[bare_drop], right: -1, aux: ir_drop_aux(layout, source, ir_cfg_value_type(out_instructions, live[bare_drop])), token: statement.token_start,
                        })
                        bare_drop = bare_drop - 1
                    }
                    out_instructions = append(out_instructions, IrInstruction {
                        op: IR_RETURN, result: -1, type_kind: SEM_UNKNOWN,
                        left: -1, right: -1, aux: -1, token: statement.token_start,
                    })
                    out_blocks = append(out_blocks, IrBlock {
                        function: function_index, instruction_start: block_instruction_start,
                        instruction_count: len(out_instructions) - block_instruction_start,
                        terminator: len(out_instructions) - 1,
                        successor_start: 0, successor_count: 0,
                    })
                    closed = true
                    position = position + 1
                    continue
                }
                if not returns_value {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering cannot return a value from a result-less function")
                }
                let lowered = ir_cfg_lower_range(
                    source, tokens, items, symbols, expression_symbols, signatures, layout,
                    expressions, expression_types, expression_locals,
                    locals, owned_locals, out_instructions, out_constants,
                    out_call_sites, out_call_arguments,
                    out_strings, out_string_index, out_values,
                    value_cursor, value_start_token, statement.token_end, -1,
                    statement.expr_root
                )
                if not lowered.ok { return lowered }
                out_instructions = lowered.instructions
                out_constants = lowered.constants
                out_call_sites = lowered.call_sites
                out_call_arguments = lowered.call_arguments
                out_strings = lowered.string_literals
                out_string_index = lowered.constant_string_index
                out_values = lowered.expression_values
                value_cursor = lowered.next_value
                if statement.expr_root < 0 or statement.expr_root >= len(out_values) or
                    out_values[statement.expr_root] < 0 {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering could not resolve a return value")
                }
                // Ownership at a return: the returned value, if owned, is
                // moved so the return consumes a fresh owner, and every other
                // owned value still live on this path is dropped. Together
                // these keep every owned definition consumed exactly once,
                // which is what the ownership verifier checks per path.
                let mut returned = out_values[statement.expr_root]
                let returns_owned = ir_type_is_owned(expression_types[statement.expr_root])
                let mut moved_from = -1
                if returns_owned {
                    moved_from = returned
                    let moved = value_cursor
                    value_cursor = value_cursor + 1
                    out_instructions = append(out_instructions, IrInstruction {
                        op: IR_MOVE, result: moved, type_kind: expression_types[statement.expr_root],
                        left: returned, right: -1, aux: -1, token: statement.token_start,
                    })
                    returned = moved
                }
                let mut drop_index = len(live) - 1
                while drop_index >= 0 {
                    if live[drop_index] != moved_from {
                        out_instructions = append(out_instructions, IrInstruction {
                            op: IR_DROP, result: -1, type_kind: ir_cfg_value_type(out_instructions, live[drop_index]),
                            left: live[drop_index], right: -1, aux: ir_drop_aux(layout, source, ir_cfg_value_type(out_instructions, live[drop_index])), token: statement.token_start,
                        })
                    }
                    drop_index = drop_index - 1
                }
                out_instructions = append(out_instructions, IrInstruction {
                    op: IR_RETURN, result: -1, type_kind: expression_types[statement.expr_root],
                    left: returned, right: -1, aux: -1,
                    token: statement.token_start,
                })
                out_blocks = append(out_blocks, IrBlock {
                    function: function_index, instruction_start: block_instruction_start,
                    instruction_count: len(out_instructions) - block_instruction_start,
                    terminator: len(out_instructions) - 1,
                    successor_start: 0, successor_count: 0,
                })
                closed = true
            } else if statement.kind == STMT_LET {
                // A scalar local bound in this block. Its initializer lowers
                // here and the binding aliases the resulting SSA value; the
                // definition dominates every block reachable from this one, so
                // no block parameter is needed. The block stays open.
                if statement.expr_root < 0 or statement.expr_root >= len(expressions) {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering requires a let initializer")
                }
                let lowered = ir_cfg_lower_range(
                    source, tokens, items, symbols, expression_symbols, signatures, layout,
                    expressions, expression_types, expression_locals,
                    locals, owned_locals, out_instructions, out_constants,
                    out_call_sites, out_call_arguments,
                    out_strings, out_string_index, out_values,
                    value_cursor, statement.token_start, statement.token_end, -1,
                    statement.expr_root
                )
                if not lowered.ok { return lowered }
                out_instructions = lowered.instructions
                out_constants = lowered.constants
                out_call_sites = lowered.call_sites
                out_call_arguments = lowered.call_arguments
                out_strings = lowered.string_literals
                out_string_index = lowered.constant_string_index
                out_values = lowered.expression_values
                value_cursor = lowered.next_value
                if out_values[statement.expr_root] < 0 {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering could not resolve a let initializer value")
                }
                // The declaration's local is the one whose recorded initializer
                // is this statement's expression root.
                let mut bound = -1
                let mut local_scan = 0
                while local_scan < len(locals) {
                    if locals[local_scan].item == signature.item and
                        not locals[local_scan].is_parameter and
                        locals[local_scan].initializer_root == statement.expr_root {
                        bound = local_scan
                    }
                    local_scan = local_scan + 1
                }
                if bound < 0 {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering could not find the local for a let statement")
                }
                if bound >= len(local_types) or not ir_cfg_bindable_type(local_types[bound]) {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering local type is not bindable")
                }
                owned_locals[bound] = out_values[statement.expr_root]
                if ir_type_is_owned(local_types[bound]) {
                    live = append(live, out_values[statement.expr_root])
                }
            } else if statement.kind == STMT_IF {
                let else_token = ir_if_else_token(tokens, statement)
                let condition_end = ir_condition_end(tokens, statement.token_start + 1, statement.token_end)
                if condition_end < 0 or condition_end <= statement.token_start + 1 {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering could not find an if condition")
                }
                let lowered = ir_cfg_lower_range(
                    source, tokens, items, symbols, expression_symbols, signatures, layout,
                    expressions, expression_types, expression_locals,
                    locals, owned_locals, out_instructions, out_constants,
                    out_call_sites, out_call_arguments,
                    out_strings, out_string_index, out_values,
                    value_cursor, statement.token_start + 1, condition_end, -1, -1
                )
                if not lowered.ok { return lowered }
                out_instructions = lowered.instructions
                out_constants = lowered.constants
                out_call_sites = lowered.call_sites
                out_call_arguments = lowered.call_arguments
                out_strings = lowered.string_literals
                out_string_index = lowered.constant_string_index
                out_values = lowered.expression_values
                value_cursor = lowered.next_value
                if statement.expr_root < 0 or statement.expr_root >= len(out_values) or
                    out_values[statement.expr_root] < 0 or
                    expression_types[statement.expr_root] != SEM_BOOL {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering requires a boolean if condition")
                }
                // Partition the child edges into the two arms. The parser
                // appends then-arm roots before else-arm roots with no marker,
                // so the depth-zero `else` token is the boundary.
                let then_start = len(list_items)
                let mut child_scan = 0
                while child_scan < statement.child_count {
                    let edge = statement.child_start + child_scan
                    if edge >= 0 and edge < len(statement_edges) {
                        let child = statement_edges[edge]
                        if child >= 0 and child < len(statements) and
                            (else_token < 0 or statements[child].token_start < else_token) {
                            list_items = append(list_items, child)
                        }
                    }
                    child_scan = child_scan + 1
                }
                let then_count = len(list_items) - then_start
                let else_start = len(list_items)
                if else_token >= 0 {
                    child_scan = 0
                    while child_scan < statement.child_count {
                        let edge = statement.child_start + child_scan
                        if edge >= 0 and edge < len(statement_edges) {
                            let child = statement_edges[edge]
                            if child >= 0 and child < len(statements) and
                                statements[child].token_start > else_token {
                                list_items = append(list_items, child)
                            }
                        }
                        child_scan = child_scan + 1
                    }
                    if position + 1 < list_count[list_index] {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                            "CFG lowering cannot merge statements after an if/else")
                    }
                } else {
                    // No else arm: the statements after this if at the same
                    // level are the false path.
                    let mut tail = position + 1
                    while tail < list_count[list_index] {
                        list_items = append(list_items, list_items[list_start[list_index] + tail])
                        tail = tail + 1
                    }
                }
                let else_count = len(list_items) - else_start
                if then_count < 1 or else_count < 1 {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering requires both if arms to hold statements")
                }
                let successor_start = len(out_successors)
                out_successors = append(out_successors, entry_block + len(list_start))
                out_successors = append(out_successors, entry_block + len(list_start) + 1)
                out_instructions = append(out_instructions, IrInstruction {
                    op: IR_BRANCH, result: -1, type_kind: SEM_BOOL,
                    left: out_values[statement.expr_root], right: -1, aux: -1,
                    token: statement.token_start,
                })
                out_blocks = append(out_blocks, IrBlock {
                    function: function_index, instruction_start: block_instruction_start,
                    instruction_count: len(out_instructions) - block_instruction_start,
                    terminator: len(out_instructions) - 1,
                    successor_start: successor_start, successor_count: 2,
                })
                let arm_scope = len(scope_items)
                let mut carry = 0
                while carry < len(live) {
                    scope_items = append(scope_items, live[carry])
                    carry = carry + 1
                }
                let arm_scope_count = len(scope_items) - arm_scope
                let else_scope = len(scope_items)
                carry = 0
                while carry < len(live) {
                    scope_items = append(scope_items, live[carry])
                    carry = carry + 1
                }
                list_start = append(list_start, then_start)
                list_count = append(list_count, then_count)
                scope_start = append(scope_start, arm_scope)
                scope_count = append(scope_count, arm_scope_count)
                list_bindings_start = append(list_bindings_start, len(list_bindings))
                let mut snap_1 = 0
                while snap_1 < len(owned_locals) {
                    list_bindings = append(list_bindings, owned_locals[snap_1])
                    snap_1 = snap_1 + 1
                }
                list_loop_header = append(list_loop_header, -1)
                list_loop_back = append(list_loop_back, inherited_back)
                list_loop_exit = append(list_loop_exit, -1)
                list_start = append(list_start, else_start)
                list_count = append(list_count, else_count)
                scope_start = append(scope_start, else_scope)
                scope_count = append(scope_count, len(scope_items) - else_scope)
                list_bindings_start = append(list_bindings_start, len(list_bindings))
                let mut snap_2 = 0
                while snap_2 < len(owned_locals) {
                    list_bindings = append(list_bindings, owned_locals[snap_2])
                    snap_2 = snap_2 + 1
                }
                list_loop_header = append(list_loop_header, -1)
                list_loop_back = append(list_loop_back, inherited_back)
                list_loop_exit = append(list_loop_exit, -1)
                closed = true
            } else if statement.kind == STMT_WHILE {
                // A loop is three blocks: a header that joins the entry edge
                // with the backedge, a body, and the continuation. The header's
                // block parameters are exactly the locals the body assigns —
                // those hold a different value on each edge. A local the body
                // only reads keeps one definition that dominates the loop and
                // needs no parameter.
                let body_open = ir_condition_end(tokens, statement.token_start + 1, statement.token_end)
                if body_open < 0 or body_open <= statement.token_start + 1 {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering could not find a while condition")
                }
                let mut carried_here: []int = make([]int, 0, 4)
                let mut carried_scan = 0
                let mut owned_carry_count = 0
                while carried_scan < len(locals) {
                    if locals[carried_scan].item == signature.item and
                        owned_locals[carried_scan] >= 0 and
                        ir_local_assigned_in_range(source, tokens, statements, locals, signature,
                            carried_scan, body_open, statement.token_end) {
                        // Bindable scalars and a single owned value may ride
                        // the backedge. Two owned carries would need a
                        // scratch move across a multi-arg jump (the second
                        // write can clobber the first), so they stay refused.
                        if carried_scan >= len(local_types) or
                            not ir_cfg_bindable_type(local_types[carried_scan]) {
                            return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                                "CFG lowering carries only bindable locals through a loop")
                        }
                        if ir_type_is_owned(local_types[carried_scan]) {
                            // Slice headers are always heap allocations here
                            // (make/append/array). Strings may be static
                            // literals on the entry edge, and munmap of a
                            // block-parameter string would free read-only
                            // code — so only slices ride the backedge for now.
                            let carry_kind = local_types[carried_scan]
                            if carry_kind != SEM_ARRAY_INT and carry_kind != SEM_ARRAY_BYTE and
                                not semantic_is_struct_array(carry_kind) {
                                return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                                    "CFG lowering carries only owned slices through a loop")
                            }
                            owned_carry_count = owned_carry_count + 1
                        }
                        carried_here = append(carried_here, carried_scan)
                    }
                    carried_scan = carried_scan + 1
                }
                // At most one owned among the carries: two would need a scratch
                // move across a multi-arg jump. Scalars may ride beside it.
                if owned_carry_count > 1 {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering carries at most one owned value through a loop")
                }
                // Transfer ownership of each owned carry into the header: the
                // entry jump consumes the pre-loop value, so it must leave
                // `live` before the body/exit scopes are snapshotted.
                let mut carry_live = 0
                while carry_live < len(carried_here) {
                    let carried_local = carried_here[carry_live]
                    if ir_type_is_owned(local_types[carried_local]) {
                        let transferred = owned_locals[carried_local]
                        let mut kept_live: []int = make([]int, 0, len(live))
                        let mut live_i = 0
                        while live_i < len(live) {
                            if live[live_i] != transferred {
                                kept_live = append(kept_live, live[live_i])
                            }
                            live_i = live_i + 1
                        }
                        live = kept_live
                    }
                    carry_live = carry_live + 1
                }
                let loop_index = len(loop_statement)
                let header_list = len(list_start)
                loop_statement = append(loop_statement, statement_index)
                loop_carried_start = append(loop_carried_start, len(loop_carried))
                loop_carried_count = append(loop_carried_count, len(carried_here))
                loop_header_block = append(loop_header_block, entry_block + header_list)
                loop_body_block = append(loop_body_block, entry_block + header_list + 1)
                loop_exit_block = append(loop_exit_block, entry_block + header_list + 2)
                loop_entry_live = append(loop_entry_live, len(live))
                let mut carried_push = 0
                while carried_push < len(carried_here) {
                    loop_carried = append(loop_carried, carried_here[carried_push])
                    // Filled in when the header emits its parameters; the value
                    // is not known until then.
                    loop_params = append(loop_params, -1)
                    carried_push = carried_push + 1
                }
                // Close the current block with the entry edge, handing the
                // header each carried local's value as it stands here.
                //
                // A single argument travels in `left` with the parameter's own
                // type; anything wider goes through the `jump_arguments` arena
                // from `aux`. Both forms are what the verifier requires, and it
                // rejects the wide form for a one-parameter target.
                if len(carried_here) == 1 {
                    out_instructions = append(out_instructions, IrInstruction {
                        op: IR_JUMP, result: -1, type_kind: local_types[carried_here[0]],
                        left: owned_locals[carried_here[0]], right: -1, aux: -1,
                        token: statement.token_start,
                    })
                } else {
                    let entry_argument_start = len(out_jump_arguments)
                    carried_push = 0
                    while carried_push < len(carried_here) {
                        out_jump_arguments = append(out_jump_arguments, owned_locals[carried_here[carried_push]])
                        carried_push = carried_push + 1
                    }
                    out_instructions = append(out_instructions, IrInstruction {
                        op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                        left: -1, right: -1, aux: entry_argument_start,
                        token: statement.token_start,
                    })
                }
                let while_successor_start = len(out_successors)
                out_successors = append(out_successors, entry_block + header_list)
                out_blocks = append(out_blocks, IrBlock {
                    function: function_index, instruction_start: block_instruction_start,
                    instruction_count: len(out_instructions) - block_instruction_start,
                    terminator: len(out_instructions) - 1,
                    successor_start: while_successor_start, successor_count: 1,
                })
                // Body statements, then whatever followed the loop.
                let body_items_start = len(list_items)
                let mut body_child = 0
                while body_child < statement.child_count {
                    let edge = statement.child_start + body_child
                    if edge >= 0 and edge < len(statement_edges) {
                        let child = statement_edges[edge]
                        if child >= 0 and child < len(statements) {
                            list_items = append(list_items, child)
                        }
                    }
                    body_child = body_child + 1
                }
                let body_items_count = len(list_items) - body_items_start
                if body_items_count < 1 {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering requires a while body to hold statements")
                }
                let exit_items_start = len(list_items)
                let mut exit_tail = position + 1
                while exit_tail < list_count[list_index] {
                    list_items = append(list_items, list_items[list_start[list_index] + exit_tail])
                    exit_tail = exit_tail + 1
                }
                let exit_items_count = len(list_items) - exit_items_start
                // The header carries no statements of its own; its condition
                // and branch are emitted from the loop table.
                let loop_scope = len(scope_items)
                let mut loop_carry = 0
                while loop_carry < len(live) {
                    scope_items = append(scope_items, live[loop_carry])
                    loop_carry = loop_carry + 1
                }
                let loop_scope_count = len(scope_items) - loop_scope
                list_start = append(list_start, len(list_items))
                list_count = append(list_count, 0)
                scope_start = append(scope_start, loop_scope)
                scope_count = append(scope_count, loop_scope_count)
                list_bindings_start = append(list_bindings_start, len(list_bindings))
                let mut snap_3 = 0
                while snap_3 < len(owned_locals) {
                    list_bindings = append(list_bindings, owned_locals[snap_3])
                    snap_3 = snap_3 + 1
                }
                list_loop_header = append(list_loop_header, loop_index)
                list_loop_back = append(list_loop_back, -1)
                list_loop_exit = append(list_loop_exit, -1)
                let body_scope = len(scope_items)
                loop_carry = 0
                while loop_carry < len(live) {
                    scope_items = append(scope_items, live[loop_carry])
                    loop_carry = loop_carry + 1
                }
                list_start = append(list_start, body_items_start)
                list_count = append(list_count, body_items_count)
                scope_start = append(scope_start, body_scope)
                scope_count = append(scope_count, len(scope_items) - body_scope)
                list_bindings_start = append(list_bindings_start, len(list_bindings))
                let mut snap_4 = 0
                while snap_4 < len(owned_locals) {
                    list_bindings = append(list_bindings, owned_locals[snap_4])
                    snap_4 = snap_4 + 1
                }
                list_loop_header = append(list_loop_header, -1)
                list_loop_back = append(list_loop_back, loop_index)
                list_loop_exit = append(list_loop_exit, -1)
                let after_scope = len(scope_items)
                loop_carry = 0
                while loop_carry < len(live) {
                    scope_items = append(scope_items, live[loop_carry])
                    loop_carry = loop_carry + 1
                }
                list_start = append(list_start, exit_items_start)
                list_count = append(list_count, exit_items_count)
                scope_start = append(scope_start, after_scope)
                scope_count = append(scope_count, len(scope_items) - after_scope)
                list_bindings_start = append(list_bindings_start, len(list_bindings))
                let mut snap_5 = 0
                while snap_5 < len(owned_locals) {
                    list_bindings = append(list_bindings, owned_locals[snap_5])
                    snap_5 = snap_5 + 1
                }
                list_loop_header = append(list_loop_header, -1)
                list_loop_back = append(list_loop_back, inherited_back)
                list_loop_exit = append(list_loop_exit, loop_index)
                closed = true
            } else if ir_statement_is_assignment(tokens, statement) {
                // `target = expr`. The store is an SSA rebinding: the local
                // simply names the new value from here on. No instruction is
                // emitted for the store itself.
                let assigned = ir_assignment_target_local(source, tokens, statements, locals, signature, statement)
                if assigned < 0 {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering could not resolve an assignment target")
                }
                if assigned >= len(local_types) or not ir_cfg_bindable_type(local_types[assigned]) {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering assigns only bindable locals")
                }
                if statement.expr_root < 0 or statement.expr_root >= len(expressions) {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering requires an assignment value")
                }
                // What the local held before the store, and where the
                // right-hand side's instructions begin — both needed to decide
                // whether the old allocation was handed to the expression that
                // replaces it, as in `out = append(out, x)`, or is being
                // dropped on the floor, as in `out = make(...)`.
                let replaced_value = owned_locals[assigned]
                let assign_rhs_start = len(out_instructions)
                // The range starts after `target =` so the target identifier is
                // not lowered as a read of the value being replaced.
                let lowered = ir_cfg_lower_range(
                    source, tokens, items, symbols, expression_symbols, signatures, layout,
                    expressions, expression_types, expression_locals,
                    locals, owned_locals, out_instructions, out_constants,
                    out_call_sites, out_call_arguments,
                    out_strings, out_string_index, out_values,
                    value_cursor, statement.token_start + 2, statement.token_end, -1,
                    statement.expr_root
                )
                if not lowered.ok { return lowered }
                out_instructions = lowered.instructions
                out_constants = lowered.constants
                out_call_sites = lowered.call_sites
                out_call_arguments = lowered.call_arguments
                out_strings = lowered.string_literals
                out_string_index = lowered.constant_string_index
                out_values = lowered.expression_values
                value_cursor = lowered.next_value
                if out_values[statement.expr_root] < 0 {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering could not resolve an assignment value")
                }
                let assigned_value = out_values[statement.expr_root]
                if ir_type_is_owned(local_types[assigned]) and replaced_value >= 0 and
                    replaced_value != assigned_value {
                    // Storing over an owned local retires the allocation it
                    // held. `out = append(out, x)` hands it to the call, which
                    // consumes it and returns the replacement — dropping it
                    // again here would be a double free. `out = make(...)`
                    // hands it to nobody, so without a drop it leaks. Which of
                    // the two happened is read off the instructions the
                    // right-hand side just emitted rather than assumed from the
                    // shape of the expression.
                    if not ir_instruction_range_consumes_value(
                        out_instructions, out_call_sites, out_call_arguments,
                        assign_rhs_start, len(out_instructions), replaced_value
                    ) {
                        out_instructions = append(out_instructions, IrInstruction {
                            op: IR_DROP, result: -1, type_kind: local_types[assigned],
                            left: replaced_value, right: -1, aux: -1,
                            token: statement.token_start,
                        })
                    }
                    // The retired value must leave the live set either way: it
                    // has been consumed exactly once already, and a scope-exit
                    // drop would consume it twice.
                    let mut kept: []int = make([]int, 0, len(live))
                    let mut live_scan = 0
                    while live_scan < len(live) {
                        if live[live_scan] != replaced_value {
                            kept = append(kept, live[live_scan])
                        }
                        live_scan = live_scan + 1
                    }
                    live = kept
                    live = append(live, assigned_value)
                }
                owned_locals[assigned] = assigned_value
            } else if statement.kind == STMT_EXPR {
                // The only statement expressions this path models are the two
                // statement intrinsics. Both take exactly one argument, which
                // hangs off the call node's right edge.
                if statement.expr_root < 0 or statement.expr_root >= len(expressions) or
                    expressions[statement.expr_root].kind != EXPR_CALL {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering supports only intrinsic call statements")
                }
                let intrinsic = token_text(source, tokens[statement.token_start])
                if intrinsic != "print" and intrinsic != "exit" {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering supports only print and exit statements")
                }
                let argument = expressions[statement.expr_root].right
                if argument < 0 or argument >= len(expressions) {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering requires one intrinsic argument")
                }
                let lowered = ir_cfg_lower_range(
                    source, tokens, items, symbols, expression_symbols, signatures, layout,
                    expressions, expression_types, expression_locals,
                    locals, owned_locals, out_instructions, out_constants,
                    out_call_sites, out_call_arguments,
                    out_strings, out_string_index, out_values,
                    value_cursor, statement.token_start, statement.token_end,
                    statement.expr_root, argument
                )
                if not lowered.ok { return lowered }
                out_instructions = lowered.instructions
                out_constants = lowered.constants
                out_call_sites = lowered.call_sites
                out_call_arguments = lowered.call_arguments
                out_strings = lowered.string_literals
                out_string_index = lowered.constant_string_index
                out_values = lowered.expression_values
                value_cursor = lowered.next_value
                if argument >= len(out_values) or out_values[argument] < 0 {
                    return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                        "CFG lowering could not resolve an intrinsic argument")
                }
                let argument_type = if argument < len(expression_types) { expression_types[argument] } else { SEM_UNKNOWN }
                if intrinsic == "print" {
                    if argument_type != SEM_STRING and argument_type != SEM_INT {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                            "CFG lowering prints only strings and integers")
                    }
                    out_instructions = append(out_instructions, IrInstruction {
                        op: IR_PRINT, result: -1, type_kind: argument_type,
                        left: out_values[argument], right: -1, aux: -1,
                        token: statement.token_start,
                    })
                    // A printed temporary is consumed here so the path leaves
                    // it defined-then-used exactly once. A printed *binding*
                    // stays live and is dropped at the path's exit instead, so
                    // dropping it here would be a double free.
                    let mut is_binding = false
                    let mut live_scan = 0
                    while live_scan < len(live) {
                        if live[live_scan] == out_values[argument] { is_binding = true }
                        live_scan = live_scan + 1
                    }
                    if ir_type_is_owned(argument_type) and not is_binding {
                        out_instructions = append(out_instructions, IrInstruction {
                            op: IR_DROP, result: -1, type_kind: argument_type,
                            left: out_values[argument], right: -1, aux: -1,
                            token: statement.token_start,
                        })
                    }
                } else {
                    if argument_type != SEM_INT {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                            "CFG lowering exits only with an integer status")
                    }
                    // `exit` never returns, so it ends the path. The block
                    // still needs a structural terminator, and only a
                    // result-less function can be given one without inventing
                    // a value of the declared result type.
                    if returns_value {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                            "CFG lowering cannot end a value-returning function with exit")
                    }
                    let mut exit_drop = len(live) - 1
                    while exit_drop >= 0 {
                        out_instructions = append(out_instructions, IrInstruction {
                            op: IR_DROP, result: -1, type_kind: ir_cfg_value_type(out_instructions, live[exit_drop]),
                            left: live[exit_drop], right: -1, aux: ir_drop_aux(layout, source, ir_cfg_value_type(out_instructions, live[exit_drop])), token: statement.token_start,
                        })
                        exit_drop = exit_drop - 1
                    }
                    out_instructions = append(out_instructions, IrInstruction {
                        op: IR_EXIT, result: -1, type_kind: SEM_INT,
                        left: out_values[argument], right: -1, aux: -1,
                        token: statement.token_start,
                    })
                    out_instructions = append(out_instructions, IrInstruction {
                        op: IR_RETURN, result: -1, type_kind: SEM_UNKNOWN,
                        left: -1, right: -1, aux: -1, token: statement.token_start,
                    })
                    out_blocks = append(out_blocks, IrBlock {
                        function: function_index, instruction_start: block_instruction_start,
                        instruction_count: len(out_instructions) - block_instruction_start,
                        terminator: len(out_instructions) - 1,
                        successor_start: 0, successor_count: 0,
                    })
                    closed = true
                }
            } else {
                return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                    "CFG lowering supports only if, while, let, assignment, print, exit, and return statements")
            }
            position = position + 1
        }
        if not closed and list_loop_back[list_index] >= 0 {
            // The body ran to its end, so it loops: hand the header each
            // carried local's value as the body left it. A body that returned
            // or exited is already closed and needs no backedge.
            let back_loop = list_loop_back[list_index]
            // A backedge argument that names a *different* carried parameter is
            // a permutation — `a = b` followed by `b = a + 1` hands back
            // (b, a'). The header's parameters are slots the jump writes in
            // sequence, so the second write would clobber a value the first
            // still had to read. Breaking the cycle needs a scratch copy, and
            // the only copy instruction here is `IR_MOVE`, which the verifier
            // reserves for owned values. Declined rather than mis-ordered; an
            // ordinary counter loop never reaches this.
            let mut back_argument = 0
            while back_argument < loop_carried_count[back_loop] {
                let carried_local = loop_carried[loop_carried_start[back_loop] + back_argument]
                let mut other = 0
                while other < loop_carried_count[back_loop] {
                    if other != back_argument and
                        owned_locals[carried_local] == loop_params[loop_carried_start[back_loop] + other] {
                        return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                            "CFG lowering cannot carry a loop value that permutes another carried value")
                    }
                    other = other + 1
                }
                back_argument = back_argument + 1
            }
            // Anything the body allocated dies here — except the values the
            // backedge hands back to the header. An owned carry is transferred
            // by the jump; dropping it first would free the next iteration's
            // input. Only what this iteration added beyond the entry mark is
            // considered, then carried current values are skipped.
            let mut body_drop = len(live) - 1
            while body_drop >= loop_entry_live[back_loop] {
                let drop_value = live[body_drop]
                let mut carried_now = false
                let mut carry_check = 0
                while carry_check < loop_carried_count[back_loop] {
                    let carried_local = loop_carried[loop_carried_start[back_loop] + carry_check]
                    if owned_locals[carried_local] == drop_value {
                        carried_now = true
                    }
                    carry_check = carry_check + 1
                }
                if not carried_now {
                    out_instructions = append(out_instructions, IrInstruction {
                        op: IR_DROP, result: -1, type_kind: ir_cfg_value_type(out_instructions, drop_value),
                        left: drop_value, right: -1, aux: ir_drop_aux(layout, source, ir_cfg_value_type(out_instructions, drop_value)),
                        token: statements[loop_statement[back_loop]].token_start,
                    })
                }
                body_drop = body_drop - 1
            }
            if loop_carried_count[back_loop] == 1 {
                let only_carried = loop_carried[loop_carried_start[back_loop]]
                out_instructions = append(out_instructions, IrInstruction {
                    op: IR_JUMP, result: -1, type_kind: local_types[only_carried],
                    left: owned_locals[only_carried], right: -1, aux: -1,
                    token: statements[loop_statement[back_loop]].token_start,
                })
            } else {
                let back_argument_start = len(out_jump_arguments)
                back_argument = 0
                while back_argument < loop_carried_count[back_loop] {
                    out_jump_arguments = append(out_jump_arguments,
                        owned_locals[loop_carried[loop_carried_start[back_loop] + back_argument]])
                    back_argument = back_argument + 1
                }
                out_instructions = append(out_instructions, IrInstruction {
                    op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                    left: -1, right: -1, aux: back_argument_start,
                    token: statements[loop_statement[back_loop]].token_start,
                })
            }
            let back_successor_start = len(out_successors)
            out_successors = append(out_successors, loop_header_block[back_loop])
            out_blocks = append(out_blocks, IrBlock {
                function: function_index, instruction_start: block_instruction_start,
                instruction_count: len(out_instructions) - block_instruction_start,
                terminator: len(out_instructions) - 1,
                successor_start: back_successor_start, successor_count: 1,
            })
            closed = true
        }
        if not closed {
            if returns_value {
                return ir_cfg_failure(out_instructions, out_constants, out_values, value_cursor,
                    "CFG lowering requires every path to return")
            }
            // A result-less body that runs off its end returns implicitly.
            let mut tail_drop = len(live) - 1
            while tail_drop >= 0 {
                out_instructions = append(out_instructions, IrInstruction {
                    op: IR_DROP, result: -1, type_kind: ir_cfg_value_type(out_instructions, live[tail_drop]),
                    left: live[tail_drop], right: -1, aux: ir_drop_aux(layout, source, ir_cfg_value_type(out_instructions, live[tail_drop])), token: item.body_end,
                })
                tail_drop = tail_drop - 1
            }
            out_instructions = append(out_instructions, IrInstruction {
                op: IR_RETURN, result: -1, type_kind: SEM_UNKNOWN,
                left: -1, right: -1, aux: -1, token: item.body_end,
            })
            out_blocks = append(out_blocks, IrBlock {
                function: function_index, instruction_start: block_instruction_start,
                instruction_count: len(out_instructions) - block_instruction_start,
                terminator: len(out_instructions) - 1,
                successor_start: 0, successor_count: 0,
            })
        }
        list_index = list_index + 1
    }
    return IrCfgLowering {
        instructions: out_instructions, constants: out_constants,
        blocks: out_blocks, successors: out_successors,
        call_sites: out_call_sites, call_arguments: out_call_arguments,
        string_literals: out_strings, constant_string_index: out_string_index,
        jump_arguments: out_jump_arguments,
        expression_values: out_values, next_value: value_cursor,
        block_count: len(list_start), ok: true, error: "",
    }
}

fn ir_item_is_banned(banned: []int, item: int) -> bool {
    let mut i = 0
    while i < len(banned) {
        if banned[i] == item { return true }
        i = i + 1
    }
    return false
}

// Source text of an item's name, for diagnostics only. Never read on a success
// path, so it cannot affect lowering.
fn ir_item_name(source: string, items: []TopItem, item: int) -> string {
    if item < 0 or item >= len(items) { return "?" }
    return source[items[item].name_start:items[item].name_end]
}

fn ir_item_has_body(functions: []IrFunction, item: int) -> bool {
    let mut i = 0
    while i < len(functions) {
        if functions[i].item == item { return true }
        i = i + 1
    }
    return false
}

// The item index of `fn main`, or -1 when the source declares none.
//
// The image entry point is a named function, not "the one nothing calls": a
// file may declare any number of functions no other function calls, and each is
// an equally good candidate, so the uncalled rule fails on every real source.
fn ir_entry_item(source: string, items: []TopItem) -> int {
    let mut i = 0
    while i < len(items) {
        let item = items[i]
        if item.kind == ITEM_FN and source[item.name_start:item.name_end] == "main" {
            return i
        }
        i = i + 1
    }
    return -1
}

fn ir_entry_item_smoke_test() -> bool {
    let source = "fn helper() {}\nfn main() {}\n"
    let mut items: []TopItem = make([]TopItem, 0, 2)
    items = append(items, TopItem {
        kind: ITEM_FN, token_start: 0, token_end: 0,
        name_start: 3, name_end: 9, body_start: 0, body_end: 0, exported: false,
    })
    items = append(items, TopItem {
        kind: ITEM_FN, token_start: 0, token_end: 0,
        name_start: 18, name_end: 22, body_start: 0, body_end: 0, exported: false,
    })
    if ir_entry_item(source, items) != 1 { return false }
    // A struct named `main` is not an entry point, and a source with no `main`
    // must report that rather than defaulting to the first item.
    let mut structs: []TopItem = make([]TopItem, 0, 1)
    structs = append(structs, TopItem {
        kind: ITEM_STRUCT, token_start: 0, token_end: 0,
        name_start: 18, name_end: 22, body_start: 0, body_end: 0, exported: false,
    })
    return ir_entry_item(source, structs) == -1
}

// Lower every function, then ban any function whose call reaches a callee that
// did not lower, and repeat until the set stops growing.
//
// Without this, one unsupported callee poisons a whole file: the caller lowers,
// its call site names an item with no IR body, and the verifier rejects the
// entire package rather than that one function. The loop is bounded by the
// signature count because each round bans at least one more function or stops.
fn lower_typed_ir(

    source: string,
    tokens: []Token,
    items: []TopItem,
    signatures: []FnSignature,
    statements: []StmtNode,
    statement_edges: []int,
    expressions: []ExprNode,
    expression_types: []int,
    locals: []LocalBinding,
    local_types: []int,
    expression_locals: []int,
    symbols: []Symbol,
    expression_symbols: []int
) -> TypedIr {
    let mut banned: []int = make([]int, 0, 4)
    let mut round = 0
    let mut result = lower_typed_ir_once(source, tokens, items, signatures, statements, statement_edges, expressions, expression_types, locals, local_types, expression_locals, symbols, expression_symbols, banned)
    while round <= len(signatures) {
        if not result.ok { return result }
        let mut grew = false
        let mut function_index = 0
        while function_index < len(result.functions) {
            let lowered = result.functions[function_index]
            let mut block_index = lowered.entry_block
            while block_index < lowered.entry_block + lowered.block_count and block_index < len(result.blocks) {
                let block = result.blocks[block_index]
                let mut at = block.instruction_start
                while at < block.instruction_start + block.instruction_count and at < len(result.instructions) {
                    let instruction = result.instructions[at]
                    if instruction.op == IR_CALL and instruction.aux >= 0 and instruction.aux < len(result.call_sites) {
                        let callee = result.call_sites[instruction.aux].callee_item
                        // Intrinsics are emitted inline and never have a body.
                        if not ir_is_intrinsic_callee(callee) and
                            not ir_item_has_body(result.functions, callee) and
                            not ir_item_is_banned(banned, lowered.item) {
                            banned = append(banned, lowered.item)
                            grew = true
                        }
                    }
                    at = at + 1
                }
                block_index = block_index + 1
            }
            function_index = function_index + 1
        }
        if not grew { return result }
        result = lower_typed_ir_once(source, tokens, items, signatures, statements, statement_edges, expressions, expression_types, locals, local_types, expression_locals, symbols, expression_symbols, banned)
        round = round + 1
    }
    return result
}

fn lower_typed_ir_once(
    source: string,
    tokens: []Token,
    items: []TopItem,
    signatures: []FnSignature,
    statements: []StmtNode,
    statement_edges: []int,
    expressions: []ExprNode,
    expression_types: []int,
    locals: []LocalBinding,
    local_types: []int,
    expression_locals: []int,
    symbols: []Symbol,
    expression_symbols: []int
,
    banned: []int) -> TypedIr {
    let mut functions: []IrFunction = []
    let mut blocks: []IrBlock = []
    let mut instructions: []IrInstruction = []
    let mut constants: []IrConstant = []
    let mut successors: []int = []
    let mut call_sites: []IrCallSite = []
    let mut call_arguments: []int = []
    let mut jump_arguments: []int = []
    let mut string_literals: []string = []
    let mut constant_string_index: []int = []
    let mut expression_values = make([]int, len(expressions), len(expressions))
    let mut local_values = make([]int, len(locals), len(locals))
    let mut i = 0
    while i < len(expression_values) {
        expression_values[i] = -1
        i = i + 1
    }
    i = 0
    while i < len(local_values) {
        local_values[i] = -1
        i = i + 1
    }
    let mut continued_calls = make([]int, len(expressions), len(expressions))
    i = 0
    while i < len(expressions) {
        if expressions[i].kind == EXPR_CALL and expressions[i].left >= 0 and
            expressions[i].left < len(expressions) and expressions[expressions[i].left].kind == EXPR_CALL {
            continued_calls[expressions[i].left] = 1
        }
        i = i + 1
    }
    // `make(T, len)` parses as a chain: a base node holding the type, then one
    // node per argument. Only the terminal node is the construction — lowering
    // the prefix too allocated a second buffer per `make` that nothing ever
    // read or freed. This mirrors the typer's `continued_makes`.
    let mut continued_makes = make([]int, len(expressions), len(expressions))
    i = 0
    while i < len(expressions) {
        if expressions[i].kind == EXPR_MAKE and expressions[i].left >= 0 and
            expressions[i].left < len(expressions) and expressions[expressions[i].left].kind == EXPR_MAKE {
            continued_makes[expressions[i].left] = 1
        }
        i = i + 1
    }

    // Per-item membership indexes. Shape matching used to walk every expression
    // and statement for every function (O(functions * nodes)); on the compiler's
    // own sources that dominated stage-1 wall time. Build the partitions once.
    let mut token_item = make([]int, len(tokens), len(tokens))
    i = 0
    while i < len(token_item) {
        token_item[i] = -1
        i = i + 1
    }
    i = 0
    while i < len(items) {
        let owned = items[i]
        if owned.kind == ITEM_FN {
            let mut token_index = owned.body_start
            while token_index < owned.body_end and token_index < len(token_item) {
                token_item[token_index] = i
                token_index = token_index + 1
            }
        }
        i = i + 1
    }
    let mut expr_item_count = make([]int, len(items), len(items))
    let mut expr_owner = make([]int, len(expressions), len(expressions))
    i = 0
    while i < len(expressions) {
        let owner = if expressions[i].token >= 0 and expressions[i].token < len(token_item) {
            token_item[expressions[i].token]
        } else {
            -1
        }
        expr_owner[i] = owner
        if owner >= 0 and owner < len(expr_item_count) {
            expr_item_count[owner] = expr_item_count[owner] + 1
        }
        i = i + 1
    }
    let mut expr_item_start = make([]int, len(items), len(items))
    let mut expr_item_cursor = make([]int, len(items), len(items))
    let mut expr_total = 0
    i = 0
    while i < len(items) {
        expr_item_start[i] = expr_total
        expr_item_cursor[i] = expr_total
        expr_total = expr_total + expr_item_count[i]
        i = i + 1
    }
    let mut item_expressions = make([]int, expr_total, expr_total)
    i = 0
    while i < len(expressions) {
        let owner = expr_owner[i]
        if owner >= 0 and owner < len(expr_item_cursor) {
            item_expressions[expr_item_cursor[owner]] = i
            expr_item_cursor[owner] = expr_item_cursor[owner] + 1
        }
        i = i + 1
    }
    let mut stmt_item_count = make([]int, len(items), len(items))
    let mut stmt_owner = make([]int, len(statements), len(statements))
    i = 0
    while i < len(statements) {
        let owner = if statements[i].token_start >= 0 and statements[i].token_start < len(token_item) {
            token_item[statements[i].token_start]
        } else {
            -1
        }
        stmt_owner[i] = owner
        if owner >= 0 and owner < len(stmt_item_count) {
            stmt_item_count[owner] = stmt_item_count[owner] + 1
        }
        i = i + 1
    }
    let mut stmt_item_start = make([]int, len(items), len(items))
    let mut stmt_item_cursor = make([]int, len(items), len(items))
    let mut stmt_total = 0
    i = 0
    while i < len(items) {
        stmt_item_start[i] = stmt_total
        stmt_item_cursor[i] = stmt_total
        stmt_total = stmt_total + stmt_item_count[i]
        i = i + 1
    }
    let mut item_statements = make([]int, stmt_total, stmt_total)
    i = 0
    while i < len(statements) {
        let owner = stmt_owner[i]
        if owner >= 0 and owner < len(stmt_item_cursor) {
            item_statements[stmt_item_cursor[owner]] = i
            stmt_item_cursor[owner] = stmt_item_cursor[owner] + 1
        }
        i = i + 1
    }
    let mut local_item_count = make([]int, len(items), len(items))
    i = 0
    while i < len(locals) {
        if locals[i].item >= 0 and locals[i].item < len(local_item_count) {
            local_item_count[locals[i].item] = local_item_count[locals[i].item] + 1
        }
        i = i + 1
    }
    let mut local_item_start = make([]int, len(items), len(items))
    let mut local_item_cursor = make([]int, len(items), len(items))
    let mut local_total = 0
    i = 0
    while i < len(items) {
        local_item_start[i] = local_total
        local_item_cursor[i] = local_total
        local_total = local_total + local_item_count[i]
        i = i + 1
    }
    let mut item_locals = make([]int, local_total, local_total)
    i = 0
    while i < len(locals) {
        let owner = locals[i].item
        if owner >= 0 and owner < len(local_item_cursor) {
            item_locals[local_item_cursor[owner]] = i
            local_item_cursor[owner] = local_item_cursor[owner] + 1
        }
        i = i + 1
    }

    let mut next_value = 0
    let mut skipped = 0
    // Rebuilt here rather than threaded through five result structs; it is
    // one pass over the items and the inputs are already parameters.
    let struct_layout = build_struct_layout(source, tokens, items)
    let mut skip_reasons = ""
    let mut signature_index = 0
    while signature_index < len(signatures) {
        let signature = signatures[signature_index]
        // A function banned by an earlier round calls one that could not be
        // lowered. Lowering it anyway would leave a call site pointing at a
        // callee with no body, which the verifier rejects for the whole
        // package — so one unsupported callee would fail an entire file
        // instead of skipping one function.
        // A banned function is not unsupported — it may well lower on its own.
        // It is held back only until its callee does. Substituting `items[0]`
        // below (which the arena indexing needs) makes every later check look
        // at the wrong item, so a banned function used to report whatever that
        // item's body happened to say, most often "found no statements in the
        // body". Recorded honestly and skipped here instead.
        let item_in_range = signature.item >= 0 and signature.item < len(items)
        if item_in_range and ir_item_is_banned(banned, signature.item) {
            skipped = skipped + 1
            skip_reasons = skip_reasons + ir_item_name(source, items, signature.item) +
                ": calls a function that could not be lowered\n"
            signature_index = signature_index + 1
            continue
        }
        let mut supported = item_in_range
        let item = if supported { items[signature.item] } else { items[0] }
        let fn_expr_start = if supported { expr_item_start[signature.item] } else { 0 }
        let fn_expr_count = if supported { expr_item_count[signature.item] } else { 0 }
        let fn_stmt_start = if supported { stmt_item_start[signature.item] } else { 0 }
        let fn_stmt_count = if supported { stmt_item_count[signature.item] } else { 0 }
        // Fail closed on an expression kind this path has no opcode for. Such
        // a kind used to reach the emitter and produce nothing at all, which
        // silently dropped part of the program: a `slice[i].field` read
        // lowered to the same image whichever field it named. Declining the
        // function sends it to the general path, which rejects it with a
        // reason instead.
        let mut expr_scan = 0
        while supported and expr_scan < fn_expr_count {
            let scanned_index = item_expressions[fn_expr_start + expr_scan]
            let scanned = expressions[scanned_index]
            if ir_expression_opcode(scanned.kind) == 0 and not ir_expression_emits_nothing(scanned.kind) {
                supported = false
            }
            // A field read is only modelled as the fused form
            // `slice[i].field` over a slice of an eligible struct, with a field
            // this struct actually has. Anything else — a field of a struct
            // value, an unknown name — is declined rather than lowered to a
            // read of the wrong slot.
            if scanned.kind == EXPR_FIELD {
                if ir_struct_field_aux(source, tokens, expressions, expression_types, expression_locals, locals, struct_layout, scanned_index) < 0 {
                    supported = false
                }
            }
            // An index into a struct slice is a borrowed element pointer. The
            // matched path may fuse it into a field read, materialise it as a
            // call argument, or forward it through a local that only does those
            // things. Anything else falls to the general path, which emits
            // `IR_ELEM_ADDR` rather than a word load.
            if scanned.kind == EXPR_INDEX and scanned.left >= 0 and scanned.left < len(expression_types) and
                semantic_is_struct_array(expression_types[scanned.left]) and
                not ir_index_is_field_object(expressions, expression_locals, locals, scanned_index) and
                not ir_expression_is_call_argument(expressions, scanned_index) {
                supported = false
            }
            expr_scan = expr_scan + 1
        }
        let fn_local_start = if supported { local_item_start[signature.item] } else { 0 }
        let fn_local_count = if supported { local_item_count[signature.item] } else { 0 }
        // Reused by ownership cleanup walks later in this function body.
        let mut local_index = 0
        let mut statement_index = 0
        let mut if_statement = -1
        let mut then_return = -1
        let mut continuation_return = -1
        let mut first_child = -1
        let mut second_child = -1
        let mut while_statement = -1
        let mut seq_wholes: []int = []
        let mut guard_statement = -1
        let mut guard_exit_kind = 0
        let mut merge_if = false
        let mut pre_if = false
        let mut pre_if_statement = -1
        let mut pre_arm_statements: []int = []
        let mut pre_arm_locals: []int = []
        let mut pre_arm_else_flags: []int = []
        let mut pre_merge_locals: []int = []
        let mut if_count = 0
        let mut second_if_statement = -1
        let mut while_count = 0
        let mut assignment_count = 0
        // Assignments only, excluding void intrinsic call statements.
        let mut store_count = 0
        let mut return_count = 0
        let mut assignment_statements: []int = []
        let mut assignment_locals: []int = []
        let mut call_statements: []int = []
        let mut arm_statements: []int = []
        let mut arm_locals: []int = []
        let mut arm_else_flags: []int = []
        let mut merge_locals: []int = []
        let mut loop_carried: []int = []
        let mut stmt_slot = 0
        while supported and stmt_slot < fn_stmt_count {
            let statement_index = item_statements[fn_stmt_start + stmt_slot]
            let statement = statements[statement_index]
            if statement.kind == STMT_IF {
                if_count = if_count + 1
                second_if_statement = if_statement
                if_statement = statement_index
            } else if statement.kind == STMT_WHILE {
                while_count = while_count + 1
                while_statement = statement_index
                seq_wholes = append(seq_wholes, statement_index)
            } else if statement.kind == STMT_RETURN {
                return_count = return_count + 1
            } else if statement.kind == STMT_EXPR {
                // Statement intrinsics (print/exit calls) are tracked
                // separately from assignment statements.
                if statement.token_start + 1 < len(tokens) and
                    tokens[statement.token_start].kind == TK_IDENT and
                    tokens[statement.token_start + 1].kind == TK_LPAREN {
                    let intrinsic_name = token_text(source, tokens[statement.token_start])
                    if intrinsic_name == "print" or intrinsic_name == "exit" {
                        call_statements = append(call_statements, statement_index)
                    } else {
                        assignment_count = assignment_count + 1
                    }
                } else {
                    assignment_count = assignment_count + 1
                    // A *store* specifically, told apart from a void intrinsic
                    // call by its second token. The distinction matters because
                    // a call statement's effect happens while its expression is
                    // lowered, whereas a store has no expression to carry it —
                    // the single-block path emits nothing for one.
                    store_count = store_count + 1
                }
            } else if statement.kind == STMT_BREAK or statement.kind == STMT_CONTINUE {
                // Only valid as the single child of a loop guard if; the
                // while-shape validation below confirms the placement.
            } else if statement.kind != STMT_LET {
                supported = false
            }
            if statement.expr_root >= 0 and
                (statement.expr_root >= len(expression_types) or expression_types[statement.expr_root] == SEM_UNKNOWN) {
                supported = false
            }
            stmt_slot = stmt_slot + 1
        }
        let mut simple_if = false
        let mut merge_return_values = false
        let mut simple_merge_if = false
        let mut simple_while = false
        let mut simple_seq = false
        let mut loop_return = -1
        let mut seq_assignment_loop: []int = []
        // A straight-line body with no branch and no loop falls through every
        // shape to the single-block path, which lowers expressions and then
        // emits only the statement intrinsics and the return. An assignment
        // there emitted *nothing at all* — `let mut i = 3; i = 7; exit(i)`
        // exited 3, and `xs[1] = 40; exit(xs[1])` exited 0. Both were silent
        // wrong answers, not diagnostics.
        //
        // Declining sends them to the general path, which rebinds an assigned
        // local to its new SSA value. The loop and merge-if shapes validate
        // their own assignments and already fail closed on an indexed target,
        // so only this case was open.
        if supported and if_count == 0 and while_count == 0 and store_count > 0 {
            supported = false
        }
        if supported and if_count == 0 and return_count > 1 { supported = false }
        if supported and if_count > 2 { supported = false }
        if supported and if_count == 2 and while_count < 1 { supported = false }
        if supported and if_count >= 1 and while_count >= 1 {
            // Each if is either a loop guard (a child of some while) or a
            // merge-if before the first loop at function scope. One of each
            // may coexist.
            let mut if_scan = 0
            while if_scan < if_count {
                let candidate = if if_count == 1 { if_statement } else if if_scan == 0 { second_if_statement } else { if_statement }
                let mut nested_if = false
                let mut nest_scan = 0
                while nest_scan < while_count {
                    let nest_loop = statements[seq_wholes[nest_scan]]
                    let mut child_scan = 0
                    while child_scan < nest_loop.child_count {
                        if nest_loop.child_start + child_scan < len(statement_edges) and
                            statement_edges[nest_loop.child_start + child_scan] == candidate {
                            nested_if = true
                        }
                        child_scan = child_scan + 1
                    }
                    nest_scan = nest_scan + 1
                }
                if nested_if {
                    if guard_statement >= 0 { supported = false }
                    guard_statement = candidate
                } else {
                    if pre_if { supported = false }
                    pre_if = true
                    pre_if_statement = candidate
                }
                if_scan = if_scan + 1
            }
            if_statement = -1
            if_count = 0
        }
        if supported and if_count == 1 {
            let branch = statements[if_statement]
            let mut has_else = false
            let mut token_index = branch.token_start
            while token_index < branch.token_end {
                if tokens[token_index].kind == TK_ELSE { has_else = true }
                token_index = token_index + 1
            }
            let expected_children = if has_else { 2 } else { 1 }
            if branch.child_count != expected_children or branch.child_start < 0 or
                branch.child_start + expected_children > len(statement_edges) {
                supported = false
            } else {
                first_child = statement_edges[branch.child_start]
                if has_else {
                    second_child = statement_edges[branch.child_start + 1]
                }
                if first_child < 0 or first_child >= len(statements) or
                    (has_else and (second_child < 0 or second_child >= len(statements))) { supported = false }
            }
            let mut fallthrough_return = -1
            let mut statement_index = 0
            while statement_index < len(statements) {
                let statement = statements[statement_index]
                if statement_index != first_child and statement_index != second_child and statement.kind == STMT_RETURN and
                    statement.token_start >= branch.token_end and statement.scope_start == item.body_start {
                    fallthrough_return = statement_index
                }
                statement_index = statement_index + 1
            }
            if supported and has_else and statements[first_child].kind == STMT_RETURN and
                statements[second_child].kind == STMT_RETURN and return_count == 2 {
                then_return = first_child
                continuation_return = second_child
                simple_if = true
                merge_return_values = true
            } else if supported and not has_else and statements[first_child].kind == STMT_RETURN and
                return_count == 2 and fallthrough_return >= 0 {
                then_return = first_child
                continuation_return = fallthrough_return
                simple_if = true
            } else if supported and has_else and statements[first_child].kind == STMT_LET and
                statements[second_child].kind == STMT_LET and return_count == 1 and fallthrough_return >= 0 {
                continuation_return = fallthrough_return
                simple_merge_if = true
            } else {
                supported = false
            }
            let mut expression_slot = 0
            while supported and expression_slot < fn_expr_count {
                let expression_index = item_expressions[fn_expr_start + expression_slot]
                let expression = expressions[expression_index]
                if expression.kind != EXPR_IDENT and expression.kind != EXPR_INT and expression.kind != EXPR_FLOAT and
                    expression.kind != EXPR_BOOL and expression.kind != EXPR_STRING and
                    expression.kind != EXPR_UNARY and expression.kind != EXPR_BINARY and
                    expression.kind != EXPR_CALL {
                    supported = false
                }
                expression_slot = expression_slot + 1
            }
            expression_slot = 0
            while supported and expression_slot < fn_expr_count {
                let expression_index = item_expressions[fn_expr_start + expression_slot]
                let expression = expressions[expression_index]
                if expression.kind == EXPR_CALL {
                    if expression.right >= 0 and expression.right < len(expression_types) and
                        ir_type_is_owned(expression_types[expression.right]) {
                        let argument_expression = expressions[expression.right]
                        if argument_expression.kind == EXPR_IDENT {
                            let argument_local = if expression.right < len(expression_locals) {
                                expression_locals[expression.right]
                            } else {
                                -1
                            }
                            if argument_local < 0 or argument_local >= len(locals) or
                                (not locals[argument_local].is_parameter and
                                    locals[argument_local].declaration_end > branch.token_start) {
                                supported = false
                            }
                        } else if argument_expression.kind != EXPR_STRING and
                            argument_expression.kind != EXPR_CALL {
                            supported = false
                        }
                    }
                }
                expression_slot = expression_slot + 1
            }
        }
        if supported and while_count > 0 and
            (if_count > 0 or return_count != 1 or assignment_count < 1) {
            supported = false
        }
        if supported and (while_count > 1 or (while_count == 1 and pre_if)) {
            // Sequential loops: every while body holds assignments and scalar
            // temporaries; the last loop may also hold one guard if (a single
            // break or continue child). Merge-ifs stay single-loop-only. One
            // merge-if may also lead the function before the first loop.
            let mut assignment_index = 0
            let mut seq_loop_index = 0
            if pre_if {
                // The merge-if must sit at function scope before the first
                // loop, hold an else, and have only assignments in its arms.
                let pre_statement = statements[pre_if_statement]
                let mut else_seen = false
                let mut else_position = pre_statement.token_end
                let mut token_index = pre_statement.token_start
                while token_index < pre_statement.token_end {
                    if tokens[token_index].kind == TK_ELSE {
                        else_seen = true
                        else_position = token_index
                    }
                    token_index = token_index + 1
                }
                if pre_statement.scope_start != item.body_start or
                    pre_statement.token_end > statements[seq_wholes[0]].token_start or
                    not else_seen or pre_statement.child_count < 1 or pre_statement.child_start < 0 or
                    pre_statement.child_start + pre_statement.child_count > len(statement_edges) or
                    pre_statement.expr_root < 0 or pre_statement.expr_root >= len(expression_types) or
                    expression_types[pre_statement.expr_root] != SEM_BOOL {
                    supported = false
                }
                let mut arm_index = 0
                while supported and arm_index < pre_statement.child_count {
                    let child = statement_edges[pre_statement.child_start + arm_index]
                    let assignment = statements[child]
                    if child < 0 or child >= len(statements) or statements[child].kind != STMT_EXPR or
                        assignment.token_start + 1 >= len(tokens) or
                        tokens[assignment.token_start].kind != TK_IDENT or
                        tokens[assignment.token_start + 1].kind != TK_ASSIGN {
                        supported = false
                    } else {
                        let assignment_target = tokens[assignment.token_start]
                        let mut target_local = -1
                        let mut local_index = 0
                        while local_index < len(locals) {
                            let local = locals[local_index]
                            if local.item == signature.item and not local.is_parameter and
                                local.declaration_end <= pre_statement.token_start and
                                assignment.token_start >= local.scope_start and
                                assignment.token_start < local.scope_end and
                                span_equal(source, local.name_start, local.name_end, assignment_target.start, assignment_target.end) {
                                target_local = local_index
                            }
                            local_index = local_index + 1
                        }
                        if target_local < 0 or target_local >= len(local_types) or
                            local_types[target_local] != SEM_INT {
                            supported = false
                        } else {
                            let in_else = assignment.token_start > else_position
                            let mut previous = 0
                            while previous < len(pre_arm_statements) {
                                if pre_arm_locals[previous] == target_local and
                                    (pre_arm_else_flags[previous] == 1) == in_else {
                                    supported = false
                                }
                                previous = previous + 1
                            }
                            pre_arm_statements = append(pre_arm_statements, child)
                            pre_arm_locals = append(pre_arm_locals, target_local)
                            pre_arm_else_flags = append(pre_arm_else_flags, if in_else { 1 } else { 0 })
                        }
                    }
                    arm_index = arm_index + 1
                }
                // Merge locals in declaration order, and the arm read rules:
                // right-hand sides read only pre-if values — never an earlier
                // update from the same arm.
                let mut carried_scan = 0
                while carried_scan < len(locals) {
                    let mut merge_hit = false
                    arm_index = 0
                    while arm_index < len(pre_arm_locals) {
                        if pre_arm_locals[arm_index] == carried_scan { merge_hit = true }
                        arm_index = arm_index + 1
                    }
                    if merge_hit { pre_merge_locals = append(pre_merge_locals, carried_scan) }
                    carried_scan = carried_scan + 1
                }
                let mut expression_slot = 0
                while supported and expression_slot < fn_expr_count {
                    let expression_index = item_expressions[fn_expr_start + expression_slot]
                    let expression = expressions[expression_index]
                    if expression.token >= pre_statement.token_start and
                        expression.token < pre_statement.token_end and
                        expression.kind == EXPR_IDENT and expression_index < len(expression_locals) {
                        let referenced = expression_locals[expression_index]
                        let mut scan = 0
                        while scan < len(pre_arm_statements) {
                            let owner = statements[pre_arm_statements[scan]]
                            if expression.token >= owner.token_start + 2 and
                                expression.token < owner.token_end and pre_arm_locals[scan] >= 0 {
                                let mut other = 0
                                while other < len(pre_arm_statements) {
                                    if other != scan and pre_arm_locals[other] == referenced and
                                        pre_arm_else_flags[other] == pre_arm_else_flags[scan] and
                                        statements[pre_arm_statements[other]].token_start < owner.token_start {
                                        supported = false
                                    }
                                    other = other + 1
                                }
                            }
                            scan = scan + 1
                        }
                    }
                    expression_slot = expression_slot + 1
                }
            }
            if guard_statement >= 0 {
                let last_loop = statements[seq_wholes[while_count - 1]]
                let mut guard_found = false
                let mut guard_scan = 0
                while guard_scan < last_loop.child_count {
                    if last_loop.child_start + guard_scan < len(statement_edges) and
                        statement_edges[last_loop.child_start + guard_scan] == guard_statement {
                        guard_found = true
                    }
                    guard_scan = guard_scan + 1
                }
                let guard = statements[guard_statement]
                if not guard_found or guard.child_count != 1 or guard.child_start < 0 or
                    guard.child_start >= len(statement_edges) {
                    supported = false
                } else {
                    let guard_child = statement_edges[guard.child_start]
                    if guard_child < 0 or guard_child >= len(statements) or
                        (statements[guard_child].kind != STMT_BREAK and
                            statements[guard_child].kind != STMT_CONTINUE) {
                        supported = false
                    } else {
                        guard_exit_kind = statements[guard_child].kind
                    }
                }
                if guard.expr_root < 0 or guard.expr_root >= len(expression_types) or
                    expression_types[guard.expr_root] != SEM_BOOL {
                    supported = false
                }
            }
            while supported and seq_loop_index < while_count {
                let loop_statement = statements[seq_wholes[seq_loop_index]]
                if loop_statement.scope_start != item.body_start or
                    loop_statement.child_count < 1 or loop_statement.child_start < 0 or
                    loop_statement.child_start + loop_statement.child_count > len(statement_edges) {
                    supported = false
                }
                if loop_statement.expr_root < 0 or loop_statement.expr_root >= len(expression_types) or
                    expression_types[loop_statement.expr_root] != SEM_BOOL {
                    supported = false
                }
                let mut child_index = 0
                while supported and child_index < loop_statement.child_count {
                    let child = statement_edges[loop_statement.child_start + child_index]
                    if child == guard_statement {
                        child_index = child_index + 1
                        continue
                    }
                    if child < 0 or child >= len(statements) or
                        (statements[child].kind != STMT_EXPR and statements[child].kind != STMT_LET) {
                        supported = false
                    } else if statements[child].kind == STMT_EXPR {
                        let assignment = statements[child]
                        if assignment.token_start + 1 >= len(tokens) or
                            tokens[assignment.token_start].kind != TK_IDENT or
                            tokens[assignment.token_start + 1].kind != TK_ASSIGN {
                            supported = false
                        } else {
                            let assignment_target = tokens[assignment.token_start]
                            let mut target_local = -1
                            let mut local_index = 0
                            while local_index < len(locals) {
                                let local = locals[local_index]
                                if local.item == signature.item and not local.is_parameter and
                                    local.declaration_end <= statements[seq_wholes[0]].token_start and
                                    assignment.token_start >= local.scope_start and
                                    assignment.token_start < local.scope_end and
                                    span_equal(source, local.name_start, local.name_end, assignment_target.start, assignment_target.end) {
                                    target_local = local_index
                                }
                                local_index = local_index + 1
                            }
                            if target_local < 0 or target_local >= len(local_types) or
                                local_types[target_local] != SEM_INT {
                                supported = false
                            } else {
                                let mut previous = 0
                                while previous < len(assignment_locals) {
                                    if assignment_locals[previous] == target_local and
                                        seq_assignment_loop[previous] == seq_loop_index {
                                        supported = false
                                    }
                                    previous = previous + 1
                                }
                                assignment_statements = append(assignment_statements, child)
                                assignment_locals = append(assignment_locals, target_local)
                                seq_assignment_loop = append(seq_assignment_loop, seq_loop_index)
                            }
                        }
                    }
                    child_index = child_index + 1
                }
                seq_loop_index = seq_loop_index + 1
            }
            // The return must follow the last loop; lets outside a loop body
            // must lead the function.
            let mut statement_index = 0
            while statement_index < len(statements) {
                let statement = statements[statement_index]
                if statement.token_start >= item.body_start and statement.token_start < item.body_end {
                    if statement.kind == STMT_RETURN {
                        if statement.token_start >= statements[seq_wholes[while_count - 1]].token_end and
                            statement.scope_start == item.body_start {
                            loop_return = statement_index
                        } else {
                            supported = false
                        }
                    }
                    if statement.kind == STMT_LET and
                        statement.token_start >= statements[seq_wholes[0]].token_start {
                        let mut inside_loop = false
                        seq_loop_index = 0
                        while seq_loop_index < while_count {
                            if statement.token_start >= statements[seq_wholes[seq_loop_index]].token_start and
                                statement.token_start < statements[seq_wholes[seq_loop_index]].token_end {
                                inside_loop = true
                            }
                            seq_loop_index = seq_loop_index + 1
                        }
                        if not inside_loop { supported = false }
                    }
                }
                statement_index = statement_index + 1
            }
            if loop_return < 0 { supported = false }
            // Carried locals across all loops, in declaration order.
            let mut carried_scan = 0
            while carried_scan < len(locals) {
                let mut carried_hit = false
                assignment_index = 0
                while assignment_index < len(assignment_locals) {
                    if assignment_locals[assignment_index] == carried_scan { carried_hit = true }
                    assignment_index = assignment_index + 1
                }
                if carried_hit { loop_carried = append(loop_carried, carried_scan) }
                carried_scan = carried_scan + 1
            }
            let mut local_index = 0
            while supported and local_index < len(locals) {
                if locals[local_index].item == signature.item and
                    (local_index >= len(local_types) or
                        (local_types[local_index] != SEM_INT and local_types[local_index] != SEM_BOOL)) {
                    supported = false
                }
                local_index = local_index + 1
            }
            // Per-loop use rules: each condition and each right-hand side
            // reads a local carried in its own loop; a right-hand side may
            // only read values current where the read happens.
            let mut guard_uses_carried = false
            let mut condition_uses: []int = []
            seq_loop_index = 0
            while seq_loop_index < while_count {
                condition_uses = append(condition_uses, 0)
                seq_loop_index = seq_loop_index + 1
            }
            let mut rhs_uses: []int = []
            assignment_index = 0
            while assignment_index < len(assignment_statements) {
                rhs_uses = append(rhs_uses, 0)
                assignment_index = assignment_index + 1
            }
            let mut expression_slot = 0
            while supported and expression_slot < fn_expr_count {
                let expression_index = item_expressions[fn_expr_start + expression_slot]
                let expression = expressions[expression_index]
                let callee_ident = expression.kind == EXPR_IDENT and
                    (expression_index >= len(expression_locals) or expression_locals[expression_index] < 0)
                if not callee_ident and
                    (expression_index >= len(expression_types) or
                        (expression_types[expression_index] != SEM_INT and
                            expression_types[expression_index] != SEM_BOOL)) {
                    supported = false
                }
                let mut expression_loop = -1
                seq_loop_index = 0
                while seq_loop_index < while_count {
                    if expression.token >= statements[seq_wholes[seq_loop_index]].token_start and
                        expression.token < statements[seq_wholes[seq_loop_index]].token_end {
                        expression_loop = seq_loop_index
                    }
                    seq_loop_index = seq_loop_index + 1
                }
                if expression_loop >= 0 {
                    let in_last_guard = guard_statement >= 0 and expression_loop == while_count - 1 and
                        expression.token >= statements[guard_statement].token_start and
                        expression.token < statements[guard_statement].token_end
                    if expression.kind != EXPR_IDENT and expression.kind != EXPR_INT and
                        expression.kind != EXPR_BOOL and expression.kind != EXPR_UNARY and
                        expression.kind != EXPR_BINARY and expression.kind != EXPR_CALL {
                        supported = false
                    }
                    // Guard conditions stay call-free so their compare can
                    // stay fused.
                    if in_last_guard and expression.kind == EXPR_CALL {
                        supported = false
                    }
                    if expression.kind == EXPR_IDENT and expression_index < len(expression_locals) {
                        let referenced = expression_locals[expression_index]
                        let mut carried_index = 0
                        while carried_index < len(loop_carried) {
                            if loop_carried[carried_index] == referenced {
                                if in_last_guard {
                                    guard_uses_carried = true
                                    // The guard may only read locals no
                                    // earlier statement in its loop assigns;
                                    // their header parameters are current.
                                    assignment_index = 0
                                    while assignment_index < len(assignment_statements) {
                                        if seq_assignment_loop[assignment_index] == expression_loop and
                                            assignment_locals[assignment_index] == referenced and
                                            statements[assignment_statements[assignment_index]].token_start <
                                                statements[guard_statement].token_start {
                                            supported = false
                                        }
                                        assignment_index = assignment_index + 1
                                    }
                                }
                                assignment_index = 0
                                while assignment_index < len(assignment_statements) {
                                    let owner = statements[assignment_statements[assignment_index]]
                                    if expression.token >= owner.token_start + 2 and
                                        expression.token < owner.token_end {
                                        rhs_uses[assignment_index] = 1
                                        if seq_assignment_loop[assignment_index] == expression_loop {
                                            // Same loop: only values current
                                            // at the read are allowed.
                                            let mut other_index = 0
                                            while other_index < len(assignment_statements) {
                                                if other_index != assignment_index and
                                                    seq_assignment_loop[other_index] == expression_loop and
                                                    assignment_locals[other_index] == referenced and
                                                    statements[assignment_statements[other_index]].token_start < owner.token_start {
                                                    supported = false
                                                }
                                                other_index = other_index + 1
                                            }
                                        }
                                    }
                                    assignment_index = assignment_index + 1
                                }
                                carried_index = carried_index + 1
                            }
                            carried_index = carried_index + 1
                        }
                    }
                }
                expression_slot = expression_slot + 1
            }
            seq_loop_index = 0
            while seq_loop_index < while_count {
                let loop_statement = statements[seq_wholes[seq_loop_index]]
                let condition_end = statements[statement_edges[loop_statement.child_start]].token_start
                let mut ident_slot = 0
                while ident_slot < fn_expr_count {
                    let ident_index = item_expressions[fn_expr_start + ident_slot]
                    if expressions[ident_index].kind == EXPR_IDENT and
                        expressions[ident_index].token >= loop_statement.token_start and
                        expressions[ident_index].token < condition_end and
                        ident_index < len(expression_locals) {
                        assignment_index = 0
                        while assignment_index < len(assignment_locals) {
                            if assignment_locals[assignment_index] == expression_locals[ident_index] and
                                seq_assignment_loop[assignment_index] == seq_loop_index {
                                condition_uses[seq_loop_index] = 1
                            }
                            assignment_index = assignment_index + 1
                        }
                    }
                    ident_slot = ident_slot + 1
                }
                if condition_uses[seq_loop_index] == 0 { supported = false }
                seq_loop_index = seq_loop_index + 1
            }
            if guard_statement >= 0 and not guard_uses_carried { supported = false }
            assignment_index = 0
            while assignment_index < len(rhs_uses) {
                if rhs_uses[assignment_index] == 0 { supported = false }
                assignment_index = assignment_index + 1
            }
            if supported { simple_seq = true }
        }
        if supported and while_count == 1 and not pre_if {
            // Scalar while loop: leading bindings, a boolean condition over
            // the carried locals, one or more reassignment statements, and a
            // trailing return. Body assignments reassign pre-loop integer
            // locals; the header block parameters follow the carried locals'
            // declaration order for determinism. The body may also hold one
            // if: either a guard whose only child is a break or continue, or
            // an if/else whose arms hold only assignments (a merge-if).
            let loop_statement = statements[while_statement]
            if loop_statement.scope_start != item.body_start or
                loop_statement.child_count < 1 or loop_statement.child_start < 0 or
                loop_statement.child_start + loop_statement.child_count > len(statement_edges) {
                supported = false
            }
            if supported and guard_statement >= 0 {
                // The body if must be one of the loop's children. Its shape
