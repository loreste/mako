        while seq_value_index < while_count * union_count {
            seq_params[seq_value_index] = -1
            seq_update_values[seq_value_index] = -1
            seq_value_index = seq_value_index + 1
        }
        seq_value_index = 0
        while seq_value_index < union_count {
            seq_init_values[seq_value_index] = -1
            seq_value_index = seq_value_index + 1
        }
        local_slot = 0
        while local_slot < fn_local_count {
            let local_index = item_locals[fn_local_start + local_slot]
            let local = locals[local_index]
            if local.is_parameter {
                let result = next_value
                next_value = next_value + 1
                local_values[local_index] = result
                instructions = append(instructions, IrInstruction {
                    op: IR_PARAM, result: result, type_kind: local_types[local_index],
                    left: -1, right: -1, aux: local_index, token: item.token_start,
                })
                parameter_count = parameter_count + 1
            }
            local_slot = local_slot + 1
        }

        // initializer_root -> local, so binding a lowered expression is O(1)
        // instead of scanning every local for every expression.
        let mut initializer_local = make([]int, len(expressions), len(expressions))
        {
            let mut init_index = 0
            while init_index < len(initializer_local) {
                initializer_local[init_index] = -1
                init_index = init_index + 1
            }
            local_slot = 0
            while local_slot < fn_local_count {
                let mapped_local = item_locals[fn_local_start + local_slot]
                let root = locals[mapped_local].initializer_root
                if root >= 0 and root < len(initializer_local) {
                    initializer_local[root] = mapped_local
                }
                local_slot = local_slot + 1
            }
        }

        let mut expr_slot = 0
        while expr_slot < fn_expr_count {
            let i = item_expressions[fn_expr_start + expr_slot]
            let expression = expressions[i]
            let in_function = true
            let mut seq_region = -1
            if pre_if and in_function and len(pre_merge_values) == 0 and
                expression.token >= statements[pre_if_statement].token_start {
                // Allocate the merge values for the pre-loop if: one per
                // arm-assigned local, in declaration order. Reads after the
                // if resolve to them.
                let mut carried_index = 0
                while carried_index < len(pre_merge_locals) {
                    pre_if_init_values[carried_index] = local_values[pre_merge_locals[carried_index]]
                    let merge_value = next_value
                    next_value = next_value + 1
                    pre_merge_values = append(pre_merge_values, merge_value)
                    local_values[pre_merge_locals[carried_index]] = merge_value
                    carried_index = carried_index + 1
                }
            }
            if simple_seq and in_function {
                let mut seq_loop_index = while_count - 1
                while seq_loop_index >= 0 {
                    if expression.token >= statements[seq_wholes[seq_loop_index]].token_start {
                        seq_region = seq_loop_index
                        seq_loop_index = -2
                    }
                    seq_loop_index = seq_loop_index - 1
                }
                if seq_region >= 0 and seq_params[seq_region * union_count] == -1 {
                    // Allocate this loop's header parameters on first contact:
                    // one per carried-union local, and the entry snapshot for
                    // the first loop.
                    let mut carried_index = 0
                    while carried_index < union_count {
                        if seq_region == 0 {
                            seq_init_values[carried_index] = local_values[loop_carried[carried_index]]
                        }
                        let param_value = next_value
                        next_value = next_value + 1
                        seq_params[seq_region * union_count + carried_index] = param_value
                        carried_index = carried_index + 1
                    }
                    if seq_region == while_count - 1 and guard_exit_kind == STMT_BREAK {
                        // A break in the last loop can fire after pre-guard
                        // updates changed a carried local, so the exit block
                        // gets its own parameters.
                        carried_index = 0
                        while carried_index < union_count {
                            let exit_param_value = next_value
                            next_value = next_value + 1
                            seq_exit_params = append(seq_exit_params, exit_param_value)
                            carried_index = carried_index + 1
                        }
                    }
                }
            }
            if simple_while and in_function and len(loop_param_values) == 0 and
                expression.token >= statements[while_statement].token_start {
                // The carried locals become header block parameters from here
                // on: condition, body, and post-loop reads all resolve to
                // them. Parameter order is the carried locals' declaration
                // order (loop_carried is built by an ascending locals scan).
                let mut carried_index = 0
                while carried_index < len(loop_carried) {
                    let carried_local = loop_carried[carried_index]
                    loop_init_values = append(loop_init_values, local_values[carried_local])
                    let param_value = next_value
                    next_value = next_value + 1
                    loop_param_values = append(loop_param_values, param_value)
                    condition_instructions = append(condition_instructions, IrInstruction {
                        op: IR_BLOCK_PARAM, result: param_value, type_kind: SEM_INT,
                        left: -1, right: -1, aux: 0, token: statements[while_statement].token_start,
                    })
                    local_values[carried_local] = param_value
                    carried_index = carried_index + 1
                }
                if guard_exit_kind == STMT_BREAK {
                    // A break can leave the loop after pre-guard assignments
                    // already updated a carried local, so the exit block gets
                    // its own parameters: the header edge carries the header
                    // parameters, the break arm carries the current values.
                    carried_index = 0
                    while carried_index < len(loop_carried) {
                        let exit_param_value = next_value
                        next_value = next_value + 1
                        exit_param_values = append(exit_param_values, exit_param_value)
                        carried_index = carried_index + 1
                    }
                }
                if merge_if {
                    // Merge-set locals get a block parameter each on the
                    // post-if merge block, fed by both arms.
                    carried_index = 0
                    while carried_index < len(loop_carried) {
                        let mut merge_hit = false
                        let mut merge_scan = 0
                        while merge_scan < len(merge_locals) {
                            if merge_locals[merge_scan] == loop_carried[carried_index] { merge_hit = true }
                            merge_scan = merge_scan + 1
                        }
                        if merge_hit {
                            let merge_value = next_value
                            next_value = next_value + 1
                            merge_values = append(merge_values, merge_value)
                        }
                        carried_index = carried_index + 1
                    }
                }
            }
            if in_function and i < len(expression_types) and expression_types[i] != SEM_UNKNOWN {
                if expression.kind == EXPR_IDENT and i < len(expression_locals) {
                    let local = expression_locals[i]
                    // Carried loop locals resolve by source position, never
                    // through the mutable local_values array: the expression
                    // arena is not in source order. Pre-loop reads see the
                    // initializer; everything from the `while` keyword on
                    // (condition, body, post-loop) sees the header parameter.
                    let mut resolved = -2
                    if simple_while {
                        let mut carried_index = 0
                        while carried_index < len(loop_carried) {
                            if loop_carried[carried_index] == local {
                                if expression.token < statements[while_statement].token_start {
                                    if carried_index < len(loop_init_values) {
                                        resolved = loop_init_values[carried_index]
                                    }
                                } else if guard_exit_kind == STMT_BREAK and
                                    expression.token >= statements[while_statement].token_end and
                                    carried_index < len(exit_param_values) {
                                    // Post-loop reads in a break loop see the
                                    // exit parameter, not the header one.
                                    resolved = exit_param_values[carried_index]
                                } else if merge_if and guard_statement >= 0 and
                                    expression.token >= statements[guard_statement].token_end and
                                    expression.token < statements[while_statement].token_end {
                                    // Post-if body reads of a merge-set local
                                    // see its merge block parameter.
                                    let mut merge_scan = 0
                                    while merge_scan < len(merge_locals) {
                                        if merge_locals[merge_scan] == local {
                                            resolved = merge_values[merge_scan]
                                        }
                                        merge_scan = merge_scan + 1
                                    }
                                }
                                if resolved == -2 and carried_index < len(loop_param_values) {
                                    resolved = loop_param_values[carried_index]
                                }
                            }
                            carried_index = carried_index + 1
                        }
                    }
                    if resolved == -2 and pre_if {
                        // Pre-loop merge-if locals resolve by position: reads
                        // before or inside the if see the pre-if value, reads
                        // between the if and the first loop see the merge
                        // value, and everything from the first loop on follows
                        // the sequential loop resolution.
                        let mut merge_index = 0
                        while merge_index < len(pre_merge_locals) {
                            if pre_merge_locals[merge_index] == local {
                                if expression.token < statements[pre_if_statement].token_end {
                                    if pre_if_init_values[merge_index] >= 0 {
                                        resolved = pre_if_init_values[merge_index]
                                    }
                                } else if expression.token < statements[seq_wholes[0]].token_start and
                                    merge_index < len(pre_merge_values) {
                                    resolved = pre_merge_values[merge_index]
                                }
                            }
                            merge_index = merge_index + 1
                        }
                    }
                    if resolved == -2 and simple_seq {
                        // Sequential loops resolve by region: pre-first-loop
                        // reads see the initializer, everything from a loop's
                        // keyword on sees that loop's header parameter, and
                        // post-loop reads in a break-last chain see the exit
                        // parameters.
                        let mut carried_index = 0
                        while carried_index < union_count {
                            if loop_carried[carried_index] == local {
                                if expression.token < statements[seq_wholes[0]].token_start {
                                    if seq_init_values[carried_index] >= 0 {
                                        resolved = seq_init_values[carried_index]
                                    }
                                } else if guard_exit_kind == STMT_BREAK and
                                    expression.token >= statements[seq_wholes[while_count - 1]].token_end and
                                    carried_index < len(seq_exit_params) {
                                    resolved = seq_exit_params[carried_index]
                                } else if seq_region >= 0 and seq_params[seq_region * union_count + carried_index] >= 0 {
                                    resolved = seq_params[seq_region * union_count + carried_index]
                                }
                            }
                            carried_index = carried_index + 1
                        }
                    }
                    if resolved == -2 {
                        if local >= 0 and local < len(local_values) {
                            resolved = local_values[local]
                        } else {
                            resolved = -1
                        }
                    }
                    if resolved >= 0 {
                        expression_values[i] = resolved
                    }
                } else {
                    let mut statement_intrinsic = false
                    if expression.kind == EXPR_CALL {
                        let mut intrinsic_callee = i
                        let mut intrinsic_steps = 0
                        while intrinsic_callee >= 0 and intrinsic_callee < len(expressions) and
                            expressions[intrinsic_callee].kind == EXPR_CALL and intrinsic_steps < len(expressions) {
                            intrinsic_callee = expressions[intrinsic_callee].left
                            intrinsic_steps = intrinsic_steps + 1
                        }
                        if intrinsic_callee >= 0 and intrinsic_callee < len(expressions) and
                            expressions[intrinsic_callee].kind == EXPR_IDENT {
                            let intrinsic_name = token_text(source, tokens[expressions[intrinsic_callee].token])
                            if intrinsic_name == "print" or intrinsic_name == "exit" {
                                statement_intrinsic = true
                            }
                        }
                    }
                    let op = if statement_intrinsic or (expression.kind == EXPR_CALL and continued_calls[i] != 0) or
                        (expression.kind == EXPR_MAKE and continued_makes[i] != 0) {
                        0
                    } else if expression.kind == EXPR_CALL {
                        let mut len_callee = i
                        let mut len_steps = 0
                        while len_callee >= 0 and len_callee < len(expressions) and
                            expressions[len_callee].kind == EXPR_CALL and len_steps < len(expressions) {
                            len_callee = expressions[len_callee].left
                            len_steps = len_steps + 1
                        }
                        if len_callee >= 0 and len_callee < len(expressions) and
                            expressions[len_callee].kind == EXPR_IDENT and
                            token_text(source, tokens[expressions[len_callee].token]) == "len" and
                            expression_types[i] == SEM_INT {
                            IR_LEN
                        } else {
                            ir_expression_opcode(expression.kind)
                        }
                    } else {
                        ir_expression_opcode(expression.kind)
                    }
                    // An index into a struct slice is fused into a field read
                    // above it, or materialised as a call-argument address.
                    // Either way the index node itself emits nothing here: the
                    // field path re-reads the slice/index operands, and the
                    // call path emits `IR_ELEM_ADDR` next to the clone prefix.
                    let fused_index = op == IR_INDEX and expression.left >= 0 and
                        expression.left < len(expression_types) and
                        semantic_is_struct_array(expression_types[expression.left])
                    if op > 0 and not fused_index {
                        let mut left = if expression.left >= 0 and expression.left < len(expression_values) { expression_values[expression.left] } else { -1 }
                        let mut right = if expression.right >= 0 and expression.right < len(expression_values) { expression_values[expression.right] } else { -1 }
                        if op == IR_FIELD {
                            // slice[i].field: the operands come from the index
                            // expression underneath, which emits nothing of its
                            // own. The pre-scan already proved this shape.
                            let field_object_index = ir_field_object_index(source, tokens, expressions, expression_types, expression_locals, locals, expression.left)
                            if field_object_index < 0 {
                                // Borrowed element: the object already holds the
                                // pointer, so there is no index to check.
                                left = if expression.left < len(expression_values) { expression_values[expression.left] } else { -1 }
                                right = -1
                            } else {
                                let field_object = expressions[field_object_index]
                                left = if field_object.left >= 0 and field_object.left < len(expression_values) { expression_values[field_object.left] } else { -1 }
                                right = if field_object.right >= 0 and field_object.right < len(expression_values) { expression_values[field_object.right] } else { -1 }
                            }
                        }
                        if op == IR_LEN {
                            // len(x): the argument is the call's right child;
                            // the callee chain plays no role.
                            left = if expression.right >= 0 and expression.right < len(expression_values) { expression_values[expression.right] } else { -1 }
                            right = -1
                        }
                        let mut call_callee = -1
                        let mut reversed_arguments: []int = []
                        let mut reversed_argument_expressions: []int = []
                        let mut call_prefix: []IrInstruction = []
                        let mut call_ready = true
                        if op == IR_CALL {
                            let mut cursor = i
                            let mut steps = 0
                            while cursor >= 0 and cursor < len(expressions) and expressions[cursor].kind == EXPR_CALL and
                                steps < len(expressions) {
                                let argument = expressions[cursor].right
                                if argument >= 0 {
                                    let argument_value = if argument < len(expression_values) { expression_values[argument] } else { -1 }
                                    // A borrowed element has no value of its own until its
                                            // address is materialised below, so its absence is not a
                                            // reason to decline the call.
                                            let addressable = argument < len(expression_types) and
                                                semantic_is_struct_value(expression_types[argument]) and
                                                ir_field_object_index(source, tokens, expressions, expression_types, expression_locals, locals, argument) >= 0
                                            if argument_value < 0 and not addressable { call_ready = false }
                                    reversed_arguments = append(reversed_arguments, argument_value)
                                    reversed_argument_expressions = append(reversed_argument_expressions, argument)
                                }
                                cursor = expressions[cursor].left
                                steps = steps + 1
                            }
                            call_callee = cursor
                            left = -1
                            right = -1
                        }
                        let mut ready = true
                        if (op == IR_UNARY or op == IR_BINARY or op == IR_INDEX or op == IR_LEN) and left < 0 { ready = false }
                        if (op == IR_BINARY or op == IR_INDEX) and right < 0 { ready = false }
                        if op == IR_CALL and not call_ready { ready = false }
                        if ready {
                let mut aux = if op == IR_FIELD {
                    ir_struct_field_aux(source, tokens, expressions, expression_types, expression_locals, locals, struct_layout, i)
                } else if op == IR_UNARY or op == IR_BINARY { tokens[expression.token].kind } else { expression.left }
                // Preserve literal make lengths in the IR. The make parser uses
                // a type-reference node as its left edge, so the generic
                // expression-value lookup cannot recover this operand later.
                if op == IR_MAKE {
                    let mut make_scan = expression.token + 1
                    while make_scan < len(tokens) and tokens[make_scan].kind != TK_COMMA and tokens[make_scan].kind != TK_RPAREN { make_scan = make_scan + 1 }
                    if make_scan < len(tokens) and tokens[make_scan].kind == TK_COMMA {
                        make_scan = make_scan + 1
                        if make_scan < len(tokens) and tokens[make_scan].kind == TK_INT {
                            aux = ir_parse_decimal_int(source, tokens[make_scan])
                        }
                    }
                }
                            if op == IR_CALL {
                                let call_signature = semantic_function_signature(
                                    signatures, symbols, expression_symbols, call_callee
                                )
                                let argument_start = len(call_arguments)
                                let mut argument_index = len(reversed_arguments) - 1
                                while argument_index >= 0 {
                                    let argument_expression = reversed_argument_expressions[argument_index]
                                    let mut argument_value = reversed_arguments[argument_index]
                                    if argument_expression >= 0 and argument_expression < len(expressions) and
                                        expressions[argument_expression].kind == EXPR_IDENT and
                                        argument_expression < len(expression_locals) {
                                        let argument_local = expression_locals[argument_expression]
                                        // Only a declared Mako function takes
                                        // ownership of what it is passed, so
                                        // only it needs a clone. An intrinsic
                                        // either borrows the slice — every
                                        // `unsafe_*` reads through it and
                                        // returns — or consumes it and hands
                                        // back the replacement, as `append`
                                        // does. Cloning for one of those leaks
                                        // the copy: nothing on the other side
                                        // ever drops it.
                                        // Struct values are always borrowed at
                                        // the call site — never cloned. There is
                                        // no clone emitter for one, and a
                                        // parameter of struct type is an
                                        // element pointer the callee must not
                                        // free.
                                        if call_signature >= 0 and
                                            argument_local >= 0 and argument_local < len(locals) and
                                            argument_expression < len(expression_types) and
                                            ir_type_is_owned(expression_types[argument_expression]) and
                                            not semantic_is_struct_value(expression_types[argument_expression]) and
                                            locals[argument_local].ownership != LOCAL_OWN_HOLD {
                                            let cloned_value = next_value
                                            next_value = next_value + 1
                                            call_prefix = append(call_prefix, IrInstruction {
                                                op: IR_CLONE, result: cloned_value,
                                                type_kind: expression_types[argument_expression],
                                                left: argument_value, right: -1, aux: -1,
                                                token: expressions[argument_expression].token,
                                            })
                                            argument_value = cloned_value
                                        }
                                    }
                                    if argument_value < 0 and argument_expression >= 0 and
                                        argument_expression < len(expression_types) and
                                        semantic_is_struct_value(expression_types[argument_expression]) {
                                        // Hand the callee a pointer to the element. The slice keeps
                                        // ownership, so nothing is cloned and nothing is dropped.
                                        let element_index = ir_field_object_index(source, tokens, expressions, expression_types, expression_locals, locals, argument_expression)
                                        if element_index >= 0 {
                                            let element_node = expressions[element_index]
                                            let element_slice = if element_node.left >= 0 and element_node.left < len(expression_values) { expression_values[element_node.left] } else { -1 }
                                            let element_offset = if element_node.right >= 0 and element_node.right < len(expression_values) { expression_values[element_node.right] } else { -1 }
                                            if element_slice >= 0 and element_offset >= 0 {
                                                let address_value = next_value
                                                next_value = next_value + 1
                                                call_prefix = append(call_prefix, IrInstruction {
                                                    op: IR_ELEM_ADDR, result: address_value,
                                                    type_kind: expression_types[argument_expression],
                                                    left: element_slice, right: element_offset,
                                                    aux: 8 * struct_kind_fields(expression_types[argument_expression]),
                                                    token: expressions[argument_expression].token,
                                                })
                                                argument_value = address_value
                                            }
                                        }
                                    }
                                    call_arguments = append(call_arguments, argument_value)
                                    argument_index = argument_index - 1
                                }
                                aux = len(call_sites)
                                call_sites = append(call_sites, IrCallSite {
                                    callee_item: if call_signature >= 0 {
                                        signatures[call_signature].item
                                    } else if call_callee >= 0 and call_callee < len(expressions) and
                                        ir_intrinsic_callee_item(token_text(source, tokens[expressions[call_callee].token])) != IR_NOT_INTRINSIC {
                                        ir_intrinsic_callee_item(token_text(source, tokens[expressions[call_callee].token]))
                                    } else {
                                        -1
                                    },
                                    argument_start: argument_start,
                                    argument_count: len(reversed_arguments),
                                })
                            }
                            if op == IR_CONST {
                                let token = tokens[expression.token]
                                let mut int_value = 0
                                let mut float_value = 0.0
                                let mut start = token.start
                                let mut end = token.end
                                if expression.kind == EXPR_INT {
                                    int_value = ir_parse_decimal_int(source, token)
                                    if int_value < 0 {
                                        return TypedIr {
                                            functions: functions, blocks: blocks, instructions: instructions,
                                            constants: constants, successors: successors,
                                            call_sites: call_sites, call_arguments: call_arguments,
                                            jump_arguments: jump_arguments,
                                            string_literals: string_literals,
                                            constant_string_index: constant_string_index,
                                            expression_values: expression_values,
                                            value_count: next_value, skipped_functions: skipped, skip_reason: skip_reasons,
                                            ok: false, error: "integer constant is out of range",
                                        }
                                    }
                                }
                                if expression.kind == EXPR_FLOAT { float_value = parse_float(token_text(source, token)) }
                                if expression.kind == EXPR_BOOL { int_value = if token.kind == TK_TRUE { 1 } else { 0 } }
                                let mut string_index = -1
                                if expression.kind == EXPR_STRING {
                                    start = token.start + 1
                                    end = token.end - 1
                                    string_index = len(string_literals)
                                    string_literals = append(string_literals, source[start:end])
                                }
                                aux = len(constants)
                                constants = append(constants, IrConstant {
                                    type_kind: expression_types[i], int_value: int_value,
                                    float_value: float_value, start: start, end: end,
                                })
                                constant_string_index = append(constant_string_index, string_index)
                            }
                            let result = next_value
                            next_value = next_value + 1
                            let lowered = IrInstruction {
                                op: op, result: result, type_kind: expression_types[i],
                                left: left, right: right, aux: aux, token: expression.token,
                            }
                            let arm_lowering = simple_if or simple_merge_if
                            let then_arm = if simple_if { then_return } else { first_child }
                            let else_arm = if simple_if { continuation_return } else { second_child }
                            let mut arm_route = -1
                            if simple_while and merge_if {
                                let mut arm_scan = 0
                                while arm_scan < len(arm_statements) {
                                    let arm_stmt = statements[arm_statements[arm_scan]]
                                    if expression.token >= arm_stmt.token_start and
                                        expression.token < arm_stmt.token_end {
                                        arm_route = arm_scan
                                    }
                                    arm_scan = arm_scan + 1
                                }
                            }
                            if pre_if and
                                expression.token >= statements[pre_if_statement].token_start and
                                expression.token < statements[pre_if_statement].token_end {
                                let mut pre_arm_route = -1
                                let mut pre_scan = 0
                                while pre_scan < len(pre_arm_statements) {
                                    let pre_arm_stmt = statements[pre_arm_statements[pre_scan]]
                                    if expression.token >= pre_arm_stmt.token_start and
                                        expression.token < pre_arm_stmt.token_end {
                                        pre_arm_route = pre_scan
                                    }
                                    pre_scan = pre_scan + 1
                                }
                                let mut prefix_index = 0
                                if pre_arm_route < 0 {
                                    while prefix_index < len(call_prefix) {
                                        pre_cond_instructions = append(pre_cond_instructions, call_prefix[prefix_index])
                                        prefix_index = prefix_index + 1
                                    }
                                    pre_cond_instructions = append(pre_cond_instructions, lowered)
                                } else if pre_arm_else_flags[pre_arm_route] == 0 {
                                    while prefix_index < len(call_prefix) {
                                        then_instructions = append(then_instructions, call_prefix[prefix_index])
                                        prefix_index = prefix_index + 1
                                    }
                                    then_instructions = append(then_instructions, lowered)
                                } else {
                                    while prefix_index < len(call_prefix) {
                                        else_instructions = append(else_instructions, call_prefix[prefix_index])
                                        prefix_index = prefix_index + 1
                                    }
                                    else_instructions = append(else_instructions, lowered)
                                }
                            } else if simple_seq and seq_region >= 0 and
                                expression.token < statements[statement_edges[statements[seq_wholes[seq_region]].child_start]].token_start {
                                let mut prefix_index = 0
                                while prefix_index < len(call_prefix) {
                                    seq_cond_instructions = append(seq_cond_instructions, call_prefix[prefix_index])
                                    seq_cond_loops = append(seq_cond_loops, seq_region)
                                    prefix_index = prefix_index + 1
                                }
                                seq_cond_instructions = append(seq_cond_instructions, lowered)
                                seq_cond_loops = append(seq_cond_loops, seq_region)
                            } else if simple_seq and seq_region == while_count - 1 and guard_statement >= 0 and
                                expression.token >= statements[guard_statement].token_start and
                                expression.token < statements[guard_statement].token_end {
                                let mut prefix_index = 0
                                while prefix_index < len(call_prefix) {
                                    last_guard_instructions = append(last_guard_instructions, call_prefix[prefix_index])
                                    prefix_index = prefix_index + 1
                                }
                                last_guard_instructions = append(last_guard_instructions, lowered)
                            } else if simple_seq and seq_region == while_count - 1 and guard_statement >= 0 and
                                expression.token < statements[guard_statement].token_start {
                                let mut prefix_index = 0
                                while prefix_index < len(call_prefix) {
                                    last_pre_instructions = append(last_pre_instructions, call_prefix[prefix_index])
                                    prefix_index = prefix_index + 1
                                }
                                last_pre_instructions = append(last_pre_instructions, lowered)
                            } else if simple_seq and seq_region >= 0 and
                                expression.token < statements[seq_wholes[seq_region]].token_end {
                                let mut prefix_index = 0
                                while prefix_index < len(call_prefix) {
                                    seq_body_instructions = append(seq_body_instructions, call_prefix[prefix_index])
                                    seq_body_loops = append(seq_body_loops, seq_region)
                                    prefix_index = prefix_index + 1
                                }
                                seq_body_instructions = append(seq_body_instructions, lowered)
                                seq_body_loops = append(seq_body_loops, seq_region)
                            } else if simple_while and arm_route >= 0 and arm_else_flags[arm_route] == 0 {
                                let mut prefix_index = 0
                                while prefix_index < len(call_prefix) {
                                    then_instructions = append(then_instructions, call_prefix[prefix_index])
                                    prefix_index = prefix_index + 1
                                }
                                then_instructions = append(then_instructions, lowered)
                            } else if simple_while and arm_route >= 0 {
                                let mut prefix_index = 0
                                while prefix_index < len(call_prefix) {
                                    else_instructions = append(else_instructions, call_prefix[prefix_index])
                                    prefix_index = prefix_index + 1
                                }
                                else_instructions = append(else_instructions, lowered)
                            } else if arm_lowering and then_arm >= 0 and
                                expression.token >= statements[then_arm].token_start and
                                expression.token < statements[then_arm].token_end {
                                let mut prefix_index = 0
                                while prefix_index < len(call_prefix) {
                                    then_instructions = append(then_instructions, call_prefix[prefix_index])
                                    prefix_index = prefix_index + 1
                                }
                                then_instructions = append(then_instructions, lowered)
                            } else if arm_lowering and else_arm >= 0 and
                                expression.token >= statements[else_arm].token_start and
                                expression.token < statements[else_arm].token_end {
                                let mut prefix_index = 0
                                while prefix_index < len(call_prefix) {
                                    else_instructions = append(else_instructions, call_prefix[prefix_index])
                                    prefix_index = prefix_index + 1
                                }
                                else_instructions = append(else_instructions, lowered)
                            } else if simple_while and guard_statement >= 0 and
                                expression.token >= statements[guard_statement].token_start and
                                expression.token < statements[guard_statement].token_end {
                                let mut prefix_index = 0
                                while prefix_index < len(call_prefix) {
                                    guard_instructions = append(guard_instructions, call_prefix[prefix_index])
                                    prefix_index = prefix_index + 1
                                }
                                guard_instructions = append(guard_instructions, lowered)
                            } else if simple_while and guard_statement >= 0 and
                                expression.token >= loop_body_start and
                                expression.token < statements[guard_statement].token_start {
                                let mut prefix_index = 0
                                while prefix_index < len(call_prefix) {
                                    pre_instructions = append(pre_instructions, call_prefix[prefix_index])
                                    prefix_index = prefix_index + 1
                                }
                                pre_instructions = append(pre_instructions, lowered)
                            } else if simple_while and
                                expression.token >= loop_body_start and
                                expression.token < loop_body_end {
                                let mut prefix_index = 0
                                while prefix_index < len(call_prefix) {
                                    body_instructions = append(body_instructions, call_prefix[prefix_index])
                                    prefix_index = prefix_index + 1
                                }
                                body_instructions = append(body_instructions, lowered)
                            } else if (simple_while or simple_seq) and
                                expression.token >= statements[loop_return].token_start and
                                expression.token < statements[loop_return].token_end {
                                let mut prefix_index = 0
                                while prefix_index < len(call_prefix) {
                                    exit_instructions = append(exit_instructions, call_prefix[prefix_index])
                                    prefix_index = prefix_index + 1
                                }
                                exit_instructions = append(exit_instructions, lowered)
                            } else if simple_while and
                                expression.token >= statements[while_statement].token_start {
                                let mut prefix_index = 0
                                while prefix_index < len(call_prefix) {
                                    condition_instructions = append(condition_instructions, call_prefix[prefix_index])
                                    prefix_index = prefix_index + 1
                                }
                                condition_instructions = append(condition_instructions, lowered)
                            } else {
                                let mut prefix_index = 0
                                while prefix_index < len(call_prefix) {
                                    instructions = append(instructions, call_prefix[prefix_index])
                                    prefix_index = prefix_index + 1
                                }
                                instructions = append(instructions, lowered)
                            }
                            expression_values[i] = result
                        }
                    }
                }
                if expression_values[i] >= 0 and initializer_local[i] >= 0 {
                    let local_index = initializer_local[i]
                    let mut initializer_value = expression_values[i]
                    if expressions[i].kind == EXPR_IDENT and i < len(expression_locals) and
                        ir_type_is_owned(expression_types[i]) {
                        let source_local = expression_locals[i]
                        if source_local >= 0 and source_local < len(locals) {
                            let transfer_value = next_value
                            next_value = next_value + 1
                            let transfer = IrInstruction {
                                op: if locals[source_local].ownership == LOCAL_OWN_HOLD {
                                    IR_MOVE
                                } else {
                                    IR_CLONE
                                },
                                result: transfer_value, type_kind: expression_types[i],
                                left: initializer_value, right: -1, aux: -1,
                                token: expressions[i].token,
                            }
                            let arm_lowering = simple_if or simple_merge_if
                            let then_arm = if simple_if { then_return } else { first_child }
                            let else_arm = if simple_if { continuation_return } else { second_child }
                            if arm_lowering and then_arm >= 0 and
                                expressions[i].token >= statements[then_arm].token_start and
                                expressions[i].token < statements[then_arm].token_end {
                                then_instructions = append(then_instructions, transfer)
                            } else if arm_lowering and else_arm >= 0 and
                                expressions[i].token >= statements[else_arm].token_start and
                                expressions[i].token < statements[else_arm].token_end {
                                else_instructions = append(else_instructions, transfer)
                            } else {
                                instructions = append(instructions, transfer)
                            }
                            initializer_value = transfer_value
                            expression_values[i] = transfer_value
                        }
                    }
                    local_values[local_index] = initializer_value
                }
                if simple_while and expression_values[i] >= 0 {
                    // Record each assignment's lowered right-hand side per
                    // body segment: pre-if, then-arm, else-arm, or post-if.
                    // The backedge and the merge edges are built from these
                    // in block-parameter order.
                    let mut assignment_index = 0
                    while assignment_index < len(assignment_statements) {
                        if statements[assignment_statements[assignment_index]].expr_root == i {
                            let target = assignment_locals[assignment_index]
                            let mut carried_index = 0
                            while carried_index < len(loop_carried) {
                                if loop_carried[carried_index] == target {
                                    loop_update_values[carried_index] = expression_values[i]
                                    let segment_arm = stmt_list_index(arm_statements, assignment_statements[assignment_index])
                                    if segment_arm >= 0 {
                                        if arm_else_flags[segment_arm] == 0 {
                                            then_update_values[carried_index] = expression_values[i]
                                        } else {
                                            else_update_values[carried_index] = expression_values[i]
                                        }
                                    } else if guard_statement >= 0 and
                                        statements[assignment_statements[assignment_index]].token_start >
                                            statements[guard_statement].token_end {
                                        post_update_values[carried_index] = expression_values[i]
                                    } else {
                                        pre_update_values[carried_index] = expression_values[i]
                                    }
                                }
                                carried_index = carried_index + 1
                            }
                        }
                        assignment_index = assignment_index + 1
                    }
                }
                if simple_seq and expression_values[i] >= 0 {
                    // Record each assignment's lowered right-hand side as the
                    // backedge value for its loop, in carried-union order.
                    let mut assignment_index = 0
                    while assignment_index < len(assignment_statements) {
                        if statements[assignment_statements[assignment_index]].expr_root == i {
                            let target = assignment_locals[assignment_index]
                            let mut carried_index = 0
                            while carried_index < union_count {
                                if loop_carried[carried_index] == target {
                                    seq_update_values[seq_assignment_loop[assignment_index] * union_count + carried_index] =
                                        expression_values[i]
                                }
                                carried_index = carried_index + 1
                            }
                        }
                        assignment_index = assignment_index + 1
                    }
                }
                if pre_if and expression_values[i] >= 0 {
                    // Record each pre-loop arm assignment's value for the
                    // merge edges, in merge-local declaration order.
                    let mut pre_scan = 0
                    while pre_scan < len(pre_arm_statements) {
                        if statements[pre_arm_statements[pre_scan]].expr_root == i {
                            let mut merge_index = 0
                            while merge_index < len(pre_merge_locals) {
                                if pre_merge_locals[merge_index] == pre_arm_locals[pre_scan] {
                                    if pre_arm_else_flags[pre_scan] == 0 {
                                        pre_then_updates[merge_index] = expression_values[i]
                                    } else {
                                        pre_else_updates[merge_index] = expression_values[i]
                                    }
                                }
                                merge_index = merge_index + 1
                            }
                        }
                        pre_scan = pre_scan + 1
                    }
                }
            }
            expr_slot = expr_slot + 1
        }

        if simple_if {
            let branch_statement = statements[if_statement]
            if branch_statement.expr_root < 0 or branch_statement.expr_root >= len(expression_values) {
                return TypedIr {
                    functions: functions, blocks: blocks, instructions: instructions,
                    constants: constants, successors: successors,
                    call_sites: call_sites, call_arguments: call_arguments,
                    jump_arguments: jump_arguments,
                    string_literals: string_literals,
                    constant_string_index: constant_string_index,
                    expression_values: expression_values,
                    value_count: next_value, skipped_functions: skipped, skip_reason: skip_reasons,
                    ok: false, error: "typed if condition has no expression",
                }
            }
            let condition = expression_values[branch_statement.expr_root]
            if condition < 0 {
                return TypedIr {
                    functions: functions, blocks: blocks, instructions: instructions,
                    constants: constants, successors: successors,
                    call_sites: call_sites, call_arguments: call_arguments,
                    jump_arguments: jump_arguments,
                    string_literals: string_literals,
                    constant_string_index: constant_string_index,
                    expression_values: expression_values,
                    value_count: next_value, skipped_functions: skipped, skip_reason: skip_reasons,
                    ok: false, error: "typed if condition did not lower to an SSA value",
                }
            }
            let entry_terminator = len(instructions)
            instructions = append(instructions, IrInstruction {
                op: IR_BRANCH, result: -1, type_kind: SEM_BOOL,
                left: condition, right: -1, aux: -1, token: branch_statement.token_start,
            })
            let entry_block = len(blocks)
            let successor_start = len(successors)
            successors = append(successors, entry_block + 1)
            successors = append(successors, entry_block + 2)
            blocks = append(blocks, IrBlock {
                function: function_index, instruction_start: instruction_start,
                instruction_count: len(instructions) - instruction_start,
                terminator: entry_terminator, successor_start: successor_start, successor_count: 2,
            })

            let then_statement = statements[then_return]
            let then_start = len(instructions)
            i = 0
            while i < len(then_instructions) {
                instructions = append(instructions, then_instructions[i])
                i = i + 1
            }
            let then_value = if then_statement.expr_root >= 0 and then_statement.expr_root < len(expression_values) { expression_values[then_statement.expr_root] } else { -1 }
            let then_type = if then_statement.expr_root >= 0 and then_statement.expr_root < len(expression_types) { expression_types[then_statement.expr_root] } else { SEM_UNKNOWN }
            let continuation_statement = statements[continuation_return]
            let continuation_value = if continuation_statement.expr_root >= 0 and continuation_statement.expr_root < len(expression_values) { expression_values[continuation_statement.expr_root] } else { -1 }
            let continuation_type = if continuation_statement.expr_root >= 0 and continuation_statement.expr_root < len(expression_types) { expression_types[continuation_statement.expr_root] } else { SEM_UNKNOWN }
            if merge_return_values {
                if then_value < 0 or continuation_value < 0 or then_type == SEM_UNKNOWN or then_type != continuation_type {
                    return TypedIr {
                        functions: functions, blocks: blocks, instructions: instructions,
                        constants: constants, successors: successors,
                        call_sites: call_sites, call_arguments: call_arguments,
                        jump_arguments: jump_arguments,
                        string_literals: string_literals,
                        constant_string_index: constant_string_index,
                        expression_values: expression_values,
                        value_count: next_value, skipped_functions: skipped, skip_reason: skip_reasons,
                        ok: false, error: "typed branch values cannot form a block parameter",
                    }
                }
                let merge_block = entry_block + 3
                local_index = len(locals) - 1
                while local_index >= 0 {
                    if locals[local_index].item == signature.item and
                        (locals[local_index].is_parameter or
                            locals[local_index].declaration_end <= branch_statement.token_start) and
                        local_values[local_index] >= 0 and
                        ir_type_is_owned(local_types[local_index]) and local_values[local_index] != then_value and
                        not ir_instruction_range_consumes_value(
                            instructions, call_sites, call_arguments, instruction_start,
                            entry_terminator, local_values[local_index]
                        ) and
                        not ir_instruction_list_consumes_value(
                            then_instructions, call_sites, call_arguments, local_values[local_index]
                        ) {
                        instructions = append(instructions, IrInstruction {
                            op: IR_DROP, result: -1, type_kind: local_types[local_index],
                            left: local_values[local_index], right: -1, aux: -1, token: then_statement.token_start,
                        })
                    }
                    local_index = local_index - 1
                }
                instructions = append(instructions, IrInstruction {
                    op: IR_JUMP, result: -1, type_kind: then_type,
                    left: then_value, right: -1, aux: -1, token: then_statement.token_start,
                })
                let then_successor = len(successors)
                successors = append(successors, merge_block)
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: then_start,
                    instruction_count: len(instructions) - then_start,
                    terminator: len(instructions) - 1, successor_start: then_successor, successor_count: 1,
                })

                let continuation_start = len(instructions)
                i = 0
                while i < len(else_instructions) {
                    instructions = append(instructions, else_instructions[i])
                    i = i + 1
                }
                local_index = len(locals) - 1
                while local_index >= 0 {
                    if locals[local_index].item == signature.item and
                        (locals[local_index].is_parameter or
                            locals[local_index].declaration_end <= branch_statement.token_start) and
                        local_values[local_index] >= 0 and
                        ir_type_is_owned(local_types[local_index]) and local_values[local_index] != continuation_value and
                        not ir_instruction_range_consumes_value(
                            instructions, call_sites, call_arguments, instruction_start,
                            entry_terminator, local_values[local_index]
                        ) and
                        not ir_instruction_list_consumes_value(
                            else_instructions, call_sites, call_arguments, local_values[local_index]
                        ) {
                        instructions = append(instructions, IrInstruction {
                            op: IR_DROP, result: -1, type_kind: local_types[local_index],
                            left: local_values[local_index], right: -1, aux: -1, token: continuation_statement.token_start,
                        })
                    }
                    local_index = local_index - 1
                }
                instructions = append(instructions, IrInstruction {
                    op: IR_JUMP, result: -1, type_kind: continuation_type,
                    left: continuation_value, right: -1, aux: -1, token: continuation_statement.token_start,
                })
                let continuation_successor = len(successors)
                successors = append(successors, merge_block)
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: continuation_start,
                    instruction_count: len(instructions) - continuation_start,
                    terminator: len(instructions) - 1, successor_start: continuation_successor, successor_count: 1,
                })

                let merge_start = len(instructions)
                let merged_value = next_value
                next_value = next_value + 1
                instructions = append(instructions, IrInstruction {
                    op: IR_BLOCK_PARAM, result: merged_value, type_kind: then_type,
                    left: -1, right: -1, aux: 0, token: branch_statement.token_start,
                })
                instructions = append(instructions, IrInstruction {
                    op: IR_RETURN, result: -1, type_kind: then_type,
                    left: merged_value, right: -1, aux: -1, token: continuation_statement.token_start,
                })
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: merge_start, instruction_count: 2,
                    terminator: merge_start + 1, successor_start: len(successors), successor_count: 0,
                })
            } else {
                local_index = len(locals) - 1
                while local_index >= 0 {
                    if locals[local_index].item == signature.item and
                        (locals[local_index].is_parameter or
                            locals[local_index].declaration_end <= branch_statement.token_start) and
                        local_values[local_index] >= 0 and
                        ir_type_is_owned(local_types[local_index]) and local_values[local_index] != then_value and
                        not ir_instruction_range_consumes_value(
                            instructions, call_sites, call_arguments, instruction_start,
                            entry_terminator, local_values[local_index]
                        ) and
                        not ir_instruction_list_consumes_value(
                            then_instructions, call_sites, call_arguments, local_values[local_index]
                        ) {
                        instructions = append(instructions, IrInstruction {
                            op: IR_DROP, result: -1, type_kind: local_types[local_index],
                            left: local_values[local_index], right: -1, aux: -1,
                            token: then_statement.token_start,
                        })
                    }
                    local_index = local_index - 1
                }
                instructions = append(instructions, IrInstruction {
                    op: IR_RETURN, result: -1, type_kind: then_type,
                    left: then_value, right: -1, aux: -1, token: then_statement.token_start,
                })
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: then_start,
                    instruction_count: len(instructions) - then_start,
                    terminator: len(instructions) - 1,
                    successor_start: len(successors), successor_count: 0,
                })

                let continuation_start = len(instructions)
                i = 0
                while i < len(else_instructions) {
                    instructions = append(instructions, else_instructions[i])
                    i = i + 1
                }
                local_index = len(locals) - 1
                while local_index >= 0 {
                    if locals[local_index].item == signature.item and
                        (locals[local_index].is_parameter or
                            locals[local_index].declaration_end <= branch_statement.token_start) and
                        local_values[local_index] >= 0 and
                        ir_type_is_owned(local_types[local_index]) and local_values[local_index] != continuation_value and
                        not ir_instruction_range_consumes_value(
                            instructions, call_sites, call_arguments, instruction_start,
                            entry_terminator, local_values[local_index]
                        ) and
                        not ir_instruction_list_consumes_value(
                            else_instructions, call_sites, call_arguments, local_values[local_index]
                        ) {
                        instructions = append(instructions, IrInstruction {
                            op: IR_DROP, result: -1, type_kind: local_types[local_index],
                            left: local_values[local_index], right: -1, aux: -1,
                            token: continuation_statement.token_start,
                        })
                    }
                    local_index = local_index - 1
                }
                instructions = append(instructions, IrInstruction {
                    op: IR_RETURN, result: -1, type_kind: continuation_type,
                    left: continuation_value, right: -1, aux: -1, token: continuation_statement.token_start,
                })
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: continuation_start,
                    instruction_count: len(instructions) - continuation_start,
                    terminator: len(instructions) - 1,
                    successor_start: len(successors), successor_count: 0,
                })
            }
            functions = append(functions, IrFunction {
                item: signature.item, entry_block: entry_block, block_count: if merge_return_values { 4 } else { 3 },
                parameter_count: parameter_count, value_start: value_start,
                value_count: next_value - value_start,
            })
            signature_index = signature_index + 1
            continue
        }

        if simple_merge_if {
            let branch_statement = statements[if_statement]
            if branch_statement.expr_root < 0 or branch_statement.expr_root >= len(expression_values) {
                return TypedIr {
                    functions: functions, blocks: blocks, instructions: instructions,
                    constants: constants, successors: successors,
                    call_sites: call_sites, call_arguments: call_arguments,
                    jump_arguments: jump_arguments,
                    string_literals: string_literals,
                    constant_string_index: constant_string_index,
                    expression_values: expression_values,
                    value_count: next_value, skipped_functions: skipped, skip_reason: skip_reasons,
                    ok: false, error: "typed merge condition has no expression",
                }
            }
            let condition = expression_values[branch_statement.expr_root]
            if condition < 0 {
                return TypedIr {
                    functions: functions, blocks: blocks, instructions: instructions,
                    constants: constants, successors: successors,
                    call_sites: call_sites, call_arguments: call_arguments,
                    jump_arguments: jump_arguments,
                    string_literals: string_literals,
                    constant_string_index: constant_string_index,
                    expression_values: expression_values,
                    value_count: next_value, skipped_functions: skipped, skip_reason: skip_reasons,
                    ok: false, error: "typed merge condition did not lower to an SSA value",
                }
            }
            let merge_statement = statements[continuation_return]
            let merge_value = if merge_statement.expr_root >= 0 and merge_statement.expr_root < len(expression_values) { expression_values[merge_statement.expr_root] } else { -1 }
            let merge_type = if merge_statement.expr_root >= 0 and merge_statement.expr_root < len(expression_types) { expression_types[merge_statement.expr_root] } else { SEM_UNKNOWN }
            let entry_terminator = len(instructions)
            instructions = append(instructions, IrInstruction {
                op: IR_BRANCH, result: -1, type_kind: SEM_BOOL,
                left: condition, right: -1, aux: -1, token: branch_statement.token_start,
            })
            let entry_block = len(blocks)
            let merge_block = entry_block + 3
            let entry_successors = len(successors)
            successors = append(successors, entry_block + 1)
            successors = append(successors, entry_block + 2)
            blocks = append(blocks, IrBlock {
                function: function_index, instruction_start: instruction_start,
                instruction_count: len(instructions) - instruction_start,
                terminator: entry_terminator, successor_start: entry_successors, successor_count: 2,
            })

            let then_start = len(instructions)
            i = 0
            while i < len(then_instructions) {
                instructions = append(instructions, then_instructions[i])
                i = i + 1
            }
            i = len(then_instructions) - 1
            while i >= 0 {
                let arm_instruction = then_instructions[i]
                if arm_instruction.result >= 0 and ir_type_is_owned(arm_instruction.type_kind) and
                    arm_instruction.result != merge_value and
                    not ir_instruction_list_consumes_value(
                        then_instructions, call_sites, call_arguments, arm_instruction.result
                    ) {
                    instructions = append(instructions, IrInstruction {
                        op: IR_DROP, result: -1, type_kind: arm_instruction.type_kind,
                        left: arm_instruction.result, right: -1, aux: -1,
                        token: statements[first_child].token_start,
                    })
                }
                i = i - 1
            }
            local_index = len(locals) - 1
            while local_index >= 0 {
                if locals[local_index].item == signature.item and
                    (locals[local_index].is_parameter or
                        locals[local_index].declaration_end <= branch_statement.token_start) and
                    local_values[local_index] >= 0 and
                    ir_type_is_owned(local_types[local_index]) and
                    local_values[local_index] != merge_value and
                    not ir_instruction_range_consumes_value(
                        instructions, call_sites, call_arguments, instruction_start,
                        entry_terminator, local_values[local_index]
                    ) and
                    not ir_instruction_list_consumes_value(
                        then_instructions, call_sites, call_arguments, local_values[local_index]
                    ) {
                    instructions = append(instructions, IrInstruction {
                        op: IR_DROP, result: -1, type_kind: local_types[local_index],
                        left: local_values[local_index], right: -1, aux: -1,
                        token: statements[first_child].token_start,
                    })
                }
                local_index = local_index - 1
            }
            instructions = append(instructions, IrInstruction {
                op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                left: -1, right: -1, aux: -1, token: branch_statement.token_start,
            })
            let then_successor = len(successors)
            successors = append(successors, merge_block)
            blocks = append(blocks, IrBlock {
                function: function_index, instruction_start: then_start,
                instruction_count: len(instructions) - then_start,
                terminator: len(instructions) - 1, successor_start: then_successor, successor_count: 1,
            })

            let else_start = len(instructions)
            i = 0
            while i < len(else_instructions) {
                instructions = append(instructions, else_instructions[i])
                i = i + 1
            }
            i = len(else_instructions) - 1
            while i >= 0 {
                let arm_instruction = else_instructions[i]
                if arm_instruction.result >= 0 and ir_type_is_owned(arm_instruction.type_kind) and
                    arm_instruction.result != merge_value and
                    not ir_instruction_list_consumes_value(
                        else_instructions, call_sites, call_arguments, arm_instruction.result
                    ) {
                    instructions = append(instructions, IrInstruction {
                        op: IR_DROP, result: -1, type_kind: arm_instruction.type_kind,
                        left: arm_instruction.result, right: -1, aux: -1,
                        token: statements[second_child].token_start,
                    })
                }
                i = i - 1
            }
            local_index = len(locals) - 1
            while local_index >= 0 {
                if locals[local_index].item == signature.item and
                    (locals[local_index].is_parameter or
                        locals[local_index].declaration_end <= branch_statement.token_start) and
                    local_values[local_index] >= 0 and
                    ir_type_is_owned(local_types[local_index]) and
                    local_values[local_index] != merge_value and
                    not ir_instruction_range_consumes_value(
                        instructions, call_sites, call_arguments, instruction_start,
                        entry_terminator, local_values[local_index]
                    ) and
                    not ir_instruction_list_consumes_value(
                        else_instructions, call_sites, call_arguments, local_values[local_index]
                    ) {
                    instructions = append(instructions, IrInstruction {
                        op: IR_DROP, result: -1, type_kind: local_types[local_index],
                        left: local_values[local_index], right: -1, aux: -1,
                        token: statements[second_child].token_start,
                    })
                }
                local_index = local_index - 1
            }
            instructions = append(instructions, IrInstruction {
                op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                left: -1, right: -1, aux: -1, token: branch_statement.token_start,
            })
            let else_successor = len(successors)
            successors = append(successors, merge_block)
            blocks = append(blocks, IrBlock {
                function: function_index, instruction_start: else_start,
                instruction_count: len(instructions) - else_start,
                terminator: len(instructions) - 1, successor_start: else_successor, successor_count: 1,
            })

            let merge_start = len(instructions)
            instructions = append(instructions, IrInstruction {
                op: IR_RETURN, result: -1, type_kind: merge_type,
                left: merge_value, right: -1, aux: -1, token: merge_statement.token_start,
            })
            blocks = append(blocks, IrBlock {
                function: function_index, instruction_start: merge_start, instruction_count: 1,
                terminator: merge_start, successor_start: len(successors), successor_count: 0,
            })
            functions = append(functions, IrFunction {
                item: signature.item, entry_block: entry_block, block_count: 4,
                parameter_count: parameter_count, value_start: value_start,
                value_count: next_value - value_start,
            })
            signature_index = signature_index + 1
            continue
        }

        if simple_seq {
            let return_statement = statements[loop_return]
            let loop_return_value = if return_statement.expr_root >= 0 and return_statement.expr_root < len(expression_values) { expression_values[return_statement.expr_root] } else { -1 }
            let loop_return_type = if return_statement.expr_root >= 0 and return_statement.expr_root < len(expression_types) { expression_types[return_statement.expr_root] } else { SEM_UNKNOWN }
            let mut seq_ready = union_count > 0 and loop_return_value >= 0
            let mut carried_index = 0
            while carried_index < union_count {
                if seq_init_values[carried_index] < 0 { seq_ready = false }
                carried_index = carried_index + 1
            }
            let mut seq_loop_index = 0
            while seq_loop_index < while_count {
                if seq_params[seq_loop_index * union_count] < 0 { seq_ready = false }
                let condition_value = if statements[seq_wholes[seq_loop_index]].expr_root >= 0 and
                    statements[seq_wholes[seq_loop_index]].expr_root < len(expression_values) {
                    expression_values[statements[seq_wholes[seq_loop_index]].expr_root]
                } else {
                    -1
                }
                if condition_value < 0 { seq_ready = false }
                seq_loop_index = seq_loop_index + 1
            }
            if not seq_ready {
                return TypedIr {
                    functions: functions, blocks: blocks, instructions: instructions,
                    constants: constants, successors: successors,
                    call_sites: call_sites, call_arguments: call_arguments,
                    jump_arguments: jump_arguments,
                    string_literals: string_literals,
                    constant_string_index: constant_string_index,
                    expression_values: expression_values,
                    value_count: next_value, skipped_functions: skipped, skip_reason: skip_reasons,
                    ok: false, error: "typed sequential loops did not lower to SSA values",
                }
            }
            // Entry: jump into the first header with the initializers. A
            // pre-loop merge-if emits its own group first; its merge block
            // then plays the entry block's role.
            let mut entry_block = -1
            if pre_if {
                let pre_condition = if statements[pre_if_statement].expr_root >= 0 and statements[pre_if_statement].expr_root < len(expression_values) { expression_values[statements[pre_if_statement].expr_root] } else { -1 }
                if pre_condition < 0 {
                    return TypedIr {
                        functions: functions, blocks: blocks, instructions: instructions,
                        constants: constants, successors: successors,
                        call_sites: call_sites, call_arguments: call_arguments,
                        jump_arguments: jump_arguments,
                        string_literals: string_literals,
                        constant_string_index: constant_string_index,
                        expression_values: expression_values,
                        value_count: next_value, skipped_functions: skipped, skip_reason: skip_reasons,
                        ok: false, error: "typed pre-loop merge condition did not lower to an SSA value",
                    }
                }
                i = 0
                while i < len(pre_cond_instructions) {
                    instructions = append(instructions, pre_cond_instructions[i])
                    i = i + 1
                }
                let pre_terminator = len(instructions)
                instructions = append(instructions, IrInstruction {
                    op: IR_BRANCH, result: -1, type_kind: SEM_BOOL,
                    left: pre_condition, right: -1, aux: -1, token: statements[pre_if_statement].token_start,
                })
                let pre_entry_block = len(blocks)
                let pre_entry_successors = len(successors)
                successors = append(successors, pre_entry_block + 1)
                successors = append(successors, pre_entry_block + 2)
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: instruction_start,
                    instruction_count: len(instructions) - instruction_start,
                    terminator: pre_terminator, successor_start: pre_entry_successors, successor_count: 2,
                })
                let mut pre_edge = 0
                while pre_edge < 2 {
                    let pre_arm_start = len(instructions)
                    if pre_edge == 0 {
                        i = 0
                        while i < len(then_instructions) {
                            instructions = append(instructions, then_instructions[i])
                            i = i + 1
                        }
                    } else {
                        i = 0
                        while i < len(else_instructions) {
                            instructions = append(instructions, else_instructions[i])
                            i = i + 1
                        }
                    }
                    let pre_arm_terminator = len(instructions)
                    let mut pre_arm_values: []int = []
                    carried_index = 0
                    while carried_index < len(pre_merge_locals) {
                        let mut arm_value = pre_if_init_values[carried_index]
                        if pre_edge == 0 and pre_then_updates[carried_index] >= 0 {
                            arm_value = pre_then_updates[carried_index]
                        }
                        if pre_edge == 1 and pre_else_updates[carried_index] >= 0 {
                            arm_value = pre_else_updates[carried_index]
                        }
                        pre_arm_values = append(pre_arm_values, arm_value)
                        carried_index = carried_index + 1
                    }
                    if len(pre_arm_values) == 1 {
                        instructions = append(instructions, IrInstruction {
                            op: IR_JUMP, result: -1, type_kind: SEM_INT,
                            left: pre_arm_values[0], right: -1, aux: -1,
                            token: statements[pre_if_statement].token_start,
                        })
                    } else {
                        let pre_arm_argument_start = len(jump_arguments)
                        carried_index = 0
                        while carried_index < len(pre_arm_values) {
                            jump_arguments = append(jump_arguments, pre_arm_values[carried_index])
                            carried_index = carried_index + 1
                        }
                        instructions = append(instructions, IrInstruction {
                            op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                            left: -1, right: -1, aux: pre_arm_argument_start,
                            token: statements[pre_if_statement].token_start,
                        })
                    }
                    let pre_arm_successors = len(successors)
                    successors = append(successors, pre_entry_block + 3)
                    blocks = append(blocks, IrBlock {
                        function: function_index, instruction_start: pre_arm_start,
                        instruction_count: len(instructions) - pre_arm_start,
                        terminator: pre_arm_terminator, successor_start: pre_arm_successors, successor_count: 1,
                    })
                    pre_edge = pre_edge + 1
                }
                // The merge block: leading parameters, then the entry jump
                // into the first loop header.
                let merge_start = len(instructions)
                carried_index = 0
                while carried_index < len(pre_merge_values) {
                    instructions = append(instructions, IrInstruction {
                        op: IR_BLOCK_PARAM, result: pre_merge_values[carried_index], type_kind: SEM_INT,
                        left: -1, right: -1, aux: 0, token: statements[pre_if_statement].token_start,
                    })
                    carried_index = carried_index + 1
                }
                let merge_terminator = len(instructions)
                if union_count == 1 {
                    instructions = append(instructions, IrInstruction {
                        op: IR_JUMP, result: -1, type_kind: SEM_INT,
                        left: seq_init_values[0], right: -1, aux: -1,
                        token: statements[seq_wholes[0]].token_start,
                    })
                } else {
                    let merge_argument_start = len(jump_arguments)
                    carried_index = 0
                    while carried_index < union_count {
                        jump_arguments = append(jump_arguments, seq_init_values[carried_index])
                        carried_index = carried_index + 1
                    }
                    instructions = append(instructions, IrInstruction {
                        op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                        left: -1, right: -1, aux: merge_argument_start,
                        token: statements[seq_wholes[0]].token_start,
                    })
                }
                entry_block = len(blocks)
                let merge_successors = len(successors)
                successors = append(successors, entry_block + 1)
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: merge_start,
                    instruction_count: len(instructions) - merge_start,
                    terminator: merge_terminator, successor_start: merge_successors, successor_count: 1,
                })
            }
            if not pre_if {
                let entry_terminator = len(instructions)
                if union_count == 1 {
                    instructions = append(instructions, IrInstruction {
                        op: IR_JUMP, result: -1, type_kind: SEM_INT,
                        left: seq_init_values[0], right: -1, aux: -1,
                        token: statements[seq_wholes[0]].token_start,
                    })
                } else {
                    let entry_argument_start = len(jump_arguments)
                    carried_index = 0
                    while carried_index < union_count {
                        jump_arguments = append(jump_arguments, seq_init_values[carried_index])
                        carried_index = carried_index + 1
                    }
                    instructions = append(instructions, IrInstruction {
                        op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                        left: -1, right: -1, aux: entry_argument_start,
                        token: statements[seq_wholes[0]].token_start,
                    })
                }
                entry_block = len(blocks)
                let entry_successors = len(successors)
                successors = append(successors, entry_block + 1)
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: instruction_start,
                    instruction_count: len(instructions) - instruction_start,
                    terminator: entry_terminator, successor_start: entry_successors, successor_count: 1,
                })
            }
            seq_loop_index = 0
            while seq_loop_index < while_count {
                let loop_statement = statements[seq_wholes[seq_loop_index]]
                // Header: block parameters, condition, branch to the body or
                // onward (junction or exit).
                let header_start = len(instructions)
                carried_index = 0
                while carried_index < union_count {
                    instructions = append(instructions, IrInstruction {
                        op: IR_BLOCK_PARAM, result: seq_params[seq_loop_index * union_count + carried_index],
                        type_kind: SEM_INT, left: -1, right: -1, aux: 0,
                        token: loop_statement.token_start,
                    })
                    carried_index = carried_index + 1
                }
                let mut cond_index = 0
                while cond_index < len(seq_cond_instructions) {
                    if seq_cond_loops[cond_index] == seq_loop_index {
                        instructions = append(instructions, seq_cond_instructions[cond_index])
                    }
                    cond_index = cond_index + 1
                }
                let condition_value = expression_values[loop_statement.expr_root]
                let header_terminator = len(instructions)
                instructions = append(instructions, IrInstruction {
                    op: IR_BRANCH, result: -1, type_kind: SEM_BOOL,
                    left: condition_value, right: -1, aux: -1, token: loop_statement.token_start,
                })
                let header_block = len(blocks)
                let header_successors = len(successors)
                successors = append(successors, header_block + 1)
                if seq_loop_index == while_count - 1 and guard_exit_kind == STMT_BREAK {
                    successors = append(successors, header_block + 5)
                } else if seq_loop_index == while_count - 1 and guard_statement >= 0 {
                    successors = append(successors, header_block + 5)
                } else {
                    successors = append(successors, header_block + 2)
                }
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: header_start,
                    instruction_count: len(instructions) - header_start,
                    terminator: header_terminator, successor_start: header_successors, successor_count: 2,
                })
                if seq_loop_index == while_count - 1 and guard_statement >= 0 {
                    // Guarded last loop: header, pre-guard updates, guard,
                    // post-guard updates, arm, (trampoline), exit.
                    let guard_condition = if statements[guard_statement].expr_root >= 0 and statements[guard_statement].expr_root < len(expression_values) { expression_values[statements[guard_statement].expr_root] } else { -1 }
                    if guard_condition < 0 {
                        return TypedIr {
                            functions: functions, blocks: blocks, instructions: instructions,
                            constants: constants, successors: successors,
                            call_sites: call_sites, call_arguments: call_arguments,
                            jump_arguments: jump_arguments,
                            string_literals: string_literals,
                            constant_string_index: constant_string_index,
                            expression_values: expression_values,
                            value_count: next_value, skipped_functions: skipped, skip_reason: skip_reasons,
                            ok: false, error: "typed loop guard did not lower to an SSA value",
                        }
                    }
                    let pre_start = len(instructions)
                    i = 0
                    while i < len(last_pre_instructions) {
                        instructions = append(instructions, last_pre_instructions[i])
                        i = i + 1
                    }
                    let pre_terminator = len(instructions)
                    instructions = append(instructions, IrInstruction {
                        op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                        left: -1, right: -1, aux: -1, token: statements[guard_statement].token_start,
                    })
                    let pre_successors = len(successors)
                    successors = append(successors, header_block + 2)
                    blocks = append(blocks, IrBlock {
                        function: function_index, instruction_start: pre_start,
                        instruction_count: len(instructions) - pre_start,
                        terminator: pre_terminator, successor_start: pre_successors, successor_count: 1,
                    })
                    let guard_start = len(instructions)
                    i = 0
                    while i < len(last_guard_instructions) {
                        instructions = append(instructions, last_guard_instructions[i])
                        i = i + 1
                    }
                    let guard_terminator = len(instructions)
                    instructions = append(instructions, IrInstruction {
                        op: IR_BRANCH, result: -1, type_kind: SEM_BOOL,
                        left: guard_condition, right: -1, aux: -1, token: statements[guard_statement].token_start,
                    })
                    let guard_successors = len(successors)
                    successors = append(successors, header_block + 4)
                    successors = append(successors, header_block + 3)
                    blocks = append(blocks, IrBlock {
                        function: function_index, instruction_start: guard_start,
                        instruction_count: len(instructions) - guard_start,
                        terminator: guard_terminator, successor_start: guard_successors, successor_count: 2,
                    })
                    let body_start = len(instructions)
                    cond_index = 0
                    while cond_index < len(seq_body_instructions) {
                        if seq_body_loops[cond_index] == seq_loop_index {
                            instructions = append(instructions, seq_body_instructions[cond_index])
                        }
                        cond_index = cond_index + 1
                    }
                    let body_terminator = len(instructions)
                    if union_count == 1 {
                        let backedge_value = if seq_update_values[seq_loop_index] >= 0 {
                            seq_update_values[seq_loop_index]
                        } else {
                            seq_params[seq_loop_index]
                        }
                        instructions = append(instructions, IrInstruction {
                            op: IR_JUMP, result: -1, type_kind: SEM_INT,
                            left: backedge_value, right: -1, aux: -1,
                            token: statements[assignment_statements[len(assignment_statements) - 1]].token_start,
                        })
                    } else {
                        let body_argument_start = len(jump_arguments)
                        carried_index = 0
                        while carried_index < union_count {
                            let backedge_value = if seq_update_values[seq_loop_index * union_count + carried_index] >= 0 {
                                seq_update_values[seq_loop_index * union_count + carried_index]
                            } else {
                                seq_params[seq_loop_index * union_count + carried_index]
                            }
                            jump_arguments = append(jump_arguments, backedge_value)
                            carried_index = carried_index + 1
                        }
                        instructions = append(instructions, IrInstruction {
                            op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                            left: -1, right: -1, aux: body_argument_start,
                            token: statements[assignment_statements[len(assignment_statements) - 1]].token_start,
                        })
                    }
                    let body_successors = len(successors)
                    successors = append(successors, header_block)
                    blocks = append(blocks, IrBlock {
                        function: function_index, instruction_start: body_start,
                        instruction_count: len(instructions) - body_start,
                        terminator: body_terminator, successor_start: body_successors, successor_count: 1,
                    })
                    // The arm carries each local's value as of the guard: the
                    // update for locals assigned before it in this loop, the
                    // header parameter for the rest.
                    let mut arm_values: []int = []
                    carried_index = 0
                    while carried_index < union_count {
                        let mut arm_value = seq_params[seq_loop_index * union_count + carried_index]
                        if seq_update_values[seq_loop_index * union_count + carried_index] >= 0 {
                            let mut assigned_before = false
                            let mut arm_scan = 0
                            while arm_scan < len(assignment_statements) {
                                if seq_assignment_loop[arm_scan] == seq_loop_index and
                                    assignment_locals[arm_scan] == loop_carried[carried_index] and
                                    statements[assignment_statements[arm_scan]].token_start <
                                        statements[guard_statement].token_start {
                                    assigned_before = true
                                }
                                arm_scan = arm_scan + 1
                            }
                            if assigned_before {
                                arm_value = seq_update_values[seq_loop_index * union_count + carried_index]
                            }
                        }
                        arm_values = append(arm_values, arm_value)
                        carried_index = carried_index + 1
                    }
                    let arm_start = len(instructions)
                    let arm_terminator = len(instructions)
                    if union_count == 1 {
                        instructions = append(instructions, IrInstruction {
                            op: IR_JUMP, result: -1, type_kind: SEM_INT,
                            left: arm_values[0], right: -1, aux: -1,
                            token: statements[guard_statement].token_start,
                        })
                    } else {
                        let arm_argument_start = len(jump_arguments)
                        carried_index = 0
                        while carried_index < union_count {
                            jump_arguments = append(jump_arguments, arm_values[carried_index])
                            carried_index = carried_index + 1
                        }
                        instructions = append(instructions, IrInstruction {
                            op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                            left: -1, right: -1, aux: arm_argument_start,
                            token: statements[guard_statement].token_start,
                        })
                    }
                    let arm_successors = len(successors)
                    if guard_exit_kind == STMT_CONTINUE {
                        successors = append(successors, header_block)
                    } else {
                        successors = append(successors, header_block + 6)
                    }
                    blocks = append(blocks, IrBlock {
                        function: function_index, instruction_start: arm_start,
                        instruction_count: len(instructions) - arm_start,
                        terminator: arm_terminator, successor_start: arm_successors, successor_count: 1,
                    })
                    if guard_exit_kind == STMT_BREAK {
                        // The header's false edge reaches the exit parameters
                        // through this trampoline.
                        let trampoline_start = len(instructions)
                        let trampoline_terminator = len(instructions)
                        if union_count == 1 {
                            instructions = append(instructions, IrInstruction {
                                op: IR_JUMP, result: -1, type_kind: SEM_INT,
                                left: seq_params[seq_loop_index], right: -1, aux: -1,
                                token: loop_statement.token_start,
                            })
                        } else {
                            let trampoline_argument_start = len(jump_arguments)
                            carried_index = 0
                            while carried_index < union_count {
                                jump_arguments = append(jump_arguments, seq_params[seq_loop_index * union_count + carried_index])
                                carried_index = carried_index + 1
                            }
                            instructions = append(instructions, IrInstruction {
                                op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                                left: -1, right: -1, aux: trampoline_argument_start,
                                token: loop_statement.token_start,
                            })
                        }
                        let trampoline_successors = len(successors)
                        successors = append(successors, header_block + 6)
                        blocks = append(blocks, IrBlock {
                            function: function_index, instruction_start: trampoline_start,
                            instruction_count: len(instructions) - trampoline_start,
                            terminator: trampoline_terminator, successor_start: trampoline_successors, successor_count: 1,
                        })
                    }
                    seq_loop_index = seq_loop_index + 1
                    continue
                }
                // Body: updates, backedge to the header.
                let body_start = len(instructions)
                cond_index = 0
                while cond_index < len(seq_body_instructions) {
                    if seq_body_loops[cond_index] == seq_loop_index {
                        instructions = append(instructions, seq_body_instructions[cond_index])
                    }
                    cond_index = cond_index + 1
                }
                let body_terminator = len(instructions)
                if union_count == 1 {
                    let backedge_value = if seq_update_values[seq_loop_index] >= 0 {
                        seq_update_values[seq_loop_index]
                    } else {
                        seq_params[seq_loop_index]
                    }
                    instructions = append(instructions, IrInstruction {
                        op: IR_JUMP, result: -1, type_kind: SEM_INT,
                        left: backedge_value, right: -1, aux: -1,
                        token: statements[assignment_statements[len(assignment_statements) - 1]].token_start,
                    })
                } else {
                    let body_argument_start = len(jump_arguments)
                    carried_index = 0
                    while carried_index < union_count {
                        let backedge_value = if seq_update_values[seq_loop_index * union_count + carried_index] >= 0 {
                            seq_update_values[seq_loop_index * union_count + carried_index]
                        } else {
                            seq_params[seq_loop_index * union_count + carried_index]
                        }
                        jump_arguments = append(jump_arguments, backedge_value)
                        carried_index = carried_index + 1
                    }
                    instructions = append(instructions, IrInstruction {
                        op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                        left: -1, right: -1, aux: body_argument_start,
                        token: statements[assignment_statements[len(assignment_statements) - 1]].token_start,
                    })
                }
                let body_successors = len(successors)
                successors = append(successors, header_block)
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: body_start,
                    instruction_count: len(instructions) - body_start,
                    terminator: body_terminator, successor_start: body_successors, successor_count: 1,
                })
                if seq_loop_index + 1 < while_count {
                    // Junction: carry this loop's final parameters into the
                    // next header.
                    let junction_terminator = len(instructions)
                    if union_count == 1 {
                        instructions = append(instructions, IrInstruction {
                            op: IR_JUMP, result: -1, type_kind: SEM_INT,
                            left: seq_params[seq_loop_index], right: -1, aux: -1,
                            token: statements[seq_wholes[seq_loop_index + 1]].token_start,
                        })
                    } else {
                        let junction_argument_start = len(jump_arguments)
                        carried_index = 0
                        while carried_index < union_count {
                            jump_arguments = append(jump_arguments, seq_params[seq_loop_index * union_count + carried_index])
                            carried_index = carried_index + 1
                        }
                        instructions = append(instructions, IrInstruction {
                            op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                            left: -1, right: -1, aux: junction_argument_start,
                            token: statements[seq_wholes[seq_loop_index + 1]].token_start,
                        })
                    }
                    let junction_successors = len(successors)
                    successors = append(successors, header_block + 3)
                    blocks = append(blocks, IrBlock {
                        function: function_index, instruction_start: len(instructions) - 1,
                        instruction_count: 1,
                        terminator: junction_terminator, successor_start: junction_successors, successor_count: 1,
                    })
                }
                seq_loop_index = seq_loop_index + 1
            }
            // Exit: the return. A break-last chain exits through its own
            // block parameters.
            let exit_start = len(instructions)
            if guard_exit_kind == STMT_BREAK {
                carried_index = 0
                while carried_index < len(seq_exit_params) {
                    instructions = append(instructions, IrInstruction {
                        op: IR_BLOCK_PARAM, result: seq_exit_params[carried_index], type_kind: SEM_INT,
                        left: -1, right: -1, aux: 0, token: statements[guard_statement].token_start,
                    })
                    carried_index = carried_index + 1
                }
            }
            i = 0
            while i < len(exit_instructions) {
                instructions = append(instructions, exit_instructions[i])
                i = i + 1
            }
            let exit_terminator = len(instructions)
            instructions = append(instructions, IrInstruction {
                op: IR_RETURN, result: -1, type_kind: loop_return_type,
                left: loop_return_value, right: -1, aux: -1, token: return_statement.token_start,
            })
            blocks = append(blocks, IrBlock {
                function: function_index, instruction_start: exit_start,
                instruction_count: len(instructions) - exit_start,
                terminator: exit_terminator, successor_start: len(successors), successor_count: 0,
            })
            functions = append(functions, IrFunction {
                item: signature.item,
                entry_block: if pre_if { 0 } else { entry_block },
                block_count: (if pre_if { 3 } else { 0 }) + if guard_statement < 0 {
                    3 * while_count + 1
                } else if guard_exit_kind == STMT_BREAK {
                    3 * while_count + 5
                } else {
                    3 * while_count + 4
                },
                parameter_count: parameter_count, value_start: value_start,
                value_count: next_value - value_start,
            })
            signature_index = signature_index + 1
            continue
        }

        if simple_while {
            let loop_statement = statements[while_statement]
            let return_statement = statements[loop_return]
            let condition_value = if loop_statement.expr_root >= 0 and loop_statement.expr_root < len(expression_values) { expression_values[loop_statement.expr_root] } else { -1 }
            let loop_return_value = if return_statement.expr_root >= 0 and return_statement.expr_root < len(expression_values) { expression_values[return_statement.expr_root] } else { -1 }
            let loop_return_type = if return_statement.expr_root >= 0 and return_statement.expr_root < len(expression_types) { expression_types[return_statement.expr_root] } else { SEM_UNKNOWN }
            let mut loop_values_ready = len(loop_param_values) > 0 and
                len(loop_init_values) == len(loop_param_values) and
                len(loop_update_values) == len(loop_param_values) and
                condition_value >= 0 and loop_return_value >= 0
            let mut carried_index = 0
            while carried_index < len(loop_param_values) {
                if loop_init_values[carried_index] < 0 or loop_update_values[carried_index] < 0 {
                    loop_values_ready = false
                }
                carried_index = carried_index + 1
            }
            if not loop_values_ready {
                return TypedIr {
                    functions: functions, blocks: blocks, instructions: instructions,
                    constants: constants, successors: successors,
                    call_sites: call_sites, call_arguments: call_arguments,
                    jump_arguments: jump_arguments,
                    string_literals: string_literals,
                    constant_string_index: constant_string_index,
                    expression_values: expression_values,
                    value_count: next_value, skipped_functions: skipped, skip_reason: skip_reasons,
                    ok: false, error: "typed while loop did not lower to SSA values",
                }
            }
            let entry_terminator = len(instructions)
            if len(loop_param_values) == 1 {
                instructions = append(instructions, IrInstruction {
                    op: IR_JUMP, result: -1, type_kind: SEM_INT,
                    left: loop_init_values[0], right: -1, aux: -1, token: loop_statement.token_start,
                })
            } else {
                let entry_argument_start = len(jump_arguments)
                carried_index = 0
                while carried_index < len(loop_init_values) {
                    jump_arguments = append(jump_arguments, loop_init_values[carried_index])
                    carried_index = carried_index + 1
                }
                instructions = append(instructions, IrInstruction {
                    op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                    left: -1, right: -1, aux: entry_argument_start, token: loop_statement.token_start,
                })
            }
            let entry_block = len(blocks)
            let entry_successors = len(successors)
            successors = append(successors, entry_block + 1)
            blocks = append(blocks, IrBlock {
                function: function_index, instruction_start: instruction_start,
                instruction_count: len(instructions) - instruction_start,
                terminator: entry_terminator, successor_start: entry_successors, successor_count: 1,
            })

            let header_start = len(instructions)
            i = 0
            while i < len(condition_instructions) {
                instructions = append(instructions, condition_instructions[i])
                i = i + 1
            }
            let header_terminator = len(instructions)
            instructions = append(instructions, IrInstruction {
                op: IR_BRANCH, result: -1, type_kind: SEM_BOOL,
                left: condition_value, right: -1, aux: -1, token: loop_statement.token_start,
            })
            let header_successors = len(successors)
            successors = append(successors, entry_block + 2)
            if guard_statement >= 0 and not merge_if {
                successors = append(successors, entry_block + 6)
            } else if merge_if {
                successors = append(successors, entry_block + 7)
            } else {
                successors = append(successors, entry_block + 3)
            }
            blocks = append(blocks, IrBlock {
                function: function_index, instruction_start: header_start,
                instruction_count: len(instructions) - header_start,
                terminator: header_terminator, successor_start: header_successors, successor_count: 2,
            })

            if merge_if {
                // Merge-if loop: entry, header, pre-if updates, if condition,
                // then arm, else arm, merge, exit. Both arms carry each merge
                // local's value into the merge block parameters.
                let guard_condition = if statements[guard_statement].expr_root >= 0 and statements[guard_statement].expr_root < len(expression_values) { expression_values[statements[guard_statement].expr_root] } else { -1 }
                if guard_condition < 0 {
                    return TypedIr {
                        functions: functions, blocks: blocks, instructions: instructions,
                        constants: constants, successors: successors,
                        call_sites: call_sites, call_arguments: call_arguments,
                        jump_arguments: jump_arguments,
                        string_literals: string_literals,
                        constant_string_index: constant_string_index,
                        expression_values: expression_values,
                        value_count: next_value, skipped_functions: skipped, skip_reason: skip_reasons,
                        ok: false, error: "typed loop merge-if did not lower to an SSA value",
                    }
                }
                let pre_start = len(instructions)
                i = 0
                while i < len(pre_instructions) {
                    instructions = append(instructions, pre_instructions[i])
                    i = i + 1
                }
                let pre_terminator = len(instructions)
                instructions = append(instructions, IrInstruction {
                    op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                    left: -1, right: -1, aux: -1, token: statements[guard_statement].token_start,
                })
                let pre_successors = len(successors)
                successors = append(successors, entry_block + 3)
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: pre_start,
                    instruction_count: len(instructions) - pre_start,
                    terminator: pre_terminator, successor_start: pre_successors, successor_count: 1,
                })

                let cond_start = len(instructions)
                i = 0
                while i < len(guard_instructions) {
                    instructions = append(instructions, guard_instructions[i])
                    i = i + 1
                }
                let cond_terminator = len(instructions)
                instructions = append(instructions, IrInstruction {
                    op: IR_BRANCH, result: -1, type_kind: SEM_BOOL,
                    left: guard_condition, right: -1, aux: -1, token: statements[guard_statement].token_start,
                })
                let cond_successors = len(successors)
                successors = append(successors, entry_block + 4)
                successors = append(successors, entry_block + 5)
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: cond_start,
                    instruction_count: len(instructions) - cond_start,
                    terminator: cond_terminator, successor_start: cond_successors, successor_count: 2,
                })

                // Arm edges: each merge local carries its arm update, or the
                // value current at the if (pre update, else header parameter).
                let mut arm_edge = 0
                while arm_edge < 2 {
                    let arm_start = len(instructions)
                    if arm_edge == 0 {
                        i = 0
                        while i < len(then_instructions) {
                            instructions = append(instructions, then_instructions[i])
                            i = i + 1
                        }
                    } else {
                        i = 0
                        while i < len(else_instructions) {
                            instructions = append(instructions, else_instructions[i])
                            i = i + 1
                        }
                    }
                    let arm_terminator = len(instructions)
                    let mut arm_values: []int = []
                    carried_index = 0
                    while carried_index < len(loop_carried) {
                        let mut merge_scan = 0
                        while merge_scan < len(merge_locals) {
                            if merge_locals[merge_scan] == loop_carried[carried_index] {
                                let mut arm_value = -1
                                if arm_edge == 0 {
                                    arm_value = then_update_values[carried_index]
                                } else {
                                    arm_value = else_update_values[carried_index]
                                }
                                if arm_value < 0 {
                                    if pre_update_values[carried_index] >= 0 {
                                        arm_value = pre_update_values[carried_index]
                                    } else {
                                        arm_value = loop_param_values[carried_index]
                                    }
                                }
                                arm_values = append(arm_values, arm_value)
                            }
                            merge_scan = merge_scan + 1
                        }
                        carried_index = carried_index + 1
                    }
                    if len(arm_values) == 1 {
                        instructions = append(instructions, IrInstruction {
                            op: IR_JUMP, result: -1, type_kind: SEM_INT,
                            left: arm_values[0], right: -1, aux: -1,
                            token: statements[guard_statement].token_start,
                        })
                    } else {
                        let arm_argument_start = len(jump_arguments)
                        let mut arm_arg_index = 0
                        while arm_arg_index < len(arm_values) {
                            jump_arguments = append(jump_arguments, arm_values[arm_arg_index])
                            arm_arg_index = arm_arg_index + 1
                        }
                        instructions = append(instructions, IrInstruction {
                            op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                            left: -1, right: -1, aux: arm_argument_start,
                            token: statements[guard_statement].token_start,
                        })
                    }
                    let arm_successors = len(successors)
                    successors = append(successors, entry_block + 6)
                    blocks = append(blocks, IrBlock {
                        function: function_index, instruction_start: arm_start,
                        instruction_count: len(instructions) - arm_start,
                        terminator: arm_terminator, successor_start: arm_successors, successor_count: 1,
                    })
                    arm_edge = arm_edge + 1
                }

                let merge_start = len(instructions)
                carried_index = 0
                while carried_index < len(merge_values) {
                    instructions = append(instructions, IrInstruction {
                        op: IR_BLOCK_PARAM, result: merge_values[carried_index], type_kind: SEM_INT,
                        left: -1, right: -1, aux: 0, token: statements[guard_statement].token_start,
                    })
                    carried_index = carried_index + 1
                }
                i = 0
                while i < len(body_instructions) {
                    instructions = append(instructions, body_instructions[i])
                    i = i + 1
                }
                let merge_terminator = len(instructions)
                let mut backedge_values: []int = []
                carried_index = 0
                while carried_index < len(loop_carried) {
                    let mut merged = false
                    let mut merge_scan = 0
                    while merge_scan < len(merge_locals) {
                        if merge_locals[merge_scan] == loop_carried[carried_index] {
                            // A post-if assignment to a merge local overrides
                            // the merge value on the backedge.
                            if post_update_values[carried_index] >= 0 {
                                backedge_values = append(backedge_values, post_update_values[carried_index])
                            } else {
                                backedge_values = append(backedge_values, merge_values[merge_scan])
                            }
                            merged = true
                        }
                        merge_scan = merge_scan + 1
                    }
                    if not merged {
                        if post_update_values[carried_index] >= 0 {
                            backedge_values = append(backedge_values, post_update_values[carried_index])
                        } else {
                            backedge_values = append(backedge_values, pre_update_values[carried_index])
                        }
                    }
                    carried_index = carried_index + 1
                }
                if len(backedge_values) == 1 {
                    instructions = append(instructions, IrInstruction {
                        op: IR_JUMP, result: -1, type_kind: SEM_INT,
                        left: backedge_values[0], right: -1, aux: -1,
                        token: statements[assignment_statements[len(assignment_statements) - 1]].token_start,
                    })
                } else {
                    let backedge_argument_start = len(jump_arguments)
                    carried_index = 0
                    while carried_index < len(backedge_values) {
                        jump_arguments = append(jump_arguments, backedge_values[carried_index])
                        carried_index = carried_index + 1
                    }
                    instructions = append(instructions, IrInstruction {
                        op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                        left: -1, right: -1, aux: backedge_argument_start,
                        token: statements[assignment_statements[len(assignment_statements) - 1]].token_start,
                    })
                }
                let merge_successors = len(successors)
                successors = append(successors, entry_block + 1)
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: merge_start,
                    instruction_count: len(instructions) - merge_start,
                    terminator: merge_terminator, successor_start: merge_successors, successor_count: 1,
                })
            } else if guard_statement >= 0 {
                // post-guard updates, arm, exit. The guard's true edge runs
                // the arm (break to the exit, continue back to the header);
                // its false edge falls into the post-guard updates.
                let guard_condition = if statements[guard_statement].expr_root >= 0 and statements[guard_statement].expr_root < len(expression_values) { expression_values[statements[guard_statement].expr_root] } else { -1 }
                if guard_condition < 0 {
                    return TypedIr {
                        functions: functions, blocks: blocks, instructions: instructions,
                        constants: constants, successors: successors,
                        call_sites: call_sites, call_arguments: call_arguments,
                        jump_arguments: jump_arguments,
                        string_literals: string_literals,
                        constant_string_index: constant_string_index,
                        expression_values: expression_values,
                        value_count: next_value, skipped_functions: skipped, skip_reason: skip_reasons,
                        ok: false, error: "typed loop guard did not lower to an SSA value",
                    }
                }
                let pre_start = len(instructions)
                i = 0
                while i < len(pre_instructions) {
                    instructions = append(instructions, pre_instructions[i])
                    i = i + 1
                }
                let pre_terminator = len(instructions)
                instructions = append(instructions, IrInstruction {
                    op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                    left: -1, right: -1, aux: -1, token: statements[guard_statement].token_start,
                })
                let pre_successors = len(successors)
                successors = append(successors, entry_block + 3)
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: pre_start,
                    instruction_count: len(instructions) - pre_start,
                    terminator: pre_terminator, successor_start: pre_successors, successor_count: 1,
                })

                let guard_start = len(instructions)
                i = 0
                while i < len(guard_instructions) {
                    instructions = append(instructions, guard_instructions[i])
                    i = i + 1
                }
                let guard_terminator = len(instructions)
                instructions = append(instructions, IrInstruction {
                    op: IR_BRANCH, result: -1, type_kind: SEM_BOOL,
                    left: guard_condition, right: -1, aux: -1, token: statements[guard_statement].token_start,
                })
                let guard_successors = len(successors)
                successors = append(successors, entry_block + 5)
                successors = append(successors, entry_block + 4)
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: guard_start,
                    instruction_count: len(instructions) - guard_start,
                    terminator: guard_terminator, successor_start: guard_successors, successor_count: 2,
                })

                let body_start = len(instructions)
                i = 0
                while i < len(body_instructions) {
                    instructions = append(instructions, body_instructions[i])
                    i = i + 1
                }
                let body_terminator = len(instructions)
                if len(loop_param_values) == 1 {
                    instructions = append(instructions, IrInstruction {
                        op: IR_JUMP, result: -1, type_kind: SEM_INT,
                        left: loop_update_values[0], right: -1, aux: -1,
                        token: statements[assignment_statements[len(assignment_statements) - 1]].token_start,
                    })
                } else {
                    let body_argument_start = len(jump_arguments)
                    carried_index = 0
                    while carried_index < len(loop_update_values) {
                        jump_arguments = append(jump_arguments, loop_update_values[carried_index])
                        carried_index = carried_index + 1
                    }
                    instructions = append(instructions, IrInstruction {
                        op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                        left: -1, right: -1, aux: body_argument_start,
                        token: statements[assignment_statements[len(assignment_statements) - 1]].token_start,
                    })
                }
                let body_successors = len(successors)
                successors = append(successors, entry_block + 1)
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: body_start,
                    instruction_count: len(instructions) - body_start,
                    terminator: body_terminator, successor_start: body_successors, successor_count: 1,
                })

                let arm_start = len(instructions)
                let arm_terminator = len(instructions)
                if guard_exit_kind == STMT_CONTINUE or guard_exit_kind == STMT_BREAK {
                    // The arm carries each local's value as of the guard: the
                    // update for locals assigned before it, the header
                    // parameter for the rest. A continue jumps back to the
                    // header; a break jumps to the exit block parameters.
                    let mut arm_values: []int = []
                    carried_index = 0
                    while carried_index < len(loop_carried) {
                        let mut assigned_before = false
                        let mut continue_scan = 0
                        while continue_scan < len(assignment_statements) {
                            if assignment_locals[continue_scan] == loop_carried[carried_index] and
                                statements[assignment_statements[continue_scan]].token_start <
                                    statements[guard_statement].token_start {
                                assigned_before = true
                            }
                            continue_scan = continue_scan + 1
                        }
                        if assigned_before {
                            arm_values = append(arm_values, loop_update_values[carried_index])
                        } else {
                            arm_values = append(arm_values, loop_param_values[carried_index])
                        }
                        carried_index = carried_index + 1
                    }
                    if len(arm_values) == 1 {
                        instructions = append(instructions, IrInstruction {
                            op: IR_JUMP, result: -1, type_kind: SEM_INT,
                            left: arm_values[0], right: -1, aux: -1,
                            token: statements[guard_statement].token_start,
                        })
                    } else {
                        let arm_argument_start = len(jump_arguments)
                        carried_index = 0
                        while carried_index < len(arm_values) {
                            jump_arguments = append(jump_arguments, arm_values[carried_index])
                            carried_index = carried_index + 1
                        }
                        instructions = append(instructions, IrInstruction {
                            op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                            left: -1, right: -1, aux: arm_argument_start,
                            token: statements[guard_statement].token_start,
                        })
                    }
                }
                let arm_successors = len(successors)
                if guard_exit_kind == STMT_CONTINUE {
                    successors = append(successors, entry_block + 1)
                } else {
                    successors = append(successors, entry_block + 7)
                }
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: arm_start,
                    instruction_count: len(instructions) - arm_start,
                    terminator: arm_terminator, successor_start: arm_successors, successor_count: 1,
                })

                if guard_exit_kind == STMT_BREAK {
                    // The header's false edge cannot carry arguments, so it
                    // reaches the exit parameters through this trampoline.
                    let trampoline_start = len(instructions)
                    let trampoline_terminator = len(instructions)
                    if len(loop_param_values) == 1 {
                        instructions = append(instructions, IrInstruction {
                            op: IR_JUMP, result: -1, type_kind: SEM_INT,
                            left: loop_param_values[0], right: -1, aux: -1,
                            token: loop_statement.token_start,
                        })
                    } else {
                        let trampoline_argument_start = len(jump_arguments)
                        carried_index = 0
                        while carried_index < len(loop_param_values) {
                            jump_arguments = append(jump_arguments, loop_param_values[carried_index])
                            carried_index = carried_index + 1
                        }
                        instructions = append(instructions, IrInstruction {
                            op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                            left: -1, right: -1, aux: trampoline_argument_start,
                            token: loop_statement.token_start,
                        })
                    }
                    let trampoline_successors = len(successors)
                    successors = append(successors, entry_block + 7)
                    blocks = append(blocks, IrBlock {
                        function: function_index, instruction_start: trampoline_start,
                        instruction_count: len(instructions) - trampoline_start,
                        terminator: trampoline_terminator, successor_start: trampoline_successors, successor_count: 1,
                    })
                }
            } else {
                // Statement intrinsics in the plain body: append them after
                // the body's value instructions in source order. Every print
                // reads the SSA value current at its source point, so the
                // append position is transparent; an exit's syscall never
                // returns, so the fallthrough is unreachable.
                let mut call_index = 0
                while call_index < len(call_statements) {
                    let call_statement = statements[call_statements[call_index]]
                    if call_statement.expr_root >= 0 and call_statement.expr_root < len(expressions) {
                        let call_expression = expressions[call_statement.expr_root]
                        let argument_value = if call_expression.right >= 0 and call_expression.right < len(expression_values) { expression_values[call_expression.right] } else { -1 }
                        if argument_value >= 0 {
                            let intrinsic_name = token_text(source, tokens[call_statement.token_start])
                            if intrinsic_name == "print" {
                                let argument_type = if call_expression.right >= 0 and call_expression.right < len(expression_types) { expression_types[call_expression.right] } else { SEM_UNKNOWN }
                                body_instructions = append(body_instructions, IrInstruction {
                                    op: IR_PRINT, result: -1, type_kind: argument_type,
                                    left: argument_value, right: -1, aux: -1,
                                    token: call_statement.token_start,
                                })
                                if ir_type_is_owned(argument_type) {
                                    // Owned arguments are consumed after the
                                    // print so every path through the body
                                    // ends with the value defined-then-used
                                    // exactly once. The backend drops string
                                    // literals as no-ops (static views).
                                    body_instructions = append(body_instructions, IrInstruction {
                                        op: IR_DROP, result: -1, type_kind: argument_type,
                                        left: argument_value, right: -1, aux: -1,
                                        token: call_statement.token_start,
                                    })
                                }
                            } else {
                                body_instructions = append(body_instructions, IrInstruction {
                                    op: IR_EXIT, result: -1, type_kind: SEM_INT,
                                    left: argument_value, right: -1, aux: -1,
                                    token: call_statement.token_start,
                                })
                            }
                        }
                    }
                    call_index = call_index + 1
                }
                let body_start = len(instructions)
                i = 0
                while i < len(body_instructions) {
                    instructions = append(instructions, body_instructions[i])
                    i = i + 1
                }
                let body_terminator = len(instructions)
                if len(loop_param_values) == 1 {
                    instructions = append(instructions, IrInstruction {
                        op: IR_JUMP, result: -1, type_kind: SEM_INT,
                        left: loop_update_values[0], right: -1, aux: -1,
                        token: statements[assignment_statements[len(assignment_statements) - 1]].token_start,
                    })
                } else {
                    let body_argument_start = len(jump_arguments)
                    carried_index = 0
                    while carried_index < len(loop_update_values) {
                        jump_arguments = append(jump_arguments, loop_update_values[carried_index])
                        carried_index = carried_index + 1
                    }
                    instructions = append(instructions, IrInstruction {
                        op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
                        left: -1, right: -1, aux: body_argument_start,
                        token: statements[assignment_statements[len(assignment_statements) - 1]].token_start,
                    })
                }
                let body_successors = len(successors)
                successors = append(successors, entry_block + 1)
                blocks = append(blocks, IrBlock {
                    function: function_index, instruction_start: body_start,
                    instruction_count: len(instructions) - body_start,
                    terminator: body_terminator, successor_start: body_successors, successor_count: 1,
                })
            }

            let exit_start = len(instructions)
            if guard_exit_kind == STMT_BREAK {
                carried_index = 0
                while carried_index < len(exit_param_values) {
                    instructions = append(instructions, IrInstruction {
                        op: IR_BLOCK_PARAM, result: exit_param_values[carried_index], type_kind: SEM_INT,
                        left: -1, right: -1, aux: 0, token: statements[guard_statement].token_start,
                    })
                    carried_index = carried_index + 1
                }
            }
            i = 0
            while i < len(exit_instructions) {
                instructions = append(instructions, exit_instructions[i])
                i = i + 1
            }
            let exit_terminator = len(instructions)
            instructions = append(instructions, IrInstruction {
                op: IR_RETURN, result: -1, type_kind: loop_return_type,
                left: loop_return_value, right: -1, aux: -1, token: return_statement.token_start,
            })
            blocks = append(blocks, IrBlock {
                function: function_index, instruction_start: exit_start,
                instruction_count: len(instructions) - exit_start,
                terminator: exit_terminator, successor_start: len(successors), successor_count: 0,
            })
            functions = append(functions, IrFunction {
                item: signature.item, entry_block: entry_block,
                block_count: if guard_statement < 0 { 4 } else if merge_if { 8 } else if guard_exit_kind == STMT_BREAK { 8 } else { 7 },
                parameter_count: parameter_count, value_start: value_start,
                value_count: next_value - value_start,
            })
            signature_index = signature_index + 1
            continue
        }

        let mut return_value = -1
        let mut return_type = SEM_UNKNOWN
        let mut return_token = item.body_end
        let mut statement_index = 0
        while statement_index < len(statements) {
            let statement = statements[statement_index]
            if statement.kind == STMT_RETURN and statement.token_start >= item.body_start and statement.token_start < item.body_end {
                return_value = if statement.expr_root >= 0 and statement.expr_root < len(expression_values) { expression_values[statement.expr_root] } else { -1 }
                return_type = if statement.expr_root >= 0 and statement.expr_root < len(expression_types) { expression_types[statement.expr_root] } else { SEM_UNKNOWN }
                return_token = statement.token_start
            }
            statement_index = statement_index + 1
        }
        // Statement intrinsics emit in source order: prints write their string
        // argument, exit terminates with its integer argument.
        let mut call_index = 0
        while call_index < len(call_statements) {
            let call_statement = statements[call_statements[call_index]]
            let intrinsic_name = token_text(source, tokens[call_statement.token_start])
            if call_statement.expr_root >= 0 and call_statement.expr_root < len(expressions) {
                let call_expression = expressions[call_statement.expr_root]
                let argument_value = if call_expression.right >= 0 and call_expression.right < len(expression_values) { expression_values[call_expression.right] } else { -1 }
                if argument_value >= 0 {
                    if intrinsic_name == "print" {
                        // The type tag rides on the instruction so the backend
                        // picks the string or integer (itoa) emission path.
                        let argument_type = if call_expression.right >= 0 and call_expression.right < len(expression_types) { expression_types[call_expression.right] } else { SEM_UNKNOWN }
                        instructions = append(instructions, IrInstruction {
                            op: IR_PRINT, result: -1, type_kind: argument_type,
                            left: argument_value, right: -1, aux: -1,
                            token: call_statement.token_start,
                        })
                    } else {
                        instructions = append(instructions, IrInstruction {
                            op: IR_EXIT, result: -1, type_kind: SEM_INT,
                            left: argument_value, right: -1, aux: -1,
                            token: call_statement.token_start,
                        })
                    }
                }
            }
            call_index = call_index + 1
        }
        let mut owned_live = make([]int, next_value, next_value)
        let mut owned_types = make([]int, next_value, next_value)
        let mut ownership_index = instruction_start
        while ownership_index < len(instructions) {
            let owned_instruction = instructions[ownership_index]
            if owned_instruction.result >= 0 and ir_type_is_owned(owned_instruction.type_kind) {
                owned_live[owned_instruction.result] = 1
                owned_types[owned_instruction.result] = owned_instruction.type_kind
            }
            if (owned_instruction.op == IR_ARRAY or owned_instruction.op == IR_SLICE or
                owned_instruction.op == IR_MOVE) and
                owned_instruction.left >= 0 and owned_live[owned_instruction.left] == 1 {
                owned_live[owned_instruction.left] = 0
            }
            if owned_instruction.op == IR_ARRAY and owned_instruction.right >= 0 and
                owned_live[owned_instruction.right] == 1 {
                owned_live[owned_instruction.right] = 0
            }
            // Only a call that takes ownership ends the value's life here. A
            // borrowing intrinsic reads through it and returns, so the caller
            // still owns it and still owes it a drop — clearing liveness for
            // one of those is why `make([]byte, n)` passed to `unsafe_argv_copy`
            // leaked its block.
            if owned_instruction.op == IR_CALL and owned_instruction.aux >= 0 and
                owned_instruction.aux < len(call_sites) {
                let owned_call = call_sites[owned_instruction.aux]
                let mut owned_argument = owned_call.argument_start
                while owned_argument < owned_call.argument_start + owned_call.argument_count {
                    let argument_value = call_arguments[owned_argument]
                    if argument_value >= 0 and argument_value < len(owned_live) and
                        owned_live[argument_value] == 1 and
                        ir_call_consumes_arguments(owned_call.callee_item,
                            owned_types[argument_value]) {
                        owned_live[argument_value] = 0
                    }
                    owned_argument = owned_argument + 1
                }
            }
            ownership_index = ownership_index + 1
        }
        if return_value >= 0 and return_value < len(owned_live) and owned_live[return_value] == 1 {
            let moved_value = next_value
            next_value = next_value + 1
            instructions = append(instructions, IrInstruction {
                op: IR_MOVE, result: moved_value, type_kind: return_type,
                left: return_value, right: -1, aux: -1, token: return_token,
            })
            owned_live[return_value] = 0
            return_value = moved_value
        }
        ownership_index = len(owned_live) - 1
        while ownership_index >= value_start {
            if owned_live[ownership_index] == 1 {
                instructions = append(instructions, IrInstruction {
                    op: IR_DROP, result: -1, type_kind: owned_types[ownership_index],
                    left: ownership_index, right: -1, aux: -1, token: return_token,
                })
            }
            ownership_index = ownership_index - 1
        }
        let terminator = len(instructions)
        instructions = append(instructions, IrInstruction {
            op: IR_RETURN, result: -1, type_kind: return_type,
            left: return_value, right: -1, aux: -1, token: return_token,
        })
        let block_index = len(blocks)
        blocks = append(blocks, IrBlock {
            function: function_index, instruction_start: instruction_start,
            instruction_count: len(instructions) - instruction_start,
            terminator: terminator, successor_start: len(successors), successor_count: 0,
        })
        functions = append(functions, IrFunction {
            item: signature.item, entry_block: block_index, block_count: 1,
            parameter_count: parameter_count, value_start: value_start,
            value_count: next_value - value_start,
        })
        signature_index = signature_index + 1
    }
    return TypedIr {
        functions: functions, blocks: blocks, instructions: instructions,
        constants: constants, successors: successors,
        call_sites: call_sites, call_arguments: call_arguments,
        jump_arguments: jump_arguments,
        string_literals: string_literals,
        constant_string_index: constant_string_index,
        expression_values: expression_values,
        value_count: next_value, skipped_functions: skipped, skip_reason: skip_reasons, ok: true, error: "",
    }
}

fn verify_typed_ir(
    functions: []IrFunction,
    blocks: []IrBlock,
    instructions: []IrInstruction,
    constants: []IrConstant,
    successors: []int,
    call_sites: []IrCallSite,
    call_arguments: []int,
    jump_arguments: []int,
    value_count: int
) -> IrVerification {
    if value_count < 0 {
        return IrVerification { ok: false, error: "IR value count is negative", checked_values: 0 }
    }
    let mut definitions = make([]int, value_count, value_count)
    let mut value_owners = make([]int, value_count, value_count)
    let mut constant_references = make([]int, len(constants), len(constants))
    let mut call_site_references = make([]int, len(call_sites), len(call_sites))
    let mut call_argument_owners = make([]int, len(call_arguments), len(call_arguments))
    let mut jump_argument_owners = make([]int, len(jump_arguments), len(jump_arguments))
    let mut instruction_owners = make([]int, len(instructions), len(instructions))
    let mut i = 0
    while i < len(value_owners) {
        value_owners[i] = -1
        i = i + 1
    }
    i = 0
    while i < len(instruction_owners) {
        instruction_owners[i] = -1
        i = i + 1
    }
    i = 0
    while i < len(call_argument_owners) {
        call_argument_owners[i] = -1
        i = i + 1
    }
    i = 0
    while i < len(jump_argument_owners) {
        jump_argument_owners[i] = -1
        i = i + 1
    }

    i = 0
    while i < len(functions) {
        let function = functions[i]
        if function.entry_block < 0 or function.entry_block >= len(blocks) or function.block_count <= 0 or
            function.entry_block + function.block_count > len(blocks) {
            return IrVerification { ok: false, error: "IR function has invalid block range", checked_values: 0 }
        }
        if function.value_start < 0 or function.value_count < 0 or function.value_start + function.value_count > value_count {
            return IrVerification { ok: false, error: "IR function has invalid value range", checked_values: 0 }
        }
        if function.parameter_count < 0 or function.parameter_count > function.value_count {
            return IrVerification { ok: false, error: "IR function has invalid parameter count", checked_values: 0 }
        }
        let mut block_index = function.entry_block
        while block_index < function.entry_block + function.block_count {
            if blocks[block_index].function != i {
                return IrVerification { ok: false, error: "IR block belongs to wrong function", checked_values: 0 }
            }
            block_index = block_index + 1
        }
        let mut value_index = function.value_start
        while value_index < function.value_start + function.value_count {
            if value_owners[value_index] >= 0 {
                return IrVerification { ok: false, error: "IR value belongs to multiple functions", checked_values: 0 }
            }
            value_owners[value_index] = i
            value_index = value_index + 1
        }
        i = i + 1
    }

    i = 0
    while i < len(blocks) {
        let block = blocks[i]
        if block.function < 0 or block.function >= len(functions) {
            return IrVerification { ok: false, error: "IR block has invalid function", checked_values: 0 }
        }
        if block.instruction_start < 0 or block.instruction_count <= 0 or
            block.instruction_start + block.instruction_count > len(instructions) {
            return IrVerification { ok: false, error: "IR block has invalid instruction range", checked_values: 0 }
        }
        if block.terminator < block.instruction_start or block.terminator >= block.instruction_start + block.instruction_count or
            block.terminator != block.instruction_start + block.instruction_count - 1 or
            (instructions[block.terminator].op != IR_RETURN and instructions[block.terminator].op != IR_BRANCH and
                instructions[block.terminator].op != IR_JUMP) {
            return IrVerification { ok: false, error: "IR block has invalid terminator", checked_values: 0 }
        }
        let mut block_parameters = 0
        let mut parameter_scan = block.instruction_start
        while parameter_scan < block.instruction_start + block.instruction_count and
            instructions[parameter_scan].op == IR_BLOCK_PARAM {
            block_parameters = block_parameters + 1
            parameter_scan = parameter_scan + 1
        }
        while parameter_scan < block.instruction_start + block.instruction_count {
            if instructions[parameter_scan].op == IR_BLOCK_PARAM {
                return IrVerification { ok: false, error: "IR block parameters must lead the block", checked_values: 0 }
            }
            parameter_scan = parameter_scan + 1
        }
        if block_parameters > 0 {
            if i == functions[block.function].entry_block {
                return IrVerification { ok: false, error: "IR entry block cannot have a block parameter", checked_values: 0 }
            }
            parameter_scan = block.instruction_start
            let mut owned_block_params = 0
            while parameter_scan < block.instruction_start + block_parameters {
                let parameter = instructions[parameter_scan]
                if parameter.aux != 0 or parameter.left >= 0 or parameter.right >= 0 or parameter.type_kind == SEM_UNKNOWN {
                    return IrVerification { ok: false, error: "IR block parameter is malformed", checked_values: 0 }
                }
                if ir_type_is_owned(parameter.type_kind) {
                    owned_block_params = owned_block_params + 1
                }
                parameter_scan = parameter_scan + 1
            }
            // One owned parameter may ride a multi-arg join (scalar siblings
            // beside it). Two would need a scratch copy across the jump.
            if owned_block_params > 1 {
                return IrVerification { ok: false, error: "IR block parameter type is owned", checked_values: 0 }
            }
            let mut incoming = 0
            let mut predecessor = 0
            while predecessor < len(blocks) {
                let candidate = blocks[predecessor]
                let mut edge = candidate.successor_start
                while edge < candidate.successor_start + candidate.successor_count {
                    if successors[edge] == i { incoming = incoming + 1 }
                    edge = edge + 1
                }
                predecessor = predecessor + 1
            }
            if incoming == 0 {
                return IrVerification { ok: false, error: "IR block parameter has no incoming edges", checked_values: 0 }
            }
        }
        if block.successor_start < 0 or block.successor_count < 0 or
            block.successor_start + block.successor_count > len(successors) {
            return IrVerification { ok: false, error: "IR block has invalid successor range", checked_values: 0 }
        }
        let mut successor_index = block.successor_start
        while successor_index < block.successor_start + block.successor_count {
            if successors[successor_index] < 0 or successors[successor_index] >= len(blocks) {
                return IrVerification { ok: false, error: "IR block has invalid successor", checked_values: 0 }
            }
            if blocks[successors[successor_index]].function != block.function {
                return IrVerification { ok: false, error: "IR successor crosses function boundary", checked_values: 0 }
            }
            successor_index = successor_index + 1
        }
        let terminator_op = instructions[block.terminator].op
        if terminator_op == IR_RETURN and block.successor_count != 0 {
            return IrVerification { ok: false, error: "IR return block has successors", checked_values: 0 }
        }
        if terminator_op == IR_BRANCH and block.successor_count != 2 {
            return IrVerification { ok: false, error: "IR branch must have two successors", checked_values: 0 }
        }
        if terminator_op == IR_JUMP and block.successor_count != 1 {
            return IrVerification { ok: false, error: "IR jump must have one successor", checked_values: 0 }
        }
        let mut checked_successor = block.successor_start
        while checked_successor < block.successor_start + block.successor_count {
            let target = blocks[successors[checked_successor]]
            let mut target_parameters = 0
            let mut target_scan = target.instruction_start
            while target_scan < target.instruction_start + target.instruction_count and
                instructions[target_scan].op == IR_BLOCK_PARAM {
                target_parameters = target_parameters + 1
                target_scan = target_scan + 1
            }
            if target_parameters == 0 {
                if terminator_op == IR_JUMP and
                    (instructions[block.terminator].left >= 0 or instructions[block.terminator].right >= 0 or
                        instructions[block.terminator].aux >= 0) {
                    return IrVerification { ok: false, error: "IR jump has an unexpected block argument", checked_values: 0 }
                }
            } else if target_parameters == 1 {
                // Single-parameter blocks keep the original encoding: the
                // argument travels in `left` and the arena stays untouched.
                if terminator_op != IR_JUMP or instructions[block.terminator].left < 0 or
                    instructions[block.terminator].right >= 0 or instructions[block.terminator].aux >= 0 or
                    instructions[block.terminator].type_kind != instructions[target.instruction_start].type_kind {
                    return IrVerification { ok: false, error: "IR edge does not provide matching block argument", checked_values: 0 }
                }
            } else {
                // Multi-parameter blocks carry their arguments in the
                // jump_arguments arena, in target-parameter order.
                if terminator_op != IR_JUMP or instructions[block.terminator].left >= 0 or
                    instructions[block.terminator].right >= 0 or instructions[block.terminator].aux < 0 or
                    instructions[block.terminator].aux + target_parameters > len(jump_arguments) {
                    return IrVerification { ok: false, error: "IR edge does not provide matching block argument", checked_values: 0 }
                }
            }
            checked_successor = checked_successor + 1
        }
        let mut instruction_index = block.instruction_start
        while instruction_index < block.instruction_start + block.instruction_count {
            if instruction_owners[instruction_index] >= 0 {
                return IrVerification { ok: false, error: "IR instruction belongs to multiple blocks", checked_values: 0 }
            }
            instruction_owners[instruction_index] = i
            instruction_index = instruction_index + 1
        }
        i = i + 1
    }

    // Dominator sets per block, one bit per function-local block index, packed
    // `IR_DOMINATOR_BITS` bits per word so a function is not limited to a
    // single machine int. Each set starts as the full function mask except the
    // entry, then iterates dom(b) = {b} ∪ (∩ dom(p) over predecessors p) to a
    // fixpoint. Every function's row is `dominator_words` wide, sized by the
    // largest function so one flat arena addresses them all.
    let mut widest_function = 0
    i = 0
    while i < len(functions) {
        if functions[i].block_count > widest_function { widest_function = functions[i].block_count }
        if functions[i].block_count > IR_MAX_FUNCTION_BLOCKS {
            return IrVerification { ok: false, error: "IR function has too many blocks", checked_values: 0 }
        }
        i = i + 1
    }
    let dominator_words = ir_dominator_words(widest_function)
    let dominator_size = len(blocks) * dominator_words
    let mut dominators = make([]int, dominator_size, dominator_size)
    i = 0
    while i < dominator_size {
        dominators[i] = 0
        i = i + 1
    }
    i = 0
    while i < len(functions) {
        let function = functions[i]
        // The full mask: every bit below block_count set, the rest clear, so a
        // meet can never introduce a block this function does not have.
        let mut full = make([]int, dominator_words, dominator_words)
        let mut word_index = 0
        while word_index < dominator_words {
            let word_base = word_index * IR_DOMINATOR_BITS
            let mut word_value = 0
            let mut word_bit = 0
            while word_bit < IR_DOMINATOR_BITS {
                if word_base + word_bit < function.block_count {
                    word_value = word_value | (1 << word_bit)
                }
                word_bit = word_bit + 1
            }
            full[word_index] = word_value
            word_index = word_index + 1
        }
        let mut block_offset = 0
        while block_offset < function.block_count {
            word_index = 0
            while word_index < dominator_words {
                dominators[(function.entry_block + block_offset) * dominator_words + word_index] = full[word_index]
                word_index = word_index + 1
            }
            block_offset = block_offset + 1
        }
        word_index = 0
        while word_index < dominator_words {
            dominators[function.entry_block * dominator_words + word_index] = if word_index == 0 { 1 } else { 0 }
            word_index = word_index + 1
        }
        let mut changed = true
        while changed {
            changed = false
            block_offset = 1
            while block_offset < function.block_count {
                let block_index = function.entry_block + block_offset
                let mut meet = make([]int, dominator_words, dominator_words)
                word_index = 0
                while word_index < dominator_words {
                    meet[word_index] = full[word_index]
                    word_index = word_index + 1
                }
                let mut predecessor = function.entry_block
                while predecessor < function.entry_block + function.block_count {
                    let candidate = blocks[predecessor]
                    let mut edge = candidate.successor_start
                    while edge < candidate.successor_start + candidate.successor_count {
                        if successors[edge] == block_index {
                            word_index = 0
                            while word_index < dominator_words {
                                meet[word_index] = meet[word_index] & dominators[predecessor * dominator_words + word_index]
                                word_index = word_index + 1
                            }
                        }
                        edge = edge + 1
                    }
                    predecessor = predecessor + 1
                }
                let self_word = block_offset / IR_DOMINATOR_BITS
                meet[self_word] = meet[self_word] | (1 << (block_offset - self_word * IR_DOMINATOR_BITS))
                word_index = 0
                while word_index < dominator_words {
                    if meet[word_index] != dominators[block_index * dominator_words + word_index] {
                        dominators[block_index * dominator_words + word_index] = meet[word_index]
                        changed = true
                    }
                    word_index = word_index + 1
                }
                block_offset = block_offset + 1
            }
        }
        i = i + 1
    }

    i = 0
    while i < len(instructions) {
        if instruction_owners[i] < 0 {
            return IrVerification { ok: false, error: "IR instruction has no owning block", checked_values: 0 }
        }
        let instruction = instructions[i]
        let owner_function = blocks[instruction_owners[i]].function
        if instruction.left >= 0 and (instruction.left >= value_count or definitions[instruction.left] == 0) {
            return IrVerification { ok: false, error: "IR instruction uses undefined left value", checked_values: 0 }
        }
        if instruction.right >= 0 and (instruction.right >= value_count or definitions[instruction.right] == 0) {
            return IrVerification { ok: false, error: "IR instruction uses undefined right value", checked_values: 0 }
        }
        if instruction.left >= 0 and value_owners[instruction.left] != owner_function {
            return IrVerification { ok: false, error: "IR left value crosses function boundary", checked_values: 0 }
        }
        if instruction.right >= 0 and value_owners[instruction.right] != owner_function {
            return IrVerification { ok: false, error: "IR right value crosses function boundary", checked_values: 0 }
        }
        let owner_block = instruction_owners[i]
        let entry_block = functions[owner_function].entry_block
        if instruction.left >= 0 {
            let definition_block = instruction_owners[definitions[instruction.left] - 1]
            if definition_block != owner_block and
                not ir_dominator_test(dominators, dominator_words, owner_block, definition_block - entry_block) {
                return IrVerification { ok: false, error: "IR left value does not dominate its use", checked_values: 0 }
            }
        }
        if instruction.right >= 0 {
            let definition_block = instruction_owners[definitions[instruction.right] - 1]
            if definition_block != owner_block and
                not ir_dominator_test(dominators, dominator_words, owner_block, definition_block - entry_block) {
                return IrVerification { ok: false, error: "IR right value does not dominate its use", checked_values: 0 }
            }
        }
        if instruction.op == IR_RETURN or instruction.op == IR_BRANCH or instruction.op == IR_JUMP or
            instruction.op == IR_DROP or instruction.op == IR_PRINT or instruction.op == IR_EXIT {
            if instruction.result >= 0 {
                return IrVerification { ok: false, error: "IR terminator unexpectedly defines a value", checked_values: 0 }
            }
        } else {
            if instruction.result < 0 or instruction.result >= value_count {
                return IrVerification { ok: false, error: "IR instruction has invalid result value", checked_values: 0 }
            }
            if value_owners[instruction.result] != owner_function {
                return IrVerification { ok: false, error: "IR result belongs to wrong function", checked_values: 0 }
            }
            if instruction.type_kind == SEM_UNKNOWN {
                return IrVerification { ok: false, error: "IR result has unknown type", checked_values: 0 }
            }
            if definitions[instruction.result] != 0 {
                return IrVerification { ok: false, error: "IR value has multiple definitions", checked_values: 0 }
            }
            definitions[instruction.result] = i + 1
        }
        if instruction.op == IR_BRANCH {
            if instruction.left < 0 {
                return IrVerification { ok: false, error: "IR branch has no condition", checked_values: 0 }
            }
            let condition_instruction = definitions[instruction.left] - 1
            if condition_instruction < 0 or instructions[condition_instruction].type_kind != SEM_BOOL {
                return IrVerification { ok: false, error: "IR branch condition is not bool", checked_values: 0 }
            }
        }
        if instruction.op == IR_JUMP and instruction.left >= 0 {
            let argument_instruction = definitions[instruction.left] - 1
            if argument_instruction < 0 or instructions[argument_instruction].type_kind != instruction.type_kind {
                return IrVerification { ok: false, error: "IR jump argument type does not match its value", checked_values: 0 }
            }
        }
        if instruction.op == IR_JUMP and instruction.aux >= 0 {
            // Multi-argument jump: the arena slice must match the target
            // block's leading parameters in count and type, and each argument
            // must dominate the jump.
            let jump_block = blocks[owner_block]
            if jump_block.successor_count != 1 or jump_block.successor_start < 0 or
                jump_block.successor_start >= len(successors) {
                return IrVerification { ok: false, error: "IR jump has invalid successor", checked_values: 0 }
            }
            let jump_target = blocks[successors[jump_block.successor_start]]
            let mut target_parameters = 0
            let mut target_scan = jump_target.instruction_start
            while target_scan < jump_target.instruction_start + jump_target.instruction_count and
                instructions[target_scan].op == IR_BLOCK_PARAM {
                target_parameters = target_parameters + 1
                target_scan = target_scan + 1
            }
            if target_parameters < 2 or instruction.aux + target_parameters > len(jump_arguments) {
                return IrVerification { ok: false, error: "IR edge does not provide matching block argument", checked_values: 0 }
            }
            let mut argument_offset = 0
            while argument_offset < target_parameters {
                let arena_index = instruction.aux + argument_offset
                if jump_argument_owners[arena_index] >= 0 {
                    return IrVerification { ok: false, error: "IR jump argument belongs to multiple jumps", checked_values: 0 }
                }
                jump_argument_owners[arena_index] = i
                let argument = jump_arguments[arena_index]
                if argument < 0 or argument >= value_count or definitions[argument] == 0 {
                    return IrVerification { ok: false, error: "IR jump uses undefined argument value", checked_values: 0 }
                }
                if value_owners[argument] != owner_function {
                    return IrVerification { ok: false, error: "IR jump argument crosses function boundary", checked_values: 0 }
                }
                let argument_block = instruction_owners[definitions[argument] - 1]
                if argument_block != owner_block and
                    not ir_dominator_test(dominators, dominator_words, owner_block, argument_block - entry_block) {
                    return IrVerification { ok: false, error: "IR jump argument does not dominate jump", checked_values: 0 }
                }
                if instructions[definitions[argument] - 1].type_kind !=
                    instructions[jump_target.instruction_start + argument_offset].type_kind {
                    return IrVerification { ok: false, error: "IR edge does not provide matching block argument", checked_values: 0 }
                }
                argument_offset = argument_offset + 1
            }
        }
        if instruction.op == IR_MOVE or instruction.op == IR_DROP {
            if instruction.left < 0 or instruction.right >= 0 {
                return IrVerification { ok: false, error: "IR ownership operation has invalid operands", checked_values: 0 }
            }
            let source_instruction = definitions[instruction.left] - 1
            if source_instruction < 0 or not ir_type_is_owned(instructions[source_instruction].type_kind) or
                instructions[source_instruction].type_kind != instruction.type_kind {
                return IrVerification { ok: false, error: "IR ownership operation has invalid type", checked_values: 0 }
            }
        }
        if instruction.op == IR_CLONE {
            if instruction.left < 0 or instruction.right >= 0 or instruction.aux >= 0 {
                return IrVerification { ok: false, error: "IR clone has invalid operands", checked_values: 0 }
            }
            let source_instruction = definitions[instruction.left] - 1
            if source_instruction < 0 or not ir_type_is_owned(instructions[source_instruction].type_kind) or
                instructions[source_instruction].type_kind != instruction.type_kind {
                return IrVerification { ok: false, error: "IR clone has invalid type", checked_values: 0 }
            }
        }
        if instruction.op == IR_CALL {
            if instruction.aux < 0 or instruction.aux >= len(call_sites) or
                instruction.left >= 0 or instruction.right >= 0 {
                return IrVerification { ok: false, error: "IR call has invalid callee or argument layout", checked_values: 0 }
            }
            let call_site = call_sites[instruction.aux]
            if call_site.argument_start < 0 or call_site.argument_count < 0 or
                call_site.argument_start + call_site.argument_count > len(call_arguments) {
                return IrVerification { ok: false, error: "IR call has invalid argument range", checked_values: 0 }
            }
        // Reserved callee items -2/-3 denote Mako-native builtins. Their
        // arguments still receive normal IR ownership and dominance checks;
        // they have no user-defined function body.
                let mut callee_index = if ir_is_intrinsic_callee(call_site.callee_item) { 0 } else { -1 }
            let mut candidate_index = 0
            while candidate_index < len(functions) {
                if functions[candidate_index].item == call_site.callee_item { callee_index = candidate_index }
                candidate_index = candidate_index + 1
            }
            if callee_index < 0 {
                return IrVerification { ok: false, error: "IR call targets a function without an IR body", checked_values: 0 }
            }
            let callee = functions[callee_index]
                if not ir_is_intrinsic_callee(call_site.callee_item) and call_site.argument_count != callee.parameter_count {
                return IrVerification { ok: false, error: "IR call argument count does not match callee", checked_values: 0 }
            }
            let callee_entry = blocks[callee.entry_block]
            let mut argument_offset = 0
            while argument_offset < call_site.argument_count {
                let argument_index = call_site.argument_start + argument_offset
                if call_argument_owners[argument_index] >= 0 {
                    return IrVerification { ok: false, error: "IR call argument belongs to multiple call sites", checked_values: 0 }
                }
                call_argument_owners[argument_index] = instruction.aux
                let argument = call_arguments[argument_index]
                if argument < 0 or argument >= value_count or definitions[argument] == 0 {
                    return IrVerification { ok: false, error: "IR call uses undefined argument value", checked_values: 0 }
                }
                if value_owners[argument] != owner_function {
                    return IrVerification { ok: false, error: "IR call argument crosses function boundary", checked_values: 0 }
                }
                let definition_block = instruction_owners[definitions[argument] - 1]
                if definition_block != owner_block and
                    not ir_dominator_test(dominators, dominator_words, owner_block, definition_block - entry_block) {
                    return IrVerification { ok: false, error: "IR call argument does not dominate call", checked_values: 0 }
                }
                let parameter_instruction = callee_entry.instruction_start + argument_offset
        if not ir_is_intrinsic_callee(call_site.callee_item) and (parameter_instruction >= callee_entry.instruction_start + callee_entry.instruction_count or
            instructions[parameter_instruction].op != IR_PARAM or
            instructions[parameter_instruction].type_kind != instructions[definitions[argument] - 1].type_kind) {
                    return IrVerification { ok: false, error: "IR call argument type does not match callee parameter", checked_values: 0 }
                }
                argument_offset = argument_offset + 1
            }
            call_site_references[instruction.aux] = call_site_references[instruction.aux] + 1
        }
        if instruction.op == IR_CONST {
            if instruction.aux < 0 or instruction.aux >= len(constants) {
                return IrVerification { ok: false, error: "IR constant has invalid pool index", checked_values: 0 }
            }
            let constant = constants[instruction.aux]
            if constant.type_kind != instruction.type_kind or constant.start < 0 or constant.end < constant.start {
                return IrVerification { ok: false, error: "IR constant payload does not match instruction", checked_values: 0 }
            }
            constant_references[instruction.aux] = constant_references[instruction.aux] + 1
        }
        i = i + 1
    }
    let mut checked = 0
    i = 0
    while i < len(definitions) {
        if value_owners[i] < 0 {
            return IrVerification { ok: false, error: "IR value has no owning function", checked_values: checked }
        }
        if definitions[i] == 0 {
            return IrVerification { ok: false, error: "IR value has no definition", checked_values: checked }
        }
        checked = checked + 1
        i = i + 1
    }
    i = 0
    while i < len(constant_references) {
        if constant_references[i] == 0 {
            return IrVerification { ok: false, error: "IR constant has no instruction", checked_values: checked }
        }
        i = i + 1
    }
    i = 0
    while i < len(call_site_references) {
        if call_site_references[i] != 1 {
            return IrVerification { ok: false, error: "IR call site is not referenced exactly once", checked_values: checked }
        }
        i = i + 1
    }
    i = 0
    while i < len(call_argument_owners) {
        if call_argument_owners[i] < 0 {
            return IrVerification { ok: false, error: "IR call argument has no owning call site", checked_values: checked }
        }
        i = i + 1
    }
    i = 0
    while i < len(jump_argument_owners) {
        if jump_argument_owners[i] < 0 {
            return IrVerification { ok: false, error: "IR jump argument has no owning jump", checked_values: checked }
        }
        i = i + 1
    }
    let ownership = verify_owned_ir_paths(
        functions, blocks, instructions, successors, call_sites, call_arguments, jump_arguments, definitions
    )
    if not ownership.ok { return ownership }
    return IrVerification { ok: true, error: "", checked_values: checked }
}

fn typed_ir_smoke_test() -> bool {
    let source = "fn add(a: int, b: int) -> int {\nlet offset = 1\nlet ratio = 1.5\nlet enabled = true\nlet label = \"mako\"\nlet sum = a + b + offset\nreturn sum\n}"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let parsed = parse_frontend(source, lexed.tokens)
    if not parsed.ok { return false }
    let ir = lower_typed_ir(
        source, lexed.tokens, parsed.items, parsed.signatures, parsed.statements,
        parsed.statement_edges, parsed.expressions, parsed.expression_types, parsed.locals,
        parsed.local_types, parsed.expression_locals, parsed.symbols, parsed.expression_symbols
    )
    if not ir.ok or len(ir.functions) != 1 or len(ir.blocks) != 1 or len(ir.instructions) != 10 or len(ir.constants) != 4 or ir.value_count != 8 { return false }
    let verified = verify_typed_ir(
        ir.functions, ir.blocks, ir.instructions, ir.constants, ir.successors,
        ir.call_sites, ir.call_arguments, ir.jump_arguments, ir.value_count
    )
    return verified.ok and verified.checked_values == 8 and
        ir.constants[0].type_kind == SEM_INT and ir.constants[0].int_value == 1 and
        ir.constants[1].type_kind == SEM_FLOAT and ir.constants[1].float_value == 1.5 and
        ir.constants[2].type_kind == SEM_BOOL and ir.constants[2].int_value == 1 and
        ir.constants[3].type_kind == SEM_STRING and ir.constants[3].end - ir.constants[3].start == 4 and
        ir.instructions[0].op == IR_PARAM and ir.instructions[1].op == IR_PARAM and
        ir.instructions[2].op == IR_CONST and ir.instructions[2].aux == 0 and
        ir.instructions[6].op == IR_BINARY and ir.instructions[6].type_kind == SEM_INT and
        ir.instructions[6].left == 0 and ir.instructions[6].right == 1 and
        ir.instructions[7].op == IR_BINARY and ir.instructions[7].left == 6 and ir.instructions[7].right == 2 and
        ir.instructions[8].op == IR_DROP and ir.instructions[8].left == 5 and
        ir.instructions[9].op == IR_RETURN and ir.instructions[9].left == 7
}

fn typed_ir_verifier_smoke_test() -> bool {
    let mut functions: []IrFunction = []
    let mut blocks: []IrBlock = []
    let mut instructions: []IrInstruction = []
    functions = append(functions, IrFunction {
        item: 0, entry_block: 0, block_count: 1,
        parameter_count: 0, value_start: 0, value_count: 1,
    })
    blocks = append(blocks, IrBlock {
        function: 0, instruction_start: 0, instruction_count: 2,
        terminator: 1, successor_start: 0, successor_count: 0,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_BINARY, result: 0, type_kind: SEM_INT,
        left: 1, right: -1, aux: TK_PLUS, token: 0,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_RETURN, result: -1, type_kind: SEM_INT,
        left: 0, right: -1, aux: -1, token: 0,
    })
    let verified = verify_typed_ir(
        functions, blocks, instructions, make([]IrConstant, 0, 0), make([]int, 0, 0),
        make([]IrCallSite, 0, 0), make([]int, 0, 0), make([]int, 0, 0), 1
    )
    return not verified.ok and verified.error == "IR instruction uses undefined left value"
}

fn typed_ir_block_parameter_verifier_smoke_test() -> bool {
    let mut functions: []IrFunction = []
    let mut blocks: []IrBlock = []
    let mut instructions: []IrInstruction = []
    let mut successors: []int = []
    functions = append(functions, IrFunction {
        item: 0, entry_block: 0, block_count: 4,
        parameter_count: 2, value_start: 0, value_count: 3,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_PARAM, result: 0, type_kind: SEM_INT,
        left: -1, right: -1, aux: 0, token: 0,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_PARAM, result: 1, type_kind: SEM_BOOL,
        left: -1, right: -1, aux: 1, token: 0,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_BRANCH, result: -1, type_kind: SEM_BOOL,
        left: 1, right: -1, aux: -1, token: 0,
    })
    successors = append(successors, 1)
    successors = append(successors, 2)
    blocks = append(blocks, IrBlock {
        function: 0, instruction_start: 0, instruction_count: 3,
        terminator: 2, successor_start: 0, successor_count: 2,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_JUMP, result: -1, type_kind: SEM_INT,
        left: -1, right: -1, aux: -1, token: 0,
    })
    successors = append(successors, 3)
    blocks = append(blocks, IrBlock {
        function: 0, instruction_start: 3, instruction_count: 1,
        terminator: 3, successor_start: 2, successor_count: 1,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_JUMP, result: -1, type_kind: SEM_INT,
        left: 0, right: -1, aux: -1, token: 0,
    })
    successors = append(successors, 3)
    blocks = append(blocks, IrBlock {
        function: 0, instruction_start: 4, instruction_count: 1,
        terminator: 4, successor_start: 3, successor_count: 1,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_BLOCK_PARAM, result: 2, type_kind: SEM_INT,
        left: -1, right: -1, aux: 0, token: 0,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_RETURN, result: -1, type_kind: SEM_INT,
        left: 2, right: -1, aux: -1, token: 0,
    })
    blocks = append(blocks, IrBlock {
        function: 0, instruction_start: 5, instruction_count: 2,
        terminator: 6, successor_start: 4, successor_count: 0,
    })
    let verified = verify_typed_ir(
        functions, blocks, instructions, make([]IrConstant, 0, 0), successors,
        make([]IrCallSite, 0, 0), make([]int, 0, 0), make([]int, 0, 0), 3
    )
    return not verified.ok and verified.error == "IR edge does not provide matching block argument"
}

fn typed_ir_arm_placement_smoke_test() -> bool {
    let source = "fn choose(value: int) -> int {\nif value > 0 {\nreturn value\n} else {\nreturn 0\n}\n}"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let parsed = parse_frontend(source, lexed.tokens)
    if not parsed.ok { return false }
    let ir = lower_typed_ir(
        source, lexed.tokens, parsed.items, parsed.signatures, parsed.statements,
        parsed.statement_edges, parsed.expressions, parsed.expression_types, parsed.locals,
        parsed.local_types, parsed.expression_locals, parsed.symbols, parsed.expression_symbols
    )
    if not ir.ok or len(ir.functions) != 1 or len(ir.blocks) != 4 or
        len(ir.instructions) != 9 or ir.value_count != 5 { return false }
    let verified = verify_typed_ir(
        ir.functions, ir.blocks, ir.instructions, ir.constants, ir.successors,
        ir.call_sites, ir.call_arguments, ir.jump_arguments, ir.value_count
    )
    return verified.ok and verified.checked_values == 5 and
        ir.blocks[0].instruction_start == 0 and ir.blocks[0].instruction_count == 4 and
        ir.instructions[3].op == IR_BRANCH and
        ir.blocks[1].instruction_start == 4 and ir.blocks[1].instruction_count == 1 and
        ir.instructions[4].op == IR_JUMP and ir.instructions[4].left == 0 and
        ir.blocks[2].instruction_start == 5 and ir.blocks[2].instruction_count == 2 and
        ir.instructions[5].op == IR_CONST and ir.instructions[6].op == IR_JUMP and
        ir.instructions[6].left == ir.instructions[5].result and
        ir.blocks[3].instruction_start == 7 and ir.blocks[3].instruction_count == 2 and
        ir.instructions[7].op == IR_BLOCK_PARAM and ir.instructions[8].op == IR_RETURN and
        ir.instructions[8].left == ir.instructions[7].result
}

fn typed_ir_dominance_verifier_smoke_test() -> bool {
    let mut functions: []IrFunction = []
    let mut blocks: []IrBlock = []
    let mut instructions: []IrInstruction = []
    let mut successors: []int = []
    functions = append(functions, IrFunction {
        item: 0, entry_block: 0, block_count: 3,
        parameter_count: 1, value_start: 0, value_count: 2,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_PARAM, result: 0, type_kind: SEM_BOOL,
        left: -1, right: -1, aux: 0, token: 0,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_BRANCH, result: -1, type_kind: SEM_BOOL,
        left: 0, right: -1, aux: -1, token: 0,
    })
    successors = append(successors, 1)
    successors = append(successors, 2)
    blocks = append(blocks, IrBlock {
        function: 0, instruction_start: 0, instruction_count: 2,
        terminator: 1, successor_start: 0, successor_count: 2,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_UNARY, result: 1, type_kind: SEM_BOOL,
        left: 0, right: -1, aux: TK_NOT, token: 0,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_JUMP, result: -1, type_kind: SEM_UNKNOWN,
        left: -1, right: -1, aux: -1, token: 0,
    })
    successors = append(successors, 2)
    blocks = append(blocks, IrBlock {
        function: 0, instruction_start: 2, instruction_count: 2,
        terminator: 3, successor_start: 2, successor_count: 1,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_RETURN, result: -1, type_kind: SEM_BOOL,
        left: 1, right: -1, aux: -1, token: 0,
    })
    blocks = append(blocks, IrBlock {
        function: 0, instruction_start: 4, instruction_count: 1,
        terminator: 4, successor_start: 3, successor_count: 0,
    })
    let verified = verify_typed_ir(
        functions, blocks, instructions, make([]IrConstant, 0, 0), successors,
        make([]IrCallSite, 0, 0), make([]int, 0, 0), make([]int, 0, 0), 2
    )
    return not verified.ok and verified.error == "IR left value does not dominate its use"
}

fn typed_ir_loop_smoke_test() -> bool {
    let source = "fn compute(value: int) -> int {\nlet mut total = 0\nwhile total < value * 5 {\ntotal = total + 7\n}\nreturn total + 1\n}"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let parsed = parse_frontend(source, lexed.tokens)
    if not parsed.ok { return false }
    let ir = lower_typed_ir(
        source, lexed.tokens, parsed.items, parsed.signatures, parsed.statements,
        parsed.statement_edges, parsed.expressions, parsed.expression_types, parsed.locals,
        parsed.local_types, parsed.expression_locals, parsed.symbols, parsed.expression_symbols
    )
    if not ir.ok or len(ir.functions) != 1 or len(ir.blocks) != 4 or
        len(ir.instructions) != 14 or len(ir.constants) != 4 or ir.value_count != 10 { return false }
    let verified = verify_typed_ir(
        ir.functions, ir.blocks, ir.instructions, ir.constants, ir.successors,
        ir.call_sites, ir.call_arguments, ir.jump_arguments, ir.value_count
    )
    if not verified.ok or verified.checked_values != 10 { return false }
    return ir.blocks[0].instruction_start == 0 and ir.blocks[0].instruction_count == 3 and
        ir.instructions[0].op == IR_PARAM and ir.instructions[1].op == IR_CONST and
        ir.instructions[2].op == IR_JUMP and ir.instructions[2].left == 1 and
        ir.instructions[2].type_kind == SEM_INT and
        ir.blocks[1].instruction_start == 3 and ir.blocks[1].instruction_count == 5 and
        ir.instructions[3].op == IR_BLOCK_PARAM and ir.instructions[3].result == 2 and
        ir.instructions[3].type_kind == SEM_INT and
        ir.instructions[6].op == IR_BINARY and ir.instructions[6].type_kind == SEM_BOOL and
        ir.instructions[6].left == 2 and
        ir.instructions[7].op == IR_BRANCH and ir.instructions[7].left == ir.instructions[6].result and
        ir.blocks[2].instruction_start == 8 and ir.blocks[2].instruction_count == 3 and
        ir.instructions[9].op == IR_BINARY and ir.instructions[9].left == 2 and
        ir.instructions[10].op == IR_JUMP and ir.instructions[10].left == ir.instructions[9].result and
        ir.blocks[3].instruction_start == 11 and ir.blocks[3].instruction_count == 3 and
        ir.instructions[12].op == IR_BINARY and ir.instructions[12].left == 2 and
        ir.instructions[13].op == IR_RETURN and ir.instructions[13].left == ir.instructions[12].result and
        len(ir.successors) == 4 and
        ir.successors[0] == 1 and ir.successors[1] == 2 and ir.successors[2] == 3 and ir.successors[3] == 1
}

fn typed_ir_loop_skip_smoke_test() -> bool {
    let source = "fn compute(value: int) -> int {\nlet mut total = 0\nwhile total < value {\nif total > 2 {\ntotal = total + 1\n}\n}\nreturn total\n}"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let parsed = parse_frontend(source, lexed.tokens)
    if not parsed.ok { return false }
    let ir = lower_typed_ir(
        source, lexed.tokens, parsed.items, parsed.signatures, parsed.statements,
        parsed.statement_edges, parsed.expressions, parsed.expression_types, parsed.locals,
        parsed.local_types, parsed.expression_locals, parsed.symbols, parsed.expression_symbols
    )
    return ir.ok and ir.skipped_functions == 1 and len(ir.functions) == 0
}

// Two carried locals: the header leads with two block parameters and both
// jumps carry their arguments through the jump_arguments arena.
fn typed_ir_loop_multi_smoke_test() -> bool {
    let source = "fn compute(value: int) -> int {\nlet mut total = 0\nlet mut i = 1\nwhile i <= value + 2 {\ntotal = total + i * 2\ni = i + 1\n}\nreturn total\n}"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let parsed = parse_frontend(source, lexed.tokens)
    if not parsed.ok { return false }
    let ir = lower_typed_ir(
        source, lexed.tokens, parsed.items, parsed.signatures, parsed.statements,
        parsed.statement_edges, parsed.expressions, parsed.expression_types, parsed.locals,
        parsed.local_types, parsed.expression_locals, parsed.symbols, parsed.expression_symbols
    )
    if not ir.ok or len(ir.functions) != 1 or len(ir.blocks) != 4 or
        len(ir.jump_arguments) != 4 { return false }
    let verified = verify_typed_ir(
        ir.functions, ir.blocks, ir.instructions, ir.constants, ir.successors,
        ir.call_sites, ir.call_arguments, ir.jump_arguments, ir.value_count
    )
    if not verified.ok { return false }
    let entry = ir.blocks[0]
    let header = ir.blocks[1]
    let body = ir.blocks[2]
    let entry_jump = ir.instructions[entry.terminator]
    let body_jump = ir.instructions[body.terminator]
    return ir.instructions[header.instruction_start].op == IR_BLOCK_PARAM and
        ir.instructions[header.instruction_start + 1].op == IR_BLOCK_PARAM and
        ir.instructions[header.instruction_start + 2].op != IR_BLOCK_PARAM and
        entry_jump.op == IR_JUMP and entry_jump.left < 0 and entry_jump.aux == 0 and
        body_jump.op == IR_JUMP and body_jump.left < 0 and body_jump.aux == 2 and
        ir.successors[body.successor_start] == 1
}

// A body right-hand side that reads a carried local assigned by an earlier
// body statement is rejected: the expression arena is not in source order, so
// only header-parameter reads are allowed.
// `a = b` then `b = a + 1` reads the *new* `a` in the same iteration, so the
// backedge hands the header (b, a') — a permutation of its own parameters. The
// matched loop shapes refuse this, and so does the general path: breaking the
// cycle needs a scratch copy, and `IR_MOVE` is reserved for owned values. It
// must stay skipped rather than emit the two writes in an order that loses one.
fn typed_ir_loop_cross_read_skip_smoke_test() -> bool {
    let source = "fn compute(value: int) -> int {\nlet mut a = 3\nlet mut b = 5\nwhile a < b {\na = b\nb = a + 1\n}\nreturn a\n}"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let parsed = parse_frontend(source, lexed.tokens)
    if not parsed.ok { return false }
    let ir = lower_typed_ir(
        source, lexed.tokens, parsed.items, parsed.signatures, parsed.statements,
        parsed.statement_edges, parsed.expressions, parsed.expression_types, parsed.locals,
        parsed.local_types, parsed.expression_locals, parsed.symbols, parsed.expression_symbols
    )
    return ir.ok and ir.skipped_functions == 1 and len(ir.functions) == 0
}

// A break guard produces the eight-block shape: the exit block carries its
// own parameters so a break after pre-guard updates returns current values.
fn typed_ir_loop_break_smoke_test() -> bool {
    let source = "fn compute(value: int) -> int {\nlet mut total = 0\nlet mut i = 0\nwhile i < value * 6 {\ntotal = total + 2\nif i > 5 {\nbreak\n}\ni = i + 3\n}\nreturn total\n}"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let parsed = parse_frontend(source, lexed.tokens)
    if not parsed.ok { return false }
    let ir = lower_typed_ir(
        source, lexed.tokens, parsed.items, parsed.signatures, parsed.statements,
        parsed.statement_edges, parsed.expressions, parsed.expression_types, parsed.locals,
        parsed.local_types, parsed.expression_locals, parsed.symbols, parsed.expression_symbols
    )
    if not ir.ok or len(ir.functions) != 1 or len(ir.blocks) != 8 { return false }
    let verified = verify_typed_ir(
        ir.functions, ir.blocks, ir.instructions, ir.constants, ir.successors,
        ir.call_sites, ir.call_arguments, ir.jump_arguments, ir.value_count
    )
    if not verified.ok { return false }
    let header = ir.blocks[1]
    let guard = ir.blocks[3]
    let post = ir.blocks[4]
    let arm = ir.blocks[5]
    let trampoline = ir.blocks[6]
    let exit = ir.blocks[7]
    if ir.instructions[header.terminator].op != IR_BRANCH or
        ir.instructions[guard.terminator].op != IR_BRANCH or
        ir.instructions[post.terminator].op != IR_JUMP or
        ir.instructions[arm.terminator].op != IR_JUMP or
        ir.instructions[trampoline.terminator].op != IR_JUMP or
        ir.instructions[exit.terminator].op != IR_RETURN {
        return false
    }
    if ir.successors[guard.successor_start] != 5 or ir.successors[guard.successor_start + 1] != 4 or
        ir.successors[post.successor_start] != 1 or ir.successors[arm.successor_start] != 7 or
        ir.successors[trampoline.successor_start] != 7 {
        return false
    }
    return ir.instructions[exit.instruction_start].op == IR_BLOCK_PARAM and
        ir.instructions[exit.instruction_start + 1].op == IR_BLOCK_PARAM
}

// A continue guard produces the seven-block shape: the arm jumps back to the
// header and the exit has no parameters of its own.
fn typed_ir_loop_continue_smoke_test() -> bool {
    let source = "fn compute(value: int) -> int {\nlet mut total = 0\nlet mut i = 0\nwhile i < value * 3 {\ni = i + 2\nif total > 4 {\ncontinue\n}\ntotal = total + 3\n}\nreturn total\n}"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let parsed = parse_frontend(source, lexed.tokens)
    if not parsed.ok { return false }
    let ir = lower_typed_ir(
        source, lexed.tokens, parsed.items, parsed.signatures, parsed.statements,
        parsed.statement_edges, parsed.expressions, parsed.expression_types, parsed.locals,
        parsed.local_types, parsed.expression_locals, parsed.symbols, parsed.expression_symbols
    )
    if not ir.ok or len(ir.functions) != 1 or len(ir.blocks) != 7 { return false }
    let verified = verify_typed_ir(
        ir.functions, ir.blocks, ir.instructions, ir.constants, ir.successors,
        ir.call_sites, ir.call_arguments, ir.jump_arguments, ir.value_count
    )
    if not verified.ok { return false }
    let arm = ir.blocks[5]
    let exit = ir.blocks[6]
    return ir.successors[arm.successor_start] == 1 and
        ir.instructions[exit.instruction_start].op != IR_BLOCK_PARAM
}

// Integer-returning calls may appear in the while condition and in assignment
// bodies; guard conditions stay call-free.
fn typed_ir_loop_call_smoke_test() -> bool {
    let source = "fn double(v: int) -> int {\nreturn v * 2\n}\nfn bound(v: int) -> int {\nreturn v * 5\n}\nfn compute(value: int) -> int {\nlet mut total = 0\nlet mut i = 1\nwhile i < bound(value) {\ntotal = total + double(i)\ni = i + 1\n}\nreturn total\n}"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let parsed = parse_frontend(source, lexed.tokens)
    if not parsed.ok { return false }
    let ir = lower_typed_ir(
        source, lexed.tokens, parsed.items, parsed.signatures, parsed.statements,
        parsed.statement_edges, parsed.expressions, parsed.expression_types, parsed.locals,
        parsed.local_types, parsed.expression_locals, parsed.symbols, parsed.expression_symbols
    )
    if not ir.ok or len(ir.functions) != 3 or len(ir.call_sites) != 2 or
        len(ir.call_arguments) != 2 { return false }
    let verified = verify_typed_ir(
        ir.functions, ir.blocks, ir.instructions, ir.constants, ir.successors,
        ir.call_sites, ir.call_arguments, ir.jump_arguments, ir.value_count
    )
    return verified.ok
}

// A nested if/else of assignments in the loop body produces the eight-block
// merge-if shape with one merge block parameter per arm-assigned local.
fn typed_ir_loop_merge_if_smoke_test() -> bool {
    let source = "fn compute(value: int) -> int {\nlet mut total = 0\nlet mut i = 0\nwhile i < value * 4 {\nif i > 1 {\ntotal = total + i\n} else {\ntotal = total + 10\n}\ni = i + 1\n}\nreturn total\n}"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let parsed = parse_frontend(source, lexed.tokens)
    if not parsed.ok { return false }
    let ir = lower_typed_ir(
        source, lexed.tokens, parsed.items, parsed.signatures, parsed.statements,
        parsed.statement_edges, parsed.expressions, parsed.expression_types, parsed.locals,
        parsed.local_types, parsed.expression_locals, parsed.symbols, parsed.expression_symbols
    )
    if not ir.ok or len(ir.functions) != 1 or len(ir.blocks) != 8 { return false }
    let verified = verify_typed_ir(
        ir.functions, ir.blocks, ir.instructions, ir.constants, ir.successors,
        ir.call_sites, ir.call_arguments, ir.jump_arguments, ir.value_count
    )
    if not verified.ok { return false }
    let header = ir.blocks[1]
    let cond = ir.blocks[3]
    let then_block = ir.blocks[4]
    let else_block = ir.blocks[5]
    let merge = ir.blocks[6]
    if ir.instructions[header.terminator].op != IR_BRANCH or
        ir.instructions[cond.terminator].op != IR_BRANCH or
        ir.instructions[then_block.terminator].op != IR_JUMP or
        ir.instructions[else_block.terminator].op != IR_JUMP or
        ir.instructions[merge.terminator].op != IR_JUMP {
        return false
    }
    if ir.successors[cond.successor_start] != 4 or ir.successors[cond.successor_start + 1] != 5 or
        ir.successors[then_block.successor_start] != 6 or ir.successors[else_block.successor_start] != 6 or
        ir.successors[merge.successor_start] != 1 {
        return false
    }
    return ir.instructions[merge.instruction_start].op == IR_BLOCK_PARAM and
        ir.instructions[merge.instruction_start + 1].op != IR_BLOCK_PARAM
}

// Two sequential plain loops chain through a junction: seven blocks, one
// header per loop, the junction carrying the first loop's final parameter.
fn typed_ir_loop_sequential_smoke_test() -> bool {
    let source = "fn compute(value: int) -> int {\nlet mut i = 0\nwhile i < value * 2 {\ni = i + 3\n}\nwhile i < value * 5 {\ni = i + 2\n}\nreturn i\n}"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let parsed = parse_frontend(source, lexed.tokens)
    if not parsed.ok { return false }
    let ir = lower_typed_ir(
        source, lexed.tokens, parsed.items, parsed.signatures, parsed.statements,
        parsed.statement_edges, parsed.expressions, parsed.expression_types, parsed.locals,
        parsed.local_types, parsed.expression_locals, parsed.symbols, parsed.expression_symbols
    )
    if not ir.ok or len(ir.functions) != 1 or len(ir.blocks) != 7 { return false }
    let verified = verify_typed_ir(
        ir.functions, ir.blocks, ir.instructions, ir.constants, ir.successors,
        ir.call_sites, ir.call_arguments, ir.jump_arguments, ir.value_count
    )
    if not verified.ok { return false }
    let header1 = ir.blocks[1]
    let body1 = ir.blocks[2]
    let junction = ir.blocks[3]
    let header2 = ir.blocks[4]
    let body2 = ir.blocks[5]
    let exit = ir.blocks[6]
    if ir.instructions[header1.terminator].op != IR_BRANCH or
        ir.instructions[body1.terminator].op != IR_JUMP or
        ir.instructions[junction.terminator].op != IR_JUMP or
        ir.instructions[header2.terminator].op != IR_BRANCH or
        ir.instructions[body2.terminator].op != IR_JUMP or
        ir.instructions[exit.terminator].op != IR_RETURN {
        return false
    }
    if ir.successors[header1.successor_start] != 2 or ir.successors[header1.successor_start + 1] != 3 or
        ir.successors[body1.successor_start] != 1 or ir.successors[junction.successor_start] != 4 or
        ir.successors[header2.successor_start] != 5 or ir.successors[header2.successor_start + 1] != 6 or
        ir.successors[body2.successor_start] != 4 {
        return false
    }
    return ir.instructions[header1.instruction_start].op == IR_BLOCK_PARAM and
        ir.instructions[header2.instruction_start].op == IR_BLOCK_PARAM
}

// A plain loop chained into a break-guarded loop: ten blocks, the guarded
// group keeping its own exit parameters.
fn typed_ir_loop_guarded_chain_smoke_test() -> bool {
    let source = "fn compute(value: int) -> int {\nlet mut total = 0\nlet mut i = 0\nwhile i < value * 2 {\ntotal = total + i\ni = i + 1\n}\nwhile i < value * 8 {\ni = i + 2\nif total > 10 {\nbreak\n}\ntotal = total + 3\n}\nreturn total + i\n}"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let parsed = parse_frontend(source, lexed.tokens)
    if not parsed.ok { return false }
    let ir = lower_typed_ir(
        source, lexed.tokens, parsed.items, parsed.signatures, parsed.statements,
        parsed.statement_edges, parsed.expressions, parsed.expression_types, parsed.locals,
        parsed.local_types, parsed.expression_locals, parsed.symbols, parsed.expression_symbols
    )
    if not ir.ok or len(ir.functions) != 1 or len(ir.blocks) != 11 { return false }
    let verified = verify_typed_ir(
        ir.functions, ir.blocks, ir.instructions, ir.constants, ir.successors,
        ir.call_sites, ir.call_arguments, ir.jump_arguments, ir.value_count
    )
    if not verified.ok { return false }
    let header1 = ir.blocks[1]
    let junction = ir.blocks[3]
    let header2 = ir.blocks[4]
    let guard = ir.blocks[6]
    let post = ir.blocks[7]
    let arm = ir.blocks[8]
    let trampoline = ir.blocks[9]
    let exit = ir.blocks[10]
    if ir.instructions[header1.terminator].op != IR_BRANCH or
        ir.instructions[junction.terminator].op != IR_JUMP or
        ir.instructions[header2.terminator].op != IR_BRANCH or
        ir.instructions[guard.terminator].op != IR_BRANCH or
        ir.instructions[post.terminator].op != IR_JUMP or
        ir.instructions[arm.terminator].op != IR_JUMP or
        ir.instructions[trampoline.terminator].op != IR_JUMP or
        ir.instructions[exit.terminator].op != IR_RETURN {
        return false
    }
    if ir.successors[junction.successor_start] != 4 or
        ir.successors[guard.successor_start] != 8 or ir.successors[guard.successor_start + 1] != 7 or
        ir.successors[post.successor_start] != 4 or ir.successors[arm.successor_start] != 10 or
        ir.successors[trampoline.successor_start] != 10 {
        return false
    }
    return ir.instructions[header1.instruction_start].op == IR_BLOCK_PARAM and
        ir.instructions[header2.instruction_start].op == IR_BLOCK_PARAM and
        ir.instructions[exit.instruction_start].op == IR_BLOCK_PARAM
}

// A merge-if leading a loop: the if entry branches, the arms jump with
// arguments into the merge block, and the merge block doubles as the loop's
// entry (leading parameter plus the initializer jump).
fn typed_ir_pre_if_loop_smoke_test() -> bool {
    let source = "fn compute(value: int) -> int {\nlet mut total = 0\nif value > 1 {\ntotal = 5\n} else {\ntotal = 10\n}\nlet mut i = 0\nwhile i < value * 3 {\ntotal = total + i\ni = i + 1\n}\nreturn total\n}"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let parsed = parse_frontend(source, lexed.tokens)
    if not parsed.ok { return false }
    let ir = lower_typed_ir(
        source, lexed.tokens, parsed.items, parsed.signatures, parsed.statements,
        parsed.statement_edges, parsed.expressions, parsed.expression_types, parsed.locals,
        parsed.local_types, parsed.expression_locals, parsed.symbols, parsed.expression_symbols
    )
    if not ir.ok or len(ir.functions) != 1 or len(ir.blocks) != 7 { return false }
    let verified = verify_typed_ir(
        ir.functions, ir.blocks, ir.instructions, ir.constants, ir.successors,
        ir.call_sites, ir.call_arguments, ir.jump_arguments, ir.value_count
    )
    if not verified.ok { return false }
    let entry = ir.blocks[0]
    let then_block = ir.blocks[1]
    let else_block = ir.blocks[2]
    let merge = ir.blocks[3]
    let header = ir.blocks[4]
    let body = ir.blocks[5]
    let exit = ir.blocks[6]
    if ir.instructions[entry.terminator].op != IR_BRANCH or
        ir.instructions[then_block.terminator].op != IR_JUMP or
        ir.instructions[else_block.terminator].op != IR_JUMP or
        ir.instructions[merge.terminator].op != IR_JUMP or
        ir.instructions[header.terminator].op != IR_BRANCH or
        ir.instructions[body.terminator].op != IR_JUMP or
        ir.instructions[exit.terminator].op != IR_RETURN {
        return false
    }
    if ir.successors[entry.successor_start] != 1 or ir.successors[entry.successor_start + 1] != 2 or
        ir.successors[then_block.successor_start] != 3 or ir.successors[else_block.successor_start] != 3 or
        ir.successors[merge.successor_start] != 4 or
        ir.successors[header.successor_start] != 5 or ir.successors[header.successor_start + 1] != 6 or
        ir.successors[body.successor_start] != 4 {
        return false
    }
    return ir.instructions[merge.instruction_start].op == IR_BLOCK_PARAM and
        ir.instructions[header.instruction_start].op == IR_BLOCK_PARAM
}

fn typed_ir_statement_merge_ownership_smoke_test() -> bool {
    let source = "fn make_label() -> string {\nreturn \"mako\"\n}\nfn choose_side_effect(flag: bool) -> int {\nif flag {\nlet label = make_label()\n} else {\nlet label = make_label()\n}\nreturn 1\n}"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let parsed = parse_frontend(source, lexed.tokens)
    if not parsed.ok { return false }
    let ir = lower_typed_ir(
        source, lexed.tokens, parsed.items, parsed.signatures, parsed.statements,
        parsed.statement_edges, parsed.expressions, parsed.expression_types, parsed.locals,
        parsed.local_types, parsed.expression_locals, parsed.symbols, parsed.expression_symbols
    )
    if not ir.ok or len(ir.functions) != 2 or len(ir.blocks) != 5 or
        len(ir.instructions) != 13 or ir.value_count != 6 or
        len(ir.call_sites) != 2 or len(ir.call_arguments) != 0 or
        ir.instructions[6].op != IR_CALL or ir.instructions[7].op != IR_DROP or
        ir.instructions[7].left != ir.instructions[6].result or
        ir.instructions[8].op != IR_JUMP or ir.instructions[9].op != IR_CALL or
        ir.instructions[10].op != IR_DROP or
        ir.instructions[10].left != ir.instructions[9].result or
        ir.instructions[11].op != IR_JUMP or ir.instructions[12].op != IR_RETURN {
        return false
    }
    let verified = verify_typed_ir(
        ir.functions, ir.blocks, ir.instructions, ir.constants, ir.successors,
        ir.call_sites, ir.call_arguments, ir.jump_arguments, ir.value_count
    )
    return verified.ok and verified.checked_values == 6
}

fn typed_ir_local_transfer_smoke_test() -> bool {
    let clone_source = "fn keep_original() -> string {\nlet first = \"mako\"\nlet second = first\nreturn first\n}"
    let clone_lexed = lex_source(clone_source)
    if not clone_lexed.ok { return false }
    let clone = parse_frontend(clone_source, clone_lexed.tokens)
    if not clone.ok { return false }
    let clone_ir = lower_typed_ir(
        clone_source, clone_lexed.tokens, clone.items, clone.signatures, clone.statements,
        clone.statement_edges, clone.expressions, clone.expression_types, clone.locals,
        clone.local_types, clone.expression_locals, clone.symbols, clone.expression_symbols
    )
    if not clone_ir.ok or len(clone_ir.instructions) != 5 or clone_ir.value_count != 3 or
        clone_ir.instructions[0].op != IR_CONST or clone_ir.instructions[1].op != IR_CLONE or
        clone_ir.instructions[1].left != clone_ir.instructions[0].result or
        clone_ir.instructions[2].op != IR_MOVE or
        clone_ir.instructions[2].left != clone_ir.instructions[0].result or
        clone_ir.instructions[3].op != IR_DROP or
        clone_ir.instructions[3].left != clone_ir.instructions[1].result or
        clone_ir.instructions[4].op != IR_RETURN or
        clone_ir.instructions[4].left != clone_ir.instructions[2].result { return false }
    let clone_verified = verify_typed_ir(
        clone_ir.functions, clone_ir.blocks, clone_ir.instructions, clone_ir.constants,
        clone_ir.successors, clone_ir.call_sites, clone_ir.call_arguments, clone_ir.jump_arguments, clone_ir.value_count
    )
    if not clone_verified.ok or clone_verified.checked_values != 3 { return false }

    let move_source = "fn transfer_local() -> string {\nhold let first = \"mako\"\nlet second = first\nreturn second\n}"
    let move_lexed = lex_source(move_source)
    if not move_lexed.ok { return false }
    let moved = parse_frontend(move_source, move_lexed.tokens)
    if not moved.ok { return false }
    let move_ir = lower_typed_ir(
        move_source, move_lexed.tokens, moved.items, moved.signatures, moved.statements,
        moved.statement_edges, moved.expressions, moved.expression_types, moved.locals,
        moved.local_types, moved.expression_locals, moved.symbols, moved.expression_symbols
    )
    if not move_ir.ok or len(move_ir.instructions) != 4 or move_ir.value_count != 3 or
        move_ir.instructions[1].op != IR_MOVE or move_ir.instructions[2].op != IR_MOVE or
        move_ir.instructions[2].left != move_ir.instructions[1].result or
        move_ir.instructions[3].op != IR_RETURN or
        move_ir.instructions[3].left != move_ir.instructions[2].result { return false }
    let move_verified = verify_typed_ir(
        move_ir.functions, move_ir.blocks, move_ir.instructions, move_ir.constants,
        move_ir.successors, move_ir.call_sites, move_ir.call_arguments, move_ir.jump_arguments, move_ir.value_count
    )
    if not move_verified.ok or move_verified.checked_values != 3 { return false }

    let invalid_source = "fn reuse_moved_local() -> string {\nhold let first = \"mako\"\nlet second = first\nreturn first\n}"
    let invalid_lexed = lex_source(invalid_source)
    if not invalid_lexed.ok { return false }
    let invalid = parse_frontend(invalid_source, invalid_lexed.tokens)
    if not invalid.ok { return false }
    let invalid_ir = lower_typed_ir(
        invalid_source, invalid_lexed.tokens, invalid.items, invalid.signatures,
        invalid.statements, invalid.statement_edges, invalid.expressions,
        invalid.expression_types, invalid.locals, invalid.local_types,
        invalid.expression_locals, invalid.symbols, invalid.expression_symbols
    )
    if not invalid_ir.ok { return false }
    let invalid_verified = verify_typed_ir(
        invalid_ir.functions, invalid_ir.blocks, invalid_ir.instructions, invalid_ir.constants,
        invalid_ir.successors, invalid_ir.call_sites, invalid_ir.call_arguments,
        invalid_ir.jump_arguments, invalid_ir.value_count
    )
    return not invalid_verified.ok and
        invalid_verified.error == "IR instruction uses consumed owned value"
}

fn typed_ir_ownership_smoke_test() -> bool {
    // Array seeds are typed (empty `[]int` plus each append link), so a three
    // element literal is: empty + three consts + three links + drop/return.
    let discard_source = "fn discard_values() -> int {\nlet values = [1, 2, 3]\nreturn 7\n}"
    let discard_lexed = lex_source(discard_source)
    if not discard_lexed.ok { return false }
    let discard = parse_frontend(discard_source, discard_lexed.tokens)
    if not discard.ok { return false }
    let drop_ir = lower_typed_ir(
        discard_source, discard_lexed.tokens, discard.items, discard.signatures, discard.statements,
        discard.statement_edges, discard.expressions, discard.expression_types, discard.locals,
        discard.local_types, discard.expression_locals, discard.symbols, discard.expression_symbols
    )
    if not drop_ir.ok or len(drop_ir.instructions) != 10 or
        drop_ir.instructions[0].op != IR_ARRAY or drop_ir.instructions[0].left >= 0 or
        drop_ir.instructions[0].right >= 0 or
        drop_ir.instructions[8].op != IR_DROP or drop_ir.instructions[9].op != IR_RETURN { return false }
    let drop_verified = verify_typed_ir(
        drop_ir.functions, drop_ir.blocks, drop_ir.instructions, drop_ir.constants,
        drop_ir.successors, drop_ir.call_sites, drop_ir.call_arguments, drop_ir.jump_arguments, drop_ir.value_count
    )
    if not drop_verified.ok { return false }

    let move_source = "fn build_values() -> []int {\nlet values = [1, 2, 3]\nreturn values\n}"
    let move_lexed = lex_source(move_source)
    if not move_lexed.ok { return false }
    let moved = parse_frontend(move_source, move_lexed.tokens)
    if not moved.ok { return false }
    let move_ir = lower_typed_ir(
        move_source, move_lexed.tokens, moved.items, moved.signatures, moved.statements,
        moved.statement_edges, moved.expressions, moved.expression_types, moved.locals,
        moved.local_types, moved.expression_locals, moved.symbols, moved.expression_symbols
    )
    // empty + 3 consts + 3 links + move + return; values are the seven SSA
    // results of those array ops and the move (consts share the pool).
    if not move_ir.ok or len(move_ir.instructions) != 9 or move_ir.value_count != 8 or
        move_ir.instructions[7].op != IR_MOVE or move_ir.instructions[8].op != IR_RETURN or
        move_ir.instructions[8].left != move_ir.instructions[7].result { return false }
    let move_verified = verify_typed_ir(
        move_ir.functions, move_ir.blocks, move_ir.instructions, move_ir.constants,
        move_ir.successors, move_ir.call_sites, move_ir.call_arguments, move_ir.jump_arguments, move_ir.value_count
    )
    if not move_verified.ok or move_verified.checked_values != 8 { return false }

    let cfg_source = "fn choose_values(flag: bool, left: []int, right: []int) -> []int {\nif flag {\nreturn left\n} else {\nreturn right\n}\n}"
    let cfg_lexed = lex_source(cfg_source)
    if not cfg_lexed.ok { return false }
    let cfg = parse_frontend(cfg_source, cfg_lexed.tokens)
    if not cfg.ok { return false }
    let cfg_ir = lower_typed_ir(
        cfg_source, cfg_lexed.tokens, cfg.items, cfg.signatures, cfg.statements,
        cfg.statement_edges, cfg.expressions, cfg.expression_types, cfg.locals,
        cfg.local_types, cfg.expression_locals, cfg.symbols, cfg.expression_symbols
    )
    if not cfg_ir.ok or len(cfg_ir.blocks) != 4 or len(cfg_ir.instructions) != 10 or
        cfg_ir.value_count != 4 or cfg_ir.instructions[4].op != IR_DROP or
        cfg_ir.instructions[4].left != 2 or cfg_ir.instructions[5].op != IR_JUMP or
        cfg_ir.instructions[5].left != 1 or cfg_ir.instructions[6].op != IR_DROP or
        cfg_ir.instructions[6].left != 1 or cfg_ir.instructions[7].op != IR_JUMP or
        cfg_ir.instructions[7].left != 2 or cfg_ir.instructions[8].op != IR_BLOCK_PARAM or
        cfg_ir.instructions[9].op != IR_RETURN { return false }
    let cfg_verified = verify_typed_ir(
        cfg_ir.functions, cfg_ir.blocks, cfg_ir.instructions, cfg_ir.constants,
        cfg_ir.successors, cfg_ir.call_sites, cfg_ir.call_arguments, cfg_ir.jump_arguments, cfg_ir.value_count
    )
    return cfg_verified.ok and cfg_verified.checked_values == 4
}

fn typed_ir_ownership_verifier_smoke_test() -> bool {
    let mut functions: []IrFunction = []
    let mut blocks: []IrBlock = []
    let mut instructions: []IrInstruction = []
    functions = append(functions, IrFunction {
        item: 0, entry_block: 0, block_count: 1,
        parameter_count: 1, value_start: 0, value_count: 1,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_PARAM, result: 0, type_kind: SEM_ARRAY_INT,
        left: -1, right: -1, aux: 0, token: 0,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_DROP, result: -1, type_kind: SEM_ARRAY_INT,
        left: 0, right: -1, aux: -1, token: 0,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_DROP, result: -1, type_kind: SEM_ARRAY_INT,
        left: 0, right: -1, aux: -1, token: 0,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_RETURN, result: -1, type_kind: SEM_UNKNOWN,
        left: -1, right: -1, aux: -1, token: 0,
    })
    blocks = append(blocks, IrBlock {
        function: 0, instruction_start: 0, instruction_count: 4,
        terminator: 3, successor_start: 0, successor_count: 0,
    })
    let double_drop = verify_typed_ir(
        functions, blocks, instructions, make([]IrConstant, 0, 0), make([]int, 0, 0),
        make([]IrCallSite, 0, 0), make([]int, 0, 0), make([]int, 0, 0), 1
    )
    if double_drop.ok or double_drop.error != "IR owned value is dropped twice" { return false }

    functions = make([]IrFunction, 0, 0)
    blocks = make([]IrBlock, 0, 0)
    instructions = make([]IrInstruction, 0, 0)
    functions = append(functions, IrFunction {
        item: 0, entry_block: 0, block_count: 1,
        parameter_count: 1, value_start: 0, value_count: 3,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_PARAM, result: 0, type_kind: SEM_ARRAY_INT,
        left: -1, right: -1, aux: 0, token: 0,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_MOVE, result: 1, type_kind: SEM_ARRAY_INT,
        left: 0, right: -1, aux: -1, token: 0,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_MOVE, result: 2, type_kind: SEM_ARRAY_INT,
        left: 0, right: -1, aux: -1, token: 0,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_RETURN, result: -1, type_kind: SEM_ARRAY_INT,
        left: 2, right: -1, aux: -1, token: 0,
    })
    blocks = append(blocks, IrBlock {
        function: 0, instruction_start: 0, instruction_count: 4,
        terminator: 3, successor_start: 0, successor_count: 0,
    })
    let use_after_move = verify_typed_ir(
        functions, blocks, instructions, make([]IrConstant, 0, 0), make([]int, 0, 0),
        make([]IrCallSite, 0, 0), make([]int, 0, 0), make([]int, 0, 0), 3
    )
    return not use_after_move.ok and use_after_move.error == "IR instruction uses consumed owned value"
}

fn typed_ir_call_smoke_test() -> bool {
    let source = "fn identity(value: int) -> int {\nreturn value\n}\nfn use_identity() -> int {\nreturn identity(1)\n}"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let parsed = parse_frontend(source, lexed.tokens)
    if not parsed.ok { return false }
    let ir = lower_typed_ir(
        source, lexed.tokens, parsed.items, parsed.signatures, parsed.statements,
        parsed.statement_edges, parsed.expressions, parsed.expression_types, parsed.locals,
        parsed.local_types, parsed.expression_locals, parsed.symbols, parsed.expression_symbols
    )
    if not ir.ok or len(ir.functions) != 2 or len(ir.blocks) != 2 or
        len(ir.instructions) != 5 or ir.value_count != 3 { return false }
    let verified = verify_typed_ir(
        ir.functions, ir.blocks, ir.instructions, ir.constants, ir.successors,
        ir.call_sites, ir.call_arguments, ir.jump_arguments, ir.value_count
    )
    if not verified.ok or verified.checked_values != 3 { return false }
    if ir.instructions[2].op != IR_CONST or ir.instructions[3].op != IR_CALL or
        ir.instructions[3].left >= 0 or ir.instructions[3].right >= 0 or
        ir.instructions[3].aux != 0 or len(ir.call_sites) != 1 or len(ir.call_arguments) != 1 or
        ir.call_sites[0].callee_item != 0 or ir.call_sites[0].argument_start != 0 or
        ir.call_sites[0].argument_count != 1 or
        ir.call_arguments[0] != ir.instructions[2].result { return false }

    let owned_source = "fn make_label() -> string {\nreturn \"mako\"\n}\nfn use_label() -> string {\nreturn make_label()\n}"
    let owned_lexed = lex_source(owned_source)
    if not owned_lexed.ok { return false }
    let owned = parse_frontend(owned_source, owned_lexed.tokens)
    if not owned.ok { return false }
    let owned_ir = lower_typed_ir(
        owned_source, owned_lexed.tokens, owned.items, owned.signatures, owned.statements,
        owned.statement_edges, owned.expressions, owned.expression_types, owned.locals,
        owned.local_types, owned.expression_locals, owned.symbols, owned.expression_symbols
    )
    if not owned_ir.ok or len(owned_ir.instructions) != 6 or owned_ir.value_count != 4 or
        owned_ir.instructions[3].op != IR_CALL or owned_ir.instructions[3].left >= 0 or
        owned_ir.instructions[3].aux != 0 or len(owned_ir.call_sites) != 1 or
        owned_ir.call_sites[0].callee_item != 0 or owned_ir.call_sites[0].argument_count != 0 or
        len(owned_ir.call_arguments) != 0 or owned_ir.instructions[4].op != IR_MOVE or
        owned_ir.instructions[4].left != owned_ir.instructions[3].result or
        owned_ir.instructions[5].op != IR_RETURN or
        owned_ir.instructions[5].left != owned_ir.instructions[4].result { return false }
    let owned_verified = verify_typed_ir(
        owned_ir.functions, owned_ir.blocks, owned_ir.instructions, owned_ir.constants,
        owned_ir.successors, owned_ir.call_sites, owned_ir.call_arguments, owned_ir.jump_arguments, owned_ir.value_count
    )
    if not owned_verified.ok or owned_verified.checked_values != 4 { return false }

    let multi_source = "fn join_values(prefix: string, suffix: string) -> string {\nreturn prefix + suffix\n}\nfn use_join() -> string {\nreturn join_values(\"mako\", \"lang\")\n}"
    let multi_lexed = lex_source(multi_source)
    if not multi_lexed.ok { return false }
    let multi = parse_frontend(multi_source, multi_lexed.tokens)
    if not multi.ok { return false }
    let multi_ir = lower_typed_ir(
        multi_source, multi_lexed.tokens, multi.items, multi.signatures, multi.statements,
        multi.statement_edges, multi.expressions, multi.expression_types, multi.locals,
        multi.local_types, multi.expression_locals, multi.symbols, multi.expression_symbols
    )
    if not multi_ir.ok or len(multi_ir.instructions) != 12 or multi_ir.value_count != 8 or
        len(multi_ir.call_sites) != 1 or len(multi_ir.call_arguments) != 2 or
        multi_ir.call_sites[0].callee_item != 0 or multi_ir.call_sites[0].argument_start != 0 or
        multi_ir.call_sites[0].argument_count != 2 or multi_ir.call_arguments[0] != 4 or
        multi_ir.call_arguments[1] != 5 or multi_ir.instructions[9].op != IR_CALL or
        multi_ir.instructions[10].op != IR_MOVE or multi_ir.instructions[11].op != IR_RETURN { return false }
    let multi_verified = verify_typed_ir(
        multi_ir.functions, multi_ir.blocks, multi_ir.instructions, multi_ir.constants,
        multi_ir.successors, multi_ir.call_sites, multi_ir.call_arguments, multi_ir.jump_arguments, multi_ir.value_count
    )
    if not multi_verified.ok or multi_verified.checked_values != 8 { return false }

    let clone_source = "fn keep_label(label: string) -> string {\nreturn label\n}\nfn reuse_label() -> string {\nlet label = \"mako\"\nlet copy = keep_label(label)\nreturn label\n}"
    let clone_lexed = lex_source(clone_source)
    if not clone_lexed.ok { return false }
    let clone = parse_frontend(clone_source, clone_lexed.tokens)
    if not clone.ok { return false }
    let clone_ir = lower_typed_ir(
        clone_source, clone_lexed.tokens, clone.items, clone.signatures, clone.statements,
        clone.statement_edges, clone.expressions, clone.expression_types, clone.locals,
        clone.local_types, clone.expression_locals, clone.symbols, clone.expression_symbols
    )
    if not clone_ir.ok or len(clone_ir.instructions) != 9 or clone_ir.value_count != 6 or
        len(clone_ir.call_sites) != 1 or len(clone_ir.call_arguments) != 1 or
        clone_ir.instructions[3].op != IR_CONST or clone_ir.instructions[4].op != IR_CLONE or
        clone_ir.instructions[4].left != clone_ir.instructions[3].result or
        clone_ir.instructions[5].op != IR_CALL or clone_ir.instructions[5].aux != 0 or
        clone_ir.call_arguments[0] != clone_ir.instructions[4].result or
        clone_ir.instructions[6].op != IR_MOVE or
        clone_ir.instructions[6].left != clone_ir.instructions[3].result or
        clone_ir.instructions[7].op != IR_DROP or
        clone_ir.instructions[7].left != clone_ir.instructions[5].result or
        clone_ir.instructions[8].op != IR_RETURN or
        clone_ir.instructions[8].left != clone_ir.instructions[6].result { return false }
    let clone_verified = verify_typed_ir(
        clone_ir.functions, clone_ir.blocks, clone_ir.instructions, clone_ir.constants,
        clone_ir.successors, clone_ir.call_sites, clone_ir.call_arguments, clone_ir.jump_arguments, clone_ir.value_count
    )
    if not clone_verified.ok or clone_verified.checked_values != 6 { return false }

    let cfg_source = "fn choose_value(flag: bool) -> int {\nif flag {\nreturn identity(1)\n}\nreturn identity(2)\n}\nfn identity(value: int) -> int {\nreturn value\n}"
    let cfg_lexed = lex_source(cfg_source)
    if not cfg_lexed.ok { return false }
    let cfg = parse_frontend(cfg_source, cfg_lexed.tokens)
    if not cfg.ok { return false }
    let cfg_ir = lower_typed_ir(
        cfg_source, cfg_lexed.tokens, cfg.items, cfg.signatures, cfg.statements,
        cfg.statement_edges, cfg.expressions, cfg.expression_types, cfg.locals,
        cfg.local_types, cfg.expression_locals, cfg.symbols, cfg.expression_symbols
    )
    if not cfg_ir.ok or len(cfg_ir.functions) != 2 or len(cfg_ir.blocks) != 4 or
        len(cfg_ir.instructions) != 10 or cfg_ir.value_count != 6 or
        len(cfg_ir.call_sites) != 2 or len(cfg_ir.call_arguments) != 2 or
        cfg_ir.call_sites[0].callee_item != cfg.signatures[1].item or
        cfg_ir.call_sites[1].callee_item != cfg.signatures[1].item or
        cfg_ir.call_sites[0].argument_count != 1 or
        cfg_ir.call_sites[1].argument_count != 1 { return false }
    let cfg_verified = verify_typed_ir(
        cfg_ir.functions, cfg_ir.blocks, cfg_ir.instructions, cfg_ir.constants,
        cfg_ir.successors, cfg_ir.call_sites, cfg_ir.call_arguments, cfg_ir.jump_arguments, cfg_ir.value_count
    )
    if not cfg_verified.ok or cfg_verified.checked_values != 6 { return false }

    let owned_cfg_source = "fn make_label() -> string {\nreturn \"mako\"\n}\nfn choose_label(flag: bool) -> string {\nif flag {\nreturn make_label()\n}\nreturn make_label()\n}"
    let owned_cfg_lexed = lex_source(owned_cfg_source)
    if not owned_cfg_lexed.ok { return false }
    let owned_cfg = parse_frontend(owned_cfg_source, owned_cfg_lexed.tokens)
    if not owned_cfg.ok { return false }
    let owned_cfg_ir = lower_typed_ir(
        owned_cfg_source, owned_cfg_lexed.tokens, owned_cfg.items, owned_cfg.signatures,
        owned_cfg.statements, owned_cfg.statement_edges, owned_cfg.expressions,
        owned_cfg.expression_types, owned_cfg.locals, owned_cfg.local_types,
        owned_cfg.expression_locals, owned_cfg.symbols, owned_cfg.expression_symbols
    )
    if not owned_cfg_ir.ok or owned_cfg_ir.skipped_functions != 0 or
        len(owned_cfg_ir.functions) != 2 or len(owned_cfg_ir.blocks) != 4 or
        len(owned_cfg_ir.instructions) != 9 or owned_cfg_ir.value_count != 5 or
        len(owned_cfg_ir.call_sites) != 2 or len(owned_cfg_ir.call_arguments) != 0 or
        owned_cfg_ir.instructions[5].op != IR_CALL or
        owned_cfg_ir.instructions[6].op != IR_RETURN or
        owned_cfg_ir.instructions[6].left != owned_cfg_ir.instructions[5].result or
        owned_cfg_ir.instructions[7].op != IR_CALL or
        owned_cfg_ir.instructions[8].op != IR_RETURN or
        owned_cfg_ir.instructions[8].left != owned_cfg_ir.instructions[7].result { return false }
    let owned_cfg_verified = verify_typed_ir(
        owned_cfg_ir.functions, owned_cfg_ir.blocks, owned_cfg_ir.instructions,
        owned_cfg_ir.constants, owned_cfg_ir.successors, owned_cfg_ir.call_sites,
        owned_cfg_ir.call_arguments, owned_cfg_ir.jump_arguments, owned_cfg_ir.value_count
    )
    if not owned_cfg_verified.ok or owned_cfg_verified.checked_values != 5 { return false }

    let owned_argument_source = "fn inspect_label(label: string) -> int {\nreturn 1\n}\nfn choose_inspection(flag: bool, label: string) -> int {\nif flag {\nreturn inspect_label(label)\n}\nreturn 0\n}"
    let owned_argument_lexed = lex_source(owned_argument_source)
    if not owned_argument_lexed.ok { return false }
    let owned_argument = parse_frontend(owned_argument_source, owned_argument_lexed.tokens)
    if not owned_argument.ok { return false }
    let owned_argument_ir = lower_typed_ir(
        owned_argument_source, owned_argument_lexed.tokens, owned_argument.items,
        owned_argument.signatures, owned_argument.statements, owned_argument.statement_edges,
        owned_argument.expressions, owned_argument.expression_types, owned_argument.locals,
        owned_argument.local_types, owned_argument.expression_locals, owned_argument.symbols,
        owned_argument.expression_symbols
    )
    if not owned_argument_ir.ok or owned_argument_ir.skipped_functions != 0 or
        len(owned_argument_ir.functions) != 2 or len(owned_argument_ir.blocks) != 4 or
        len(owned_argument_ir.instructions) != 14 or owned_argument_ir.value_count != 7 or
        len(owned_argument_ir.call_sites) != 1 or len(owned_argument_ir.call_arguments) != 1 or
        owned_argument_ir.instructions[7].op != IR_CLONE or
        owned_argument_ir.instructions[8].op != IR_CALL or
        owned_argument_ir.call_arguments[0] != owned_argument_ir.instructions[7].result or
        owned_argument_ir.instructions[9].op != IR_DROP or
        owned_argument_ir.instructions[9].left != owned_argument_ir.instructions[5].result or
        owned_argument_ir.instructions[12].op != IR_DROP or
        owned_argument_ir.instructions[12].left != owned_argument_ir.instructions[5].result {
        return false
    }
    let owned_argument_verified = verify_typed_ir(
        owned_argument_ir.functions, owned_argument_ir.blocks, owned_argument_ir.instructions,
        owned_argument_ir.constants, owned_argument_ir.successors, owned_argument_ir.call_sites,
        owned_argument_ir.call_arguments, owned_argument_ir.jump_arguments, owned_argument_ir.value_count
    )
    if not owned_argument_verified.ok or owned_argument_verified.checked_values != 7 { return false }

    let held_argument_source = "fn inspect_held(label: string) -> int {\nreturn 1\n}\nfn choose_held(flag: bool) -> int {\nhold let label = \"mako\"\nif flag {\nreturn inspect_held(label)\n}\nreturn 0\n}"
    let held_argument_lexed = lex_source(held_argument_source)
    if not held_argument_lexed.ok { return false }
    let held_argument = parse_frontend(held_argument_source, held_argument_lexed.tokens)
    if not held_argument.ok { return false }
    let held_argument_ir = lower_typed_ir(
        held_argument_source, held_argument_lexed.tokens, held_argument.items,
        held_argument.signatures, held_argument.statements, held_argument.statement_edges,
        held_argument.expressions, held_argument.expression_types, held_argument.locals,
        held_argument.local_types, held_argument.expression_locals, held_argument.symbols,
        held_argument.expression_symbols
    )
    if not held_argument_ir.ok or held_argument_ir.skipped_functions != 0 or
        len(held_argument_ir.functions) != 2 or len(held_argument_ir.blocks) != 4 or
        len(held_argument_ir.instructions) != 12 or held_argument_ir.value_count != 6 or
        len(held_argument_ir.call_sites) != 1 or len(held_argument_ir.call_arguments) != 1 or
        held_argument_ir.instructions[7].op != IR_CALL or
        held_argument_ir.call_arguments[0] != held_argument_ir.instructions[5].result or
        held_argument_ir.instructions[8].op != IR_RETURN or
        held_argument_ir.instructions[9].op != IR_CONST or
        held_argument_ir.instructions[10].op != IR_DROP or
        held_argument_ir.instructions[10].left != held_argument_ir.instructions[5].result or
        held_argument_ir.instructions[11].op != IR_RETURN { return false }
    let held_argument_verified = verify_typed_ir(
        held_argument_ir.functions, held_argument_ir.blocks, held_argument_ir.instructions,
        held_argument_ir.constants, held_argument_ir.successors, held_argument_ir.call_sites,
        held_argument_ir.call_arguments, held_argument_ir.jump_arguments, held_argument_ir.value_count
    )
    return held_argument_verified.ok and held_argument_verified.checked_values == 6
}

fn typed_ir_call_verifier_smoke_test() -> bool {
    let mut functions: []IrFunction = []
    let mut blocks: []IrBlock = []
    let mut instructions: []IrInstruction = []
    functions = append(functions, IrFunction {
        item: 0, entry_block: 0, block_count: 1,
        parameter_count: 1, value_start: 0, value_count: 2,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_PARAM, result: 0, type_kind: SEM_STRING,
        left: -1, right: -1, aux: 0, token: 0,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_CALL, result: 1, type_kind: SEM_STRING,
        left: -1, right: -1, aux: 0, token: 0,
    })
    instructions = append(instructions, IrInstruction {
        op: IR_RETURN, result: -1, type_kind: SEM_STRING,
        left: 1, right: -1, aux: -1, token: 0,
    })
    blocks = append(blocks, IrBlock {
        function: 0, instruction_start: 0, instruction_count: 3,
        terminator: 2, successor_start: 0, successor_count: 0,
    })
    let verified = verify_typed_ir(
        functions, blocks, instructions, make([]IrConstant, 0, 0), make([]int, 0, 0),
        make([]IrCallSite, 0, 0), make([]int, 0, 0), make([]int, 0, 0), 2
    )
    return not verified.ok and verified.error == "IR call has invalid callee or argument layout"
}
