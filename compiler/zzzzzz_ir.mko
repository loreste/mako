        discard.statement_edges, discard.expressions, discard.expression_types, discard.locals,
        discard.local_types, discard.expression_locals, discard.symbols, discard.expression_symbols
    )
    if not drop_ir.ok or len(drop_ir.instructions) != 9 or
        drop_ir.instructions[7].op != IR_DROP or drop_ir.instructions[8].op != IR_RETURN { return false }
