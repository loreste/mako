// Stage-1 self-hosted Mako compiler entry point.
// The frontend is being brought up component-by-component under differential
// tests against the stage-0 compiler.

// Read one or more sources as a single translation unit.
//
// Stage 1 has no module system: a type declared in one file is invisible in the
// next, so `zzzzzz_ir.mko` alone cannot see `Token` or `ExprNode` and every
// parameter of such a type is unknown. Concatenating the members gives one span
// space and one symbol table, which is what lets the compiler's own fourteen
// files be compiled together at all.
//
// The members are separated by a newline so the last token of one cannot merge
// with the first of the next. Spans then index the combined buffer, so a
// diagnostic's offset is package-relative rather than file-relative — the
// tradeoff of doing this by concatenation rather than by merging arenas.
//
// A path with no comma is one file and behaves exactly as before, so every
// pinned single-file invocation is unaffected.
// Returns "" when any member could not be read, which the caller reports. Each
// member is checked on its own: `read_file` yields "" for a missing path, so
// summing the members and testing the total would let a mistyped member vanish
// into a package that still compiled — silently missing whatever it declared.
fn read_package(path_list: string) -> string {
    let mut combined = ""
    let mut start = 0
    let mut i = 0
    let mut members = 0
    while i <= len(path_list) {
        let mut boundary = false
        if i == len(path_list) {
            boundary = true
        } else if str_byte_at(path_list, i) == 44 {
            boundary = true
        }
        if boundary {
            if i > start {
                let piece = read_file(path_list[start:i])
                if len(piece) == 0 {
                    return ""
                }
                combined = combined + piece + "\n"
                members = members + 1
            }
            start = i + 1
        }
        i = i + 1
    }
    if members == 0 {
        return ""
    }
    return combined
}

fn main() {
    if not x86_64_smoke_test() {
        print("internal compiler error: x86-64 encoder smoke test failed")
        exit(70)
    }
    if not elf64_smoke_test() {
        print("internal compiler error: ELF64 writer smoke test failed")
        exit(70)
    }
    if not expression_smoke_test() {
        print("internal compiler error: expression parser smoke test failed")
        exit(70)
    }
    if not type_smoke_test() {
        print("internal compiler error: type parser smoke test failed")
        exit(70)
    }
    if not statement_smoke_test() {
        print("internal compiler error: statement parser smoke test failed")
        exit(70)
    }
    if not expression_attachment_smoke_test() {
        print("internal compiler error: statement expression attachment smoke test failed")
        exit(70)
    }
    if not condition_ident_attachment_smoke_test() {
        print("internal compiler error: condition identifier attachment smoke test failed")
        exit(70)
    }
    if not symbol_smoke_test() {
        print("internal compiler error: symbol table smoke test failed")
        exit(70)
    }
    if not resolution_smoke_test() {
        print("internal compiler error: global resolution smoke test failed")
        exit(70)
    }
    if not local_resolution_smoke_test() {
        print("internal compiler error: local resolution smoke test failed")
        exit(70)
    }
    if not branch_scope_smoke_test() {
        print("internal compiler error: branch scope smoke test failed")
        exit(70)
    }
    if not struct_layout_smoke_test() {
        print("internal compiler error: struct layout smoke test failed")
        exit(70)
    }
    if not struct_kind_distinct_smoke_test() {
        print("internal compiler error: struct kind distinctness smoke test failed")
        exit(70)
    }
    if not ir_entry_item_smoke_test() {
        print("internal compiler error: entry item smoke test failed")
        exit(70)
    }
    if not semantic_type_smoke_test() {
        print("internal compiler error: semantic type smoke test failed")
        exit(70)
    }
    if not typed_ir_smoke_test() {
        print("internal compiler error: typed IR smoke test failed")
        exit(70)
    }
    if not typed_ir_verifier_smoke_test() {
        print("internal compiler error: typed IR verifier smoke test failed")
        exit(70)
    }
    if not typed_ir_block_parameter_verifier_smoke_test() {
        print("internal compiler error: typed IR block parameter verifier smoke test failed")
        exit(70)
    }
    if not typed_ir_arm_placement_smoke_test() {
        print("internal compiler error: typed IR arm placement smoke test failed")
        exit(70)
    }
    if not typed_ir_dominance_verifier_smoke_test() {
        print("internal compiler error: typed IR dominance verifier smoke test failed")
        exit(70)
    }
    if not typed_ir_loop_smoke_test() {
        print("internal compiler error: typed IR loop smoke test failed")
        exit(70)
    }
    if not typed_ir_loop_skip_smoke_test() {
        print("internal compiler error: typed IR loop skip smoke test failed")
        exit(70)
    }
    if not typed_ir_loop_multi_smoke_test() {
        print("internal compiler error: typed IR multi-carried loop smoke test failed")
        exit(70)
    }
    if not typed_ir_loop_cross_read_skip_smoke_test() {
        print("internal compiler error: typed IR loop cross-read skip smoke test failed")
        exit(70)
    }
    if not typed_ir_loop_break_smoke_test() {
        print("internal compiler error: typed IR loop break smoke test failed")
        exit(70)
    }
    if not typed_ir_loop_continue_smoke_test() {
        print("internal compiler error: typed IR loop continue smoke test failed")
        exit(70)
    }
    if not typed_ir_loop_call_smoke_test() {
        print("internal compiler error: typed IR loop call smoke test failed")
        exit(70)
    }
    if not typed_ir_loop_merge_if_smoke_test() {
        print("internal compiler error: typed IR loop merge-if smoke test failed")
        exit(70)
    }
    if not typed_ir_loop_sequential_smoke_test() {
        print("internal compiler error: typed IR sequential loop smoke test failed")
        exit(70)
    }
    if not typed_ir_loop_guarded_chain_smoke_test() {
        print("internal compiler error: typed IR guarded chain smoke test failed")
        exit(70)
    }
    if not typed_ir_pre_if_loop_smoke_test() {
        print("internal compiler error: typed IR pre-if loop smoke test failed")
        exit(70)
    }
    if not typed_ir_statement_merge_ownership_smoke_test() {
        print("internal compiler error: typed IR statement-merge ownership smoke test failed")
        exit(70)
    }
    if not typed_ir_local_transfer_smoke_test() {
        print("internal compiler error: typed IR local-transfer smoke test failed")
        exit(70)
    }
    if not typed_ir_ownership_smoke_test() {
        print("internal compiler error: typed IR ownership smoke test failed")
        exit(70)
    }
    if not typed_ir_ownership_verifier_smoke_test() {
        print("internal compiler error: typed IR ownership verifier smoke test failed")
        exit(70)
    }
    if not typed_ir_call_smoke_test() {
        print("internal compiler error: typed IR call smoke test failed")
        exit(70)
    }
    if not typed_ir_call_verifier_smoke_test() {
        print("internal compiler error: typed IR call verifier smoke test failed")
        exit(70)
    }
    if argc() < 2 {
        print("usage: makoc <source.mko>")
        exit(2)
    }
 let path = arg_get(1)
    let source = read_package(path)
    if len(source) == 0 {
        // `read_file` yields "" for a missing path, a directory and a broken
        // symlink alike, and an empty source lexes to an empty arena and
        // reports success. Refusing here is what stops a mistyped package
        // member from looking like a clean compile of nothing.
        print(path + ": no source read")
        exit(1)
    }
    let result = lex_source(source)
    if not result.ok {
        print(path + ":" + format_int(result.error_line) + ":" + format_int(result.error_col) + ": " + result.error)
        exit(1)
    }
    let parsed = parse_frontend(source, result.tokens)
    if not parsed.ok {
        print(path + ":" + format_int(parsed.error_line) + ":" + format_int(parsed.error_col) + ": " + parsed.error)
        exit(1)
    }
    let ir = lower_typed_ir(
        source, result.tokens, parsed.items, parsed.signatures, parsed.statements,
        parsed.statement_edges, parsed.expressions, parsed.expression_types, parsed.locals,
        parsed.local_types, parsed.expression_locals, parsed.symbols, parsed.expression_symbols
    )
    if not ir.ok {
        print(path + ": typed IR lowering failed: " + ir.error)
        exit(1)
    }
    let ir_verification = verify_typed_ir(
        ir.functions, ir.blocks, ir.instructions, ir.constants, ir.successors,
        ir.call_sites, ir.call_arguments, ir.jump_arguments, ir.value_count
    )
    if not ir_verification.ok {
        print(path + ": typed IR verification failed: " + ir_verification.error)
        exit(1)
    }
    // A fourth argument asks the driver to say why each function declined,
    // which turns the skip count into a work list. The gate never passes one,
    // so pinned output is unaffected.
    if argc() >= 4 {
        print(ir.skip_reason)
    }
    let elf = elf64_lower_typed_ir(ir, ir_entry_item(source, parsed.items))
    if elf.status == ELF_OK { print("elf_bytes " + format_int(len(elf.bytes))) }
    if argc() >= 3 {
        if ir.skipped_functions != 0 {
            print(path + ": ELF lowering failed: source contains functions the typed IR cannot lower yet")
            exit(1)
        }
        if elf.status != ELF_OK {
            print(path + ": ELF lowering failed: " + elf.error)
            exit(1)
        }
 let output_path = arg_get(2)
        let mut raw: []byte = make([]byte, 0, len(elf.bytes))
        let mut byte_index = 0
        while byte_index < len(elf.bytes) {
            raw = append(raw, byte(elf.bytes[byte_index]))
            byte_index = byte_index + 1
        }
        let write_status = write_file(output_path, string(raw))
        if write_status != 0 {
            print(output_path + ": failed to write ELF image")
            exit(1)
        }
    }
    print(
        "tokens " + format_int(parsed.token_count) +
        " items " + format_int(len(parsed.items)) +
        " types " + format_int(len(parsed.types)) +
        " signatures " + format_int(len(parsed.signatures)) +
        " parameters " + format_int(len(parsed.parameters)) +
        " statements " + format_int(len(parsed.statements)) +
        " bodies " + format_int(len(parsed.bodies)) +
        " expressions " + format_int(len(parsed.expressions)) +
        " symbols " + format_int(len(parsed.symbols)) +
        " resolved " + format_int(parsed.resolved_globals) +
        " locals " + format_int(len(parsed.locals)) +
        " local_refs " + format_int(parsed.resolved_locals) +
        " typed " + format_int(parsed.typed_expressions) +
        " ir_functions " + format_int(len(ir.functions)) +
        " ir_blocks " + format_int(len(ir.blocks)) +
        " ir_instructions " + format_int(len(ir.instructions)) +
        " ir_constants " + format_int(len(ir.constants)) +
        " ir_values " + format_int(ir.value_count) +
        " ir_skipped " + format_int(ir.skipped_functions) +
        " ir_verified " + format_int(ir_verification.checked_values)
    )
}
