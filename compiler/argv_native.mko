// Entry-only argv pointer primitive for the self-hosted x86-64 backend.
fn x86_emit_argc(bytes: []int, result_slot: int) []int {
 let mut out = bytes
 // mov rax, [rbp + 16] (argc remains above the body frame)
 out = append(out, 72); out = append(out, 139); out = append(out, 69); out = append(out, 16)
 return x86_emit_store_rax(out, result_slot)
}

fn x86_emit_argv_ptr(bytes: []int, index_slot: int, result_slot: int) []int {
 let mut out = x86_emit_load_rax(bytes, index_slot)
 // mov rdx, rax
 out = append(out, 72)
 out = append(out, 137)
 out = append(out, 194)
 // mov rcx, [rbp + 24]
 out = append(out, 72)
 out = append(out, 141)
 out = append(out, 77)
 out = append(out, 24)
 // mov rcx, [rcx + rdx*8]
 out = append(out, 72)
 out = append(out, 139)
 out = append(out, 12)
 out = append(out, 209)
 // mov rax, rcx
 out = append(out, 72)
 out = append(out, 137)
 out = append(out, 200)
 return x86_emit_store_rax(out, result_slot)
}

// Return the NUL-terminated length of argv[index]. The caller owns the
// pointer contract; repne scasb stops at the process-provided terminator.
fn x86_emit_argv_len(bytes: []int, index_slot: int, result_slot: int) []int {
 let mut out = x86_emit_load_rax(bytes, index_slot)
 // mov rdx, rax; mov rcx, [rbp + 24]; mov rdi, [rcx + rdx*8]
 out = append(out, 72); out = append(out, 137); out = append(out, 194)
 out = append(out, 72); out = append(out, 141); out = append(out, 77); out = append(out, 24)
 out = append(out, 72); out = append(out, 139); out = append(out, 60); out = append(out, 209)
 // xor eax, eax; mov rcx, -1; repne scasb; not rcx; dec rcx; mov rax, rcx
 out = append(out, 49); out = append(out, 192)
 out = append(out, 72); out = append(out, 199); out = append(out, 193)
 out = append(out, 255); out = append(out, 255); out = append(out, 255); out = append(out, 255)
 out = append(out, 242); out = append(out, 174)
 out = append(out, 72); out = append(out, 247); out = append(out, 209)
 out = append(out, 72); out = append(out, 255); out = append(out, 201)
 out = append(out, 72); out = append(out, 137); out = append(out, 200)
 return x86_emit_store_rax(out, result_slot)
}

// Return argv[index][offset] as a byte. Bounds and NUL handling are the
// caller's responsibility, matching the other unsafe pointer primitives.
fn x86_emit_argv_byte(bytes: []int, index_slot: int, offset_slot: int, result_slot: int) []int {
 let mut out = x86_emit_load_rax(bytes, index_slot)
 // mov rdx, rax; mov rcx, [rbp + 24]; mov rcx, [rcx + rdx*8]
 out = append(out, 72); out = append(out, 137); out = append(out, 194)
 out = append(out, 72); out = append(out, 141); out = append(out, 77); out = append(out, 24)
 out = append(out, 72); out = append(out, 139); out = append(out, 12); out = append(out, 209)
 // mov rdx, [rbp - 8*offset]; add rcx, rdx; movzx eax, byte [rcx]
 out = x86_emit_load_syscall_arg(out, offset_slot, 3)
 out = append(out, 72); out = append(out, 1); out = append(out, 209)
 out = append(out, 15); out = append(out, 182); out = append(out, 1)
 return x86_emit_store_rax(out, result_slot)
}

// Copy argv[index] into an existing byte-slice, clamped to its capacity.
// The slice header is [length, capacity, data_pointer].
fn x86_emit_argv_copy(bytes: []int, index_slot: int, slice_slot: int, result_slot: int) []int {
 let mut out = x86_emit_load_rax(bytes, index_slot)
 // Locate argv[index] in rsi.
 out = append(out, 72); out = append(out, 137); out = append(out, 194)
 out = append(out, 72); out = append(out, 141); out = append(out, 77); out = append(out, 24)
 out = append(out, 72); out = append(out, 139); out = append(out, 52); out = append(out, 209)
 // Preserve slice header in r8.
 out = x86_emit_load_rax(out, slice_slot)
 out = append(out, 73); out = append(out, 137); out = append(out, 192)
 // Scan argv bytes through the terminating NUL.
 out = append(out, 72); out = append(out, 137); out = append(out, 247)
 out = append(out, 49); out = append(out, 192)
 out = append(out, 72); out = append(out, 199); out = append(out, 193)
 out = append(out, 255); out = append(out, 255); out = append(out, 255); out = append(out, 255)
 out = append(out, 242); out = append(out, 174)
 out = append(out, 72); out = append(out, 247); out = append(out, 209)
 out = append(out, 72); out = append(out, 255); out = append(out, 201)
 // rdx = source length; rax = capacity; choose min(source length, capacity).
 out = append(out, 72); out = append(out, 137); out = append(out, 202)
 out = append(out, 73); out = append(out, 139); out = append(out, 64); out = append(out, 8)
 out = append(out, 72); out = append(out, 57); out = append(out, 194)
 out = append(out, 72); out = append(out, 15); out = append(out, 71); out = append(out, 208)
 // Store length and copy exactly that many bytes into the slice payload.
 out = append(out, 73); out = append(out, 137); out = append(out, 16)
 out = append(out, 73); out = append(out, 139); out = append(out, 120); out = append(out, 16)
 out = append(out, 72); out = append(out, 137); out = append(out, 209)
 out = append(out, 243); out = append(out, 164)
 out = append(out, 72); out = append(out, 137); out = append(out, 208)
 return x86_emit_store_rax(out, result_slot)
}

// Allocate an owned string object {length, bytes} from a byte slice. This is
// explicitly unsafe until ownership/drop lowering is wired to the allocation.
fn x86_emit_bytes_to_string(bytes: []int, slice_slot: int, result_slot: int) []int {
 let mut out = x86_emit_load_rax(bytes, slice_slot)
 // r8 = slice header; rcx = length; r9 = source payload.
 out = append(out, 73); out = append(out, 137); out = append(out, 192)
 out = append(out, 73); out = append(out, 139); out = append(out, 8)
 out = append(out, 77); out = append(out, 139); out = append(out, 72); out = append(out, 16)
 // Save length while mmap clobbers rcx, then mmap(length + 10): eight bytes
 // of header plus the NUL and newline that close every string object.
 out = append(out, 81)
 out = append(out, 65); out = append(out, 81)
 out = x86_emit_int_rax(out, 9)
 out = x86_emit_syscall_const(out, 0, 1)
 out = append(out, 72); out = append(out, 137); out = append(out, 206)
 out = append(out, 72); out = append(out, 131); out = append(out, 198); out = append(out, 10)
 out = x86_emit_syscall_const(out, 3, 3)
 out = x86_emit_syscall_const(out, 34, 4)
 out = x86_emit_syscall_const(out, -1, 5)
 out = x86_emit_syscall_const(out, 0, 6)
 out = append(out, 15); out = append(out, 5)
 out = append(out, 65); out = append(out, 89)
 out = append(out, 89)
 // Store length, copy source bytes to allocation + 8, return allocation.
 // The source pointer comes from the saved r9; re-reading it through r8 would
 // fault, because mmap's fifth argument already overwrote r8 with -1.
 out = append(out, 72); out = append(out, 137); out = append(out, 8)
 out = append(out, 72); out = append(out, 141); out = append(out, 120); out = append(out, 8)
 out = append(out, 76); out = append(out, 137); out = append(out, 206)
 out = append(out, 72); out = append(out, 137); out = append(out, 201)
 out = append(out, 243); out = append(out, 164)
 out = x86_emit_string_terminators(out)
 return x86_emit_store_rax(out, result_slot)
}

// Close an owned string payload after `rep movsb`: rdi points one past the
// copied bytes, so the NUL terminator and the newline print appends land at
// [rdi] and [rdi + 1]. Both are inside the allocation because the string
// allocators reserve length + 10 bytes.
fn x86_emit_string_terminators(bytes: []int) []int {
 let mut out = bytes
 out = append(out, 198); out = append(out, 7); out = append(out, 0)
 out = append(out, 198); out = append(out, 71); out = append(out, 1); out = append(out, 10)
 return out
}

// Byte at an index of a string object, or -1 when the index is out of range.
//
// The sentinel is the contract, not a trap: `mako_str_byte_at` returns -1 for a
// negative index or one at or past the length, and the lexer reads that as end
// of input. Trapping here instead would diverge from the stage-0 oracle on
// every scan that walks off the end deliberately.
fn x86_emit_str_byte_at(bytes: []int, string_slot: int, index_slot: int, result_slot: int) []int {
 let mut out = x86_emit_load_rax(bytes, string_slot)
 // mov r9, rax (object); mov rdx, [r9] (length)
 out = append(out, 73); out = append(out, 137); out = append(out, 193)
 out = append(out, 73); out = append(out, 139); out = append(out, 17)
 out = x86_emit_load_rax(out, index_slot)
 // mov rcx, rax (index); mov r8, -1 (the out-of-range result)
 out = append(out, 72); out = append(out, 137); out = append(out, 193)
 out = x86_emit_syscall_const(out, -1, 5)
 // test rcx, rcx; js +16 — a negative index keeps the sentinel. The skip
 // covers cmp (3) + jge (2) + the load sequence (11).
 out = append(out, 72); out = append(out, 133); out = append(out, 201)
 out = append(out, 120); out = append(out, 16)
 // cmp rcx, rdx; jge +11 — at or past the length keeps the sentinel too.
 out = append(out, 72); out = append(out, 57); out = append(out, 209)
 out = append(out, 125); out = append(out, 11)
 // lea rsi, [r9 + 8]; add rsi, rcx; movzx r8d, byte [rsi]
 out = append(out, 73); out = append(out, 141); out = append(out, 113); out = append(out, 8)
 out = append(out, 72); out = append(out, 1); out = append(out, 206)
 out = append(out, 68); out = append(out, 15); out = append(out, 182); out = append(out, 6)
 // mov rax, r8
 out = append(out, 76); out = append(out, 137); out = append(out, 192)
 return x86_emit_store_rax(out, result_slot)
}

// True when this struct value is one the program owns, as opposed to a
// borrowed pointer into a slice somebody else owns.
//
// Both share a semantic kind, deliberately — the type checker cares that it is
// a Pt, not who owns it — so ownership is read off the producing instruction,
// exactly as it is for strings. Getting this backwards frees a slice's storage
// out from under it, so anything that is not a construction is a borrow.
//
// Owned producers:
//   - IR_STRUCT_NEW (a literal construction)
//   - a Mako function call that returns a struct (caller receives ownership)
//   - IR_MOVE of an owned value (return transfer, rebinding)
// Element addresses and parameters are not owned.
fn x86_struct_value_owned(instructions: []IrInstruction, call_sites: []IrCallSite, value: int) bool {
 let mut guard = 0
 let mut current = value
 while guard < len(instructions) {
  let mut found = false
  let mut i = 0
  while i < len(instructions) {
   if instructions[i].result == current {
    found = true
    if instructions[i].op == IR_CALL and instructions[i].aux >= 0 and
     instructions[i].aux < len(call_sites) {
     let callee = call_sites[instructions[i].aux].callee_item
     // Construction sentinel or a declared function (non-negative item).
     // Intrinsics are negative and never return a struct value.
     if callee == IR_STRUCT_NEW_ITEM or callee >= 0 { return true }
     return false
    }
    if instructions[i].op == IR_MOVE {
     current = instructions[i].left
     i = len(instructions)
    } else {
     return false
    }
   } else {
    i = i + 1
   }
  }
  if not found { return false }
  guard = guard + 1
 }
 return false
}

// Free every owned field of a constructed struct, then the block itself is
// released by the caller. `owned_pack` carries 2 bits per field (see
// `struct_owned_slot_mask`): 1 = string, 2 = []int, 3 = []byte. Fields are
// released before the block so their pointers are still readable.
fn x86_emit_drop_struct_fields(bytes: []int, slot: int, field_count: int, owned_pack: int) []int {
 let mut out = bytes
 if owned_pack <= 0 { return out }
 let mut i = 0
 let mut unit = 1
 while i < field_count {
  let code = (owned_pack / unit) - ((owned_pack / unit) / 4) * 4
  if code > 0 {
   out = x86_emit_load_rax(out, slot)
   // rax = [block + 8*i]
   out = append(out, 72); out = append(out, 139); out = append(out, 128)
   out = x86_emit_u32(out, i * 8)
   if code == 1 {
    // string: munmap(field, field.length + 10)
    out = append(out, 72); out = append(out, 137); out = append(out, 199)
    out = append(out, 72); out = append(out, 139); out = append(out, 48)
    out = append(out, 72); out = append(out, 131); out = append(out, 198); out = append(out, 10)
    out = x86_emit_int_rax(out, 11)
    out = x86_emit_syscall_const(out, 0, 3)
    out = x86_emit_syscall_const(out, 0, 4)
    out = x86_emit_syscall_const(out, 0, 5)
    out = x86_emit_syscall_const(out, 0, 6)
    out = append(out, 15); out = append(out, 5)
   } else {
    // slice header in rax: munmap(header, capacity * stride + 24)
    // r8 = header; rsi = capacity; scale; +24; munmap
    out = append(out, 73); out = append(out, 137); out = append(out, 192)
    out = append(out, 73); out = append(out, 139); out = append(out, 112); out = append(out, 8)
    out = append(out, 72); out = append(out, 137); out = append(out, 240)
    if code == 2 {
     // []int: stride 8
     out = append(out, 72); out = append(out, 193); out = append(out, 224); out = append(out, 3)
    }
    // []byte: stride 1, no scale
    out = append(out, 72); out = append(out, 131); out = append(out, 192); out = append(out, 24)
    out = append(out, 72); out = append(out, 137); out = append(out, 198)
    out = append(out, 76); out = append(out, 137); out = append(out, 199)
    out = append(out, 184); out = x86_emit_u32(out, 11)
    out = append(out, 49); out = append(out, 210)
    out = append(out, 15); out = append(out, 5)
   }
  }
  unit = unit * 4
  i = i + 1
 }
 return out
}

fn x86_emit_drop_struct(bytes: []int, slot: int, field_count: int) []int {
 let mut out = x86_emit_load_rax(bytes, slot)
 out = append(out, 72); out = append(out, 137); out = append(out, 199)
 out = x86_emit_syscall_const(out, field_count * 8, 2)
 out = x86_emit_int_rax(out, 11)
 out = x86_emit_syscall_const(out, 0, 3)
 out = x86_emit_syscall_const(out, 0, 4)
 out = x86_emit_syscall_const(out, 0, 5)
 out = x86_emit_syscall_const(out, 0, 6)
 out = append(out, 15); out = append(out, 5)
 return out
}

// Duplicate a string into an independent owned {length, bytes} allocation.
//
// This always allocates, whatever the source was. An owned string is an mmap'd
// block while a literal is a static view into the code image, and a clone that
// tried to preserve which is which would hand a later `IR_DROP` a value whose
// nature depends on a producer several instructions away — get it wrong and the
// drop unmaps read-only code. Allocating unconditionally removes the
// distinction: the result is always droppable and the source keeps its own
// nature. Cloning a literal costs one page it did not strictly need, which is
// the cheap side of that trade.
fn x86_emit_clone_string(bytes: []int, source_slot: int, result_slot: int) []int {
 let mut out = x86_emit_load_rax(bytes, source_slot)
 // mov r12, rax (source object); mov r13, [r12] (length). Both survive the
 // mmap, which destroys only rax, rcx and r11 beyond its own arguments.
 out = append(out, 73); out = append(out, 137); out = append(out, 196)
 out = append(out, 77); out = append(out, 139); out = append(out, 44); out = append(out, 36)
 // mmap(0, length + 10, PROT_READ|WRITE, PRIVATE|ANON, -1, 0).
 out = x86_emit_int_rax(out, 9)
 out = x86_emit_syscall_const(out, 0, 1)
 out = append(out, 76); out = append(out, 137); out = append(out, 238)
 out = append(out, 72); out = append(out, 131); out = append(out, 198); out = append(out, 10)
 out = x86_emit_syscall_const(out, 3, 3)
 out = x86_emit_syscall_const(out, 34, 4)
 out = x86_emit_syscall_const(out, -1, 5)
 out = x86_emit_syscall_const(out, 0, 6)
 out = append(out, 15); out = append(out, 5)
 // mov [rax], r13; lea rdi, [rax + 8]; lea rsi, [r12 + 8]; mov rcx, r13; rep movsb
 out = append(out, 76); out = append(out, 137); out = append(out, 40)
 out = append(out, 72); out = append(out, 141); out = append(out, 120); out = append(out, 8)
 out = append(out, 73); out = append(out, 141); out = append(out, 116); out = append(out, 36); out = append(out, 8)
 out = append(out, 76); out = append(out, 137); out = append(out, 233)
 out = append(out, 243); out = append(out, 164)
 out = x86_emit_string_terminators(out)
 return x86_emit_store_rax(out, result_slot)
}

// Concatenate two string objects into a fresh owned {length, bytes}.
//
// Neither operand is consumed: this reads both payloads and allocates its own,
// so each operand stays owned by whatever binding holds it and keeps its own
// drop. That is why no move or clone is emitted here, and why the ownership
// verifier does not count `+` as a use.
//
// Both object pointers and both lengths have to survive the mmap, so they live
// in r12/r13/r14/r15; `syscall` destroys rax, rcx and r11, and mmap's own
// arguments cover rdi/rsi/rdx/r10/r8/r9. A zero-length operand is not a special
// case — `rep movsb` with rcx = 0 copies nothing and leaves rdi where it was.
fn x86_emit_concat_string(bytes: []int, left_slot: int, right_slot: int, result_slot: int) []int {
 let mut out = x86_emit_load_rax(bytes, left_slot)
 // mov r12, rax; then the right object into r13.
 out = append(out, 73); out = append(out, 137); out = append(out, 196)
 out = x86_emit_load_rax(out, right_slot)
 out = append(out, 73); out = append(out, 137); out = append(out, 197)
 // mov r14, [r12] (left length); mov r15, [r13] (right length). r13 as a base
 // needs the disp8 form, the same encoding quirk rbp has.
 out = append(out, 77); out = append(out, 139); out = append(out, 52); out = append(out, 36)
 out = append(out, 77); out = append(out, 139); out = append(out, 125); out = append(out, 0)
 // mmap(0, left + right + 10, PROT_READ|WRITE, PRIVATE|ANON, -1, 0).
 out = x86_emit_int_rax(out, 9)
 out = x86_emit_syscall_const(out, 0, 1)
 out = append(out, 76); out = append(out, 137); out = append(out, 246)
 out = append(out, 76); out = append(out, 1); out = append(out, 254)
 out = append(out, 72); out = append(out, 131); out = append(out, 198); out = append(out, 10)
 out = x86_emit_syscall_const(out, 3, 3)
 out = x86_emit_syscall_const(out, 34, 4)
 out = x86_emit_syscall_const(out, -1, 5)
 out = x86_emit_syscall_const(out, 0, 6)
 out = append(out, 15); out = append(out, 5)
 // mov rcx, r14; add rcx, r15; mov [rax], rcx — the combined length header.
 out = append(out, 76); out = append(out, 137); out = append(out, 241)
 out = append(out, 76); out = append(out, 1); out = append(out, 249)
 out = append(out, 72); out = append(out, 137); out = append(out, 8)
 // lea rdi, [rax + 8]; copy the left payload, then the right, leaving rdi one
 // past the last byte for the terminators.
 out = append(out, 72); out = append(out, 141); out = append(out, 120); out = append(out, 8)
 out = append(out, 73); out = append(out, 141); out = append(out, 116); out = append(out, 36); out = append(out, 8)
 out = append(out, 76); out = append(out, 137); out = append(out, 241)
 out = append(out, 243); out = append(out, 164)
 out = append(out, 73); out = append(out, 141); out = append(out, 117); out = append(out, 8)
 out = append(out, 76); out = append(out, 137); out = append(out, 249)
 out = append(out, 243); out = append(out, 164)
 out = x86_emit_string_terminators(out)
 return x86_emit_store_rax(out, result_slot)
}

// Native format_int: decimal-render an int into a fresh owned {length, bytes}
// string. The digits are built backward in the red zone first, because the
// length is not known until they are, and the allocation has to be exact —
// `x86_emit_drop_owned_string` unmaps `length + 10`, so a padded allocation
// would leave the tail mapped.
//
// r12 walks backward over the digits and r13 holds the end, so both survive the
// mmap; `syscall` destroys only rax, rcx and r11, and the six argument
// registers cover rdi/rsi/rdx/r10/r8/r9. Nothing is pushed between the digits
// and the copy, so the red zone below rsp stays intact — the same assumption
// `print(int)` already runs on.
fn x86_emit_format_int(bytes: []int, value_slot: int, result_slot: int) []int {
 let mut out = x86_emit_load_rax(bytes, value_slot)
 // lea r12, [rsp - 24]; mov r13, r12. Twenty characters is the widest result
 // (`-9223372036854775808`), so the digits never reach past [rsp - 44].
 out = append(out, 76); out = append(out, 141); out = append(out, 100); out = append(out, 36); out = append(out, 232)
 out = append(out, 77); out = append(out, 137); out = append(out, 229)
 // mov r8, 10 (divisor); xor r9d, r9d (sign flag)
 out = append(out, 73); out = append(out, 199); out = append(out, 192)
 out = append(out, 10); out = append(out, 0); out = append(out, 0); out = append(out, 0)
 out = append(out, 69); out = append(out, 49); out = append(out, 201)
 // test rax, rax; jns +9 — skip the sign branch for a non-negative value.
 out = append(out, 72); out = append(out, 133); out = append(out, 192)
 out = append(out, 121); out = append(out, 9)
 // mov r9d, 1; neg rax. Negating INT_MIN yields INT_MIN, whose unsigned value
 // is exactly the magnitude, and `div` is unsigned — so INT_MIN renders.
 out = append(out, 65); out = append(out, 185)
 out = append(out, 1); out = append(out, 0); out = append(out, 0); out = append(out, 0)
 out = append(out, 72); out = append(out, 247); out = append(out, 216)
 // Digit loop: xor edx, edx; div r8; add dl, 48; dec r12; mov [r12], dl;
 // test rax, rax; jnz -20. Emits one digit for zero, since the test is at the
 // bottom.
 out = append(out, 49); out = append(out, 210)
 out = append(out, 73); out = append(out, 247); out = append(out, 240)
 out = append(out, 128); out = append(out, 194); out = append(out, 48)
 out = append(out, 73); out = append(out, 255); out = append(out, 204)
 out = append(out, 65); out = append(out, 136); out = append(out, 20); out = append(out, 36)
 out = append(out, 72); out = append(out, 133); out = append(out, 192)
 out = append(out, 117); out = append(out, 236)
 // test r9d, r9d; jz +8; dec r12; mov byte [r12], 45
 out = append(out, 69); out = append(out, 133); out = append(out, 201)
 out = append(out, 116); out = append(out, 8)
 out = append(out, 73); out = append(out, 255); out = append(out, 204)
 out = append(out, 65); out = append(out, 198); out = append(out, 4); out = append(out, 36); out = append(out, 45)
 // sub r13, r12 — r13 becomes the character count.
 out = append(out, 77); out = append(out, 41); out = append(out, 229)
 // mmap(0, length + 10, PROT_READ|WRITE, PRIVATE|ANON, -1, 0): header, payload,
 // NUL, newline.
 out = x86_emit_int_rax(out, 9)
 out = x86_emit_syscall_const(out, 0, 1)
 out = append(out, 76); out = append(out, 137); out = append(out, 238)
 out = append(out, 72); out = append(out, 131); out = append(out, 198); out = append(out, 10)
 out = x86_emit_syscall_const(out, 3, 3)
 out = x86_emit_syscall_const(out, 34, 4)
 out = x86_emit_syscall_const(out, -1, 5)
 out = x86_emit_syscall_const(out, 0, 6)
 out = append(out, 15); out = append(out, 5)
 // mov [rax], r13; lea rdi, [rax + 8]; mov rsi, r12; mov rcx, r13; rep movsb
 out = append(out, 76); out = append(out, 137); out = append(out, 40)
 out = append(out, 72); out = append(out, 141); out = append(out, 120); out = append(out, 8)
 out = append(out, 76); out = append(out, 137); out = append(out, 230)
 out = append(out, 76); out = append(out, 137); out = append(out, 233)
 out = append(out, 243); out = append(out, 164)
 out = x86_emit_string_terminators(out)
 return x86_emit_store_rax(out, result_slot)
}

// Native arg_get: scan argv[index], allocate {length, bytes}, and copy it.
fn x86_emit_arg_get(bytes: []int, index_slot: int, result_slot: int) []int {
 let mut out = x86_emit_load_rax(bytes, index_slot)
 // rdx = index; rcx = argv; r9 = source pointer.
 out = append(out, 72); out = append(out, 137); out = append(out, 194)
 out = append(out, 72); out = append(out, 141); out = append(out, 77); out = append(out, 24)
 // mov r9, [rcx + rdx*8]: REX must be 0x4C. 0x4D adds REX.B, which retargets
 // the SIB base from rcx to r9 and indexes off an uninitialized register.
 out = append(out, 76); out = append(out, 139); out = append(out, 12); out = append(out, 209)
 // Scan source into length rcx, preserving source and length over syscall.
 out = append(out, 76); out = append(out, 137); out = append(out, 207)
 out = append(out, 49); out = append(out, 192)
 out = append(out, 72); out = append(out, 199); out = append(out, 193)
 out = append(out, 255); out = append(out, 255); out = append(out, 255); out = append(out, 255)
 out = append(out, 242); out = append(out, 174)
 out = append(out, 72); out = append(out, 247); out = append(out, 209)
 out = append(out, 72); out = append(out, 255); out = append(out, 201)
 out = append(out, 81)
 out = append(out, 65); out = append(out, 81)
 // mmap(length + 10): header, payload, NUL, newline.
 out = x86_emit_int_rax(out, 9)
 out = x86_emit_syscall_const(out, 0, 1)
 out = append(out, 72); out = append(out, 137); out = append(out, 206)
 out = append(out, 72); out = append(out, 131); out = append(out, 198); out = append(out, 10)
 out = x86_emit_syscall_const(out, 3, 3)
 out = x86_emit_syscall_const(out, 34, 4)
 out = x86_emit_syscall_const(out, -1, 5)
 out = x86_emit_syscall_const(out, 0, 6)
 out = append(out, 15); out = append(out, 5)
 out = append(out, 65); out = append(out, 89)
 out = append(out, 89)
 // Store length and copy source bytes.
 out = append(out, 72); out = append(out, 137); out = append(out, 8)
 out = append(out, 72); out = append(out, 141); out = append(out, 120); out = append(out, 8)
 out = append(out, 76); out = append(out, 137); out = append(out, 206)
 out = append(out, 72); out = append(out, 137); out = append(out, 201)
 out = append(out, 243); out = append(out, 164)
 out = x86_emit_string_terminators(out)
 return x86_emit_store_rax(out, result_slot)
}

fn x86_emit_close(bytes: []int, fd_slot: int, result_slot: int) []int {
 let mut out = x86_emit_int_rax(bytes, 3)
 out = x86_emit_load_syscall_arg(out, fd_slot, 1)
 out = x86_emit_syscall_const(out, 0, 2)
 out = x86_emit_syscall_const(out, 0, 3)
 out = x86_emit_syscall_const(out, 0, 4)
 out = x86_emit_syscall_const(out, 0, 5)
 out = x86_emit_syscall_const(out, 0, 6)
 out = append(out, 15); out = append(out, 5)
 return x86_emit_store_rax(out, result_slot)
}

// Read an entire regular file into an owned {length, bytes} string. Linux
// struct stat st_size is at offset 48 on x86-64; scratch storage is unmapped.
fn x86_emit_read_file(bytes: []int, path_slot: int, result_slot: int) []int {
 let mut out = x86_emit_load_rax(bytes, path_slot)
 // openat(AT_FDCWD, path.data, O_RDONLY). The path bytes follow the length
 // word, and openat takes them in rsi: staging them through rdi lost the
 // pointer to the AT_FDCWD constant that immediately overwrites it.
 out = append(out, 72); out = append(out, 141); out = append(out, 112); out = append(out, 8)
 out = x86_emit_int_rax(out, 257)
 out = x86_emit_syscall_const(out, -100, 1)
 out = x86_emit_syscall_const(out, 0, 3)
 out = x86_emit_syscall_const(out, 0, 4)
 out = x86_emit_syscall_const(out, 0, 5)
 out = x86_emit_syscall_const(out, 0, 6)
 out = append(out, 15); out = append(out, 5)
 out = append(out, 73); out = append(out, 137); out = append(out, 196)
 // mmap 144-byte stat scratch.
 out = x86_emit_int_rax(out, 9)
 out = x86_emit_syscall_const(out, 0, 1)
 out = x86_emit_syscall_const(out, 144, 2)
 out = x86_emit_syscall_const(out, 3, 3)
 out = x86_emit_syscall_const(out, 34, 4)
 out = x86_emit_syscall_const(out, -1, 5)
 out = x86_emit_syscall_const(out, 0, 6)
 out = append(out, 15); out = append(out, 5)
 out = append(out, 73); out = append(out, 137); out = append(out, 197)
 // fstat(fd, scratch); load st_size.
 out = x86_emit_int_rax(out, 5)
 out = append(out, 76); out = append(out, 137); out = append(out, 231)
 out = append(out, 76); out = append(out, 137); out = append(out, 238)
 out = x86_emit_syscall_const(out, 0, 3)
 out = x86_emit_syscall_const(out, 0, 4)
 out = x86_emit_syscall_const(out, 0, 5)
 out = x86_emit_syscall_const(out, 0, 6)
 out = append(out, 15); out = append(out, 5)
 out = append(out, 77); out = append(out, 139); out = append(out, 117); out = append(out, 48)
 // mmap(file_size + 10) for the string object: header, payload, NUL, newline.
 out = x86_emit_int_rax(out, 9)
 out = x86_emit_syscall_const(out, 0, 1)
 out = append(out, 76); out = append(out, 137); out = append(out, 246)
 out = append(out, 72); out = append(out, 131); out = append(out, 198); out = append(out, 10)
 out = x86_emit_syscall_const(out, 3, 3)
 out = x86_emit_syscall_const(out, 34, 4)
 out = x86_emit_syscall_const(out, -1, 5)
 out = x86_emit_syscall_const(out, 0, 6)
 out = append(out, 15); out = append(out, 5)
 out = append(out, 73); out = append(out, 137); out = append(out, 199)
 // read(fd, string.data, file_size); close(fd); munmap(stat scratch).
 out = x86_emit_int_rax(out, 0)
 out = append(out, 76); out = append(out, 137); out = append(out, 231)
 out = append(out, 73); out = append(out, 141); out = append(out, 119); out = append(out, 8)
 // read length goes in rdx; overwriting rsi here discarded the destination
 // pointer and passed the stat scratch as the count.
 out = append(out, 76); out = append(out, 137); out = append(out, 242)
 out = x86_emit_syscall_const(out, 0, 4)
 out = x86_emit_syscall_const(out, 0, 5)
 out = x86_emit_syscall_const(out, 0, 6)
 out = append(out, 15); out = append(out, 5)
 out = append(out, 73); out = append(out, 137); out = append(out, 198)
 out = x86_emit_int_rax(out, 3)
 out = append(out, 76); out = append(out, 137); out = append(out, 231)
 out = x86_emit_syscall_const(out, 0, 2); out = x86_emit_syscall_const(out, 0, 3)
 out = x86_emit_syscall_const(out, 0, 4); out = x86_emit_syscall_const(out, 0, 5)
 out = x86_emit_syscall_const(out, 0, 6); out = append(out, 15); out = append(out, 5)
 out = x86_emit_int_rax(out, 11)
 out = append(out, 76); out = append(out, 137); out = append(out, 239)
 out = x86_emit_syscall_const(out, 144, 2); out = x86_emit_syscall_const(out, 0, 3)
 out = x86_emit_syscall_const(out, 0, 4); out = x86_emit_syscall_const(out, 0, 5)
 out = x86_emit_syscall_const(out, 0, 6); out = append(out, 15); out = append(out, 5)
 // Fail closed: a failed open or read leaves a negative count in r14, and
 // storing that as an unsigned length would hand every later reader a
 // multi-exabyte string. Clamp to an empty string instead.
 out = append(out, 77); out = append(out, 133); out = append(out, 246)
 out = append(out, 121); out = append(out, 3)
 out = append(out, 69); out = append(out, 49); out = append(out, 246)
 // Store read count as string length, close the payload with the NUL and
 // newline, and return the buffer. r15 holds the allocation and r14 the
 // count; rax still holds the munmap result, so it must be reloaded.
 out = append(out, 77); out = append(out, 137); out = append(out, 55)
 out = append(out, 67); out = append(out, 198); out = append(out, 68); out = append(out, 55); out = append(out, 8); out = append(out, 0)
 out = append(out, 67); out = append(out, 198); out = append(out, 68); out = append(out, 55); out = append(out, 9); out = append(out, 10)
 out = append(out, 76); out = append(out, 137); out = append(out, 248)
 return x86_emit_store_rax(out, result_slot)
}

fn x86_emit_write_all(bytes: []int, fd_slot: int, pointer_slot: int, length_slot: int, result_slot: int) []int {
 let mut out = x86_emit_load_syscall_arg(bytes, fd_slot, 1)
 out = x86_emit_load_syscall_arg(out, pointer_slot, 2)
 out = x86_emit_load_syscall_arg(out, length_slot, 3)
 let loop_start = len(out)
 out = append(out, 72); out = append(out, 133); out = append(out, 210)
 let done_jump = len(out); out = append(out, 116); out = append(out, 0)
 out = append(out, 184); out = x86_emit_u32(out, 1)
 out = append(out, 15); out = append(out, 5)
 out = append(out, 72); out = append(out, 133); out = append(out, 192)
 let error_jump = len(out); out = append(out, 120); out = append(out, 0)
 out = append(out, 72); out = append(out, 41); out = append(out, 194)
 out = append(out, 72); out = append(out, 1); out = append(out, 198)
 let loop_jump = len(out); out = append(out, 235); out = append(out, 0)
 let done = len(out)
 out[done_jump + 1] = (done - (done_jump + 2)) & 255
 out[loop_jump + 1] = (loop_start - (loop_jump + 2)) & 255
 out = x86_emit_int_rax(out, 0)
 let success_jump = len(out)
 out = append(out, 235); out = append(out, 0)
 let error = len(out)
 out[error_jump + 1] = (error - (error_jump + 2)) & 255
 let finish = len(out)
 out[success_jump + 1] = (finish - (success_jump + 2)) & 255
 return x86_emit_store_rax(out, result_slot)
}

fn x86_emit_write_file_retry(bytes: []int, path_slot: int, contents_slot: int, result_slot: int) []int {
 let mut out = x86_emit_load_rax(bytes, path_slot)
 // openat path points at inline string bytes, not the length word.
 out = append(out, 72); out = append(out, 141); out = append(out, 112); out = append(out, 8)
 out = x86_emit_load_rax(out, contents_slot)
 out = append(out, 73); out = append(out, 137); out = append(out, 197)
 out = x86_emit_int_rax(out, 257)
 out = x86_emit_syscall_const(out, -100, 1)
 out = x86_emit_syscall_const(out, 577, 3)
 out = x86_emit_syscall_const(out, 420, 4)
 out = x86_emit_syscall_const(out, 0, 5)
 out = x86_emit_syscall_const(out, 0, 6)
 out = append(out, 15); out = append(out, 5)
 out = append(out, 73); out = append(out, 137); out = append(out, 196)
 out = append(out, 76); out = append(out, 137); out = append(out, 231)
 // lea rsi, [r13+8] — the payload address. A mov here loaded the first eight
 // payload bytes and passed them to write as a pointer.
 out = append(out, 73); out = append(out, 141); out = append(out, 117); out = append(out, 8)
 out = append(out, 73); out = append(out, 139); out = append(out, 85); out = append(out, 0)
 let loop_start = len(out)
 out = append(out, 72); out = append(out, 133); out = append(out, 210)
 let done_jump = len(out); out = append(out, 116); out = append(out, 0)
 out = append(out, 184); out = x86_emit_u32(out, 1); out = append(out, 15); out = append(out, 5)
 out = append(out, 72); out = append(out, 133); out = append(out, 192)
 let error_jump = len(out); out = append(out, 120); out = append(out, 0)
 out = append(out, 72); out = append(out, 41); out = append(out, 194)
 out = append(out, 72); out = append(out, 1); out = append(out, 198)
 let loop_jump = len(out); out = append(out, 235); out = append(out, 0)
 let done = len(out)
 out[done_jump + 1] = (done - (done_jump + 2)) & 255
 out[loop_jump + 1] = (loop_start - (loop_jump + 2)) & 255
 out = x86_emit_int_rax(out, 0)
 let success_jump = len(out); out = append(out, 235); out = append(out, 0)
 let error = len(out); out[error_jump + 1] = (error - (error_jump + 2)) & 255
 let finish = len(out); out[success_jump + 1] = (finish - (success_jump + 2)) & 255
 out = append(out, 73); out = append(out, 137); out = append(out, 198)
 // mov rdi, r12 is 4C 89 E7; the missing 0x89 decoded as a privileged OUT
 // that also swallowed the following byte.
 out = x86_emit_int_rax(out, 3); out = append(out, 76); out = append(out, 137); out = append(out, 231)
 out = x86_emit_syscall_const(out, 0, 2); out = x86_emit_syscall_const(out, 0, 3)
 out = x86_emit_syscall_const(out, 0, 4); out = x86_emit_syscall_const(out, 0, 5)
 out = x86_emit_syscall_const(out, 0, 6); out = append(out, 15); out = append(out, 5)
 out = append(out, 76); out = append(out, 137); out = append(out, 240)
 return x86_emit_store_rax(out, result_slot)
}

fn x86_emit_read_all(bytes: []int, fd_slot: int, pointer_slot: int, length_slot: int, result_slot: int) []int {
 let mut out = x86_emit_load_syscall_arg(bytes, fd_slot, 1)
 out = x86_emit_load_syscall_arg(out, pointer_slot, 2)
 out = x86_emit_load_syscall_arg(out, length_slot, 3)
 out = append(out, 69); out = append(out, 49); out = append(out, 228)
 let loop_start = len(out)
 out = append(out, 72); out = append(out, 133); out = append(out, 210)
 let done_jump = len(out); out = append(out, 116); out = append(out, 0)
 out = append(out, 49); out = append(out, 192); out = append(out, 15); out = append(out, 5)
 out = append(out, 72); out = append(out, 133); out = append(out, 192)
 let error_jump = len(out); out = append(out, 120); out = append(out, 0)
 let eof_jump = len(out); out = append(out, 116); out = append(out, 0)
 out = append(out, 73); out = append(out, 1); out = append(out, 196)
 out = append(out, 72); out = append(out, 41); out = append(out, 194)
 out = append(out, 72); out = append(out, 1); out = append(out, 198)
 let loop_jump = len(out); out = append(out, 235); out = append(out, 0)
 let done = len(out)
 out[done_jump + 1] = (done - (done_jump + 2)) & 255
 out[eof_jump + 1] = (done - (eof_jump + 2)) & 255
 out[loop_jump + 1] = (loop_start - (loop_jump + 2)) & 255
 out = append(out, 76); out = append(out, 137); out = append(out, 224)
 let success_jump = len(out); out = append(out, 235); out = append(out, 0)
 let error = len(out); out[error_jump + 1] = (error - (error_jump + 2)) & 255
 let finish = len(out); out[success_jump + 1] = (finish - (success_jump + 2)) & 255
 return x86_emit_store_rax(out, result_slot)
}

fn x86_emit_open_string(bytes: []int, path_slot: int, result_slot: int) []int {
 let mut out = x86_emit_load_rax(bytes, path_slot)
 // openat(AT_FDCWD, string bytes, O_RDONLY, 0)
 out = append(out, 72); out = append(out, 141); out = append(out, 112); out = append(out, 8)
 out = x86_emit_int_rax(out, 257)
 out = x86_emit_syscall_const(out, -100, 1)
 out = x86_emit_syscall_const(out, 0, 3)
 out = x86_emit_syscall_const(out, 0, 4)
 out = x86_emit_syscall_const(out, 0, 5)
 out = x86_emit_syscall_const(out, 0, 6)
 out = append(out, 15); out = append(out, 5)
 return x86_emit_store_rax(out, result_slot)
}

fn x86_string_value_owned_at(instructions: []IrInstruction, call_sites: []IrCallSite, value: int, depth: int) bool {
 if depth > len(instructions) { return false }
 let mut i = 0
 while i < len(instructions) {
  if instructions[i].result == value {
   // Every producer that mmaps a string object belongs here. One missing leaks
   // the whole buffer per call; one added that returns a borrow or a static
   // unmaps memory it does not own.
   if instructions[i].op == IR_CALL and instructions[i].aux >= 0 and instructions[i].aux < len(call_sites) and (call_sites[instructions[i].aux].callee_item == -19 or call_sites[instructions[i].aux].callee_item == -20 or call_sites[instructions[i].aux].callee_item == -22 or call_sites[instructions[i].aux].callee_item == -27) {
    return true
   }
   // Concatenation and clone always allocate, so their results are owned
   // whatever the operands were — including `"a" + "b"`, where both are static
   // views into the code image and neither is itself droppable. Neither needs
   // the recursive walk below for that reason.
   if (instructions[i].op == IR_BINARY or instructions[i].op == IR_CLONE) and
    instructions[i].type_kind == SEM_STRING {
    return true
   }
   if instructions[i].op == IR_MOVE and x86_string_value_owned_at(instructions, call_sites, instructions[i].left, depth + 1) {
    return true
   }
  }
  i = i + 1
 }
 return false
}

fn x86_string_value_owned(instructions: []IrInstruction, call_sites: []IrCallSite, value: int) bool {
 return x86_string_value_owned_at(instructions, call_sites, value, 0)
}

// True when `value` is a string parameter of `function` that every reachable
// call site fills with an owned allocation.
//
// A string parameter's nature is invisible from the signature: one caller may
// clone (an allocation), another may move a literal (a static view into the
// code image). Dropping the second unmaps read-only code. So the callee may
// only drop when *every* call site is proven to pass the first — one
// unprovable site, or no call site at all, and the parameter stays borrowed.
// That direction leaks rather than crashes, which is the way this has to fail
// when the proof is missing.
fn x86_string_parameter_owned(instructions: []IrInstruction, call_sites: []IrCallSite, call_arguments: []int, function: IrFunction, value: int) bool {
 // Locate the IR_PARAM that defines this value and read its position.
 let mut parameter_index = -1
 let mut scan = 0
 while scan < len(instructions) {
  if instructions[scan].result == value and instructions[scan].op == IR_PARAM and
   instructions[scan].type_kind == SEM_STRING {
   parameter_index = instructions[scan].aux
  }
  scan = scan + 1
 }
 if parameter_index < 0 { return false }
 let mut proven = false
 let mut i = 0
 while i < len(call_sites) {
  if call_sites[i].callee_item == function.item {
   if parameter_index >= call_sites[i].argument_count { return false }
   let at = call_sites[i].argument_start + parameter_index
   if at < 0 or at >= len(call_arguments) { return false }
   if not x86_string_value_owned(instructions, call_sites, call_arguments[at]) { return false }
   proven = true
  }
  i = i + 1
 }
 return proven
}

fn x86_emit_drop_owned_string(bytes: []int, slot: int) []int {
 let mut out = x86_emit_load_rax(bytes, slot)
 // munmap(string, string.length + 10). The producers map length + 10 — the
 // header word, the payload, a NUL and a newline — so unmapping length + 8
 // leaves the final page mapped whenever length + 8 lands exactly on a page
 // boundary. The size here has to match what was mapped.
 out = append(out, 72); out = append(out, 137); out = append(out, 199)
 out = append(out, 72); out = append(out, 139); out = append(out, 48)
 out = append(out, 72); out = append(out, 131); out = append(out, 198); out = append(out, 10)
 out = x86_emit_int_rax(out, 11)
 out = x86_emit_syscall_const(out, 0, 3)
 out = x86_emit_syscall_const(out, 0, 4)
 out = x86_emit_syscall_const(out, 0, 5)
 out = x86_emit_syscall_const(out, 0, 6)
 out = append(out, 15); out = append(out, 5)
 return out
}
