// Primitive semantic typing over flat arenas. Integer codes keep this pass
// compact and make unresolved types explicit rather than pointer-shaped.

const SEM_UNKNOWN = 0
const SEM_INT = 1
const SEM_FLOAT = 2
const SEM_BOOL = 3
const SEM_STRING = 4
const SEM_ARRAY_INT = 5
const SEM_ARRAY_FLOAT = 6
const SEM_ARRAY_BOOL = 7
const SEM_ARRAY_STRING = 8
const SEM_MAP = 9
const SEM_BYTE = 10
const SEM_ARRAY_BYTE = 11

// A slice of a user-defined struct is encoded as one integer carrying both the
// struct's identity and its width:
//
//     kind = SEM_ARRAY_STRUCT_BASE + struct_index * SEM_STRUCT_WIDTH_UNIT + field_count
//
// The identity half keeps two different structs from being interchangeable
// even when they have the same number of fields. The width half lets the
// backend compute the element stride from the kind alone, so no pass below the
// type checker has to be handed the struct table.
const SEM_ARRAY_STRUCT_BASE = 100000
const SEM_STRUCT_WIDTH_UNIT = 64

// A struct *value* kind names a local bound directly to a slice element. It
// exists only so such a local has a type and a field read can resolve through
// it; it is never materialised. `ir_cfg_bindable_type` rejects it, so it can
// never occupy a slot, be passed, or be returned, and `ir_type_is_owned`
// rejects it too, since it is a view into a slice that owns the storage.
// The range sits above every possible slice kind so the two never overlap.
const SEM_STRUCT_VALUE_BASE = 10000000


// Field layout for user-defined structs.
//
// Only a struct whose every field is a one-slot scalar is marked eligible. A
// slice of those is a plain heap block with a fixed stride: it drops exactly
// like any other slice and no element needs a drop of its own. A struct with
// an owned field would need per-element ownership at the drop, so it is left
// ineligible and every use of it keeps failing closed rather than leaking a
// field or freeing one twice.
struct StructLayout {
    name_start: []int
    name_end: []int
    field_start: []int
    field_count: []int
    field_name_start: []int
    field_name_end: []int
    field_type: []int
    eligible: []bool
}

// The semantic kind of a one-slot scalar type name, or SEM_UNKNOWN.
fn semantic_scalar_named(name: string) -> int {
    if name == "int" or name == "int64" { return SEM_INT }
    if name == "float" or name == "float64" { return SEM_FLOAT }
    if name == "bool" { return SEM_BOOL }
    if name == "byte" or name == "uint8" { return SEM_BYTE }
    return SEM_UNKNOWN
}

fn semantic_is_struct_array(kind: int) -> bool {
    return kind >= SEM_ARRAY_STRUCT_BASE and kind < SEM_STRUCT_VALUE_BASE
}

fn semantic_is_struct_value(kind: int) -> bool {
    return kind >= SEM_STRUCT_VALUE_BASE
}

// The value kind for the element of a slice kind, or SEM_UNKNOWN.
fn semantic_struct_value_of(slice_kind: int) -> int {
    if not semantic_is_struct_array(slice_kind) { return SEM_UNKNOWN }
    return SEM_STRUCT_VALUE_BASE + (slice_kind - SEM_ARRAY_STRUCT_BASE)
}

// The slice kind a value kind came from, or SEM_UNKNOWN.
fn semantic_struct_array_of_value(value_kind: int) -> int {
    if not semantic_is_struct_value(value_kind) { return SEM_UNKNOWN }
    return SEM_ARRAY_STRUCT_BASE + (value_kind - SEM_STRUCT_VALUE_BASE)
}

// The struct a slice kind names, or -1.
fn struct_kind_index(kind: int) -> int {
    let normalized = if semantic_is_struct_value(kind) { semantic_struct_array_of_value(kind) } else { kind }
    if not semantic_is_struct_array(normalized) { return -1 }
    return (normalized - SEM_ARRAY_STRUCT_BASE) / SEM_STRUCT_WIDTH_UNIT
}

// Fields per element, which is also the element width in slots. Zero when the
// kind is not a struct slice, so a caller that forgets to check still gets a
// stride of zero rather than a plausible wrong one.
fn struct_kind_fields(kind: int) -> int {
    let normalized = if semantic_is_struct_value(kind) { semantic_struct_array_of_value(kind) } else { kind }
    if not semantic_is_struct_array(normalized) { return 0 }
    return (normalized - SEM_ARRAY_STRUCT_BASE) - struct_kind_index(normalized) * SEM_STRUCT_WIDTH_UNIT
}

// Build the slice kind for a struct, or SEM_UNKNOWN when it is ineligible or
// too wide to encode.
fn semantic_struct_array_kind(layout: StructLayout, struct_index: int) -> int {
    if struct_index < 0 or struct_index >= len(layout.field_count) { return SEM_UNKNOWN }
    if not layout.eligible[struct_index] { return SEM_UNKNOWN }
    let fields = layout.field_count[struct_index]
    if fields < 1 or fields >= SEM_STRUCT_WIDTH_UNIT { return SEM_UNKNOWN }
    return SEM_ARRAY_STRUCT_BASE + struct_index * SEM_STRUCT_WIDTH_UNIT + fields
}

// Walk each struct item's body and record its fields. A field is an
// identifier, a colon, and a single type token; anything else (a slice, a map,
// another struct) makes the whole struct ineligible, which is the conservative
// direction.
fn build_struct_layout(source: string, tokens: []Token, items: []TopItem) -> StructLayout {
    let mut name_start: []int = make([]int, 0, 8)
    let mut name_end: []int = make([]int, 0, 8)
    let mut field_start: []int = make([]int, 0, 8)
    let mut field_count: []int = make([]int, 0, 8)
    let mut field_name_start: []int = make([]int, 0, 32)
    let mut field_name_end: []int = make([]int, 0, 32)
    let mut field_type: []int = make([]int, 0, 32)
    let mut eligible: []bool = make([]bool, 0, 8)
    let mut item_index = 0
    while item_index < len(items) {
        let item = items[item_index]
        if item.kind == ITEM_STRUCT {
            let start = len(field_name_start)
            let mut count = 0
            let mut ok = true
            let mut scan = item.body_start
            while ok and scan + 2 < item.body_end and scan + 2 < len(tokens) {
                if tokens[scan].kind == TK_IDENT and tokens[scan + 1].kind == TK_COLON {
                    let type_token = scan + 2
                    let kind = if tokens[type_token].kind == TK_IDENT {
                        semantic_scalar_named(token_text(source, tokens[type_token]))
                    } else {
                        SEM_UNKNOWN
                    }
                    if kind == SEM_UNKNOWN {
                        ok = false
                    } else {
                        field_name_start = append(field_name_start, tokens[scan].start)
                        field_name_end = append(field_name_end, tokens[scan].end)
                        field_type = append(field_type, kind)
                        count = count + 1
                        scan = scan + 3
                    }
                } else {
                    scan = scan + 1
                }
            }
            if count == 0 { ok = false }
            name_start = append(name_start, item.name_start)
            name_end = append(name_end, item.name_end)
            field_start = append(field_start, start)
            field_count = append(field_count, count)
            eligible = append(eligible, ok)
        }
        item_index = item_index + 1
    }
    return StructLayout {
        name_start: name_start, name_end: name_end,
        field_start: field_start, field_count: field_count,
        field_name_start: field_name_start, field_name_end: field_name_end,
        field_type: field_type, eligible: eligible,
    }
}

// Index of an eligible struct by source name, or -1.
fn struct_layout_lookup(layout: StructLayout, source: string, name: string) -> int {
    let mut i = 0
    while i < len(layout.name_start) {
        if layout.eligible[i] and source[layout.name_start[i]:layout.name_end[i]] == name {
            return i
        }
        i = i + 1
    }
    return -1
}

// Position of a field within a struct, or -1. The position is also its slot:
// every eligible field is one slot wide.
fn struct_field_slot(layout: StructLayout, source: string, struct_index: int, field: string) -> int {
    if struct_index < 0 or struct_index >= len(layout.field_start) { return -1 }
    let mut i = 0
    while i < layout.field_count[struct_index] {
        let at = layout.field_start[struct_index] + i
        if source[layout.field_name_start[at]:layout.field_name_end[at]] == field { return i }
        i = i + 1
    }
    return -1
}

fn struct_field_type(layout: StructLayout, struct_index: int, slot: int) -> int {
    if struct_index < 0 or struct_index >= len(layout.field_start) { return SEM_UNKNOWN }
    if slot < 0 or slot >= layout.field_count[struct_index] { return SEM_UNKNOWN }
    return layout.field_type[layout.field_start[struct_index] + slot]
}

fn struct_layout_smoke_test() -> bool {
    let source = "struct Pair { a: int  b: bool }\nstruct Owning { name: string }\nstruct Sliced { xs: []int }"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let structure = parse_structure(source, lexed.tokens)
    if not structure.ok { return false }
    let layout = build_struct_layout(source, lexed.tokens, structure.items)
    if len(layout.eligible) != 3 { return false }
    // A struct of one-slot scalars is eligible and its fields keep source order.
    let pair = struct_layout_lookup(layout, source, "Pair")
    if pair < 0 or layout.field_count[pair] != 2 { return false }
    if struct_field_slot(layout, source, pair, "a") != 0 { return false }
    if struct_field_slot(layout, source, pair, "b") != 1 { return false }
    if struct_field_type(layout, pair, 0) != SEM_INT { return false }
    if struct_field_type(layout, pair, 1) != SEM_BOOL { return false }
    if struct_field_slot(layout, source, pair, "missing") >= 0 { return false }
    // An owned or aggregate field makes the struct ineligible, and an
    // ineligible struct is invisible to lookup so no caller can bind one.
    if struct_layout_lookup(layout, source, "Owning") >= 0 { return false }
    if struct_layout_lookup(layout, source, "Sliced") >= 0 { return false }
    if struct_field_type(layout, pair, 2) != SEM_UNKNOWN { return false }
    if struct_field_type(layout, -1, 0) != SEM_UNKNOWN { return false }
    // The slice kind round-trips to both halves it encodes.
    let pair_slice = semantic_struct_array_kind(layout, pair)
    if pair_slice == SEM_UNKNOWN or not semantic_is_struct_array(pair_slice) { return false }
    if struct_kind_index(pair_slice) != pair { return false }
    if struct_kind_fields(pair_slice) != 2 { return false }
    // An ineligible struct has no slice kind, so it can never be bound.
    if semantic_struct_array_kind(layout, 1) != SEM_UNKNOWN { return false }
    if semantic_struct_array_kind(layout, -1) != SEM_UNKNOWN { return false }
    // A builtin kind is never mistaken for a struct slice, and asking a
    // non-struct kind for a stride yields zero rather than a plausible width.
    if semantic_is_struct_array(SEM_ARRAY_INT) or semantic_is_struct_array(SEM_INT) { return false }
    if struct_kind_fields(SEM_ARRAY_BYTE) != 0 or struct_kind_index(SEM_ARRAY_BYTE) != -1 { return false }
    return true
}

// Two structs of equal width must not share a kind, or a slice of one could be
// bound where the other is expected.
fn struct_kind_distinct_smoke_test() -> bool {
    let source = "struct Alpha { a: int  b: int }\nstruct Beta { c: int  d: int }"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let structure = parse_structure(source, lexed.tokens)
    if not structure.ok { return false }
    let layout = build_struct_layout(source, lexed.tokens, structure.items)
    let alpha = struct_layout_lookup(layout, source, "Alpha")
    let beta = struct_layout_lookup(layout, source, "Beta")
    if alpha < 0 or beta < 0 or alpha == beta { return false }
    let alpha_slice = semantic_struct_array_kind(layout, alpha)
    let beta_slice = semantic_struct_array_kind(layout, beta)
    if alpha_slice == SEM_UNKNOWN or beta_slice == SEM_UNKNOWN { return false }
    if alpha_slice == beta_slice { return false }
    // Same width, different identity.
    if struct_kind_fields(alpha_slice) != struct_kind_fields(beta_slice) { return false }
    if struct_kind_index(alpha_slice) != alpha or struct_kind_index(beta_slice) != beta { return false }
    // The element's value kind round-trips, and is never mistaken for a slice.
    let alpha_value = semantic_struct_value_of(alpha_slice)
    if not semantic_is_struct_value(alpha_value) or semantic_is_struct_array(alpha_value) { return false }
    if semantic_struct_array_of_value(alpha_value) != alpha_slice { return false }
    if struct_kind_index(alpha_value) != alpha or struct_kind_fields(alpha_value) != 2 { return false }
    // A slice kind is not a value kind, and a builtin is neither.
    if semantic_is_struct_value(alpha_slice) or semantic_is_struct_value(SEM_ARRAY_INT) { return false }
    if semantic_struct_value_of(SEM_ARRAY_INT) != SEM_UNKNOWN { return false }
    return true
}


fn semantic_declared_type(source: string, tokens: []Token, types: []TypeNode, type_edges: []int, layout: StructLayout, root: int) -> int {
    if root < 0 or root >= len(types) { return SEM_UNKNOWN }
    let node = types[root]
    if node.kind == TYPE_MAP { return SEM_MAP }
    if node.kind == TYPE_ARRAY and node.edge_count == 1 and node.edge_start >= 0 and node.edge_start < len(type_edges) {
        let element_root = type_edges[node.edge_start]
        if element_root < 0 or element_root >= len(types) { return SEM_UNKNOWN }
        let element = types[element_root]
        if element.kind != TYPE_NAMED or element.token < 0 or element.token >= len(tokens) { return SEM_UNKNOWN }
        let element_name = token_text(source, tokens[element.token])
        if element_name == "int" or element_name == "int64" { return SEM_ARRAY_INT }
        if element_name == "float" or element_name == "float64" { return SEM_ARRAY_FLOAT }
        if element_name == "bool" { return SEM_ARRAY_BOOL }
        if element_name == "string" { return SEM_ARRAY_STRING }
        if element_name == "byte" or element_name == "uint8" { return SEM_ARRAY_BYTE }
        // Not a builtin element: a slice of an eligible user struct. An
        // ineligible one is absent from the table, so this stays unknown and
        // every later pass keeps failing closed on it.
        return semantic_struct_array_kind(layout, struct_layout_lookup(layout, source, element_name))
    }
    if node.kind != TYPE_NAMED or node.token < 0 or node.token >= len(tokens) { return SEM_UNKNOWN }
    let name = token_text(source, tokens[node.token])
    if name == "int" or name == "int64" { return SEM_INT }
    if name == "float" or name == "float64" { return SEM_FLOAT }
    if name == "bool" { return SEM_BOOL }
    if name == "string" { return SEM_STRING }
    if name == "byte" or name == "uint8" { return SEM_BYTE }
    // A parameter or local declared as an eligible struct is one borrowed
    // element: the caller owns the storage, and every field is a scalar, so
    // the callee can read fields but can never free or copy anything.
    return semantic_struct_value_of(semantic_struct_array_kind(layout, struct_layout_lookup(layout, source, name)))
}

fn semantic_array_of(element: int) -> int {
    if element == SEM_INT { return SEM_ARRAY_INT }
    if element == SEM_FLOAT { return SEM_ARRAY_FLOAT }
    if element == SEM_BOOL { return SEM_ARRAY_BOOL }
    if element == SEM_STRING { return SEM_ARRAY_STRING }
    if element == SEM_BYTE { return SEM_ARRAY_BYTE }
    return SEM_UNKNOWN
}

// Any slice, builtin or user struct. Element extraction stays narrow on
// purpose: the element of a struct slice is a struct value, which this
// bring-up does not model, so `semantic_array_element` keeps returning unknown
// for one and only length-like queries widen.
fn semantic_is_slice(kind: int) -> bool {
    return semantic_array_element(kind) != SEM_UNKNOWN or semantic_is_struct_array(kind)
}

fn semantic_array_element(array: int) -> int {
    if array == SEM_ARRAY_INT { return SEM_INT }
    if array == SEM_ARRAY_FLOAT { return SEM_FLOAT }
    if array == SEM_ARRAY_BOOL { return SEM_BOOL }
    if array == SEM_ARRAY_STRING { return SEM_STRING }
    if array == SEM_ARRAY_BYTE { return SEM_BYTE }
    return SEM_UNKNOWN
}

fn semantic_is_number(kind: int) -> bool {
    return kind == SEM_INT or kind == SEM_FLOAT
}

fn semantic_is_arithmetic(operator: int) -> bool {
    return operator == TK_PLUS or operator == TK_MINUS or operator == TK_STAR or
        operator == TK_SLASH or operator == TK_PERCENT
}

fn semantic_is_equality(operator: int) -> bool {
    return operator == TK_EQ_EQ or operator == TK_BANG_EQ
}

fn semantic_is_ordered(operator: int) -> bool {
    return operator == TK_LT or operator == TK_LE or operator == TK_GT or operator == TK_GE
}

fn semantic_is_logical(operator: int) -> bool {
    return operator == TK_AMP_AMP or operator == TK_PIPE_PIPE or operator == TK_AND or operator == TK_OR
}

fn semantic_is_bitwise(operator: int) -> bool {
    return operator == TK_AMP or operator == TK_PIPE or operator == TK_CARET or
        operator == TK_AMP_CARET or operator == TK_SHL or operator == TK_SHR
}

fn semantic_type_reference(source: string, tokens: []Token, layout: StructLayout, expression: ExprNode) -> int {
    if expression.kind != EXPR_TYPE_REF or expression.token < 0 or expression.token >= len(tokens) {
        return SEM_UNKNOWN
    }
    let start = tokens[expression.token]
    if start.kind == TK_IDENT and token_text(source, start) == "map" { return SEM_MAP }
    if start.kind != TK_LBRACKET { return SEM_UNKNOWN }
    let mut element_token = expression.token + 1
    if element_token < len(tokens) and tokens[element_token].kind == TK_RBRACKET {
        element_token = element_token + 1
    }
    if element_token < 0 or element_token >= len(tokens) or tokens[element_token].kind != TK_IDENT {
        return SEM_UNKNOWN
    }
    let name = token_text(source, tokens[element_token])
    if name == "int" or name == "int64" { return SEM_ARRAY_INT }
    if name == "float" or name == "float64" { return SEM_ARRAY_FLOAT }
    if name == "bool" { return SEM_ARRAY_BOOL }
    if name == "string" { return SEM_ARRAY_STRING }
    if name == "byte" or name == "uint8" { return SEM_ARRAY_BYTE }
    // A `make([]Struct, ...)` names an eligible struct; an ineligible one is
    // absent from the table and stays unknown.
    return semantic_struct_array_kind(layout, struct_layout_lookup(layout, source, name))
}

fn semantic_type_name(kind: int) -> string {
    if semantic_is_struct_array(kind) { return "[]struct" }
    if kind == SEM_INT { return "int" }
    if kind == SEM_FLOAT { return "float" }
    if kind == SEM_BOOL { return "bool" }
    if kind == SEM_STRING { return "string" }
    if kind == SEM_BYTE { return "byte" }
    if kind == SEM_ARRAY_INT { return "[]int" }
    if kind == SEM_ARRAY_FLOAT { return "[]float" }
    if kind == SEM_ARRAY_BOOL { return "[]bool" }
    if kind == SEM_ARRAY_STRING { return "[]string" }
    if kind == SEM_MAP { return "map" }
    return "unknown"
}

fn semantic_is_unbound_identifier(expression_symbols: []int, expression_locals: []int, expression: int) -> bool {
    return expression >= 0 and expression < len(expression_symbols) and expression < len(expression_locals) and
        expression_symbols[expression] < 0 and expression_locals[expression] < 0
}

fn semantic_function_result(
    source: string,
    tokens: []Token,
    types: []TypeNode,
    type_edges: []int,
    signatures: []FnSignature,
    symbols: []Symbol,
    expression_symbols: []int,
    layout: StructLayout,
    callee: int
) -> int {
    if callee < 0 or callee >= len(expression_symbols) { return SEM_UNKNOWN }
    let symbol_index = expression_symbols[callee]
    if symbol_index < 0 or symbol_index >= len(symbols) { return SEM_UNKNOWN }
    let symbol = symbols[symbol_index]
    if symbol.kind != ITEM_FN { return SEM_UNKNOWN }
    let mut i = 0
    while i < len(signatures) {
        let signature = signatures[i]
        if signature.item == symbol.item {
            return semantic_declared_type(source, tokens, types, type_edges, layout, signature.result_type)
        }
        i = i + 1
    }
    return SEM_UNKNOWN
}

fn semantic_function_signature(
    signatures: []FnSignature,
    symbols: []Symbol,
    expression_symbols: []int,
    callee: int
) -> int {
    if callee < 0 or callee >= len(expression_symbols) { return -1 }
    let symbol_index = expression_symbols[callee]
    if symbol_index < 0 or symbol_index >= len(symbols) { return -1 }
    let symbol = symbols[symbol_index]
    if symbol.kind != ITEM_FN { return -1 }
    let mut i = 0
    while i < len(signatures) {
        if signatures[i].item == symbol.item { return i }
        i = i + 1
    }
    return -1
}

// Semantic type of the global `const` an identifier resolves to, or
// SEM_UNKNOWN. A const item records no body range — the parser stops it at
// end-of-line — so the initializer is the token run after its `=`. Only a
// single literal is classified here; a computed initializer stays unknown and
// therefore stays deferred rather than being guessed.
fn semantic_const_reference_type(
    source: string, tokens: []Token, items: []TopItem, symbols: []Symbol,
    expression_symbols: []int, expression_index: int
) -> int {
    if expression_index < 0 or expression_index >= len(expression_symbols) { return SEM_UNKNOWN }
    let symbol_index = expression_symbols[expression_index]
    if symbol_index < 0 or symbol_index >= len(symbols) { return SEM_UNKNOWN }
    let item_index = symbols[symbol_index].item
    if item_index < 0 or item_index >= len(items) { return SEM_UNKNOWN }
    let item = items[item_index]
    if item.kind != ITEM_CONST { return SEM_UNKNOWN }
    let mut scan = item.token_start
    let mut assign = -1
    while scan < item.token_end and scan < len(tokens) {
        if tokens[scan].kind == TK_ASSIGN {
            assign = scan
            scan = item.token_end
        } else {
            scan = scan + 1
        }
    }
    if assign < 0 { return SEM_UNKNOWN }
    let mut value_index = assign + 1
    if value_index < item.token_end and value_index < len(tokens) and tokens[value_index].kind == TK_MINUS {
        value_index = value_index + 1
    }
    if value_index >= item.token_end or value_index >= len(tokens) { return SEM_UNKNOWN }
    // Reject anything past the literal so `const A = B + 1` stays unknown.
    if value_index + 1 < item.token_end and value_index + 1 < len(tokens) and
        tokens[value_index + 1].kind != TK_SEMICOLON {
        return SEM_UNKNOWN
    }
    let kind = tokens[value_index].kind
    if kind == TK_INT { return SEM_INT }
    if kind == TK_FLOAT { return SEM_FLOAT }
    if kind == TK_STRING { return SEM_STRING }
    if kind == TK_TRUE or kind == TK_FALSE { return SEM_BOOL }
    return SEM_UNKNOWN
}

fn infer_semantic_types(
    source: string,
    tokens: []Token,
    items: []TopItem,
    types: []TypeNode,
    type_edges: []int,
    signatures: []FnSignature,
    statements: []StmtNode,
    expressions: []ExprNode,
    symbols: []Symbol,
    expression_symbols: []int,
    expression_locals: []int,
    locals: []LocalBinding
) -> TypeInference {
    let layout = build_struct_layout(source, tokens, items)
    let mut expression_types = make([]int, len(expressions), len(expressions))
    let mut local_types = make([]int, len(locals), len(locals))
    let mut initializer_owner = make([]int, len(expressions), len(expressions))
    let mut i = 0
    while i < len(initializer_owner) {
        initializer_owner[i] = -1
        i = i + 1
    }
    i = 0
    while i < len(locals) {
        let local = locals[i]
        if local.is_parameter {
            local_types[i] = semantic_declared_type(source, tokens, types, type_edges, layout, local.type_root)
        }
        if local.initializer_root >= 0 and local.initializer_root < len(expressions) {
            initializer_owner[local.initializer_root] = i
        }
        i = i + 1
    }

    // Two linear passes cover source-ordered initializer chains while keeping
    // runtime bounded. A later SSA worklist will replace this bootstrap pass.
    let mut pass = 0
    while pass < 2 {
        i = 0
        while i < len(expressions) {
            let expression = expressions[i]
            let mut inferred = expression_types[i]
            if expression.kind == EXPR_INT { inferred = SEM_INT }
            if expression.kind == EXPR_FLOAT { inferred = SEM_FLOAT }
            if expression.kind == EXPR_BOOL { inferred = SEM_BOOL }
            if expression.kind == EXPR_STRING { inferred = SEM_STRING }
            if expression.kind == EXPR_IDENT and i < len(expression_locals) and expression_locals[i] >= 0 and expression_locals[i] < len(local_types) {
                inferred = local_types[expression_locals[i]]
            } else if expression.kind == EXPR_IDENT and inferred == SEM_UNKNOWN {
                // A reference to a global `const` takes its initializer's type.
                // Without this the reference stays unknown and every operator
                // built on it stays unknown too, which reads downstream as an
                // unsupported expression rather than a typed constant.
                inferred = semantic_const_reference_type(source, tokens, items, symbols, expression_symbols, i)
            }
            if expression.kind == EXPR_UNARY and expression.left >= 0 {
                let operand = expression_types[expression.left]
                let operator = tokens[expression.token].kind
                inferred = SEM_UNKNOWN
                if operator == TK_MINUS and semantic_is_number(operand) { inferred = operand }
                if (operator == TK_BANG or operator == TK_NOT) and operand == SEM_BOOL {
                    inferred = SEM_BOOL
                }
                if operator == TK_CARET and operand == SEM_INT { inferred = SEM_INT }
            }
            if expression.kind == EXPR_BINARY and expression.left >= 0 and expression.right >= 0 {
                let left = expression_types[expression.left]
                let right = expression_types[expression.right]
                let operator = tokens[expression.token].kind
                inferred = SEM_UNKNOWN
