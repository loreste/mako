                    }
                }
            }
            if expression.kind == EXPR_INDEX and expression.left >= 0 {
                inferred = semantic_array_element(expression_types[expression.left])
            }
            if expression.kind == EXPR_SLICE and expression.left >= 0 {
                inferred = expression_types[expression.left]
            }
            if expression.kind == EXPR_CALL and expression.left >= 0 {
                let callee = expressions[expression.left]
                if callee.kind == EXPR_IDENT {
                    if semantic_is_unbound_identifier(expression_symbols, expression_locals, expression.left) {
                        let name = token_text(source, tokens[callee.token])
                        if name == "len" or name == "cap" { inferred = SEM_INT }
                        // Int rather than byte: out of range it yields -1, which
                        // a byte cannot hold and which the lexer reads as end of
                        // input.
                        if name == "str_byte_at" { inferred = SEM_INT }
 if name == "format_int" { inferred = SEM_STRING }
 if name == "arg_get" { inferred = SEM_STRING }
                        if name == "byte" { inferred = SEM_BYTE }
 if name == "argc" or name == "linux_syscall6" { inferred = SEM_INT }
 if name == "unsafe_ptr_load8" or name == "unsafe_ptr_store8" or name == "unsafe_alloc" or name == "unsafe_free" or name == "unsafe_write" { inferred = SEM_INT }
 if name == "unsafe_write_bytes" { inferred = SEM_INT }
 if name == "unsafe_read_bytes" { inferred = SEM_INT }
 if name == "unsafe_open_bytes" { inferred = SEM_INT }
 if name == "unsafe_argv_ptr" or name == "unsafe_argv_len" { inferred = SEM_INT }
 if name == "unsafe_argv_byte" { inferred = SEM_BYTE }
 if name == "unsafe_argv_copy" { inferred = SEM_INT }
 if name == "unsafe_bytes_to_string" { inferred = SEM_STRING }
 if name == "unsafe_close" { inferred = SEM_INT }
 if name == "unsafe_read_file" { inferred = SEM_STRING }
 if name == "unsafe_write_file" { inferred = SEM_INT }
 if name == "unsafe_write_all" { inferred = SEM_INT }
 if name == "unsafe_read_all" { inferred = SEM_INT }
if name == "unsafe_open_string" { inferred = SEM_INT }
 if name == "append" {
                            // `append` returns its first argument's slice type,
                            // not always []byte. Hard-coding []byte typed every
                            // `[]int` append as bytes, so indexing the result
                            // produced a byte and `element + int` was rejected
                            // as an arithmetic error on unrelated operands.
                            let appended = if expression.right >= 0 and expression.right < len(expression_types) {
                                expression_types[expression.right]
                            } else {
                                SEM_UNKNOWN
                            }
                            inferred = if semantic_array_element(appended) != SEM_UNKNOWN { appended } else { SEM_UNKNOWN }
                        }
                        // Statement intrinsics: print and exit produce no
                        // value; the int marker keeps them out of the
                        // unknown-type rejection while the IR lowering treats
                        // them as statement operations.
                        if name == "print" or name == "exit" { inferred = SEM_INT }
                    }
                    if inferred == SEM_UNKNOWN {
                        inferred = semantic_function_result(
                            source, tokens, types, type_edges, signatures, symbols,
                            expression_symbols, layout, expression.left
                        )
                    }
                } else if callee.kind == EXPR_CALL {
                    inferred = expression_types[expression.left]
                }
            }
            // An index into a slice of structs names an element. The kind
            // exists so a local bound to it has a type; it is never
            // materialised, and every consumer other than a field read
            // rejects it.
            if expression.kind == EXPR_INDEX and expression.left >= 0 and
                expression.left < len(expression_types) and
                semantic_is_struct_array(expression_types[expression.left]) {
                inferred = semantic_struct_value_of(expression_types[expression.left])
            }
            // `slice[i].field` on a slice of an eligible struct. The index
            // itself stays untyped on purpose: its value is a struct, which
            // this bring-up does not model. Only the fused field read has a
            // type, and it is the field's own.
            if expression.kind == EXPR_FIELD and expression.left >= 0 and
                expression.left < len(expressions) and expression.token >= 0 and
                expression.token < len(tokens) {
                // Simplest case first: the object already has a struct value
                // type. That covers a parameter declared as a struct and a
                // local bound to an element, without looking at how either
                // came to be.
