                            name == "unsafe_alloc" or name == "unsafe_free" or name == "unsafe_write" or name == "unsafe_write_bytes" or name == "unsafe_write_all" or name == "unsafe_read_all" or name == "unsafe_read_bytes" or name == "unsafe_open_bytes" or name == "unsafe_open_string" or name == "unsafe_close" or name == "unsafe_read_file" or name == "unsafe_write_file" or name == "unsafe_argv_ptr" or name == "unsafe_argv_len" or name == "unsafe_argv_byte" or name == "unsafe_argv_copy" or name == "unsafe_bytes_to_string" or name == "append"
