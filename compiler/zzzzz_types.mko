                            let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                            return TypeInference { expression_types: expression_types, local_types: local_types, typed_expressions: typed, ok: false, error: "unsafe_argv_ptr needs exactly one argument", error_line: line, error_col: col, }
                        }
                        if name == "unsafe_argv_len" and argument_count != 1 {
                            let error_token = expressions[i].token
                            let line = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].line } else { 0 }
                            let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                            return TypeInference { expression_types: expression_types, local_types: local_types, typed_expressions: typed, ok: false, error: "unsafe_argv_len needs exactly one argument", error_line: line, error_col: col, }
                        }
                        if name == "unsafe_argv_byte" and argument_count != 2 {
                            let error_token = expressions[i].token
                            let line = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].line } else { 0 }
                            let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                            return TypeInference { expression_types: expression_types, local_types: local_types, typed_expressions: typed, ok: false, error: "unsafe_argv_byte needs exactly two arguments", error_line: line, error_col: col, }
