                            let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                            return TypeInference { expression_types: expression_types, local_types: local_types, typed_expressions: typed, ok: false, error: "unsafe_argv_copy needs exactly two arguments", error_line: line, error_col: col, }
                        }
