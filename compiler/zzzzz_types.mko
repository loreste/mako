                            let error_token = expressions[i].token
                            let line = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].line } else { 0 }
                            let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                            return TypeInference { expression_types: expression_types, local_types: local_types, typed_expressions: typed, ok: false, error: "unsafe_bytes_to_string needs exactly one argument", error_line: line, error_col: col, }
                        }
                        if name == "unsafe_close" and argument_count != 1 {
                            let error_token = expressions[i].token
                            let line = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].line } else { 0 }
                            let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                            return TypeInference { expression_types: expression_types, local_types: local_types, typed_expressions: typed, ok: false, error: "unsafe_close needs exactly one argument", error_line: line, error_col: col, }
