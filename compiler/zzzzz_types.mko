                            let error_token = expressions[i].token
                            let line = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].line } else { 0 }
                            let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                            return TypeInference { expression_types: expression_types, local_types: local_types, typed_expressions: typed, ok: false, error: "unsafe_read_file needs exactly one argument", error_line: line, error_col: col, }
                        }
                        if name == "unsafe_write_file" and argument_count != 2 {
                            let error_token = expressions[i].token
                            let line = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].line } else { 0 }
                            let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                            return TypeInference { expression_types: expression_types, local_types: local_types, typed_expressions: typed, ok: false, error: "unsafe_write_file needs exactly two arguments", error_line: line, error_col: col, }
                        }
                        if name == "unsafe_write_all" and argument_count != 3 {
                            let error_token = expressions[i].token
                            let line = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].line } else { 0 }
                            let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                            return TypeInference { expression_types: expression_types, local_types: local_types, typed_expressions: typed, ok: false, error: "unsafe_write_all needs exactly three arguments", error_line: line, error_col: col, }
                        }
                        if name == "unsafe_read_all" and argument_count != 3 {
                            let error_token = expressions[i].token
                            let line = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].line } else { 0 }
                            let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                            return TypeInference { expression_types: expression_types, local_types: local_types, typed_expressions: typed, ok: false, error: "unsafe_read_all needs exactly three arguments", error_line: line, error_col: col, }
                        }
if name == "unsafe_open_string" and argument_count != 1 {
                            let error_token = expressions[i].token
                            let line = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].line } else { 0 }
                            let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                            return TypeInference { expression_types: expression_types, local_types: local_types, typed_expressions: typed, ok: false, error: "unsafe_open_string needs exactly one argument", error_line: line, error_col: col, }
                        }
                        if name == "append" and argument_count != 2 {
                            let error_token = expressions[i].token
                            let line = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].line } else { 0 }
                            let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                            return TypeInference { expression_types: expression_types, local_types: local_types, typed_expressions: typed, ok: false, error: "append needs exactly two arguments", error_line: line, error_col: col, }
                        }
                        if name == "unsafe_write" and argument_count == 3 {
                            let mut cursor_write = i
                            let mut write_arg_index = 0
                            let mut bad_write_argument = -1
                            while write_arg_index < 3 and cursor_write >= 0 and cursor_write < len(expressions) {
                                let write_argument = expressions[cursor_write].right
                                if write_argument >= 0 and write_argument < len(expression_types) and expression_types[write_argument] != SEM_UNKNOWN and expression_types[write_argument] != SEM_INT { bad_write_argument = write_argument }
                                cursor_write = expressions[cursor_write].left
                                write_arg_index = write_arg_index + 1
                            }
                            if bad_write_argument >= 0 {
                                let error_token = expressions[bad_write_argument].token
                                let line = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].line } else { 0 }
                                let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                                return TypeInference { expression_types: expression_types, local_types: local_types, typed_expressions: typed, ok: false, error: "unsafe_write needs int fd pointer and length, got " + semantic_type_name(expression_types[bad_write_argument]), error_line: line, error_col: col, }
                            }
                        }
                        if name == "unsafe_ptr_store8" and argument_count == 2 {
                            let value_argument = expressions[i].right
                            let pointer_call = expressions[i].left
                            let pointer_argument = if pointer_call >= 0 and pointer_call < len(expressions) { expressions[pointer_call].right } else { -1 }
                            let mut bad_argument = -1
                            if value_argument >= 0 and value_argument < len(expression_types) and expression_types[value_argument] != SEM_UNKNOWN and expression_types[value_argument] != SEM_INT { bad_argument = value_argument }
                            if pointer_argument >= 0 and pointer_argument < len(expression_types) and expression_types[pointer_argument] != SEM_UNKNOWN and expression_types[pointer_argument] != SEM_INT { bad_argument = pointer_argument }
                            if bad_argument >= 0 {
                                let error_token = expressions[bad_argument].token
                                let line = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].line } else { 0 }
                                let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                                return TypeInference { expression_types: expression_types, local_types: local_types, typed_expressions: typed, ok: false, error: "unsafe_ptr_store8 needs int pointer and int byte, got " + semantic_type_name(expression_types[bad_argument]), error_line: line, error_col: col, }
                            }
                        }
 if intrinsic and name != "argc" and name != "arg_get" and name != "linux_syscall6" and name != "unsafe_ptr_store8" and name != "unsafe_free" and name != "unsafe_write" and name != "unsafe_write_bytes" and name != "unsafe_write_all" and name != "unsafe_read_all" and name != "unsafe_read_bytes" and name != "unsafe_open_bytes" and name != "unsafe_open_string" and name != "unsafe_close" and name != "unsafe_read_file" and name != "unsafe_write_file" and name != "unsafe_argv_ptr" and name != "unsafe_argv_len" and name != "unsafe_argv_byte" and name != "unsafe_argv_copy" and name != "unsafe_bytes_to_string" and name != "append" and argument_count != 1 {
                    let error_token = expressions[i].token
                    let line = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].line } else { 0 }
                    let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                    return TypeInference {
                        expression_types: expression_types, local_types: local_types, typed_expressions: typed,
                        ok: false, error: "expected 1 args, got " + format_int(argument_count),
                        error_line: line, error_col: col,
                    }
                }
                if intrinsic and argument_count == 1 {
                    let argument = expressions[i].right
                    if argument >= 0 and argument < len(expression_types) {
                        let actual = expression_types[argument]
                        let is_array = semantic_array_element(actual) != SEM_UNKNOWN
                        let mut valid = true
                        let mut message = ""
                        if name == "len" {
                            valid = actual == SEM_UNKNOWN or semantic_is_slice(actual) or actual == SEM_STRING or actual == SEM_MAP
                            message = "len needs slice/array/string/map/string_view, got " + semantic_type_name(actual)
                        }
                        if name == "cap" {
                            valid = actual == SEM_UNKNOWN or semantic_is_slice(actual)
                            message = "cap needs slice ([]int), got " + semantic_type_name(actual)
                        }
                        if name == "format_int" {
                            valid = actual == SEM_UNKNOWN or actual == SEM_INT
                            message = "argument type mismatch: expected int, got " + semantic_type_name(actual)
                        }
                        if name == "byte" or name == "unsafe_ptr_load8" {
                            valid = actual == SEM_UNKNOWN or actual == SEM_INT
                            message = if name == "byte" { "byte needs int, got " + semantic_type_name(actual) } else { "unsafe_ptr_load8 needs int pointer, got " + semantic_type_name(actual) }
                        }
                        if name == "print" {
                            valid = actual == SEM_UNKNOWN or actual == SEM_STRING or actual == SEM_INT
                            message = "print needs string or int, got " + semantic_type_name(actual)
                        }
                        if name == "exit" {
                            valid = actual == SEM_UNKNOWN or actual == SEM_INT
                            message = "exit needs int, got " + semantic_type_name(actual)
                        }
                        if not valid {
                            let error_token = expressions[argument].token
                            let line = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].line } else { 0 }
                            let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                            return TypeInference {
                                expression_types: expression_types, local_types: local_types, typed_expressions: typed,
                                ok: false, error: message, error_line: line, error_col: col,
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    // Validate every return inside each function's token span. Unknown
    // expression types remain deferred, but value presence is always known.
    let mut signature_index = 0
    while signature_index < len(signatures) {
        let signature = signatures[signature_index]
        if signature.item >= 0 and signature.item < len(items) {
            let item = items[signature.item]
            let expected = semantic_declared_type(source, tokens, types, type_edges, layout, signature.result_type)
            let mut found_return = false
            let mut statement_index = 0
            while statement_index < len(statements) {
                let statement = statements[statement_index]
                if statement.kind == STMT_RETURN and statement.token_start >= item.body_start and statement.token_start < item.body_end {
                    found_return = true
                    let mut value_end = statement.token_end
                    while value_end > statement.token_start and tokens[value_end - 1].kind == TK_SEMICOLON {
                        value_end = value_end - 1
                    }
                    let has_value = statement.token_start + 1 < value_end
                    if signature.result_type >= 0 and not has_value {
                        let token = tokens[statement.token_start]
                        return TypeInference {
                            expression_types: expression_types, local_types: local_types, typed_expressions: typed,
                            ok: false, error: "return value required by function declaration",
                            error_line: token.line, error_col: token.col,
                        }
                    }
                    if signature.result_type < 0 and has_value {
                        let token = tokens[statement.token_start + 1]
                        return TypeInference {
                            expression_types: expression_types, local_types: local_types, typed_expressions: typed,
                            ok: false, error: "function without result type cannot return a value",
                            error_line: token.line, error_col: token.col,
                        }
                    }
                    if has_value and statement.expr_root >= 0 and statement.expr_root < len(expression_types) {
                        let actual = expression_types[statement.expr_root]
                        if expected != SEM_UNKNOWN and actual != SEM_UNKNOWN and expected != actual {
                            let expression = expressions[statement.expr_root]
                            let error_token = expression.token
                            let line = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].line } else { 0 }
                            let col = if error_token >= 0 and error_token < len(tokens) { tokens[error_token].col } else { 0 }
                            return TypeInference {
                                expression_types: expression_types, local_types: local_types, typed_expressions: typed,
                                ok: false, error: "return value type does not match function result",
                                error_line: line, error_col: col,
                            }
                        }
                    }
                }
                statement_index = statement_index + 1
            }
            // A declared result with no return anywhere in the body is an
            // error in stage 0. Stage 1 used to lower such a body anyway and
            // emit an executable that returned zero, which is how a body the
            // statement splitter had not actually parsed (every statement on
            // one line collapses into a single node) turned into a silently
            // wrong program instead of a diagnostic.
            if signature.result_type >= 0 and not found_return {
                // name_start is a source byte offset, not a token index; find
                // the declaration's name token so the location points at it.
                let mut token_index = item.token_start
                let mut name_scan = item.token_start
                while name_scan < len(tokens) and name_scan < item.body_start {
                    if tokens[name_scan].start == item.name_start {
                        token_index = name_scan
                        name_scan = item.body_start
                    } else {
                        name_scan = name_scan + 1
                    }
                }
                let token = tokens[token_index]
                return TypeInference {
                    expression_types: expression_types, local_types: local_types, typed_expressions: typed,
                    ok: false, error: "function must return a value declared by its result type",
                    error_line: token.line, error_col: token.col,
                }
            }
        }
        signature_index = signature_index + 1
    }
    return TypeInference {
        expression_types: expression_types, local_types: local_types, typed_expressions: typed,
        ok: true, error: "", error_line: 0, error_col: 0,
    }
}

fn semantic_type_smoke_test() -> bool {
    let source = "fn sum(a: int, b: int) -> int {\nreturn a + b\n}\nfn values() -> []int {\nreturn [1, 2]\n}\nfn lookup() -> map[string]int {\nreturn make(map[string]int)\n}\nfn main() {\nlet x = sum(1, 2)\nlet xs = values()\nlet first = xs[0]\nlet table = lookup()\nlet message = \"a\" + \"b\"\nlet both = true and false\nif both { print_int(x) }\nwhile false { break }\nlet tail = xs[1:]\nlet made = make([]int, 2, 4)\nlet count = len(made)\nlet capacity = cap(made)\nlet rendered = format_int(count)\nlet mystery = missing()\nprint_int(x)\n}"
    let lexed = lex_source(source)
    if not lexed.ok { return false }
    let parsed = parse_frontend(source, lexed.tokens)
    if not parsed.ok or len(parsed.local_types) != 14 { return false }
    return parsed.local_types[0] == SEM_INT and parsed.local_types[1] == SEM_INT and
        parsed.local_types[2] == SEM_INT and parsed.local_types[3] == SEM_ARRAY_INT and
        parsed.local_types[4] == SEM_INT and parsed.local_types[5] == SEM_MAP and
        parsed.local_types[6] == SEM_STRING and parsed.local_types[7] == SEM_BOOL and
        parsed.local_types[8] == SEM_ARRAY_INT and parsed.local_types[9] == SEM_ARRAY_INT and
        parsed.local_types[10] == SEM_INT and parsed.local_types[11] == SEM_INT and
        parsed.local_types[12] == SEM_STRING and parsed.local_types[13] == SEM_UNKNOWN
}
