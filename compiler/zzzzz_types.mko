                    let direct_owner = struct_kind_index(expression_types[expression.left])
                    let direct_slot = struct_field_slot(layout, source, direct_owner, token_text(source, tokens[expression.token]))
                    inferred = struct_field_type(layout, direct_owner, direct_slot)
                }
