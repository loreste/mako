// Channel handles passed to crew.kick must keep the parent's mailbox alive
// after the worker returns. A raw pointer pack lets the worker drop free the
// shared channel (FayDB thread-per-connection req_ch).

fn echo_int(ch: chan[int]) -> int {
    return ch.recv()
}

fn TestKickChanParentKeepsHandleAfterJoin() {
    let ch = chan_new(1)
    let _ = ch.send(7)
    crew t {
        let j = t.kick(echo_int(ch))
        assert_eq(j.join(), 7)
    }
    // Parent still owns `ch` after the worker drop.
    let _ = ch.send(9)
    assert_eq(ch.recv(), 9)
}

fn TestKickChanTwoWorkersShareMailbox() {
    let ch = chan_new(4)
    crew t {
        let p = t.kick(echo_int(ch))
        let q = t.kick(echo_int(ch))
        let _ = ch.send(1)
        let _ = ch.send(2)
        let a = p.join()
        let b = q.join()
        assert_eq(a + b, 3)
    }
    let _ = ch.send(4)
    assert_eq(ch.recv(), 4)
}
