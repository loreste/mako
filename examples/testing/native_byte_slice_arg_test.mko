fn fill_bytes(mut buf: []byte) -> int {
    buf[0] = byte(65)
    buf[1] = byte(66)
    buf[2] = byte(67)
    return len(buf)
}

struct ByteFiller {
    prefix: int
}

on ByteFiller {
    fn fill(mut self, mut buf: []byte) -> int {
        buf[0] = byte(self.prefix)
        buf[1] = byte(self.prefix + 1)
        return len(buf)
    }
}

fn TestNativeByteSliceFunctionArg() {
    let mut buf = make([]byte, 3, 3)
    assert_eq(fill_bytes(buf), 3)
    assert_eq_str(string(buf), "ABC")
}

fn TestNativeByteSliceMethodArg() {
    let mut buf = make([]byte, 2, 2)
    let mut filler = ByteFiller { prefix: 88 }
    assert_eq(filler.fill(buf), 2)
    assert_eq_str(string(buf), "XY")
}
