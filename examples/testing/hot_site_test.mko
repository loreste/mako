// Anneal — adaptive hot-site counters. Years-up traffic feedback folded into
// the next offline build; never a live in-process recompile.

fn TestHotSiteDisabledByDefault() {
    assert_eq(hot_site_clear(), 1)
    // Default off: hits are free no-ops.
    assert_eq(hot_site_enabled(), 0)
    assert_eq(hot_site_hit(1), 0)
    assert_eq(hot_site_count(1), 0)
    assert_eq(hot_site_total(), 0)
}

fn TestHotSiteHitAndTop() {
    assert_eq(hot_site_clear(), 1)
    let prev = hot_site_enable(1)
    assert_eq(prev, 0)
    assert_eq(hot_site_enabled(), 1)

    assert_eq(hot_site_hit(7), 1)
    assert_eq(hot_site_hit(7), 2)
    assert_eq(hot_site_hit(3), 1)
    assert_eq(hot_site_hit(7), 3)
    assert_eq(hot_site_count(7), 3)
    assert_eq(hot_site_count(3), 1)
    assert_eq(hot_site_total(), 4)
    assert_eq(hot_site_top_id(), 7)
    assert_eq(hot_site_top_count(), 3)

    let js = hot_sites_json()
    assert(str_contains(js, "mako.hot_sites.v1"))
    assert(str_contains(js, "\"id\":7"))
    assert(str_contains(js, "\"count\":3"))
    assert(str_contains(js, "total_hits"))

    // Disable: further hits must not move counters.
    assert_eq(hot_site_enable(0), 1)
    assert_eq(hot_site_hit(7), 0)
    assert_eq(hot_site_count(7), 3)
    assert_eq(hot_site_total(), 4)

    // HTTP export seed
    let _ = hot_site_enable(1)
    let http = profile_http_route("/debug/hot_sites")
    assert(str_contains(http, "HTTP/1.0 200"))
    assert(str_contains(http, "mako.hot_sites.v1"))

    assert_eq(hot_site_clear(), 1)
    assert_eq(hot_site_total(), 0)
    assert_eq(hot_site_top_id(), -1)
    assert_eq(hot_site_enable(0), 1)
}

fn TestHotSiteBadId() {
    assert_eq(hot_site_enable(1), 0)
    assert_eq(hot_site_hit(-1), -1)
    assert_eq(hot_site_hit(256), -1)
    assert_eq(hot_site_count(-1), -1)
    assert_eq(hot_site_enable(0), 1)
}

// Lowest (0) and highest (255) ids are valid; MAKO_HOT_SITE_MAX (256) is not.
fn TestHotSiteBoundaryIds() {
    assert_eq(hot_site_clear(), 1)
    assert_eq(hot_site_enable(1), 0)
    assert_eq(hot_site_hit(0), 1)
    assert_eq(hot_site_hit(255), 1)
    assert_eq(hot_site_count(0), 1)
    assert_eq(hot_site_count(255), 1)
    // One past the top edge and below zero are rejected without moving totals.
    assert_eq(hot_site_hit(256), -1)
    assert_eq(hot_site_hit(-5), -1)
    assert_eq(hot_site_count(256), -1)
    assert_eq(hot_site_total(), 2)
    assert_eq(hot_site_enable(0), 1)
    assert_eq(hot_site_clear(), 1)
}

// The top site tracks the current leader as a later site overtakes it.
fn TestHotSiteTopReassign() {
    assert_eq(hot_site_clear(), 1)
    assert_eq(hot_site_enable(1), 0)
    let _ = hot_site_hit(3)
    let _ = hot_site_hit(3)
    assert_eq(hot_site_top_id(), 3)
    assert_eq(hot_site_top_count(), 2)
    // Site 9 overtakes site 3 — the leader must follow.
    let _ = hot_site_hit(9)
    let _ = hot_site_hit(9)
    let _ = hot_site_hit(9)
    assert_eq(hot_site_top_id(), 9)
    assert_eq(hot_site_top_count(), 3)
    assert_eq(hot_site_total(), 5)
    assert_eq(hot_site_enable(0), 1)
    assert_eq(hot_site_clear(), 1)
}

// enable() returns the previous mode across every transition; idempotent flips
// report no change.
fn TestHotSiteEnableTransitions() {
    let _ = hot_site_enable(0)
    assert_eq(hot_site_enable(1), 0)
    assert_eq(hot_site_enable(1), 1)
    assert_eq(hot_site_enabled(), 1)
    assert_eq(hot_site_enable(0), 1)
    assert_eq(hot_site_enable(0), 0)
    assert_eq(hot_site_enabled(), 0)
}

// Concurrent hits on one site: relaxed-atomic counters must not lose an
// increment. This is the long-running-server path — many workers, exact tally.
fn beat(id: int, n: int) -> int {
    var i = 0
    while i < n {
        let _ = hot_site_hit(id)
        i = i + 1
    }
    return n
}

fn TestHotSiteConcurrentHits() {
    assert_eq(hot_site_clear(), 1)
    assert_eq(hot_site_enable(1), 0)
    crew t {
        let a = t.kick(beat(5, 2000))
        let b = t.kick(beat(5, 2000))
        let c = t.kick(beat(5, 2000))
        let d = t.kick(beat(5, 2000))
        assert_eq(a.join() + b.join() + c.join() + d.join(), 8000)
    }
    // No lost updates across threads: the site and the global total agree.
    assert_eq(hot_site_count(5), 8000)
    assert_eq(hot_site_total(), 8000)
    assert_eq(hot_site_top_id(), 5)
    assert_eq(hot_site_top_count(), 8000)
    assert_eq(hot_site_enable(0), 1)
    assert_eq(hot_site_clear(), 1)
}

// Concurrent hits fanned across distinct sites: per-site counts stay isolated
// and the global total is their exact sum.
fn TestHotSiteConcurrentMultiSite() {
    assert_eq(hot_site_clear(), 1)
    assert_eq(hot_site_enable(1), 0)
    crew t {
        let a = t.kick(beat(10, 1500))
        let b = t.kick(beat(20, 1500))
        let c = t.kick(beat(30, 1500))
        assert_eq(a.join() + b.join() + c.join(), 4500)
    }
    assert_eq(hot_site_count(10), 1500)
    assert_eq(hot_site_count(20), 1500)
    assert_eq(hot_site_count(30), 1500)
    assert_eq(hot_site_total(), 4500)
    let js = hot_sites_json()
    assert(str_contains(js, "mako.hot_sites.v1"))
    assert(str_contains(js, "total_hits"))
    assert_eq(hot_site_enable(0), 1)
    assert_eq(hot_site_clear(), 1)
}

// Map AOT opts (identity hash / pre-size) must not break adaptive feedback:
// hot_site still counts; map work still frees; export still valid.
fn TestHotSiteCoexistsWithMapWork() {
    assert_eq(hot_site_clear(), 1)
    assert_eq(hot_site_enable(1), 0)
    var round = 0
    var acc = 0
    while round < 8 {
        let _ = hot_site_hit(42)
        var m = make(map[int]int, 256)
        var i = 0
        while i < 256 {
            m[i] = i * 3
            i = i + 1
        }
        i = 0
        while i < 256 {
            acc = acc + m[i]
            i = i + 1
        }
        // m drops here — ownership free; counters independent of map free
        round = round + 1
    }
    assert_eq(hot_site_total(), 8)
    assert_eq(hot_site_top_id(), 42)
    assert_eq(hot_site_count(42), 8)
    assert(acc > 0)
    let js = hot_sites_json()
    assert(str_contains(js, "mako.hot_sites.v1"))
    assert(str_contains(js, "\"id\":42"))
    // Off again: map-heavy path must not require counters for correctness
    assert_eq(hot_site_enable(0), 1)
    var m2 = make(map[int]int, 64)
    m2[0] = 1
    assert_eq(m2[0], 1)
    assert_eq(hot_site_hit(42), 0)
    assert_eq(hot_site_count(42), 8)
    assert_eq(hot_site_clear(), 1)
}
