// Adversarial: defer interaction with `?` and owned locals.
// Defer is function-scoped (like Go) — runs on return and `?` early-return,
// but NOT on break/continue (they don't exit the function).
// All paths must be ASan-clean.

fn fail_res() -> Result[int, string] {
    return Err("fail")
}

fn ok_res(v: int) -> Result[int, string] {
    return Ok(v)
}

// Defer + `?` early return: owned locals freed, defer body executes.
// We verify defer ran by having it write to a mutable local that is
// returned on the error path (the defer runs before early return).
fn defer_then_try_err() -> Result[int, string] {
    var ran_defer = 0
    defer { ran_defer = 1 }
    let owned = f"will-be-freed{1}"
    let _ = fail_res()?
    return Ok(len(owned) + ran_defer)
}

fn TestDeferRunsOnTryEarlyReturn() {
    match defer_then_try_err() {
        Ok(_) => assert(false),
        Err(e) => assert(e == "fail"),
    }
}

// Defer on normal return path with `?` success.
fn defer_then_try_ok() -> Result[int, string] {
    var ran_defer = 0
    defer { ran_defer = 10 }
    let v = ok_res(42)?
    // ran_defer is set by defer AFTER this return statement runs
    return Ok(v)
}

fn TestDeferRunsOnNormalReturn() {
    match defer_then_try_ok() {
        Ok(n) => assert_eq(n, 42),
        Err(_) => assert(false),
    }
}

// Multiple defers in LIFO order + `?` early-return with owned map.
fn multi_defer_try() -> Result[int, string] {
    var a = 0
    var b = 0
    defer { a = 1 }
    defer { b = 2 }
    let owned_map = make(map[string]int)
    let _ = fail_res()?
    return Ok(len(owned_map) + a + b)
}

fn TestMultiDeferOnTryEarlyReturn() {
    match multi_defer_try() {
        Ok(_) => assert(false),
        Err(e) => assert(e == "fail"),
    }
}

// Defer runs once at function exit, even after break.
fn defer_in_loop_break() -> int {
    var sum = 0
    var i = 0
    while i < 10 {
        if i == 3 {
            break
        }
        sum = sum + 1
        i = i + 1
    }
    return sum
}

fn TestDeferRunsOnceAfterBreak() {
    let v = defer_in_loop_break()
    assert_eq(v, 3)
}

// Owned locals inside loop freed on each iteration, defer runs once at return.
fn defer_with_owned_loop() -> int {
    var sum = 0
    defer { sum = sum + 1 }
    var i = 0
    while i < 50 {
        let s = f"iter-{i}"
        sum = sum + len(s)
        i = i + 1
    }
    return sum
}

fn TestDeferWithOwnedLoop() {
    let v = defer_with_owned_loop()
    assert(v > 0)
}

// Defer + owned locals + `?` churn to amplify leaks under ASan.
fn TestDeferTryChurn() {
    var i = 0
    while i < 200 {
        match defer_then_try_err() {
            Ok(_) => { let _ = 0 },
            Err(_) => { let _ = 0 },
        }
        match multi_defer_try() {
            Ok(_) => { let _ = 0 },
            Err(_) => { let _ = 0 },
        }
        i = i + 1
    }
}
