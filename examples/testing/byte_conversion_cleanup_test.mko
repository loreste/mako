// Run with LeakSanitizer: disk page scans must release each copied byte buffer.
fn scan_page(page: string, stop: int) -> int {
    let raw = bytes(page)
    let mut i = 0
    while i < len(raw) {
        if int(raw[i]) == stop { return i }
        i = i + 1
    }
    return len(raw)
}

fn page_bytes(page: string) -> []byte {
    let raw = bytes(page)
    return raw
}

fn inspect_view(page: string) -> int {
    let view = as_bytes(page)
    return len(view)
}

struct TokenChoice { value: string }

fn receive_token(messages: chan[TokenChoice]) -> string {
    let message = messages.recv()
    return message.value
}

fn choose_token(text: string) -> TokenChoice {
    let fields = str_fields(text)
    let chosen = fields[1]
    return TokenChoice { value: chosen }
}

fn borrowed_text_length(text: string) -> int { return len(text) }

fn response_text(text: string) -> string {
    let output = str_builder()
    builder_write(output, str_to_upper(text))
    builder_write_slice(output, str_repeat("!", 3), 0, 1)
    return builder_string(output)
}

struct QueryState { values: []int labels: []string }

fn retain_query_state(state: QueryState) -> QueryState { return state }

fn query_state_values(records: map[string]QueryState) -> []QueryState {
    return maps_values(records)
}

fn retain_values(values: []int) -> []int { return values }

fn replace_retained_field(state: QueryState) -> QueryState {
    let mut result = state
    let retained = retain_values(state.values)
    result.values = retained
    return result
}

export fn TestRetainedFieldCleanup() {
    let mut items = make([]QueryState, 1, 1)
    items[0] = QueryState { values: make([]int, 0, 0), labels: make([]string, 0, 0) }
    let mut i = 0
    while i < 1000 {
        let packed = make([]int, 1000, 1000)
        items[0].values = packed
        items[0] = replace_retained_field(items[0])
        let retained = retain_values(items[0].values)
        items[0].values = retained
        assert_eq(len(retained), 1000)
        items[0].values = append(items[0].values, 7)
        assert_eq(len(retained), 1000)
        assert_eq(items[0].values[1000], 7)
        i = i + 1
    }
}

fn clone_query_states(states: map[string]QueryState) -> map[string]QueryState { return maps_clone(states) }
fn clone_integer_states(states: map[int]QueryState) -> map[int]QueryState { return maps_clone(states) }
fn clone_float_states(states: map[float]QueryState) -> map[float]QueryState { return maps_clone(states) }
fn clone_boolean_states(states: map[bool]QueryState) -> map[bool]QueryState { return maps_clone(states) }

export fn TestContainerReplacementCleanup() {
    let mut items = make([]QueryState, 1, 1)
    items[0] = QueryState { values: [7, 8], labels: [str_repeat("label", 4)] }
    let snapshot = retain_query_state(items[0])
    let mut records = make(map[string]QueryState)
    records["state"] = retain_query_state(snapshot)
    let mut i = 0
    while i < 1000 {
        items[0] = retain_query_state(items[0])
        records["state"] = retain_query_state(records["state"])
        i = i + 1
    }
    items[0] = QueryState { values: [9], labels: ["replacement"] }
    assert_eq(snapshot.values[0], 7)
    assert_eq(records["state"].values[1], 8)
    assert_eq(len(snapshot.labels[0]), 20)
    assert_eq(len(records["state"].labels[0]), 20)
    let cloned = clone_query_states(records)
    let listed = query_state_values(records)
    maps_clear(records)
    assert_eq(cloned["state"].values[0], 7)
    assert_eq(len(listed[0].labels[0]), 20)
    maps_copy(records, cloned)
    delete(cloned, "state")
    assert_eq(records["state"].values[1], 8)
    assert_eq(len(snapshot.labels[0]), 20)
    let mut integers = make(map[int]QueryState)
    let mut floats = make(map[float]QueryState)
    let mut flags = make(map[bool]QueryState)
    integers[1] = retain_query_state(snapshot)
    floats[1.5] = retain_query_state(snapshot)
    flags[true] = retain_query_state(snapshot)
    let saved_integers = clone_integer_states(integers)
    let saved_floats = clone_float_states(floats)
    let saved_flags = clone_boolean_states(flags)
    maps_clear(integers)
    maps_clear(floats)
    maps_clear(flags)
    maps_copy(integers, saved_integers)
    maps_copy(floats, saved_floats)
    maps_copy(flags, saved_flags)
    delete(saved_integers, 1)
    delete(saved_floats, 1.5)
    delete(saved_flags, true)
    assert_eq(integers[1].values[0], 7)
    assert_eq(floats[1.5].values[0], 7)
    assert_eq(flags[true].values[0], 7)
}

export fn TestQueryTemporaryCleanup() {
    let messages = chan_open[TokenChoice](1)
    let parts = ["hello", "hé"]
    let mut i = 0
    while i < 1000 {
        let mut trimmed = str_repeat(" value ", 3)
        trimmed = str_trim_space(trimmed)
        trimmed = str_trim(trimmed, "e")
        assert_eq(len(trimmed), 18)
        assert_eq(borrowed_text_length(str_repeat("temporary", 3)), 27)
        assert_eq(str_slice_ci_index("select VALUES", 0, 13, str_repeat("values", 1)), 7)
        let cut = str_cut(str_repeat("left:right", 1), ":")
        assert_eq(len(cut), 2)
        assert_eq(file_open(str_repeat("/issue64-missing-directory/file", 1), 0, 0), -1)
        assert_eq(write_file("/issue64-missing-directory/file", str_repeat("data", 3)), -1)
        assert_eq(append_file("/issue64-missing-directory/file", str_repeat("data", 3)), -1)
        let choice = choose_token("select value from table")
        assert(str_eq(choice.value, "value"))
        let response = response_text("hello")
        assert(str_eq(response, "HELLO!"))
        assert_eq(len(bytes(str_repeat("hé", 3))), 9)
        assert_eq(len(bytes(parts[1])), 3)
        assert_eq(int(bytes(str_repeat("hé", 3))[1]), 195)
        assert_eq(int(bytes(parts[0])[4]), 111)
        assert_eq(str_index(str_to_upper("hello"), str_repeat("L", 1)), 2)
        assert_eq(str_last_index(str_to_upper("hello"), "L"), 3)
        assert_eq(tcp_write(-1, response_text("hello")), -1)
        assert_eq(tcp_write_all(-1, response_text("hello")), -1)
        let _ = messages.send(TokenChoice { value: str_repeat("reply", 4) })
        assert_eq(messages.try_send(TokenChoice { value: str_repeat("full", 4) }), 0)
        assert_eq(messages.send_timeout(TokenChoice { value: str_repeat("timeout", 4) }, 0), 0)
        let reply = receive_token(messages)
        assert_eq(len(reply), 20)
        i = i + 1
    }
    let named = TokenChoice { value: "still owned by caller" }
    let _ = messages.send(named)
    let received = receive_token(messages)
    assert(str_eq(received, named.value))
    messages.close()
    let _ = messages.send(TokenChoice { value: str_repeat("closed", 4) })
    let _ = messages.try_send(TokenChoice { value: str_repeat("closed", 4) })
    let _ = messages.send_timeout(TokenChoice { value: str_repeat("closed", 4) }, 0)
}

export fn TestByteConversionCleanup() {
    let page = str_repeat("hello\n", 256)
    let mut i = 0
    while i < 1000 {
        assert_eq(scan_page(page, 10), 5)
        assert_eq(scan_page(page, 0), len(page))
        assert_eq(inspect_view(page), len(page))
        let copied = page_bytes(page)
        assert_eq(int(copied[0]), 104)
        assert_eq(len(copied), len(page))
        i = i + 1
    }
}

struct NestedQueryState { state: QueryState }

export fn TestNestedFieldCleanup() {
    let mut indexed = make([]NestedQueryState, 1, 1)
    indexed[0] = NestedQueryState { state: QueryState { values: [0], labels: ["initial"] } }
    let mut outer = NestedQueryState { state: QueryState { values: [1], labels: ["seed"] } }
    let mut i = 0
    while i < 1000 {
        indexed[0].state = QueryState { values: [i], labels: [str_repeat("indexed", 3)] }
        assert_eq(len(indexed[0].state.labels[0]), 21)
        outer.state.labels = append(outer.state.labels, str_repeat("entry", 3))
        let retained = retain_values(outer.state.values)
        outer.state.values = retained
        outer.state.labels = [str_repeat("replacement", 2)]
        assert_eq(len(outer.state.labels[0]), 22)
        i = i + 1
    }
}

struct QueryBatch { states: []QueryState }

export fn TestStructArrayReplacementCleanup() {
    let mut batch = QueryBatch { states: make([]QueryState, 0, 1) }
    let mut i = 0
    while i < 1000 {
        let mut fresh = make([]QueryState, 0, 1)
        fresh = append(fresh, QueryState { values: [i], labels: [str_repeat("payload", 3)] })
        batch.states = fresh
        assert_eq(batch.states[0].values[0], i)
        i = i + 1
    }
}

struct SessionHandles { numbers: chan[int], texts: chan[string], objects: chan[TokenChoice] }
fn retain_session_handles(handles: SessionHandles) -> SessionHandles { return handles }

export fn TestChannelFieldReplacementCleanup() {
    let mut i = 0
    while i < 1000 {
        let mut handles = SessionHandles { numbers: chan_open[int](1), texts: chan_open[string](1), objects: chan_open[TokenChoice](1) }
        let retained = retain_session_handles(handles)
        handles = retain_session_handles(handles)
        let _ = handles.numbers.send(i)
        assert_eq(retained.numbers.recv(), i)
        let _ = handles.texts.send("text")
        assert_eq(len(retained.texts.recv()), 4)
        let _ = handles.objects.send(TokenChoice { value: "object" })
        assert_eq(len(receive_token(retained.objects)), 6)
        i = i + 1
    }
}

export fn TestPageWriteTemporaryCleanup() {
    // Failure-path writes also borrow their payload; this runs on every OS.
    let pages = pman_open("")
    let mut i = 0
    while i < 1000 {
        assert_eq(pman_write_page(pages, 0, str_repeat("page", 8)), -1)
        i = i + 1
    }
    let path = temp_file(str_repeat("mako_issue64_", 1))
    assert(file_exists(path))
    assert_eq(remove_file(path), 0)
}

export fn TestSelfResliceCleanup() {
    let mut slots = make([]int, 0, 64)
    let mut i = 0
    while i < 1000 {
        let mut j = 0
        while j < 64 {
            slots = append(slots, j)
            j = j + 1
        }
        while len(slots) > 0 {
            slots = slots[0:len(slots) - 1]
        }
        assert_eq(len(slots), 0)
        i = i + 1
    }
    let mut values = [1, 2, 3]
    let retained = retain_values(values)
    values = values[1:3]
    assert_eq(values[0], 2)
    assert_eq(retained[0], 1)
    let mut data = bytes("abc")
    data = data[1:3]
    assert_eq(int(data[0]), 98)
}

fn fresh_query_state(n: int) -> QueryState {
    return QueryState { values: [n], labels: [str_repeat("temporary", 3)] }
}
fn inspect_query_state(state: QueryState) -> int { return len(state.labels[0]) }

export fn TestBorrowedStructArgumentCleanup() {
    let mut i = 0
    while i < 1000 {
        assert_eq(inspect_query_state(fresh_query_state(i)), 27)
        assert_eq(inspect_query_state(QueryState { values: [i], labels: [str_repeat("literal", 3)] }), 21)
        i = i + 1
    }
}

export fn TestProcessTemporaryCleanup() {
    let mut i = 0
    while i < 1000 {
        let argv = args()
        assert(len(argv) > 0)
        let ignored = signal_ignore(str_repeat("PIPE", 1))
        i = i + 1
    }
}

fn main() {
    TestProcessTemporaryCleanup()
    TestByteConversionCleanup()
    TestQueryTemporaryCleanup()
    TestContainerReplacementCleanup()
    TestRetainedFieldCleanup()
    TestNestedFieldCleanup()
    TestStructArrayReplacementCleanup()
    TestChannelFieldReplacementCleanup()
    TestPageWriteTemporaryCleanup()
    TestBorrowedStructArgumentCleanup()
    TestSelfResliceCleanup()
}
