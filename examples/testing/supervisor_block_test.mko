// Test supervisor block syntax and execution
fn worker_success(id: int) -> int {
    return 0
}

fn TestSupervisorBlock() {
    supervisor sup (policy = one_for_one, max_restarts = 3) {
        let _ = sup.kick(worker_success(1))
        let _ = sup.kick(worker_success(2))
    }
    assert(true)
}
