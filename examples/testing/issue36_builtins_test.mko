fn TestBase64UrlBuiltins() {
    let encoded = base64url_encode("hello")
    assert_eq_str(encoded, "aGVsbG8")
    assert_eq_str(base64url_decode(encoded), "hello")
}

fn TestJwtCustomHeaderRejectsBadKey() {
    let header = "{\"alg\":\"ES256\",\"ppt\":\"shaken\",\"typ\":\"passport\",\"x5u\":\"https://example.test/cert.pem\"}"
    let token = jwt_sign_es256_header("{\"sub\":\"alice\"}", "not-a-p256-private-key", header)
    assert_eq_str(token, "")
    let token2 = jwt_sign_custom("{\"sub\":\"alice\"}", "not-a-p256-private-key", header)
    assert_eq_str(token2, "")
}

fn TestCMapCompositeAndIntBuiltins() {
    let cache = cmap_new()
    // cmap_concat2 uses plain concatenation (no separator)
    cmap_set(cache, "presuf", "value")
    assert_eq(cmap_has2(cache, "pre", "suf"), 1)
    assert_eq_str(cmap_get2(cache, "pre", "suf"), "value")
    assert_eq(cmap_del2(cache, "pre", "suf"), 1)
    assert_eq(cmap_has2(cache, "pre", "suf"), 0)

    // cmap_concat3i: plain concat with int suffix
    cmap_set(cache, "premid7", "triple")
    assert_eq(cmap_has3i(cache, "pre", "mid", 7), 1)
    assert_eq_str(cmap_get3i(cache, "pre", "mid", 7), "triple")
    assert_eq(cmap_del3i(cache, "pre", "mid", 7), 1)

    cmap_set_int(cache, "n", 42)
    assert_eq(cmap_get_int(cache, "n", -1), 42)
    assert_eq(cmap_get_int(cache, "missing", -1), -1)
}

fn TestTlsServerPoolBuiltins() {
    let srv = tls_server_new("", "")
    let handle = tls_server_pool_accept(srv, -1)
    assert_eq(handle, -1)
    assert_eq(tls_server_pool_fd(handle), -1)
    assert_eq(tls_server_pool_write(handle, "x"), -1)
    assert_eq_str(tls_server_pool_read(handle, 8), "")
    assert_eq(tls_server_pool_close(handle), -1)
    let _ = tls_server_free(srv)
}

fn TestP256AcmeBuiltins() {
    let path = path_join(temp_dir(), "mako_p256_acme_account.pem")
    let _ = remove_file(path)

    assert_eq(p256_keygen(path), 0)
    let key_pem = read_file(path)
    assert(str_contains(key_pem, "BEGIN PRIVATE KEY"))

    let jwk = p256_public_jwk(key_pem)
    assert(str_contains(jwk, "\"crv\":\"P-256\""))
    assert(str_contains(jwk, "\"kty\":\"EC\""))
    assert(str_contains(jwk, "\"x\":\""))
    assert(str_contains(jwk, "\"y\":\""))

    let thumbprint = p256_jwk_thumbprint(key_pem)
    assert(str_len(thumbprint) > 30)

    let header = "{\"alg\":\"ES256\",\"nonce\":\"nonce\",\"url\":\"https://acme.example/new-acct\",\"jwk\":" + jwk + "}"
    let token = jwt_sign_es256_header("{\"termsOfServiceAgreed\":true}", key_pem, header)
    assert(str_count(token, ".") == 2)

    let _ = remove_file(path)
}
