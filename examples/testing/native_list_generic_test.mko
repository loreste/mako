// Native backend: List[T] for non-scalar T (structs, nested lists, strings).
// List[T] aliases []T; this exercises the paths that previously errored with
// "native IR: List[...] is not supported yet". Differentially valid vs the C
// backend and run clean under the sanitizers.

struct Pt {
    x: int
    y: int
}

fn TestListOfStructs() {
    let ps: List[Pt] = [Pt { x: 1, y: 2 }, Pt { x: 3, y: 4 }, Pt { x: 5, y: 6 }]
    assert_eq(len(ps), 3)
    assert_eq(ps[0].x, 1)
    assert_eq(ps[2].y, 6)
    var sum = 0
    var i = 0
    while i < len(ps) {
        sum = sum + ps[i].x + ps[i].y
        i = i + 1
    }
    assert_eq(sum, 21)
}

fn TestListOfLists() {
    let xss: List[List[int]] = [[1, 2], [3, 4, 5], [6]]
    assert_eq(len(xss), 3)
    assert_eq(len(xss[1]), 3)
    assert_eq(xss[1][2], 5)
    var total = 0
    var i = 0
    while i < len(xss) {
        var j = 0
        while j < len(xss[i]) {
            total = total + xss[i][j]
            j = j + 1
        }
        i = i + 1
    }
    assert_eq(total, 21)
}

fn TestListOfStrings() {
    let ss: List[string] = ["a", "bb", "ccc"]
    assert_eq(len(ss), 3)
    assert(ss[1] == "bb")
    var n = 0
    var i = 0
    while i < len(ss) {
        n = n + len(ss[i])
        i = i + 1
    }
    assert_eq(n, 6)
}

// Ownership stress: build and drop List[Struct] repeatedly (no leak/UAF).
fn make_row(base: int) -> List[Pt] {
    return [Pt { x: base, y: base + 1 }, Pt { x: base + 2, y: base + 3 }]
}

fn TestListStructOwnershipChurn() {
    var round = 0
    var acc = 0
    while round < 64 {
        let row = make_row(round)
        acc = acc + row[0].x + row[1].y
        round = round + 1
        // row drops here — owned StructSlice free
    }
    // sum over round 0..63 of (row[0].x + row[1].y) = (2*round + 3) = 4224
    assert_eq(acc, 4224)
}
