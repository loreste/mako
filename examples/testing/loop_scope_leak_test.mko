export fn TestStringRangeNoLeak() {
    let s = "hello world"
    let mut count = 0
    for ch in range s {
        let tmp = "prefix_" + int_to_string(ch)
        count = count + 1
    }
    assert(count == 11)
}

export fn TestMapRangeNoLeak() {
    let mut m = make(map[string]int, 4)
    m["a"] = 1
    m["b"] = 2
    m["c"] = 3
    let mut total = 0
    for k, v in range m {
        let tmp = k + "_suffix"
        total = total + v
    }
    assert(total == 6)
}

export fn TestLoopHighIterNoOom() {
    let mut m = make(map[string]int, 4)
    m["key"] = 1
    for _ in 50000 {
        for k, v in range m {
            let tmp = k + "_" + int_to_string(v)
        }
    }
}

fn main() {
    TestStringRangeNoLeak()
    TestMapRangeNoLeak()
    TestLoopHighIterNoOom()
    print("PASS\n")
}
