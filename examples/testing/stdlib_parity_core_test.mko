// Adversarial Go-stdlib equivalent tests: strings, bytes, slices, strconv, path.

pull "strings"
pull "bytes"
pull "slices"
pull "strconv"
pull "path"
pull "path/filepath"
pull "sort"
pull "maps"
pull "cmp"
pull "bufio"

fn is_comma(r: int) -> bool { return r == 44 }
fn is_even(n: int) -> bool { return n % 2 == 0 }

fn TestStringsSearch() {
    assert(strings.contains("hello", "ell"))
    assert(!strings.contains("hello", "xyz"))
    assert(strings.contains("", ""))
    assert_eq(strings.index("banana", "na"), 2)
    assert_eq(strings.last_index("banana", "na"), 4)
    assert_eq(strings.index("abc", "z"), -1)
    assert_eq(strings.index_byte("abc", 98), 1)
    assert_eq(strings.index_byte("abc", 256), -1)
    assert_eq(strings.index_byte("", 97), -1)
    assert_eq(strings.last_index_byte("abca", 97), 3)
    assert_eq(strings.index_rune("café", 233), 3)
    assert(strings.contains_rune("café", 233))
    assert(!strings.contains_rune("abc", 233))
    assert_eq(strings.index_any("hello", "aeiou"), 1)
    assert_eq(strings.index_any("xyz", "aeiou"), -1)
    assert_eq(strings.last_index_any("hello", "l"), 3)
    assert(strings.contains_any("path/x", "/\\"))
    assert(strings.equal_fold("Mako", "MAKO"))
    assert(!strings.equal_fold("mako", "rust"))
}

fn TestStringsCutSplit() {
    let head, tail, ok = strings.cut_ok("a=b=c", "=")
    assert(ok)
    assert_eq_str(head, "a")
    assert_eq_str(tail, "b=c")
    let h2, t2, ok2 = strings.cut_ok("abc", "=")
    assert(!ok2)
    assert_eq_str(h2, "abc")
    assert_eq_str(t2, "")

    let rest, hit = strings.cut_prefix("foobar", "foo")
    assert(hit)
    assert_eq_str(rest, "bar")
    let rest2, hit2 = strings.cut_prefix("foobar", "baz")
    assert(!hit2)
    assert_eq_str(rest2, "foobar")
    let rest3, hit3 = strings.cut_suffix("file.mko", ".mko")
    assert(hit3)
    assert_eq_str(rest3, "file")

    let parts = strings.split_n("a,b,c,d", ",", 2)
    assert_eq(len(parts), 2)
    assert_eq_str(parts[0], "a")
    assert_eq_str(parts[1], "b,c,d")
    let all = strings.split_n("a,b", ",", 0)
    assert_eq(len(all), 2)
    let after = strings.split_after("a,b,c", ",")
    assert_eq(len(after), 3)
    assert_eq_str(after[0], "a,")
    assert_eq_str(after[2], "c")

    assert_eq_str(strings.replace_n("aaa", "a", "b", 2), "bba")
    assert_eq_str(strings.replace_n("aaa", "a", "b", 0), "aaa")
    assert_eq_str(strings.replace_n("aaa", "a", "b", -1), "bbb")
    assert_eq_str(strings.clone("hi"), "hi")
    assert_eq_str(strings.repeat("ab", 0), "")
    assert_eq_str(strings.repeat("ab", -3), "")
    assert_eq_str(strings.slice("hello", -1, 2), "he")
    assert_eq_str(strings.slice("hello", 3, 99), "lo")
    assert_eq_str(strings.slice("hello", 4, 2), "")

    let f = strings.fields_fn("a,b,,c", is_comma)
    assert_eq(len(f), 3)
    assert_eq_str(f[1], "b")
    assert_eq_str(strings.title("hello world"), "Hello World")
    assert_eq(strings.compare("a", "b"), -1)
    assert_eq(strings.compare("b", "a"), 1)
    assert_eq(strings.compare("a", "a"), 0)
}

fn TestBytesSliceOps() {
    let a = bytes.from_string("hello")
    let b = bytes.from_string("ell")
    assert_eq(bytes.index_bytes(a, b), 1)
    assert(bytes.contains_bytes(a, b))
    assert(bytes.has_prefix_bytes(a, bytes.from_string("he")))
    assert(bytes.has_suffix_bytes(a, bytes.from_string("lo")))
    assert(!bytes.has_prefix_bytes(a, bytes.from_string("lo")))
    assert_eq(bytes.index_byte(a, byte(108)), 2)
    assert_eq(bytes.last_index_byte(a, byte(108)), 3)
    assert_eq(bytes.count_bytes(bytes.from_string("aaaa"), bytes.from_string("aa")), 2)
    assert_eq(bytes.count_bytes(a, bytes.from_string("")), 6)
    assert(bytes.equal_bytes(a, bytes.clone(a)))
    assert_eq(bytes.compare_bytes(bytes.from_string("a"), bytes.from_string("b")), -1)
    assert_eq(bytes.compare_bytes(bytes.from_string("ab"), bytes.from_string("a")), 1)
    let trimmed = bytes.trim_prefix_bytes(a, bytes.from_string("he"))
    assert(bytes.equal_bytes(trimmed, bytes.from_string("llo")))
}

fn TestSlicesOps() {
    let xs = [1, 3, 3, 5, 8]
    assert(slices.is_sorted(xs))
    assert(!slices.is_sorted([3, 1]))
    let i, found = slices.binary_search(xs, 5)
    assert(found)
    assert_eq(i, 3)
    let j, found2 = slices.binary_search(xs, 4)
    assert(!found2)
    assert_eq(j, 3)
    assert(slices.equal(slices.compact([1, 1, 2, 2, 2, 3]), [1, 2, 3]))
    assert(slices.equal(slices.delete_at([1, 2, 3, 4], 1), [1, 3, 4]))
    assert(slices.equal(slices.delete_range([1, 2, 3, 4], -1, 2), [3, 4]))
    assert(slices.equal(slices.insert([1, 3], 1, 2), [1, 2, 3]))
    assert(slices.equal(slices.insert([1, 2], 99, 3), [1, 2, 3]))
    assert(slices.equal(slices.concat([1, 2], [3]), [1, 2, 3]))
    assert(slices.equal(slices.replace([1, 2, 3, 4], 1, 3, [9, 9]), [1, 9, 9, 4]))
    assert(slices.equal(slices.repeat_n(7, 3), [7, 7, 7]))
    assert(slices.equal(slices.repeat_n(7, 0), make([]int, 0)))
    assert(slices.contains_fn([1, 2, 3], is_even))
    assert_eq(slices.index_fn([1, 3, 4], is_even), 2)
    assert_eq(slices.compare([1, 2], [1, 3]), -1)
    assert(slices.is_sorted_strs(["a", "b", "c"]))
    assert(!slices.is_sorted_strs(["b", "a"]))
}

fn TestStrconvQuote() {
    assert_eq_str(strconv.quote("hi"), "\"hi\"")
    assert_eq_str(strconv.quote("a\"b"), "\"a\\\"b\"")
    assert_eq_str(strconv.quote("a\nb"), "\"a\\nb\"")
    let u1, e1 = strconv.unquote("\"hi\"")
    assert_eq_str(e1, "")
    assert_eq_str(u1, "hi")
    let u2, e2 = strconv.unquote("\"a\\n\"")
    assert_eq_str(e2, "")
    assert_eq_str(u2, "a\n")
    let _, e3 = strconv.unquote("nope")
    assert(str_len(e3) > 0)
    assert(strconv.can_backquote("hello"))
    assert(!strconv.can_backquote("has`tick"))
    assert(strconv.is_print(65))
    assert(!strconv.is_print(7))
    assert_eq_str(strconv.append_int("n=", 3), "n=3")
}

fn TestPathGlob() {
    assert(path.matches("*.mko", "main.mko"))
    assert(!path.matches("*.mko", "main.rs"))
    assert(path.matches("a/b", "a/b"))
    assert(!path.matches("a*", "a/b"))
    assert(path.matches("a?c", "abc"))
    assert(!path.matches("a?c", "ac"))
    let d, f = path.split("/tmp/x.txt")
    assert_eq_str(f, "x.txt")
    assert_eq_str(path.join3("a", "b", "c"), path.join_path(path.join_path("a", "b"), "c"))

    assert_eq_str(filepath.to_slash("a\\b\\c"), "a/b/c")
    assert_eq_str(filepath.from_slash("a/b"), "a\\b")
    assert_eq_str(filepath.volume_name("C:\\tmp"), "C:\\")
    assert_eq_str(filepath.volume_name("/tmp"), "")
    let rel = filepath.rel("/a/b", "/a/b/c")
    assert_eq_str(rel, "c")
    let rel2 = filepath.rel("/a/b/c", "/a/b/d")
    assert_eq_str(rel2, "../d")
    assert(filepath.matches("*.txt", "x.txt"))
    let list = filepath.split_list("a:b:c")
    assert_eq(len(list), 3)
    assert_eq_str(list[1], "b")
}

fn TestSortSearch() {
    assert(sort.is_sorted_ints([1, 2, 2, 9]))
    assert(!sort.is_sorted_ints([2, 1]))
    assert(sort.is_sorted_strings(["a", "b"]))
    assert_eq(sort.search_ints([1, 3, 5, 7], 5), 2)
    assert_eq(sort.search_ints([1, 3, 5, 7], 4), 2)
    assert_eq(sort.search_strings(["a", "c", "e"], "c"), 1)
}

fn TestCmp() {
    assert_eq(cmp.compare_int(1, 2), -1)
    assert_eq(cmp.compare_str("b", "a"), 1)
    assert_eq_str(cmp.or_str("", "x"), "x")
    assert_eq(cmp.or_int(0, 7), 7)
    assert_eq(cmp.or_int(3, 7), 3)
}

fn TestMapsHasRemove() {
    let mut m = make(map[string]int)
    m["a"] = 1
    m["b"] = 2
    assert(maps.has_key(m, "a"))
    assert(!maps.has_key(m, "missing"))
    delete(m, "a")
    assert(!maps.has_key(m, "a"))
}

fn TestBufioScan() {
    let lines = bufio.scan_lines("a\nb\r\nc")
    assert_eq(len(lines), 3)
    assert_eq_str(lines[0], "a")
    assert_eq_str(lines[1], "b")
    assert_eq_str(lines[2], "c")
    let empty = bufio.scan_lines("")
    assert_eq(len(empty), 1)
    assert_eq_str(empty[0], "")
    assert_eq_str(bufio.peek_prefix("hello", 2), "he")
    assert_eq_str(bufio.peek_prefix("hello", 99), "hello")
}
