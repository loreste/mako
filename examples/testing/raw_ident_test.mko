struct Stmt {
    rawv: string
}

fn test_fn(rawv: int) -> int {
    return rawv + 1
}

fn TestRawAsIdentifier() {
    let rawv = 42
    assert_eq(rawv, 42)
    assert_eq(test_fn(10), 11)
    let s = Stmt { rawv: "select 1" }
    assert_eq_str(s.rawv, "select 1")

    let mut arr: raw []int = make(raw []int, 0, 4)
    arr = append(arr, 100)
    assert_eq(len(arr), 1)
    assert_eq(arr[0], 100)
}
