// Regression test for #32: native backend SIGSEGV in struct clone
// through deeply nested if/else chains. The root cause was unsealed
// Cranelift basic blocks in emit_struct_clone / emit_struct_drop,
// producing wild SSA values for struct field pointers.

struct Route {
    path: string
    method: string
    backend: string
    host: string
    prefix: string
    rewrite: string
    name: string
}

fn route_new(path: string, method: string, backend: string) -> Route {
    return Route{
        path: path,
        method: method,
        backend: backend,
        host: "",
        prefix: "",
        rewrite: "",
        name: "",
    }
}

struct World {
    name: string
    mode: string
    routes: []Route
    workers: int
}

fn parse_line(mut w: World, line: string) -> World {
    if line == "route" {
        let r = route_new("/default", "GET", "app")
        w.routes = append(w.routes, r)
    } else if line == "route2" {
        let r = route_new("/api", "POST", "api")
        w.routes = append(w.routes, r)
    } else if line == "route3" {
        let r = route_new("/health", "GET", "health")
        w.routes = append(w.routes, r)
    } else if line == "workers" {
        w.workers = 4
    } else if line == "mode" {
        w.mode = "http"
    } else if line == "name" {
        w.name = "test"
    }
    return w
}

// Takes World by value — triggers clone of all string/slice fields.
fn doctor_world(w: World) -> int {
    let mut errors = 0
    if len(w.name) == 0 {
        errors = errors + 1
    }
    if len(w.routes) == 0 {
        errors = errors + 1
    }
    for i, r in range w.routes {
        if len(r.path) == 0 {
            errors = errors + 1
        }
        if len(r.backend) == 0 {
            errors = errors + 1
        }
    }
    return errors
}

fn TestStructCloneNestedIf() {
    let mut w = World{
        name: "",
        mode: "",
        routes: make([]Route, 0, 4),
        workers: 0,
    }
    w = parse_line(w, "name")
    w = parse_line(w, "mode")
    w = parse_line(w, "route")
    w = parse_line(w, "route2")
    w = parse_line(w, "route3")
    w = parse_line(w, "workers")

    // By-value call — clones World including []Route with string fields
    let errors = doctor_world(w)
    assert(errors == 0)
    assert(len(w.routes) == 3)
    assert(w.routes[0].path == "/default")
    assert(w.routes[1].path == "/api")
    assert(w.routes[2].path == "/health")
    assert(w.name == "test")
    assert(w.workers == 4)
}

fn TestRepeatedCloneCycle() {
    let mut w = World{
        name: "base",
        mode: "tcp",
        routes: make([]Route, 0, 4),
        workers: 1,
    }
    // Repeated parse cycles stress the clone/drop path
    for i in 20 {
        w = parse_line(w, "route")
        let e = doctor_world(w)
        assert(e == 0)
    }
    assert(len(w.routes) == 20)
}

// Verify by-value pass clones correctly: read-only by-value arg must not
// corrupt the caller's copy when the callee returns.
fn count_routes(w: World) -> int {
    return len(w.routes)
}

fn TestByValueCloneIntegrity() {
    let mut orig = World{
        name: "original",
        mode: "http",
        routes: make([]Route, 0, 4),
        workers: 2,
    }
    orig = parse_line(orig, "route")
    orig = parse_line(orig, "route2")

    // By-value calls clone World; after callee returns, original must survive
    let n = count_routes(orig)
    assert(n == 2)
    let e = doctor_world(orig)
    assert(e == 0)

    // Original still intact after two by-value clones were created and dropped
    assert(orig.name == "original")
    assert(orig.mode == "http")
    assert(orig.workers == 2)
    assert(len(orig.routes) == 2)
    assert(orig.routes[0].path == "/default")
    assert(orig.routes[1].path == "/api")
}

// Chained index+field assignment: w.routes[0].path = "x"
fn TestChainedIndexFieldAssign() {
    let mut w = World{
        name: "test",
        mode: "http",
        routes: make([]Route, 0, 4),
        workers: 1,
    }
    w = parse_line(w, "route")
    w = parse_line(w, "route2")
    w = parse_line(w, "route3")

    assert(w.routes[0].path == "/default")
    assert(w.routes[1].path == "/api")
    assert(w.routes[2].path == "/health")

    // Mutate via chained index+field assignment
    w.routes[0].path = "/changed"
    w.routes[1].method = "PUT"
    w.routes[2].backend = "new-backend"

    assert(w.routes[0].path == "/changed")
    assert(w.routes[1].method == "PUT")
    assert(w.routes[2].backend == "new-backend")

    // Other fields untouched
    assert(w.routes[0].method == "GET")
    assert(w.routes[1].path == "/api")
    assert(w.routes[2].path == "/health")
}

// Verify mut param deep-clone: mutating owned fields must not corrupt caller.
fn mutate_world(mut w: World) -> World {
    w.name = "mutated"
    w.mode = "changed"
    w.workers = 999
    let r = route_new("/new", "DELETE", "nowhere")
    w.routes = append(w.routes, r)
    return w
}

fn TestMutParamDeepClone() {
    let mut orig = World{
        name: "original",
        mode: "http",
        routes: make([]Route, 0, 4),
        workers: 2,
    }
    orig = parse_line(orig, "route")
    orig = parse_line(orig, "route2")

    let cloned = mutate_world(orig)

    // Original must be untouched
    assert(orig.name == "original")
    assert(orig.mode == "http")
    assert(orig.workers == 2)
    assert(len(orig.routes) == 2)
    assert(orig.routes[0].path == "/default")
    assert(orig.routes[1].path == "/api")

    // Clone must reflect mutations
    assert(cloned.name == "mutated")
    assert(cloned.workers == 999)
    assert(len(cloned.routes) == 3)
    assert(cloned.routes[2].path == "/new")
}

// Stress: repeated clone+drop cycles to surface UaF/double-free
fn TestStressCloneDrop() {
    let mut w = World{
        name: "stress",
        mode: "tcp",
        routes: make([]Route, 0, 4),
        workers: 0,
    }
    for i in 5 {
        w = parse_line(w, "route")
        w = parse_line(w, "route2")
        w = parse_line(w, "route3")
    }
    assert(len(w.routes) == 15)

    // 50 clone+drop cycles via by-value call
    for i in 50 {
        let e = doctor_world(w)
        assert(e == 0)
    }

    // Verify data integrity after all those clones
    assert(w.name == "stress")
    assert(len(w.routes) == 15)
    assert(w.routes[0].path == "/default")
    assert(w.routes[14].path == "/health")
}
