pull "io"

fn TestIoLimitSection() {
    let lim = io.limit_reader("abcdef", 3)
    let mut buf = make([]byte, 8, 8)
    let n, err = lim.read(buf)
    assert_eq(n, 3)
    assert_eq_str(err, "")
    let n2, err2 = lim.read(buf)
    assert_eq(n2, 0)
    assert_eq_str(err2, io.eof())
    assert_eq_str(io.copy_n("hello", 2), "he")
    assert_eq_str(io.copy_n("hello", 0), "")
    assert_eq_str(io.copy_n("hello", 99), "hello")
    let chunk, e = io.read_full("abcdef", 2, 3)
    assert_eq_str(e, "")
    assert_eq_str(chunk, "cde")
    let _, e2 = io.read_full("ab", 0, 5)
    assert_eq_str(e2, "unexpected EOF")
    let sec = io.section_reader("abcdef", 2, 3)
    assert_eq(sec.size(), 3)
    let n3, err3 = sec.read(buf)
    assert_eq(n3, 3)
    assert_eq_str(err3, "")
    assert_eq_str(io.multi_string(["a", "b", "c"]), "abc")
    let x, y = io.tee("z")
    assert_eq_str(x, "z")
    assert_eq_str(y, "z")
}
