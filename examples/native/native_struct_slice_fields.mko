// Native backend: structs with owned `[]float` / `[]byte` / `[]bool` fields
// (recursive clone/drop).
// Exercises construction (moving owned slice literals in), field reads as
// borrows, by-value pass (deep clone of the slice fields), value-copy
// semantics (mutating a copy leaves the original intact), and per-field
// drops on scope exit.
// Differentially validated against the C backend, and gated at zero leaks.
//
// A `StrBuilder` field is deliberately NOT exercised here — see
// native_struct_builder_field.mko, which documents a known leak that would
// otherwise take this fixture out of the zero-leak set.

struct Mix {
    floats: []float
    bytes: []byte
    flags: []bool
    tag: int
}

fn total_len(m: Mix) -> int {
    return len(m.floats) + len(m.bytes) + len(m.flags)
}

fn main() {
    let m = Mix { floats: [1.5, 2.5], bytes: []byte("Hi"), flags: [true, false], tag: 3 }
    print_int(total_len(m))

    var c = m
    c.tag = 9
    print_int(c.tag)
    print_int(m.tag)
    print(c.floats[0] == 1.5)
    print_int(int(c.bytes[1]))
    print(c.flags[0])
    print(m.flags[1])
}
