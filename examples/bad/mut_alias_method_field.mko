// Must fail: mut self and a mut field of self alias the same root.
struct Heavy {
    a: string
    b: string
    c: string
    d: []int
}

struct Holder {
    inner: Heavy
    n: int
}

on Holder {
    fn stamp_inner(mut self, mut inner: Heavy) {
        inner.a = "x"
        self.n = 2
    }
}

fn main() {
    let mut holder = Holder {
        inner: Heavy { a: "h", b: "b", c: "c", d: make([]int, 0, 1) },
        n: 1,
    }
    holder.stamp_inner(holder.inner)
}
