// Must fail: owned field already moved out of a call-returned struct
struct Detail {
    label string
}

struct QueryResult {
    code int
    text string
    detail Detail
}

fn query_result(text: string, label: string) -> QueryResult {
    return QueryResult{
        code: 200,
        text: text,
        detail: Detail{label: label},
    }
}

fn main() {
    let result = query_result("rows", "disk")
    let detail = result.detail
    let again = result.detail
    print(detail.label)
    print(again.label)
}
