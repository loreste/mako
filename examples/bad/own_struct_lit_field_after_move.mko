// Must fail: owned field already moved out of a unique struct local
struct Detail {
    label string
}

struct QueryResult {
    code int
    text string
    detail Detail
}

fn main() {
    let result = QueryResult{
        code: 200,
        text: "rows",
        detail: Detail{label: "disk"},
    }
    let detail = result.detail
    let again = result.detail
    print(detail.label)
    print(again.label)
}
