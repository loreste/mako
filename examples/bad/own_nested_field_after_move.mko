// Must fail: nested owned field already moved out of a call-returned struct
struct Inner {
    label string
}

struct Detail {
    inner Inner
}

struct QueryResult {
    code int
    text string
    detail Detail
}

fn query_result(text: string, label: string) -> QueryResult {
    return QueryResult{
        code: 200,
        text: text,
        detail: Detail{inner: Inner{label: label}},
    }
}

fn main() {
    let result = query_result("rows", "disk")
    let inner = result.detail.inner
    let again = result.detail.inner
    print(inner.label)
    print(again.label)
}
