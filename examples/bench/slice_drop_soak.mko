// Per-call slice drop soak.
//
// `build` allocates a 200k-element backing array, appends into it, and returns
// an int derived from it. The int cannot alias the array, so the array must be
// freed when `build` returns. If that drop is suppressed — as it was when any
// `return f(local)` marked the local moved — this leaks 1.6 MB per call and
// peaks near 800 MB instead of a few MB.
//
// The leak is invisible to a run-once fixture and to an across-run RSS ratio
// (every run leaks the same amount, so the ratio stays flat). Only the peak RSS
// of a single process over many calls shows it. See scripts/memory-safety-gate.sh.

fn build(n: int) -> int {
    let mut a = make([]int, 0, n)
    let mut i = 0
    while i < n {
        a = append(a, i)
        i = i + 1
    }
    return len(a)
}

// Same shape one level over: `str_to_upper` allocates its result, so it cannot
// alias `a` and `a` is still ours to free. Transferring the argument because the
// call returns an owning type leaked the source string on every call — 236 MB
// over the loop below, against ~7 MB once the drop is kept.
fn shout(n: int) -> string {
    let a = str_repeat("x", n)
    return str_to_upper(a)
}

// One more level of indirection: a user function cannot return a borrow of its
// argument (every escape path clones), so the caller still owns `a` and must
// free it. Transferring through the call instead leaked the source string.
fn upper_of(s: string) -> string {
    return str_to_upper(s)
}

fn via_fn(n: int) -> string {
    let a = str_repeat("z", n)
    return upper_of(a)
}

fn main() {
    let n = black_box(200000)
    let mut i = 0
    let mut acc = 0
    while i < 500 {
        acc = acc + build(n)
        i = i + 1
    }

    let m = black_box(100000)
    i = 0
    while i < 2000 {
        let s = shout(m)
        acc = acc + str_len(s)
        i = i + 1
    }

    i = 0
    while i < 2000 {
        let s = via_fn(m)
        acc = acc + str_len(s)
        i = i + 1
    }
    print_int(acc)
}
